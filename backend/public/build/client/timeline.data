43,"_45":175,"_47":43,"_48":43,"_49":152,"_51":88,"_53":176,"_55":177,"_56":178,"_58":-5,"_59":179,"_61":180,"_63":181,"_65":182,"_67":43,"_68":69},{"_30":160,"_32":161,"_34":35,"_36":162,"_38":163,"_40":164,"_42":43,"_44":43,"_45":41,"_47":43,"_48":43,"_49":43,"_51":43,"_53":54,"_55":54,"_56":165,"_58":-5,"_59":166,"_61":167,"_63":-5,"_65":168,"_67":43,"_68":69},{"_30":147,"_32":148,"_34":35,"_36":149,"_38":150,"_40":151,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":52,"_51":152,"_53":54,"_55":54,"_56":153,"_58":-5,"_59":154,"_61":155,"_63":156,"_65":157,"_67":43,"_68":69},{"_30":135,"_32":136,"_34":84,"_36":137,"_38":138,"_40":41,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":52,"_51":52,"_53":-5,"_55":-5,"_56":139,"_58":-5,"_59":140,"_61":141,"_63":142,"_65":143,"_67":43,"_68":69},{"_30":120,"_32":121,"_34":84,"_36":122,"_38":123,"_40":41,"_42":43,"_44":43,"_45":124,"_47":43,"_48":43,"_49":52,"_51":107,"_53":125,"_55":126,"_56":127,"_58":128,"_59":129,"_61":130,"_63":131,"_65":132,"_67":43,"_68":69},{"_30":103,"_32":104,"_34":105,"_36":106,"_38":54,"_40":41,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":107,"_51":52,"_53":108,"_55":109,"_56":110,"_58":-5,"_59":111,"_61":112,"_63":113,"_65":114,"_67":43,"_68":69},{"_30":82,"_32":83,"_34":84,"_36":85,"_38":86,"_40":41,"_42":43,"_44":43,"_45":87,"_47":43,"_48":43,"_49":52,"_51":88,"_53":89,"_55":90,"_56":91,"_58":-5,"_59":92,"_61":93,"_63":94,"_65":95,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":54,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","2435","name","Settlement of Sahul","type","event","startDescription","Humans reach Sahul (Australia and New Guinea) via island-hopping, establishing some of the earliest known human populations outside Africa and Eurasia.","endDescription","These populations form the basis of Aboriginal and Papuan cultural continuity.","startYear",-50000,"startMonth",0,"startDay","endYear",-45000,"endMonth","endDay","startSignificance",0.95,"endSignificance",0.9,"imageUrl","","imageCredit","sourceUrl","https://en.wikipedia.org/wiki/History_of_Australia","cdnId","country",{"_32":79,"_80":81},"subjects",[76],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"7","username","Kushim","Human Migrations","icon","GiEarthAfricaEurope",{"_30":77,"_32":78},"3","culture","Australia","continent","Oceania","2328","Sahul Land Bridge","period","A prehistoric landmass connecting present-day Australia, New Guinea, and Tasmania during periods of low sea levels in the Pleistocene.","As sea levels rose after the last Ice Age, the land bridge submerged, isolating populations and leading to the unique flora, fauna, and human cultures of Sahul.",-8000,0.7,"https://en.wikipedia.org/wiki/File:Sahul_map.png","Image: Sahul Map / Wikimedia Commons","https://en.wikipedia.org/wiki/Sahul",{"_32":79,"_80":81},[100],{"_32":98,"_74":99},{"_30":96,"_71":97},"6","HistOracle","Prehistory","GiStoneAxe",{"_30":101,"_32":102},"5","environment","2173","Lubang Jeriji Saléh","landmark","This site is known for its significant archaeological findings, showcasing the rich history of human habitation and cultural development.",0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6f/Lubang_Jeriji_Sal%C3%A9h_cave_painting_of_Bull.jpg/330px-Lubang_Jeriji_Sal%C3%A9h_cave_painting_of_Bull.jpg","Image: Lubang Jeriji Saléh / Wikimedia Commons","https://en.wikipedia.org/wiki/Lubang_Jeriji_Saléh",{"_32":118,"_80":119},[115,116],{"_32":98,"_74":99},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":96,"_32":117},"maritime","Indonesia","Asia","476","Upper Paleolithic Period","This period is characterized by the development of early human cultures and the emergence of advanced tools and art forms. It marks significant advancements in human creativity and social organization.","The period concludes with the transition to the Mesolithic, as climatic changes and human adaptation lead to new ways of life.",-10000,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Loewenmensch1.jpg/330px-Loewenmensch1.jpg","Dagmar Hollmann / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Upper_Paleolithic","images/2afcf57ffad227b46d409147a3c2a69367d2bf63.webp",{"_32":134,"_80":134},[133],{"_32":98,"_74":99},{"_30":70,"_71":72},{"_30":77,"_32":78},"Global","467","Australian Aboriginal culture","Australian Aboriginal culture encompasses the diverse traditions, languages, and practices of the Indigenous peoples of Australia, dating back tens of thousands of years.","It continues to thrive today, influencing contemporary Australian society and identity.","https://en.wikipedia.org/wiki/Aboriginal_Australians",{"_32":79,"_80":81},[146],{"_32":144,"_74":145},{"_30":70,"_71":72},"Polynesia and Oceania","GiCanoe",{"_30":77,"_32":78},"2434","Migration into Southeast Asia","Humans follow coastal routes into Southeast Asia, settling in areas such as modern-day Thailand, Vietnam, and Indonesia.","Populations continue to expand, setting the stage for eventual migration into Sahul.",-55000,0.85,"https://en.wikipedia.org/wiki/Human_migration_to_Southeast_Asia",{"_32":159,"_80":119},[158],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"Thailand","2432","Migration into South Asia","Humans migrate into South Asia, occupying the Indian subcontinent with lithic and genetic evidence of early populations.","South Asian populations form distinct genetic and cultural groups, forming part of the southern coastal migration route.",-65000,"https://en.wikipedia.org/wiki/Genetic_history_of_India",{"_32":170,"_80":119},[169],{"_30":70,"_71":72},{"_30":77,"_32":78},"India","2285","Howiesons Poort","Howiesons Poort is a Middle Stone Age culture from South Africa known for backed tools, early symbolic behavior, and advanced blade technology.","It eventually disappeared as humans transitioned to later Stone Age industries.",-60000,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/78/Howiesons_Poort_tools.jpg/330px-Howiesons_Poort_tools.jpg","Image: Howiesons Poort tools / Wikimedia Commons","https://en.wikipedia.org/wiki/Howiesons_Poort",{"_32":184,"_80":185},[183],{"_32":98,"_74":99},{"_30":96,"_71":97},{"_30":77,"_32":78},"South Africa","Africa","1259","Early Human Migration Out of Africa","Groups crossed through the Arabian Peninsula into Asia and later into Europe and Oceania. This migration established the first human populations outside Africa and shaped the genetic and cultural development of all later societies.",-70000,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/27/Spreading_homo_sapiens_la.svg/330px-Spreading_homo_sapiens_la.svg.png","Image: Out of Africa / Wikimedia Commons","https://en.wikipedia.org/wiki/Early_human_migrations",{"_32":134,"_80":134},[197],{"_32":98,"_74":99},{"_30":70,"_71":72},{"_30":77,"_32":78},"2442","Toba Supereruption","The Toba supereruption was one of the largest volcanic events in the last 2 million years, occurring on the island of Sumatra, Indonesia.","The eruption caused a volcanic winter, drastically affecting global climates and possibly creating a genetic bottleneck in human populations.",-74000,-73800,"https://upload.wikimedia.org/wikipedia/commons/b/b1/Toba_zoom.jpg","Image: Toba Caldera / Wikimedia Commons","https://en.wikipedia.org/wiki/Toba_catastrophe_theory",{"_32":118,"_80":119},[210],{"_30":96,"_71":97},{"_30":77,"_32":78},"2284","Still Bay Culture","Still Bay culture is a Middle Stone Age tradition from South Africa, known for bifacial points and early symbolic behavior.","It represents a technological and cognitive leap toward modern human behaviors.",-75000,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Still_Bay_point.jpg/330px-Still_Bay_point.jpg","Image: Still Bay point / Wikimedia Commons","https://en.wikipedia.org/wiki/Still_Bay",{"_32":184,"_80":185},[223],{"_32":98,"_74":99},{"_30":96,"_71":97},{"_30":77,"_32":78},"1188","Origin of Clothing","The earliest humans developed clothing from animal skins, furs, and plant fibers to protect themselves from the elements and aid survival.","Clothing allowed humans to inhabit diverse environments and laid the foundation for later cultural and social expression.",-100000,"https://en.wikipedia.org/wiki/History_of_clothing_and_textiles",{"_32":134,"_80":134},[233,234],{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":235,"_32":236},"8","economic","2289","Mumba Complex","The Mumba Complex is a Middle Stone Age culture from Tanzania, recognized for microlithic tools and evidence of early human cognitive behavior.","It represents an important phase in the development of modern human technology in East Africa.",-130000,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/33/Mumba_MSA_tools.jpg/330px-Mumba_MSA_tools.jpg","Image: Mumba Complex / Wikimedia Commons","https://en.wikipedia.org/wiki/Mumba_Complex",{"_32":250,"_80":185},[249],{"_32":98,"_74":99},{"_30":70,"_71":72},{"_30":77,"_32":78},"Tanzania","2288","Aterian Culture","The Aterian is a North African Middle-to-Later Stone Age culture, notable for tanged points and early symbolic artifacts.","It gradually disappeared as later Stone Age technologies spread across Africa.",-145000,-20000,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Aterian_tanged_point.jpg","Image: Aterian tanged point / Wikimedia Commons","https://en.wikipedia.org/wiki/Aterian",{"_32":185,"_80":185},[264],{"_32":98,"_74":99},{"_30":70,"_71":72},{"_30":77,"_32":78},"1008","Emergence of Homo Sapiens","The species of anatomically modern humans that emerged in Africa and spread globally, becoming the dominant hominin with advanced cognition and culture.","The emergence of Homo sapiens laid the foundation for the development of societies and cultures that would follow.",-300000,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/68/Akha_cropped_hires.JPG/330px-Akha_cropped_hires.JPG","Image: Human / Wikimedia Commons","https://en.wikipedia.org/wiki/Homo_sapiens",{"_32":185,"_80":185},[278,279],{"_32":98,"_74":99},{"_30":70,"_71":72},2,{"_30":77,"_32":78},{"_30":280,"_32":281},"4","intellectual",[],"subject",[],[],"yearStart","yearEnd",2025,"search","sortBy",true]
