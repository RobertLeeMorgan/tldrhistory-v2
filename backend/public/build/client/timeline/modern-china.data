38":191,"_40":192,"_42":43,"_44":105,"_45":193,"_46":43,"_47":105,"_48":194,"_50":124,"_51":195,"_53":196,"_55":197,"_57":-5,"_58":198,"_60":199,"_62":200,"_64":201,"_66":43,"_67":68},{"_30":171,"_32":172,"_34":82,"_36":173,"_38":174,"_40":175,"_42":176,"_44":177,"_45":175,"_46":43,"_47":43,"_48":87,"_50":124,"_51":178,"_53":179,"_55":180,"_57":-5,"_58":181,"_60":182,"_62":183,"_64":184,"_66":43,"_67":68},{"_30":155,"_32":156,"_34":82,"_36":157,"_38":158,"_40":159,"_42":43,"_44":43,"_45":160,"_46":43,"_47":43,"_48":88,"_50":88,"_51":161,"_53":162,"_55":163,"_57":164,"_58":165,"_60":166,"_62":167,"_64":168,"_66":43,"_67":68},{"_30":136,"_32":137,"_34":82,"_36":138,"_38":139,"_40":140,"_42":141,"_44":142,"_45":143,"_46":105,"_47":43,"_48":88,"_50":87,"_51":144,"_53":145,"_55":146,"_57":-5,"_58":147,"_60":148,"_62":149,"_64":150,"_66":43,"_67":68},{"_30":118,"_32":119,"_34":82,"_36":120,"_38":121,"_40":122,"_42":43,"_44":43,"_45":123,"_46":43,"_47":43,"_48":124,"_50":88,"_51":125,"_53":126,"_55":127,"_57":-5,"_58":128,"_60":129,"_62":130,"_64":131,"_66":43,"_67":68},{"_30":100,"_32":101,"_34":82,"_36":102,"_38":103,"_40":104,"_42":105,"_44":105,"_45":106,"_46":43,"_47":43,"_48":88,"_50":87,"_51":107,"_53":108,"_55":109,"_57":-5,"_58":110,"_60":111,"_62":112,"_64":113,"_66":43,"_67":68},{"_30":80,"_32":81,"_34":82,"_36":83,"_38":84,"_40":85,"_42":43,"_44":43,"_45":86,"_46":43,"_47":43,"_48":87,"_50":88,"_51":-5,"_53":-5,"_55":89,"_57":-5,"_58":90,"_60":91,"_62":92,"_64":93,"_66":43,"_67":68},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":49,"_50":43,"_51":52,"_53":54,"_55":56,"_57":-5,"_58":59,"_60":61,"_62":63,"_64":65,"_66":43,"_67":68},"id","944","name","Nanjing Yangtze River Bridge","type","landmark","startDescription","This bridge is a significant feat of engineering and a symbol of national pride in China. Spanning the Yangtze River, it serves as a vital transportation link and showcases the country's advancements in infrastructure.","endDescription","The bridge remains operational and continues to facilitate travel and trade across the river.","startYear",1968,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.75,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/%E5%8D%97%E4%BA%AC%E9%95%BF%E6%B1%9F%E5%A4%A7%E6%A1%A5%C2%B7%E4%B8%9C%E5%8C%97.jpg/330px-%E5%8D%97%E4%BA%AC%E9%95%BF%E6%B1%9F%E5%A4%A7%E6%A1%A5%C2%B7%E4%B8%9C%E5%8C%97.jpg","imageCredit","Image: Nanjing Yangtze River Bridge / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Nanjing_Yangtze_River_Bridge","cdnId","country",{"_32":77,"_78":79},"subjects",[75],"group",{"_32":72,"_73":74},"user",{"_30":69,"_70":71},"likes","liked",false,"6","username","HistOracle","Modern China","icon","GiModernCity",{"_30":69,"_32":76},"maritime","China","continent","Asia","507","The Cultural Revolution","event","A sociopolitical movement in China aimed at preserving communist ideology by purging remnants of capitalist and traditional elements.","The movement led to widespread chaos, persecution, and significant changes in Chinese society.",1966,1976,0.8,0.9,"https://en.wikipedia.org/wiki/Cultural_Revolution",{"_32":77,"_78":79},[94,95],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":96,"_32":97},"3","culture","2","politics","1817","Great Leap Forward","An ambitious campaign aimed at rapidly transforming China from an agrarian society into a socialist society through rapid industrialization and collectivization.","The campaign ended with widespread famine and economic disaster, leading to significant changes in policy and leadership in China.",1958,1,1962,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/15/Great_Leap_Forward_%28Chinese_characters%29.svg/330px-Great_Leap_Forward_%28Chinese_characters%29.svg.png","Image: Great Leap Forward / Wikimedia Commons","https://en.wikipedia.org/wiki/Great_Leap_Forward",{"_32":77,"_78":79},[114,115],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":116,"_32":117},"8","economic","1642","The Hundred Flowers Campaign","A political movement encouraging open expression and criticism of the Communist Party, aiming to promote intellectual discourse.","The campaign ended with a crackdown on dissent, leading to widespread persecution of those who spoke out.",1956,1957,0.7,"","Image: Hundred Flowers Campaign / Wikimedia Commons","https://en.wikipedia.org/wiki/Hundred_Flowers_Campaign",{"_32":77,"_78":79},[132,133],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":134,"_32":135},"4","intellectual","1484","Nanjing Massacre","A horrific episode marked by mass killings and atrocities committed against civilians during a military invasion.","The event concluded with significant loss of life and left a lasting impact on historical memory and international relations.",1937,12,13,1938,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Nanking_bodies_1937.jpg/330px-Nanking_bodies_1937.jpg","Image: Nanjing Massacre / Wikimedia Commons","https://en.wikipedia.org/wiki/Nanjing_Massacre",{"_32":77,"_78":79},[151,152],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":153,"_32":154},{"_30":98,"_32":99},"1","military","509","The Chinese Civil War","A conflict between the Nationalists and Communists in China that shaped the country's political landscape.","The war concluded with the establishment of the People's Republic of China, altering the course of Chinese history.",1927,1950,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/Battle_of_Siping03.jpg/330px-Battle_of_Siping03.jpg","Unknown author / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Chinese_Civil_War","images/bda197aa6bda00c8ddfc80988e4a359e2f6f9275.webp",{"_32":77,"_78":79},[169,170],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":153,"_32":154},{"_30":98,"_32":99},"1822","May Fourth Movement","A cultural and political movement that emerged in response to the Treaty of Versailles, advocating for modernization and reform in China.","The movement concluded with significant impacts on Chinese intellectual thought and the rise of nationalism.",1919,5,4,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/00/Chinese_protestors_march_against_the_Treaty_of_Versailles_%28May_4%2C_1919%29.jpg/330px-Chinese_protestors_march_against_the_Treaty_of_Versailles_%28May_4%2C_1919%29.jpg","Image: May Fourth Movement / Wikimedia Commons","https://en.wikipedia.org/wiki/May_Fourth_Movement",{"_32":77,"_78":79},[185,186],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":134,"_32":135},"2251","Republic of China","period","The Republic of China was established after the fall of the Qing Dynasty, introducing modern republican governance and initiating political, social, and military reforms.","It lost mainland China to the People's Republic of China in 1949 and now governs Taiwan.",1912,1949,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Republic_of_China_%281912-1949%29_map.png/330px-Republic_of_China_%281912-1949%29_map.png","Image: Republic of China / Wikimedia Commons","https://en.wikipedia.org/wiki/Republic_of_China",{"_32":77,"_78":79},[202],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":96,"_32":97},"1819","Boxer Rebellion","A violent anti-foreign and anti-Christian uprising that emerged in China, fueled by nationalist sentiments and opposition to foreign imperialism.","The uprising was suppressed by an eight-nation alliance, leading to significant foreign intervention and the imposition of harsh penalties on China.",1899,1901,9,7,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b2/Taku_Forts_Landing.JPG/330px-Taku_Forts_Landing.JPG","Image: Boxer Rebellion / Wikimedia Commons","https://en.wikipedia.org/wiki/Boxer_Rebellion",{"_32":77,"_78":79},[218,219],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":96,"_32":97},"1826","Mao Zedong","person","A prominent Chinese revolutionary leader who played a key role in the establishment of the People's Republic of China.","His death marked the end of an era in Chinese politics, leading to significant changes in the country's direction.",1893,26,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Mao_Zedong_1950_Portait_%283x4_cropped%29.jpg/330px-Mao_Zedong_1950_Portait_%283x4_cropped%29.jpg","Image: Mao Zedong / Wikimedia Commons","https://en.wikipedia.org/wiki/Mao_Zedong",{"_32":77,"_78":79},[234,235],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":96,"_32":97},"1824","Lu Xun","A prominent figure in modern Chinese literature, he is known for his sharp critiques of traditional Chinese culture and society.","His legacy continues to influence Chinese literature and thought, marking him as a key figure in the cultural revolution.",1881,25,1936,10,19,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/LuXun1930.jpg/330px-LuXun1930.jpg","Image: Lu Xun / Wikimedia Commons","https://en.wikipedia.org/wiki/Lu_Xun",{"_32":77,"_78":79},[252,253],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":96,"_32":97},{"_30":134,"_32":135},"1821","Liang Qichao","A prominent intellectual and reformer in late Qing China, advocating for modernization and political reform.","His ideas and writings significantly influenced modern Chinese thought and politics, leaving a lasting legacy.",1873,2,23,1929,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f0/Liang_Qichao_portrait.jpg/330px-Liang_Qichao_portrait.jpg","Image: Liang Qichao / Wikimedia Commons","https://en.wikipedia.org/wiki/Liang_Qichao",{"_32":77,"_78":79},[269,270],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":134,"_32":135},"1827","Sun Yat-sen","A revolutionary leader who played a pivotal role in overthrowing the Qing dynasty and establishing the Republic of China.","His death marked the end of an era in Chinese politics, but his legacy continued to influence future generations.",1866,11,1925,3,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d9/%E5%AD%99%E4%B8%AD%E5%B1%B1%E8%82%96%E5%83%8F.jpg/330px-%E5%AD%99%E4%B8%AD%E5%B1%B1%E8%82%96%E5%83%8F.jpg","Image: Sun Yat-sen / Wikimedia Commons","https://en.wikipedia.org/wiki/Sun_Yat-sen",{"_32":77,"_78":79},[286,287],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":134,"_32":135},"1820","Taiping Rebellion","A massive civil war in southern China led by Hong Xiuquan, who claimed to be the brother of Jesus Christ, aiming to overthrow the Qing dynasty.","The rebellion ended with the fall of the Taiping capital, Nanjing, resulting in a devastating loss of life and the restoration of Qing control.",1850,1864,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Regaining_the_Provincial_City_Anqing2.jpg/330px-Regaining_the_Provincial_City_Anqing2.jpg","Image: Taiping Rebellion / Wikimedia Commons","https://en.wikipedia.org/wiki/Taiping_Rebellion",{"_32":77,"_78":79},[301,302],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":153,"_32":154},{"_30":98,"_32":99},"258","The Opium Wars","Conflicts between China and Britain over trade imbalances and opium trade.","The wars resulted in the Treaty of Nanking, marking the start of foreign influence in China.",1839,1842,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Destroying_Chinese_war_junks%2C_by_E._Duncan_%281843%29.jpg/330px-Destroying_Chinese_war_junks%2C_by_E._Duncan_%281843%29.jpg","Edward Duncan / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Opium_Wars","images/ec225fb703f948ad25993922452a9e9cee28de57.webp",{"_32":77,"_78":79},[317],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,48]
