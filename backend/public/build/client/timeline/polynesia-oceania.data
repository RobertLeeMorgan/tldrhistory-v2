_44":43,"_45":188,"_47":43,"_48":43,"_49":174,"_51":189,"_53":190,"_55":191,"_57":192,"_59":-5,"_60":193,"_62":194,"_64":195,"_66":196,"_68":43,"_69":70},{"_30":168,"_32":169,"_34":87,"_36":170,"_38":171,"_40":172,"_42":43,"_44":43,"_45":173,"_47":43,"_48":43,"_49":174,"_51":175,"_53":176,"_55":177,"_57":178,"_59":-5,"_60":179,"_62":180,"_64":181,"_66":182,"_68":43,"_69":70},{"_30":151,"_32":152,"_34":35,"_36":153,"_38":154,"_40":141,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":50,"_53":155,"_55":156,"_57":157,"_59":158,"_60":159,"_62":160,"_64":161,"_66":162,"_68":43,"_69":70},{"_30":136,"_32":137,"_34":138,"_36":139,"_38":140,"_40":141,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":52,"_51":43,"_53":128,"_55":142,"_57":143,"_59":-5,"_60":144,"_62":145,"_64":146,"_66":147,"_68":43,"_69":70},{"_30":122,"_32":123,"_34":35,"_36":124,"_38":125,"_40":126,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":127,"_53":128,"_55":-5,"_57":129,"_59":-5,"_60":130,"_62":131,"_64":132,"_66":133,"_68":43,"_69":70},{"_30":103,"_32":104,"_34":35,"_36":105,"_38":106,"_40":107,"_42":43,"_44":43,"_45":108,"_47":43,"_48":43,"_49":52,"_51":52,"_53":109,"_55":110,"_57":111,"_59":-5,"_60":112,"_62":113,"_64":114,"_66":115,"_68":43,"_69":70},{"_30":85,"_32":86,"_34":87,"_36":88,"_38":89,"_40":90,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":52,"_53":91,"_55":92,"_57":93,"_59":-5,"_60":94,"_62":95,"_64":96,"_66":97,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","1978","name","Puʻuhonua o Hōnaunau","type","landmark","startDescription","This site served as a place of refuge for those who broke kapu, the ancient laws of Hawaii, providing sanctuary and a chance for redemption.","endDescription","The site was designated a national historical park, preserving its cultural and historical significance for future generations.","startYear",1400,"startMonth",0,"startDay","endYear",1961,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.9,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Pu%CA%BBuhonua_o_H%C5%8Dnaunau.jpg/330px-Pu%CA%BBuhonua_o_H%C5%8Dnaunau.jpg","imageCredit","Image: Puʻuhonua o Hōnaunau National Historical Park / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Puʻuhonua_o_Hōnaunau_National_Historical_Park","cdnId","country",{"_32":82,"_83":84},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"7","username","Kushim","Polynesia and Oceania","icon","GiCanoe",{"_30":80,"_32":81},{"_30":71,"_32":79},"religion","3","culture","United States of America","continent","NorthAmerica","955","Māori Culture","period","This period marks the arrival of the Māori people in New Zealand, bringing with them rich cultural practices, including traditional cooking methods such as hangi.","The significance of Māori culture continues to thrive today, influencing New Zealand's identity and heritage.",1280,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/TamatekapuaMeetingHouse.jpg/330px-TamatekapuaMeetingHouse.jpg","Image: Māori culture / Wikimedia Commons","https://en.wikipedia.org/wiki/M%C4%81ori_culture",{"_32":101,"_83":102},[100],{"_32":74,"_75":76},{"_30":98,"_72":99},"6","HistOracle",{"_30":80,"_32":81},"New Zealand","Oceania","984","Moai Statues","These monumental statues are renowned for their oversized heads and represent the artistic and cultural achievements of the Rapa Nui people. Carved from volcanic tuff, they are scattered across the island.","Construction of the Moai ceased as societal changes and environmental pressures reshaped the island's culture, leaving the statues as enduring symbols of Rapa Nui heritage.",1250,1500,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Ahu-Akivi-1.JPG/330px-Ahu-Akivi-1.JPG","Image: Rapa Nui National Park / Wikimedia Commons","https://en.wikipedia.org/wiki/Moai",{"_32":120,"_83":121},[116,117],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":80,"_32":81},{"_30":118,"_32":119},"9","art","Chile","SouthAmerica","1977","Haʻamonga ʻa Maui","This monumental stone structure is located in the island of Tongatapu and is believed to have been constructed as a significant cultural and ceremonial site.","The site remains a vital part of Tongan heritage and continues to be a symbol of the nation's history and culture.",1200,0.5,"","https://en.wikipedia.org/wiki/Ha%CA%BBamonga_%C4%80_Maui",{"_32":135,"_83":102},[134],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},"Tonga","1965","Hotu Matuʻa","person","A legendary figure credited with the discovery and settlement of Easter Island, leading the first Polynesian migration to the island.","The legacy of this figure continues to influence the cultural identity of the Rapa Nui people.",1100,"Image: Hotu Matuꞌa / Wikimedia Commons","https://en.wikipedia.org/wiki/Hotu_Matu%27a",{"_32":120,"_83":121},[148,149],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},{"_30":98,"_32":150},"maritime","464","Bunjil's Shelter","Bunjil's Shelter is a significant Aboriginal rock art site located in Victoria, Australia, featuring ancient engravings that depict cultural stories and beliefs.","It serves as an important symbol of Indigenous heritage and connection to the land.","https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/20120705_Bunjil_Shelter.JPG/330px-20120705_Bunjil_Shelter.JPG","Michael Barnett / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Bunjil%27s_Shelter","images/5d88e71a99b5075b7537a017815a581763a7ba42.webp",{"_32":167,"_83":102},[163,164],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},{"_30":165,"_32":166},"5","environment","Australia","2272","Tongan Chiefdom","Tongan Chiefdoms were Polynesian societies with hierarchical leadership and rich maritime culture in the Tongan islands.","They transitioned into the modern Kingdom of Tonga with the unification under King George Tupou I in 1845.",1000,1845,0.75,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/19/Tonga_map.png/330px-Tonga_map.png","Image: Tonga / Wikimedia Commons","https://en.wikipedia.org/wiki/Kingdom_of_Tonga#History",{"_32":135,"_83":102},[183],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},"2270","Samoan Chiefdoms","Samoan Chiefdoms were a collection of Polynesian societies with hierarchical structures and rich cultural traditions across the Samoan islands.","European colonization and unification led to the modern state of Samoa.",1900,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/Samoa_map.png/330px-Samoa_map.png","Image: Samoa / Wikimedia Commons","https://en.wikipedia.org/wiki/Samoa#History",{"_32":198,"_83":102},[197],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},"Samoa","1963","Tuʻi Tonga Empire","This empire was a significant political and cultural entity in the South Pacific, known for its maritime prowess and influence over various islands.","The decline of the empire marked the end of a significant era in Polynesian history, leading to shifts in power dynamics across the region.",950,1865,0.7,"https://en.wikipedia.org/wiki/Tu%CA%BBi_Tonga_empire",{"_32":135,"_83":102},[211,212],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":213,"_32":214},{"_30":80,"_32":81},"2","politics","1964","Nan Madol","An ancient city of basalt structures built on artificial islets in Micronesia, serving as the ceremonial and political center of the Saudeleur Dynasty.","The site fell into disuse and was largely abandoned, with its ruins becoming a significant archaeological and cultural landmark.",700,1600,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c3/Nan_madol.jpg/330px-Nan_madol.jpg","Image: Nan Madol / Wikimedia Commons","https://en.wikipedia.org/wiki/Nan_Madol",{"_32":230,"_83":102},[228,229],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":80,"_32":81},{"_30":98,"_32":150},"Micronesia","982","Rapa Nui Culture","The Rapa Nui culture emerged on Easter Island, characterized by its unique art forms, including the famous moai statues, and a complex social structure. This period saw the development of religious practices and a rich oral tradition.","The culture began to decline due to various factors, including environmental changes and European contact, leading to significant transformations in social and cultural practices.",300,1868,"https://en.wikipedia.org/wiki/Rapa_Nui_culture",{"_32":120,"_83":121},[242,243],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},{"_30":71,"_32":79},"1984","Settlement of Polynesia","The initial migration of Polynesians across the Pacific Ocean, leading to the establishment of communities on various islands.","The settlement process laid the foundation for the diverse cultures and societies that developed across Polynesia.",-900,"https://en.wikipedia.org/wiki/Settlement_of_Polynesia",{"_32":255,"_83":255},[254],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},"Global","1982","Lapita Culture","This cultural phenomenon is characterized by distinctive pottery, navigation skills, and the establishment of settlements across the Pacific Islands.","The culture gradually evolved into distinct regional cultures, leading to the diverse societies seen in the Pacific today.",-1600,-500,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cb/Carte_lapita.png/330px-Carte_lapita.png","Image: Lapita culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Lapita_culture",{"_32":102,"_83":102},[269],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},"1980","Kuk Early Agricultural Site","This site is one of the earliest known agricultural locations in the world, showcasing the development of farming practices in the Pacific region.","The site remains significant for ongoing research into early agriculture and its impact on human societies.",-8000,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Kuk_New_Guinea_2002.jpg/330px-Kuk_New_Guinea_2002.jpg","Image: Kuk Swamp / Wikimedia Commons","https://en.wikipedia.org/wiki/Kuk_Early_Agricultural_Site",{"_32":286,"_83":102},[282,283],{"_32":74,"_75":76},{"_30":98,"_72":99},{"_30":80,"_32":81},{"_30":284,"_32":285},"8","economic","Papua New Guinea","467","Australian Aboriginal culture","Australian Aboriginal culture encompasses the diverse traditions, languages, and practices of the Indigenous peoples of Australia, dating back tens of thousands of years.","It continues to thrive today, influencing contemporary Australian society and identity.",-50000,"https://en.wikipedia.org/wiki/Aboriginal_Australians",{"_32":167,"_83":102},[297],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":80,"_32":81},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,34]
