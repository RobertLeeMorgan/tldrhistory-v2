6":189,"_38":190,"_40":191,"_42":123,"_44":120,"_46":192,"_47":145,"_48":49,"_50":89,"_52":146,"_53":193,"_55":194,"_57":195,"_59":-5,"_60":196,"_62":197,"_64":198,"_66":199,"_68":69,"_70":71},{"_30":172,"_32":173,"_34":35,"_36":174,"_38":175,"_40":176,"_42":123,"_44":120,"_46":121,"_47":123,"_48":177,"_50":178,"_52":179,"_53":180,"_55":181,"_57":182,"_59":-5,"_60":183,"_62":184,"_64":185,"_66":186,"_68":69,"_70":71},{"_30":157,"_32":158,"_34":159,"_36":160,"_38":161,"_40":143,"_42":69,"_44":69,"_46":121,"_47":69,"_48":69,"_50":120,"_52":51,"_53":162,"_55":163,"_57":164,"_59":-5,"_60":165,"_62":166,"_64":167,"_66":168,"_68":69,"_70":71},{"_30":139,"_32":140,"_34":35,"_36":141,"_38":142,"_40":143,"_42":144,"_44":49,"_46":106,"_47":122,"_48":145,"_50":51,"_52":146,"_53":147,"_55":148,"_57":149,"_59":-5,"_60":150,"_62":151,"_64":152,"_66":153,"_68":69,"_70":71},{"_30":116,"_32":117,"_34":35,"_36":118,"_38":119,"_40":106,"_42":120,"_44":120,"_46":121,"_47":122,"_48":123,"_50":51,"_52":51,"_53":124,"_55":125,"_57":126,"_59":127,"_60":128,"_62":129,"_64":130,"_66":131,"_68":69,"_70":71},{"_30":102,"_32":103,"_34":35,"_36":104,"_38":105,"_40":106,"_42":107,"_44":49,"_46":106,"_47":107,"_48":49,"_50":51,"_52":89,"_53":108,"_55":109,"_57":110,"_59":-5,"_60":111,"_62":112,"_64":113,"_66":114,"_68":69,"_70":71},{"_30":84,"_32":85,"_34":35,"_36":86,"_38":87,"_40":41,"_42":69,"_44":69,"_46":88,"_47":69,"_48":69,"_50":51,"_52":89,"_53":90,"_55":91,"_57":92,"_59":93,"_60":94,"_62":95,"_64":96,"_66":97,"_68":69,"_70":71},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":41,"_47":43,"_48":49,"_50":51,"_52":51,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71},"id","2152","name","Battle of Midway","type","event","startDescription","This pivotal naval battle marked a turning point in the Pacific Theater, featuring a decisive victory for the United States against Japan.","endDescription","The battle concluded with significant losses for Japan, shifting the balance of power in the Pacific towards the Allies.","startYear",1942,"startMonth",6,"startDay",4,"endYear","endMonth","endDay",7,"startSignificance",0.9,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/USS_Yorktown_%28CV-5%29_is_hit_by_a_torpedo_on_4_June_1942.jpg/330px-USS_Yorktown_%28CV-5%29_is_hit_by_a_torpedo_on_4_June_1942.jpg","imageCredit","Image: Battle of Midway / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Battle_of_Midway","cdnId","country",{"_32":81,"_82":83},"subjects",[78],"group",{"_32":75,"_76":77},"user",{"_30":72,"_73":74},"likes",0,"liked",false,"6","username","HistOracle","WWII","icon","GiTank",{"_30":79,"_32":80},"1","military","United States of America","continent","NorthAmerica","542","The Manhattan Project","A secret U.S. government research project during World War II that produced the first nuclear weapons.","The project concluded with the successful testing of atomic bombs, fundamentally changing warfare and international relations.",1946,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9f/Time%2C_3-22_p.m%2C_December_2%2C_1942._Place%2C_Racquets_Court_under_West_Stands_of_Stagg_Field%2C_University_of_Chicago...._-_NARA_-_542144.tif/lossy-page1-320px-Time%2C_3-22_p.m%2C_December_2%2C_1942._Place%2C_Racquets_Court_under_West_Stands_of_Stagg_Field%2C_University_of_Chicago...._-_NARA_-_542144.tif.jpg","Unknown author / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Manhattan_Project","images/4b5c5fec9233d5a0f740725c333149299a3705e4.webp",{"_32":81,"_82":83},[98,99],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},{"_30":100,"_32":101},"4","intellectual","2151","Attack on Pearl Harbor","A surprise military strike by the Imperial Japanese Navy against the United States naval base at Pearl Harbor.","The attack led to significant losses for the U.S. Pacific Fleet and propelled the United States into World War II.",1941,12,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/Attack_on_Pearl_Harbor_Japanese_planes_view.jpg/330px-Attack_on_Pearl_Harbor_Japanese_planes_view.jpg","Image: Attack on Pearl Harbor / Wikimedia Commons","https://en.wikipedia.org/wiki/Attack_on_Pearl_Harbor",{"_32":81,"_82":83},[115],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},"241","The Holocaust","The systematic, state-sponsored persecution and murder of six million Jews.","The genocide ended with the defeat of Nazi Germany in World War II.",1,1945,5,8,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Selection_on_the_ramp_at_Auschwitz-Birkenau%2C_1944_%28Auschwitz_Album%29_1b.jpg/330px-Selection_on_the_ramp_at_Auschwitz-Birkenau%2C_1944_%28Auschwitz_Album%29_1b.jpg","Bernhard Walter / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Holocaust","images/0571210047a37a75c66900e2ab8011ae1276f73b.webp",{"_32":138,"_82":138},[132,133],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":136,"_32":137},{"_30":134,"_32":135},"7","religion","2","politics","Global","2148","The Blitz","A sustained bombing campaign by the German Luftwaffe against the United Kingdom, primarily targeting London and other major cities.","The campaign concluded with the Luftwaffe shifting focus to other military objectives, marking a significant moment in the air war of WWII.",1940,9,11,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/Heinkel_He_111_over_Wapping%2C_East_London.jpg/330px-Heinkel_He_111_over_Wapping%2C_East_London.jpg","Image: The Blitz / Wikimedia Commons","https://en.wikipedia.org/wiki/The_Blitz",{"_32":155,"_82":156},[154],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},"United Kingdom","Europe","2160","Auschwitz Concentration Camp","landmark","Auschwitz was a complex of concentration and extermination camps operated by Nazi Germany during World War II, located in occupied Poland.","The camp was liberated by Soviet forces in January 1945, marking the end of its operation and the discovery of the atrocities committed there.","https://upload.wikimedia.org/wikipedia/commons/thumb/3/35/Auschwitz_I_%2822_May_2010%29_b.jpg/330px-Auschwitz_I_%2822_May_2010%29_b.jpg","Image: Auschwitz concentration camp / Wikimedia Commons","https://en.wikipedia.org/wiki/Auschwitz_concentration_camp",{"_32":171,"_82":156},[169,170],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},{"_30":136,"_32":137},"Poland","2444","World War II","World War II was a global conflict involving most of the world's nations, starting with Germany's invasion of Poland.","The war ended with the defeat of the Axis Powers, the Holocaust, the use of nuclear weapons on Japan, and the establishment of the United Nations.",1939,15,0.98,0.95,"https://upload.wikimedia.org/wikipedia/commons/2/2e/WWII_Montage.png","Image: Various / Wikimedia Commons","https://en.wikipedia.org/wiki/World_War_II",{"_32":138,"_82":138},[],{"_32":75,"_76":77},{"_30":72,"_73":74},"2154","The Great Purge","This was a campaign of political repression in the Soviet Union, marked by widespread arrests and executions of perceived enemies.","The campaign ended with a significant reduction in the Communist Party's membership and a climate of fear across the nation.",1936,1938,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f5/Vinnycia16.jpg/330px-Vinnycia16.jpg","Image: Great Purge / Wikimedia Commons","https://en.wikipedia.org/wiki/Great_Purge",{"_32":201,"_82":156},[200],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":136,"_32":137},"Russia","1247","Anne Frank","person","A Jewish girl who gained fame posthumously with the publication of her diary, which documents her life in hiding during the Holocaust.","Her life was tragically cut short in a concentration camp, but her diary continues to resonate as a powerful testament to the human spirit.",1929,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6b/Anne_Frank_passport_photo%2C_May_1942_%28cropped%29.jpg/330px-Anne_Frank_passport_photo%2C_May_1942_%28cropped%29.jpg","Image: Anne Frank / Wikimedia Commons","https://en.wikipedia.org/wiki/Anne_Frank",{"_32":218,"_82":156},[215],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":216,"_32":217},"3","culture","Netherlands","2156","Joseph Goebbels","A prominent political figure and the Minister of Propaganda in Nazi Germany, he played a crucial role in shaping public opinion and promoting the regime's ideology.","He died by suicide in the final days of the war, as the Nazi regime collapsed and defeat became inevitable.",1897,10,29,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/35/Bundesarchiv_Bild_146-1968-101-20A%2C_Joseph_Goebbels.jpg/330px-Bundesarchiv_Bild_146-1968-101-20A%2C_Joseph_Goebbels.jpg","Image: Joseph Goebbels / Wikimedia Commons","https://en.wikipedia.org/wiki/Joseph_Goebbels",{"_32":234,"_82":156},[233],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":136,"_32":137},"Germany","2159","Hermann Göring","A prominent military and political leader in Nazi Germany, he played a key role in the establishment of the Luftwaffe and was a close associate of the Führer.","He was captured after the war and tried at Nuremberg, where he was sentenced to death for crimes against humanity.",1893,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/49/Hermann_Goering_-_Nuremberg_2_%28cropped%29.jpg/330px-Hermann_Goering_-_Nuremberg_2_%28cropped%29.jpg","Image: Hermann Göring / Wikimedia Commons","https://en.wikipedia.org/wiki/Hermann_G%C3%B6ring",{"_32":234,"_82":156},[247,248],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},{"_30":136,"_32":137},"2445","Adolf Hitler","Adolf Hitler was the leader of the National Socialist German Workers' Party (Nazi Party) and became Chancellor of Germany in 1933.","Hitler led Germany through World War II, orchestrated the Holocaust, and committed suicide in 1945 as the Allies closed in.",1889,20,30,"https://upload.wikimedia.org/wikipedia/commons/5/53/Hitler_portrait_crop.jpg","Image: Bundesarchiv / Wikimedia Commons","https://en.wikipedia.org/wiki/Adolf_Hitler",{"_32":234,"_82":156},[],{"_32":75,"_76":77},{"_30":72,"_73":74},"876","Franklin D. Roosevelt","The 32nd President of the United States, he led the country during the Great Depression and World War II.","His New Deal policies transformed the American economy and expanded the role of the federal government.",1882,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fd/FDR-1944-Campaign-Portrait_%283x4_retouched%2C_cropped%29.jpg/330px-FDR-1944-Campaign-Portrait_%283x4_retouched%2C_cropped%29.jpg","Image: Franklin D. Roosevelt / Wikimedia Commons","https://en.wikipedia.org/wiki/Franklin_D._Roosevelt",{"_32":81,"_82":83},[275],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":136,"_32":137},"2155","Joseph Stalin","A prominent political leader who played a crucial role in the Soviet Union's transformation into a major world power during the 20th century.","His death marked the end of an era characterized by significant political repression and the establishment of a totalitarian regime in the USSR.",1878,18,1953,3,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/Joseph_Stalin_in_1932_%284%29_%28cropped%29%282%29.jpg/330px-Joseph_Stalin_in_1932_%284%29_%28cropped%29%282%29.jpg","Image: Joseph Stalin / Wikimedia Commons","https://en.wikipedia.org/wiki/Joseph_Stalin",{"_32":201,"_82":156},[291],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":136,"_32":137},"316","Winston Churchill","A British statesman, he served as Prime Minister during World War II and is known for his leadership and oratory skills.","His legacy includes his role in shaping post-war Europe and the establishment of the United Nations.",1874,1965,24,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Sir_Winston_Churchill_-_19086236948.jpg/330px-Sir_Winston_Churchill_-_19086236948.jpg","Yousuf Karsh / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Winston_Churchill","images/374215acd21396f3cff01d40c501bbb0986be713.webp",{"_32":155,"_82":156},[307,308],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":79,"_32":80},{"_30":136,"_32":137},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,50]
