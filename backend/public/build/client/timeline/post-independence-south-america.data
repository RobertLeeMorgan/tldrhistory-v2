":199,"_40":200,"_42":201,"_44":202,"_45":203,"_47":162,"_48":204,"_49":93,"_51":92,"_53":205,"_55":206,"_57":207,"_59":-5,"_60":208,"_62":209,"_64":210,"_66":211,"_68":43,"_69":70},{"_30":176,"_32":177,"_34":120,"_36":178,"_38":179,"_40":180,"_42":181,"_44":124,"_45":182,"_47":145,"_48":183,"_49":50,"_51":93,"_53":184,"_55":185,"_57":186,"_59":187,"_60":188,"_62":189,"_64":190,"_66":191,"_68":43,"_69":70},{"_30":157,"_32":158,"_34":35,"_36":159,"_38":160,"_40":161,"_42":162,"_44":163,"_45":164,"_47":162,"_48":124,"_49":52,"_51":165,"_53":166,"_55":167,"_57":168,"_59":169,"_60":170,"_62":171,"_64":172,"_66":173,"_68":43,"_69":70},{"_30":139,"_32":140,"_34":88,"_36":141,"_38":142,"_40":143,"_42":144,"_44":145,"_45":146,"_47":43,"_48":43,"_49":92,"_51":147,"_53":148,"_55":149,"_57":150,"_59":-5,"_60":151,"_62":152,"_64":153,"_66":154,"_68":43,"_69":70},{"_30":118,"_32":119,"_34":120,"_36":121,"_38":122,"_40":123,"_42":124,"_44":125,"_45":126,"_47":124,"_48":127,"_49":93,"_51":92,"_53":128,"_55":129,"_57":130,"_59":-5,"_60":131,"_62":132,"_64":133,"_66":134,"_68":43,"_69":70},{"_30":101,"_32":102,"_34":35,"_36":103,"_38":104,"_40":105,"_42":43,"_44":43,"_45":106,"_47":43,"_48":43,"_49":107,"_51":52,"_53":108,"_55":109,"_57":110,"_59":111,"_60":112,"_62":113,"_64":114,"_66":115,"_68":43,"_69":70},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":41,"_42":43,"_44":43,"_45":91,"_47":43,"_48":43,"_49":92,"_51":93,"_53":-5,"_55":-5,"_57":94,"_59":-5,"_60":95,"_62":96,"_64":97,"_66":98,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","2004","name","Colombian Conflict","type","event","startDescription","An armed conflict in Colombia involving various guerrilla groups, paramilitary organizations, and the government, marked by violence and social issues.","endDescription","The peace agreement in 2016 aimed to end decades of violence and promote reconciliation.","startYear",1964,"startMonth",0,"startDay","endYear",2016,"endMonth","endDay","startSignificance",0.85,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Collage_conflicto_interno_armado_en_Colombia.jpg/330px-Collage_conflicto_interno_armado_en_Colombia.jpg","imageCredit","Image: Colombian conflict / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Colombian_conflict","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Post-Independence South America","icon","GiSouthAmerica",{"_30":81,"_32":82},{"_30":79,"_32":80},"2","politics","1","military","Colombia","continent","SouthAmerica","614","Brazilian Military Dictatorship","period","A period marked by military rule in Brazil, characterized by repression and censorship.","The dictatorship ended with a return to civilian rule and the restoration of democracy.",1985,0.8,0.9,"https://en.wikipedia.org/wiki/Brazilian_Military_Dictatorship",{"_32":100,"_84":85},[99],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},"Brazil","593","Bolivian National Revolution","A major political and social upheaval that aimed to address land reform and nationalization of resources.","The revolution resulted in significant changes to Bolivian society and governance, impacting future policies.",1952,1956,0.75,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Museum_of_National_Revolution_Bas_Relief.jpg/330px-Museum_of_National_Revolution_Bas_Relief.jpg","Carwil Bjork-James / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Bolivian_National_Revolution","images/7741b7b2315e9a34f7554fce42b5ca6d50325c4f.webp",{"_32":117,"_84":85},[116],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},"Bolivia","2005","Pablo Escobar","person","A notorious Colombian drug lord and leader of the Medellín Cartel, known for his immense wealth and influence over the drug trade.","His death marked a significant turning point in the war on drugs in Colombia.",1949,12,1,1993,2,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Pablo_Escobar_Mug.jpg/330px-Pablo_Escobar_Mug.jpg","Image: Pablo Escobar / Wikimedia Commons","https://en.wikipedia.org/wiki/Pablo_Escobar",{"_32":83,"_84":85},[135,136],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":137,"_32":138},"8","economic","1986","La Violencia","A decade-long period of intense political violence in Colombia, marked by civil conflict between the Liberal and Conservative parties.","The violence subsided with the establishment of a political agreement, leading to a temporary peace and the formation of a new political framework.",1948,4,9,1958,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Bogotazo.jpg/330px-Bogotazo.jpg","Image: La Violencia / Wikimedia Commons","https://en.wikipedia.org/wiki/La_Violencia",{"_32":83,"_84":85},[155,156],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"578","Chaco War","A conflict between Bolivia and Paraguay over control of the Chaco region, which was believed to be rich in oil.","The war concluded with a peace treaty, significantly impacting the territorial boundaries and national identities of both countries.",1932,6,15,1935,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/35/Mapa_de_la_Guerra_del_Chaco_es.svg/330px-Mapa_de_la_Guerra_del_Chaco_es.svg.png","Anibalcesar / vector / MacedonianBoy / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Chaco_War","images/415cedb7332e31c809e8541a5b566873ca23252c.webp",{"_32":175,"_84":85},[174],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"Paraguay","594","Pablo Neruda","A renowned Chilean poet and diplomat, celebrated for his passionate and politically charged poetry.","His legacy continues to influence literature and politics in Latin America and beyond.",1904,7,1973,23,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/86/Pablo_Neruda_1963.jpg/330px-Pablo_Neruda_1963.jpg","detail / news-photo / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Pablo_Neruda","images/0fd01999853104db39927c6bb763800f77219d44.webp",{"_32":195,"_84":85},[192],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":193,"_32":194},"9","art","Chile","902","Jorge Luis Borges","An Argentine writer and poet, he is regarded as one of the most important literary figures of the 20th century, known for his complex narratives and philosophical themes.","His works have had a profound impact on literature and continue to be widely read and studied.",1899,8,24,1986,14,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Jorge_Luis_Borges_1951%2C_by_Grete_Stern_%28full%29.jpg/330px-Jorge_Luis_Borges_1951%2C_by_Grete_Stern_%28full%29.jpg","Image: Jorge Luis Borges / Wikimedia Commons","https://en.wikipedia.org/wiki/Jorge_Luis_Borges",{"_32":213,"_84":85},[212],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":193,"_32":194},"Argentina","896","César Vallejo","A renowned Peruvian poet and writer, he is considered one of the most significant literary figures in Latin America, known for his innovative use of language and themes of human suffering.","His works continue to be studied and celebrated for their depth and emotional resonance.",1892,3,16,1938,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Cesar_vallejo_1929.jpg/330px-Cesar_vallejo_1929.jpg","Image: César Vallejo / Wikimedia Commons","https://en.wikipedia.org/wiki/C%C3%A9sar_Vallejo",{"_32":230,"_84":85},[229],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":193,"_32":194},"Peru","2002","Getúlio Vargas","A Brazilian politician who served as president, known for his populist policies and significant impact on Brazil's economic development.","His death marked the end of an era in Brazilian politics, leaving a complex legacy.",1882,19,1954,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/Getulio_Vargas_%281930%29.jpg/330px-Getulio_Vargas_%281930%29.jpg","Image: Getúlio Vargas / Wikimedia Commons","https://en.wikipedia.org/wiki/Get%C3%BAlio_Vargas",{"_32":100,"_84":85},[245,246],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":137,"_32":138},"588","War of the Pacific","A conflict involving Chile, Bolivia, and Peru over territory and resources in the Pacific coast region.","The war resulted in significant territorial changes and economic impacts for the involved nations.",1879,5,1884,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/35/Sinking_of_the_Esmeralda_during_the_battle_of_Iquique.jpg/330px-Sinking_of_the_Esmeralda_during_the_battle_of_Iquique.jpg","Thomas Somerscales / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/War_of_the_Pacific","images/2dc28e370cc3f08f515e35307dd3f0854de4f0e8.webp",{"_32":195,"_84":85},[262],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"1988","Rubber Boom","This period marked a significant surge in the extraction and export of rubber from the Amazon rainforest, driven by global demand.","The boom ended as synthetic rubber became prevalent and the exploitation of natural rubber resources declined.",1912,"","https://en.wikipedia.org/wiki/Rubber_Boom",{"_32":100,"_84":85},[274],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":137,"_32":138},"595","Paraguayan War","A devastating conflict involving Paraguay against Brazil, Argentina, and Uruguay, leading to massive casualties.","The war resulted in significant territorial losses for Paraguay and a profound impact on its population.",1864,1870,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/Escenas_de_la_Guerra_de_la_Triple_Alianza.png/330px-Escenas_de_la_Guerra_de_la_Triple_Alianza.png","Inkratt / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Paraguayan_War","images/5d15c4e58864c93a5543ecccad3247a86831b082.webp",{"_32":175,"_84":85},[289],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"1987","Federalist War","This conflict arose from political tensions between federalists and centralists in the early years of the republic, leading to a series of violent confrontations.","The war concluded with the federalist forces being defeated, which solidified centralist control over the region and shaped future governance.",1824,1830,"https://en.wikipedia.org/wiki/Federalist_War",{"_32":100,"_84":85},[301,302],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"1998","Juan Manuel de Rosas","An Argentine politician and military leader, known for his authoritarian rule and influence over Argentine politics in the 19th century.","His legacy is controversial, marked by both loyalty and opposition from various factions.",1793,30,1877,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Rosas_2.jpg/330px-Rosas_2.jpg","Image: Juan Manuel de Rosas / Wikimedia Commons","https://en.wikipedia.org/wiki/Juan_Manuel_de_Rosas",{"_32":213,"_84":85},[317],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,44]
