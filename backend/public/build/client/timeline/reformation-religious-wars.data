_40":201,"_42":202,"_44":203,"_45":204,"_46":43,"_47":43,"_48":51,"_50":116,"_52":205,"_54":206,"_56":207,"_58":-5,"_59":208,"_61":209,"_63":210,"_65":211,"_67":43,"_68":69},{"_30":180,"_32":181,"_34":35,"_36":182,"_38":183,"_40":184,"_42":43,"_44":43,"_45":185,"_46":43,"_47":43,"_48":132,"_50":116,"_52":186,"_54":187,"_56":188,"_58":189,"_59":190,"_61":191,"_63":192,"_65":193,"_67":43,"_68":69},{"_30":165,"_32":166,"_34":35,"_36":167,"_38":168,"_40":169,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":116,"_50":49,"_52":170,"_54":171,"_56":172,"_58":173,"_59":174,"_61":175,"_63":176,"_65":177,"_67":43,"_68":69},{"_30":145,"_32":146,"_34":147,"_36":148,"_38":149,"_40":150,"_42":43,"_44":43,"_45":151,"_46":43,"_47":43,"_48":51,"_50":116,"_52":152,"_54":153,"_56":154,"_58":-5,"_59":155,"_61":156,"_63":157,"_65":158,"_67":43,"_68":69},{"_30":127,"_32":128,"_34":35,"_36":129,"_38":130,"_40":131,"_42":43,"_44":43,"_45":131,"_46":43,"_47":43,"_48":132,"_50":132,"_52":133,"_54":134,"_56":135,"_58":136,"_59":137,"_61":138,"_63":139,"_65":140,"_67":43,"_68":69},{"_30":107,"_32":108,"_34":35,"_36":109,"_38":110,"_40":111,"_42":112,"_44":113,"_45":114,"_46":91,"_47":115,"_48":116,"_50":51,"_52":117,"_54":118,"_56":119,"_58":-5,"_59":120,"_61":121,"_63":122,"_65":123,"_67":43,"_68":69},{"_30":84,"_32":85,"_34":35,"_36":86,"_38":87,"_40":88,"_42":89,"_44":90,"_45":41,"_46":91,"_47":92,"_48":51,"_50":51,"_52":93,"_54":94,"_56":95,"_58":96,"_59":97,"_61":98,"_63":99,"_65":100,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","1636","name","The Peace of Westphalia","type","event","startDescription","A series of treaties that ended the Thirty Years' War in Europe, marking a significant turning point in the religious and political landscape.","endDescription","The treaties established a new political order based on the concept of state sovereignty and religious tolerance.","startYear",1648,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",1,"endSignificance",0.9,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/d/df/M%C3%BCnster%2C_Historisches_Rathaus_--_2014_--_6855.jpg/330px-M%C3%BCnster%2C_Historisches_Rathaus_--_2014_--_6855.jpg","imageCredit","Image: Peace of Westphalia / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Peace_of_Westphalia","cdnId","country",{"_32":81,"_82":83},"subjects",[76,77],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"7","username","Kushim","Reformation and Religious Wars","icon","GiHolyGrail",{"_30":79,"_32":80},{"_30":70,"_32":78},"religion","2","politics","Germany","continent","Europe","213","Thirty Years' War","A series of conflicts primarily fought in Central Europe, involving many of the major European powers.","The war concluded with the Peace of Westphalia, which reshaped the political map of Europe.",1618,5,23,10,24,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/17/Carl_Friedrich_Lessing_-_The_Siege_%28Defense_of_a_Church_Courtyard_During_the_Thirty_Years%E2%80%99_War%29_-_Google_Art_Project.jpg/330px-Carl_Friedrich_Lessing_-_The_Siege_%28Defense_of_a_Church_Courtyard_During_the_Thirty_Years%E2%80%99_War%29_-_Google_Art_Project.jpg","Karl Friedrich Lessing / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Thirty_Years%27_War","images/5736987cd24b93850b6c4b0cb221f079275c1dba.webp",{"_32":81,"_82":83},[103,104],{"_32":73,"_74":75},{"_30":101,"_71":102},"6","HistOracle",{"_30":105,"_32":106},{"_30":79,"_32":80},"1","military","2058","The Edict of Nantes","This decree granted substantial rights and freedoms to the Huguenots, marking a significant moment in the French Wars of Religion.","The edict was revoked, leading to renewed persecution of Protestants and significant emigration from France.",1598,4,13,1685,18,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/da/King_Henry_IV_of_France.jpg/330px-King_Henry_IV_of_France.jpg","Image: Edict of Nantes / Wikimedia Commons","https://en.wikipedia.org/wiki/Edict_of_Nantes",{"_32":126,"_82":83},[124,125],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"France","210","Spanish Armada","A failed naval invasion by Spain against England, marking a turning point in naval power.","The defeat of the Armada established England as a dominant maritime power.",1588,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Armadaroute.jpg/330px-Armadaroute.jpg","Robert Adams / Augustine Ryther / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Spanish_Armada","images/8bcaa765f825af5b9f8384936cd1b9ae660151ec.webp",{"_32":144,"_82":83},[141,142],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":105,"_32":106},{"_30":101,"_32":143},"maritime","United Kingdom","1010","The Elizabethan Era","period","A significant period in English history marked by the reign of Queen Elizabeth I, characterized by the flourishing of arts, exploration, and the establishment of the English Protestant Church.","The era concluded with the death of the queen, leading to the succession of James I and the beginning of the Stuart period.",1558,1603,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bf/Queen_Elizabeth_I_by_George_Gower.jpg/330px-Queen_Elizabeth_I_by_George_Gower.jpg","Image: Elizabethan era / Wikimedia Commons","https://en.wikipedia.org/wiki/Elizabethan_era",{"_32":144,"_82":83},[159,160],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":163,"_32":164},{"_30":161,"_32":162},"9","art","3","culture","638","The Book of Common Prayer","This liturgical text of the Church of England contains prayers, services, and rites, reflecting the religious practices and beliefs of Anglicanism.","Its influence on worship and English spirituality has been profound, shaping the religious landscape for centuries.",1549,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Book_of_Common_Prayer_1760.jpg/330px-Book_of_Common_Prayer_1760.jpg","Church of England / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Book_of_Common_Prayer","images/74f796ff51d8f84fd16fed4439f6bca1eb8c6e6e.webp",{"_32":144,"_82":83},[178,179],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":163,"_32":164},{"_30":70,"_32":78},"211","Council of Trent","An ecumenical council of the Catholic Church that addressed issues raised by the Reformation.","The council's decrees helped to reform the Church and solidify Catholic doctrine.",1545,1563,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Concilio_Trento_Museo_Buonconsiglio.jpg/330px-Concilio_Trento_Museo_Buonconsiglio.jpg","Laurom / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Council_of_Trent","images/391f54a050c92daa49a7c3bca837c95a79e22cc8.webp",{"_32":196,"_82":83},[194,195],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"Italy","2057","The Jesuit Order","Founded as a religious order, this group aimed to spread the Catholic faith through education and missionary work.","The order was suppressed, leading to a significant reduction in its influence and activities across Europe and beyond.",1540,8,15,1773,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1c/Ihs-logo.svg/330px-Ihs-logo.svg.png","Image: Jesuits / Wikimedia Commons","https://en.wikipedia.org/wiki/Society_of_Jesus",{"_32":216,"_82":216},[212,213],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":214,"_32":215},{"_30":70,"_32":78},"4","intellectual","Global","2047","The German Peasants' War","A major uprising across the Holy Roman Empire, driven by social and religious discontent among peasants seeking to improve their conditions.","The conflict concluded with a brutal suppression of the rebels, leading to significant loss of life and a reaffirmation of the existing social order.",1524,1525,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/82/Karte_bauernkrieg3.jpg/330px-Karte_bauernkrieg3.jpg","Image: German Peasants' War / Wikimedia Commons","https://en.wikipedia.org/wiki/German_Peasants%27_War",{"_32":81,"_82":83},[231,232],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"2059","Diet of Worms","This assembly was convened to address the teachings and writings of a prominent figure who challenged the Catholic Church's practices.","The assembly concluded with a decree that ultimately led to significant religious and political changes across Europe.",1521,17,26,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/79/%D0%9B%D1%8E%D1%82%D0%B5%D1%80_%D0%B2_%D0%92%D0%BE%D1%80%D0%BC%D1%81%D0%B5.jpg/330px-%D0%9B%D1%8E%D1%82%D0%B5%D1%80_%D0%B2_%D0%92%D0%BE%D1%80%D0%BC%D1%81%D0%B5.jpg","Image: Diet of Worms / Wikimedia Commons","https://en.wikipedia.org/wiki/Diet_of_Worms",{"_32":81,"_82":83},[247,248],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"2048","Ninety-Five Theses","A document that challenged the practices of the Catholic Church, particularly the sale of indulgences, sparking widespread theological debate.","The theses led to the Protestant Reformation, fundamentally altering the landscape of Christianity and European society.",1517,31,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Luther_95_Thesen.png/330px-Luther_95_Thesen.png","Image: Ninety-five Theses / Wikimedia Commons","https://en.wikipedia.org/wiki/Ninety-Five_Theses",{"_32":81,"_82":83},[262,263],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":214,"_32":215},{"_30":70,"_32":78},"209","Protestant Reformation","A religious movement that challenged the practices of the Catholic Church, leading to new denominations.","The Reformation reshaped Christianity and had lasting impacts on European politics and society.","https://en.wikipedia.org/wiki/Protestant_Reformation",{"_32":216,"_82":216},[273,274],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"2051","John Calvin","person","A prominent theologian and pastor during the Protestant Reformation, he played a key role in the development of Reformed theology and the establishment of the Geneva school.","His death marked the end of a significant era in Protestant thought, but his teachings continued to influence various branches of Christianity.",1509,7,1564,27,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/58/John_Calvin_Museum_Catharijneconvent_RMCC_s84_cropped.png/330px-John_Calvin_Museum_Catharijneconvent_RMCC_s84_cropped.png","Image: John Calvin / Wikimedia Commons","https://en.wikipedia.org/wiki/John_Calvin",{"_32":293,"_82":83},[291,292],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":214,"_32":215},{"_30":70,"_32":78},"Switzerland","910","Henry VIII","A prominent monarch known for his significant impact on the English church and state, he is often remembered for his six marriages and the English Reformation.","His reign concluded with his death, leaving a legacy that shaped the future of England and its religious landscape.",1491,6,28,1547,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/After_Hans_Holbein_the_Younger_-_Portrait_of_Henry_VIII_-_Google_Art_Project.jpg/330px-After_Hans_Holbein_the_Younger_-_Portrait_of_Henry_VIII_-_Google_Art_Project.jpg","Image: Henry VIII / Wikimedia Commons","https://en.wikipedia.org/wiki/Henry_VIII",{"_32":144,"_82":83},[309,310],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},"909","Tudor Period","This era in English history is marked by the reign of the Tudor dynasty, beginning with Henry VII and ending with Elizabeth I. It was a time of significant political and religious transformation, including the English Reformation.","The period concluded with the death of the last Tudor monarch, Elizabeth I, leading to the succession of the Stuart dynasty and significant changes in governance and society.",1485,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/Tudor_Rose.svg/320px-Tudor_Rose.svg.png","Image: Tudor period / Wikimedia Commons","https://en.wikipedia.org/wiki/Tudor_period",{"_32":144,"_82":83},[323,324],{"_32":73,"_74":75},{"_30":101,"_71":102},{"_30":79,"_32":80},{"_30":70,"_32":78},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,36]
