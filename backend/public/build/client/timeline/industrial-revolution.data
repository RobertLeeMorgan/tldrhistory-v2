44":72,"_46":178,"_47":72,"_49":72,"_51":52,"_53":179,"_55":180,"_57":181,"_59":182,"_61":-5,"_63":183,"_65":184,"_67":185,"_69":186,"_71":72,"_73":74},{"_30":161,"_32":162,"_34":35,"_36":163,"_38":164,"_40":165,"_42":72,"_44":72,"_46":72,"_47":72,"_49":72,"_51":109,"_53":72,"_55":166,"_57":167,"_59":168,"_61":-5,"_63":169,"_65":170,"_67":171,"_69":172,"_71":72,"_73":74},{"_30":149,"_32":150,"_34":35,"_36":151,"_38":152,"_40":137,"_42":72,"_44":72,"_46":72,"_47":72,"_49":72,"_51":93,"_53":109,"_55":153,"_57":154,"_59":155,"_61":-5,"_63":156,"_65":157,"_67":158,"_69":159,"_71":72,"_73":74},{"_30":133,"_32":134,"_34":35,"_36":135,"_38":136,"_40":137,"_42":72,"_44":72,"_46":72,"_47":72,"_49":72,"_51":93,"_53":72,"_55":138,"_57":139,"_59":140,"_61":-5,"_63":141,"_65":142,"_67":143,"_69":144,"_71":72,"_73":74},{"_30":118,"_32":119,"_34":35,"_36":120,"_38":121,"_40":122,"_42":72,"_44":72,"_46":72,"_47":72,"_49":72,"_51":109,"_53":72,"_55":123,"_57":124,"_59":125,"_61":-5,"_63":126,"_65":127,"_67":128,"_69":129,"_71":72,"_73":74},{"_30":104,"_32":105,"_34":35,"_36":106,"_38":107,"_40":108,"_42":72,"_44":72,"_46":92,"_47":72,"_49":72,"_51":93,"_53":109,"_55":94,"_57":94,"_59":110,"_61":-5,"_63":111,"_65":112,"_67":113,"_69":114,"_71":72,"_73":74},{"_30":87,"_32":88,"_34":35,"_36":89,"_38":90,"_40":91,"_42":72,"_44":72,"_46":92,"_47":72,"_49":72,"_51":93,"_53":45,"_55":94,"_57":-5,"_59":95,"_61":-5,"_63":96,"_65":97,"_67":98,"_69":99,"_71":72,"_73":74},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":41,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":74},"id","259","name","The Great Exhibition","type","event","startDescription","A world's fair held in London showcasing industrial achievements and culture.","endDescription","The exhibition concluded successfully, symbolizing the height of the British Empire's industrial power.","startYear",1851,"startMonth",5,"startDay",1,"endYear","endMonth",11,"endDay",15,"startSignificance",0.7,"endSignificance",0.6,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/a/a8/The_Crystal_Palace_in_Hyde_Park_for_Grand_International_Exhibition_of_1851.jpg/330px-The_Crystal_Palace_in_Hyde_Park_for_Grand_International_Exhibition_of_1851.jpg","imageCredit","Read &amp / Co. Engravers &amp / Printers / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/Great_Exhibition","cdnId","images/01b8def6604c3c1385b1a468b6f3a4c141536e51.webp","country",{"_32":84,"_85":86},"subjects",[81],"group",{"_32":78,"_79":80},"user",{"_30":75,"_76":77},"likes",0,"liked",false,"6","username","HistOracle","Industrial Revolution","icon","GiFactory",{"_30":82,"_32":83},"3","culture","United Kingdom","continent","Europe","1761","Steel Revolution","This period marked a significant transformation in steel production, driven by technological advancements and increased demand for steel in various industries.","The Steel Revolution concluded as steel became the backbone of modern infrastructure and manufacturing, leading to the rise of new industries.",1850,1900,0.8,"","https://en.wikipedia.org/wiki/Steel_Revolution",{"_32":103,"_85":103},[100],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":101,"_32":102},"8","economic","Global","1766","Improvement of Working Conditions","This period marked a growing awareness and advocacy for better working conditions, driven by labor movements and social reformers.","Improvements in working conditions were gradually implemented, leading to better labor laws and a focus on workers' rights.",1839,0.9,"https://en.wikipedia.org/wiki/Improvement_of_Working_Conditions",{"_32":103,"_85":103},[117],{"_32":78,"_79":80},{"_30":115,"_76":116},"7","Kushim",{"_30":101,"_32":102},"1161","Invention of the Dynamo","Michael Faraday developed the first electromagnetic generator, demonstrating that mechanical motion could produce electricity.","This invention laid the groundwork for modern electrical power generation, powering later innovations in industry and technology.",1831,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/14/DynamoElectricMachinesEndViewPartlySection_USP284110.png/330px-DynamoElectricMachinesEndViewPartlySection_USP284110.png","Image: Dynamo / Wikimedia Commons","https://en.wikipedia.org/wiki/Dynamo",{"_32":103,"_85":103},[130],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":131,"_32":132},"4","intellectual","1361","Niépce’s Heliographic Camera","This event marked the introduction of a new photographic process that allowed for the creation of permanent images using sunlight and bitumen of Judea.","The process eventually evolved into more advanced forms of photography, leading to significant developments in visual arts.",1826,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/eb/Nic%C3%A9phore_Ni%C3%A9pce_Oldest_Photograph_1825.jpg/330px-Nic%C3%A9phore_Ni%C3%A9pce_Oldest_Photograph_1825.jpg","Image: Heliography / Wikimedia Commons","https://en.wikipedia.org/wiki/Heliography",{"_32":148,"_85":86},[145],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":146,"_32":147},"9","art","France","1358","View from the Window at Le Gras","This event marks the creation of the first known permanent photograph, capturing a unique view from a window.","The event concluded with the establishment of photography as a significant medium in art and documentation.","https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Untitled_%28point_de_vue%29%2C_Ni%C3%A9pce_1827_%E2%80%94_HRC_2020_%28cropped%29.jpg/330px-Untitled_%28point_de_vue%29%2C_Ni%C3%A9pce_1827_%E2%80%94_HRC_2020_%28cropped%29.jpg","Image: View from the Window at Le Gras / Wikimedia Commons","https://en.wikipedia.org/wiki/View_from_the_Window_at_Le_Gras",{"_32":148,"_85":86},[160],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":146,"_32":147},"1156","Invention of the Steam Locomotive","The first successful steam-powered locomotive was developed by Richard Trevithick, marking the beginning of railway technology. This innovation allowed goods and passengers to be moved faster and more efficiently along rails.","It set the foundation for the railway revolution of the 19th century, which later transformed global transportation, industry, and trade.",1804,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Stockton_%26_Darlington_Railway_0-4-0_No._1_%27Locomotion%27_%281825%29_Head_of_Steam%2C_Darlington_30.06.2009_P6300119_%2810192855826%29.jpg/330px-Stockton_%26_Darlington_Railway_0-4-0_No._1_%27Locomotion%27_%281825%29_Head_of_Steam%2C_Darlington_30.06.2009_P6300119_%2810192855826%29.jpg","Image: Locomotion No. 1 / Wikimedia Commons","https://en.wikipedia.org/wiki/Locomotion_No_1",{"_32":84,"_85":86},[173],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":131,"_32":132},"1153","The First Electric Light","The first electric light was demonstrated, showcasing the potential of electricity for illumination.","This event marked a significant milestone in the development of electric lighting technology.",1802,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7b/Light-bulbs.jpg/330px-Light-bulbs.jpg","Image: Electric light / Wikimedia Commons","https://en.wikipedia.org/wiki/Electric_light",{"_32":84,"_85":86},[187],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":131,"_32":132},"1154","Voltaic Pile","Marking the creation of the Voltaic pile, the first continuous electrical power source. This achievement transformed electricity from a set of isolated natural phenomena into a field of experimental science.","This milestone initiated the rapid expansion of electrical science and technology, forming the foundation of the electrical age of the 19th and 20th centuries.",1800,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/London_MMB_%C2%BB1E6_Lightning.jpg/330px-London_MMB_%C2%BB1E6_Lightning.jpg","Image: Electricity / Wikimedia Commons","https://en.wikipedia.org/wiki/Electricity",{"_32":103,"_85":103},[200],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":131,"_32":132},"1472","Discovery of Vaccination","The introduction of vaccination marked a revolutionary advancement in public health, providing a method to prevent smallpox through inoculation with cowpox.","This discovery laid the foundation for modern immunology and the development of vaccines for various diseases.",1796,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/30/Young_girl_about_to_receive_a_vaccine_in_her_upper_arm_%2848545990252%29.jpg/330px-Young_girl_about_to_receive_a_vaccine_in_her_upper_arm_%2848545990252%29.jpg","Image: Vaccination / Wikimedia Commons","https://en.wikipedia.org/wiki/Vaccination",{"_32":84,"_85":86},[213],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":131,"_32":132},"629","The Wealth of Nations","This foundational text in classical economics outlines the principles of free market economies and the division of labor. It introduced key concepts that shaped modern economic thought.","Its influence persisted, laying the groundwork for future economic theories and policies, and it remains a critical reference in economic discourse.",1776,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Wealth_of_Nations.jpg/330px-Wealth_of_Nations.jpg","Gerhard Streminger / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Wealth_of_Nations","images/8724a3775ef7e8959a5baaea38f2e8f23c7b91d8.webp",{"_32":84,"_85":86},[227],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":131,"_32":132},"1765","Rise of the Factory System","This period saw the emergence of factories as the primary mode of production, revolutionizing labor and manufacturing processes.","The rise of factories transformed economies and societies, leading to urbanization and changes in labor dynamics.",1760,1840,"https://upload.wikimedia.org/wikipedia/commons/e/e3/Zilina_zapalkaren.jpg","Image: Factory Systems / Wikimedia Commons","https://en.wikipedia.org/wiki/Factory_system",{"_32":103,"_85":103},[241],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":101,"_32":102},"1763","Child Labor in the Industrial Revolution","During this period, child labor became prevalent in factories, often under harsh conditions, highlighting the darker side of industrial progress.","The issue of child labor eventually led to reforms and regulations aimed at improving conditions for working children.","https://en.wikipedia.org/wiki/Child_Labor_in_the_Industrial_Revolution",{"_32":103,"_85":103},[251],{"_32":78,"_79":80},{"_30":115,"_76":116},{"_30":101,"_32":102},"1155","period","A transformative period marked by the shift from agrarian economies to industrialized and urban ones, leading to significant technological advancements.","The period concluded as industrialization became established, paving the way for modern economic systems and societal changes.","https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/Powerloom_weaving_in_1835.jpg/330px-Powerloom_weaving_in_1835.jpg","Image: Industrial Revolution / Wikimedia Commons","https://en.wikipedia.org/wiki/Industrial_Revolution",{"_32":84,"_85":86},[263],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":82,"_32":83},"1762","Iron Production","The evolution of iron production techniques significantly impacted the industrial landscape, leading to enhanced efficiency and output.","Iron production methods evolved, paving the way for the mass production of iron goods and contributing to the Industrial Revolution.",1700,"https://en.wikipedia.org/wiki/Iron_Production",{"_32":103,"_85":103},[274],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":101,"_32":102},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,14]
