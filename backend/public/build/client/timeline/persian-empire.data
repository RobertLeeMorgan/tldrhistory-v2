40":184,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":185,"_53":186,"_55":187,"_56":188,"_58":-5,"_59":189,"_61":190,"_63":191,"_65":192,"_67":43,"_68":69},{"_30":164,"_32":165,"_34":35,"_36":166,"_38":167,"_40":168,"_42":43,"_44":43,"_45":168,"_47":43,"_48":43,"_49":105,"_51":105,"_53":169,"_55":170,"_56":171,"_58":-5,"_59":172,"_61":173,"_63":174,"_65":175,"_67":43,"_68":69},{"_30":148,"_32":149,"_34":100,"_36":150,"_38":151,"_40":152,"_42":43,"_44":43,"_45":103,"_47":43,"_48":43,"_49":105,"_51":50,"_53":153,"_55":154,"_56":155,"_58":-5,"_59":156,"_61":157,"_63":158,"_65":159,"_67":43,"_68":69},{"_30":135,"_32":136,"_34":35,"_36":137,"_38":138,"_40":139,"_42":43,"_44":43,"_45":139,"_47":43,"_48":43,"_49":50,"_51":105,"_53":140,"_55":141,"_56":142,"_58":-5,"_59":143,"_61":144,"_63":145,"_65":146,"_67":43,"_68":69},{"_30":119,"_32":120,"_34":121,"_36":122,"_38":123,"_40":124,"_42":43,"_44":43,"_45":125,"_47":43,"_48":43,"_49":105,"_51":105,"_53":126,"_55":127,"_56":128,"_58":-5,"_59":129,"_61":130,"_63":131,"_65":132,"_67":43,"_68":69},{"_30":98,"_32":99,"_34":100,"_36":101,"_38":102,"_40":103,"_42":43,"_44":43,"_45":104,"_47":43,"_48":43,"_49":105,"_51":50,"_53":106,"_55":107,"_56":108,"_58":109,"_59":110,"_61":111,"_63":112,"_65":113,"_67":43,"_68":69},{"_30":85,"_32":86,"_34":35,"_36":87,"_38":88,"_40":89,"_42":43,"_44":43,"_45":89,"_47":43,"_48":43,"_49":50,"_51":50,"_53":54,"_55":90,"_56":91,"_58":-5,"_59":92,"_61":93,"_63":94,"_65":95,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":-5,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","1931","name","Byzantine-Sasanian War","type","event","startDescription","A series of conflicts between two great empires that shaped the political landscape of the region.","endDescription","The war concluded with significant territorial changes and the weakening of both empires, paving the way for future conquests.","startYear",602,"startMonth",0,"startDay","endYear",628,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.7,"imageUrl","","imageCredit","sourceUrl","https://en.wikipedia.org/wiki/Byzantine–Sasanian_War","cdnId","country",{"_32":82,"_83":84},"subjects",[76,77],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Persian Empire","icon","GiWingedEmblem",{"_30":80,"_32":81},{"_30":78,"_32":79},"2","politics","1","military","Turkey","continent","MiddleEast","1930","Battle of Ctesiphon","This battle marked a significant confrontation between the Roman and Sasanian empires, showcasing military strategies and the struggle for dominance in the region.","The battle concluded with a Sasanian victory, further solidifying their power and influence over the territories contested.",337,"Image: Battle of Ctesiphon / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Ctesiphon",{"_32":97,"_83":84},[96],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"Iraq","65","Sassanid Empire","period","The Sassanid Empire was a major Iranian empire known for its cultural achievements and conflicts with the Roman Empire.","The empire fell to the Islamic conquests, leading to significant cultural and religious transformations in the region.",224,651,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cf/The_Sasanian_Empire_at_its_apex_under_Khosrow_II.svg/330px-The_Sasanian_Empire_at_its_apex_under_Khosrow_II.svg.png","edited by me / Wikimedia Commons / CC BY 4.0","https://en.wikipedia.org/wiki/Sasanian_Empire","images/7366a64ca557b44a8ccb023f41b218ecc8337f74.webp",{"_32":118,"_83":84},[114,115],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},{"_30":116,"_32":117},"3","culture","Iran","1927","Ardashir I","person","A significant ruler who founded the Sasanian Empire, establishing a new dynasty that would last for over four centuries.","His reign marked the beginning of a powerful empire that influenced culture, religion, and politics in the region.",180,242,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Dinar_of_Ardashir_I_%28cropped%29.jpg/330px-Dinar_of_Ardashir_I_%28cropped%29.jpg","Image: Ardashir I / Wikimedia Commons","https://en.wikipedia.org/wiki/Ardashir_I",{"_32":118,"_83":84},[133,134],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},{"_30":116,"_32":117},"1926","Battle of Carrhae","This battle marked a significant confrontation between Roman and Parthian forces, showcasing military tactics and the prowess of both armies.","The battle concluded with a decisive Parthian victory, leading to a shift in power dynamics in the region.",-53,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f1/Battle_of_Carrhae_%28Caesar%CB%90_A_History_Of_The_Art_Of_War_Among_The_Romans_Down_To_The_End%2C_vol._II%2C_1892%29.jpg/330px-Battle_of_Carrhae_%28Caesar%CB%90_A_History_Of_The_Art_Of_War_Among_The_Romans_Down_To_The_End%2C_vol._II%2C_1892%29.jpg","Image: Battle of Carrhae / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Carrhae",{"_32":82,"_83":84},[147],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"1929","Parthian Empire","A significant political entity that emerged in the 3rd century BCE, known for its unique blend of cultures and its role as a major power in the ancient world.","The empire eventually fell to the Sassanian dynasty, marking the end of its influence in the region.",-248,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Map_of_the_Parthian_Empire_under_Mithridates_II.svg/330px-Map_of_the_Parthian_Empire_under_Mithridates_II.svg.png","Image: Parthian Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Parthian_Empire",{"_32":118,"_83":84},[162,163],{"_32":73,"_74":75},{"_30":160,"_71":161},"7","Kushim",{"_30":78,"_32":79},{"_30":116,"_32":117},"1921","The Battle of Marathon","A pivotal battle during the Greco-Persian Wars where Persian forces faced a decisive defeat at the hands of the Athenians.","This defeat significantly impacted Persian ambitions in Greece and marked a turning point in the conflict.",-490,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/99/Scene_of_the_Battle_of_Marathon.jpg/330px-Scene_of_the_Battle_of_Marathon.jpg","Image: Battle of Marathon / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Marathon",{"_32":177,"_83":178},[176],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":80,"_32":81},"Greece","Europe","1925","The Royal Road","landmark","An ancient highway that facilitated communication and trade across the vast Persian Empire, linking key cities and regions.","The Royal Road fell into disuse after the decline of the empire, but its routes influenced later trade networks.",-500,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a3/Achaemenid_Empire_at_its_greatest_extent_according_to_Oxford_Atlas_of_World_History_2002.jpg/330px-Achaemenid_Empire_at_its_greatest_extent_according_to_Oxford_Atlas_of_World_History_2002.jpg","Image: Royal Road / Wikimedia Commons","https://en.wikipedia.org/wiki/Royal_Road",{"_32":118,"_83":84},[193,194],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":70,"_32":197},{"_30":195,"_32":196},"8","economic","maritime","1924","Persepolis","An ancient ceremonial capital of the Persian Empire, known for its grand architecture and rich cultural significance.","The site fell into ruin after the conquest of Alexander the Great, symbolizing the decline of Persian power.",-518,-331,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/39/Gate_of_All_Nations%2C_Persepolis.jpg/330px-Gate_of_All_Nations%2C_Persepolis.jpg","Image: Persepolis / Wikimedia Commons","https://en.wikipedia.org/wiki/Persepolis",{"_32":118,"_83":84},[212,213],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":116,"_32":117},{"_30":214,"_32":215},"9","art","1391","Xerxes I","A prominent king of the Persian Empire known for his massive invasion of Greece and the construction of monumental architecture.","His reign ended with his assassination, marking a significant transition in Persian leadership.",-519,-465,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/National_Museum_of_Iran_Darafsh_%28785%29.JPG/330px-National_Museum_of_Iran_Darafsh_%28785%29.JPG","Image: Xerxes I / Wikimedia Commons","https://en.wikipedia.org/wiki/Xerxes_I",{"_32":118,"_83":84},[229,230],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":78,"_32":79},"1923","Darius the Great","An influential ruler known for his administrative reforms and expansion of the Persian Empire to its greatest extent.","His reign concluded with significant developments in governance and infrastructure.",-550,-486,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/31/Darius_I.jpg/330px-Darius_I.jpg","Image: Darius the Great / Wikimedia Commons","https://en.wikipedia.org/wiki/Darius_the_Great",{"_32":118,"_83":84},[244,245],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":78,"_32":79},{"_30":195,"_32":196},"1920","The Achaemenid Empire","A significant historical period marked by the rise and expansion of one of the largest empires in ancient history.","The period ended with the conquest by Alexander the Great, leading to the fragmentation of the empire.",-330,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Achaemenid_Empire_500_BCE.jpg/330px-Achaemenid_Empire_500_BCE.jpg","Image: Achaemenid Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Achaemenid_Empire",{"_32":118,"_83":84},[258,259],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":78,"_32":79},{"_30":116,"_32":117},"1365","Persian Immortals","An elite group of soldiers known for their unwavering loyalty and strength, serving the Achaemenid Empire.","The decline of the Persian Immortals coincided with the fall of the Achaemenid Empire, marking the end of their military prominence.",0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Persian_warriors_from_Berlin_Museum.jpg/330px-Persian_warriors_from_Berlin_Museum.jpg","Image: Immortals (Achaemenid Empire) / Wikimedia Commons","https://en.wikipedia.org/wiki/Persian_Immortals",{"_32":118,"_83":84},[272],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"1922","Cyrus the Great","A prominent figure known for founding the Achaemenid Empire and establishing a vast territory through military conquests.","His death marked the end of an era of expansion and consolidation for the Persian Empire.",-600,-530,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Cyrus_II_%28The_Great%29_%28cropped%29.jpg/330px-Cyrus_II_%28The_Great%29_%28cropped%29.jpg","Image: Cyrus the Great / Wikimedia Commons","https://en.wikipedia.org/wiki/Cyrus_the_Great",{"_32":118,"_83":84},[286,287],{"_32":73,"_74":75},{"_30":160,"_71":161},{"_30":80,"_32":81},{"_30":78,"_32":79},"270","The Life of Zoroaster","An influential prophet and founder of Zoroastrianism, a major ancient religion that shaped Persian culture.","His teachings laid the foundation for religious thought in the region and beyond.",-628,-551,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Yazd%2C_Templo_del_Fuego_%282000%29_02_%28cropped%29.jpg/330px-Yazd%2C_Templo_del_Fuego_%282000%29_02_%28cropped%29.jpg","Unknown author / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Zoroaster","images/0fa03f26a69b644532585b340e3bf32afa58540d.webp",{"_32":118,"_83":84},[302,303],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":305,"_32":306},{"_30":160,"_32":304},"religion","4","intellectual",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,21]
