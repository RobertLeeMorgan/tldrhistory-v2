_42":43,"_44":43,"_45":196,"_47":43,"_48":43,"_49":50,"_51":90,"_53":197,"_55":198,"_57":199,"_59":-5,"_60":200,"_62":201,"_64":202,"_66":203,"_68":43,"_69":70},{"_30":174,"_32":175,"_34":35,"_36":176,"_38":177,"_40":178,"_42":43,"_44":43,"_45":179,"_47":43,"_48":43,"_49":180,"_51":181,"_53":182,"_55":183,"_57":184,"_59":-5,"_60":185,"_62":186,"_64":187,"_66":188,"_68":43,"_69":70},{"_30":157,"_32":158,"_34":140,"_36":159,"_38":160,"_40":161,"_42":43,"_44":43,"_45":162,"_47":43,"_48":43,"_49":90,"_51":163,"_53":164,"_55":165,"_57":166,"_59":-5,"_60":167,"_62":168,"_64":169,"_66":170,"_68":43,"_69":70},{"_30":138,"_32":139,"_34":140,"_36":141,"_38":142,"_40":143,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":144,"_51":43,"_53":145,"_55":146,"_57":147,"_59":-5,"_60":148,"_62":149,"_64":150,"_66":151,"_68":43,"_69":70},{"_30":124,"_32":125,"_34":107,"_36":126,"_38":127,"_40":128,"_42":43,"_44":43,"_45":129,"_47":43,"_48":43,"_49":90,"_51":91,"_53":130,"_55":131,"_57":132,"_59":-5,"_60":133,"_62":134,"_64":135,"_66":136,"_68":43,"_69":70},{"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_40":110,"_42":43,"_44":43,"_45":111,"_47":43,"_48":43,"_49":50,"_51":52,"_53":112,"_55":113,"_57":114,"_59":-5,"_60":115,"_62":116,"_64":117,"_66":118,"_68":43,"_69":70},{"_30":83,"_32":84,"_34":85,"_36":86,"_38":87,"_40":88,"_42":43,"_44":43,"_45":89,"_47":43,"_48":43,"_49":90,"_51":91,"_53":92,"_55":93,"_57":94,"_59":-5,"_60":95,"_62":96,"_64":97,"_66":98,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","2256","name","Buyid Dynasty","type","period","startDescription","The Buyids were a Persian dynasty that controlled much of modern-day Iran and Iraq, exercising significant influence over the Abbasid Caliphate.","endDescription","Their power declined with the rise of the Seljuk Turks and internal fragmentation.","startYear",934,"startMonth",0,"startDay","endYear",1062,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.6,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Buyid_dynasty_map.png/330px-Buyid_dynasty_map.png","imageCredit","Image: Buyid Dynasty / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Buyid_dynasty","cdnId","country",{"_32":80,"_81":82},"subjects",[77],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Islamic Golden Age","icon","GiSamaraMosque",{"_30":78,"_32":79},"3","culture","Iran","continent","MiddleEast","1779","The Caliphate of Cordoba","event","A period of political and cultural prominence in the Iberian Peninsula, known for its advancements in arts and sciences.","The caliphate eventually fragmented, leading to a decline in centralized power and cultural unity.",929,1031,0.9,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/65/Caliphate_of_C%C3%B3rdoba_under_Almanzor_-_1000_CE.png/330px-Caliphate_of_C%C3%B3rdoba_under_Almanzor_-_1000_CE.png","Image: Umayyad state of Córdoba / Wikimedia Commons","https://en.wikipedia.org/wiki/Caliphate_of_Cordoba",{"_32":103,"_81":104},[99,100],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":101,"_32":102},{"_30":78,"_32":79},"2","politics","Spain","Europe","1770","Al-Farabi","person","A prominent philosopher and scientist, known for his contributions to logic, political philosophy, and ethics.","His works influenced later scholars and established a foundation for future philosophical thought.",872,950,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/04/Alpharabius_in_Liber_Chronicarum_1493_AD.png/330px-Alpharabius_in_Liber_Chronicarum_1493_AD.png","Image: Al-Farabi / Wikimedia Commons","https://en.wikipedia.org/wiki/Al-Farabi",{"_32":122,"_81":123},[119],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":120,"_32":121},"4","intellectual","Kazakhstan","Asia","1771","Al-Razi","An influential physician and philosopher, known for his pioneering work in medicine and chemistry.","His medical texts remained influential in both the Islamic world and Europe for centuries.",865,925,"","Image: Razi / Wikimedia Commons","https://en.wikipedia.org/wiki/Al-Razi",{"_32":80,"_81":82},[137],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":120,"_32":121},"940","Great Mosque of Samarra","landmark","This mosque was one of the largest in the world during its time and is famous for its unique spiral minaret. It represents the architectural innovation of the Abbasid Caliphate and is a significant symbol of Islamic culture.","Though now in ruins, the mosque remains an important historical site and is recognized as a UNESCO World Heritage Site.",848,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/df/Samrraa_05.jpg/330px-Samrraa_05.jpg","Image: Great Mosque of Samarra / Wikimedia Commons","https://en.wikipedia.org/wiki/Great_Mosque_of_Samarra",{"_32":156,"_81":82},[152,153],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},{"_30":154,"_32":155},"7","religion","Iraq","1767","House of Wisdom","A major intellectual center during the Islamic Golden Age, known for its vast collection of knowledge and scholars.","The center was destroyed during the Mongol invasion, leading to a significant loss of knowledge and cultural heritage.",832,1258,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Maqamat_hariri.jpg/330px-Maqamat_hariri.jpg","Image: House of Wisdom / Wikimedia Commons","https://en.wikipedia.org/wiki/House_of_Wisdom",{"_32":156,"_81":82},[172,173],{"_32":74,"_75":76},{"_30":154,"_72":171},"Kushim",{"_30":78,"_32":79},{"_30":120,"_32":121},"2257","Samanid Empire","The Samanids were a Persian empire in Central Asia that promoted trade, culture, and the Persian language during their rule.","Their empire fragmented under external invasions, leading to regional dynasties in Central Asia.",819,999,0.75,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e1/Samanid_Empire_map.png/330px-Samanid_Empire_map.png","Image: Samanid Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Samanid_dynasty",{"_32":190,"_81":123},[189],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"Uzbekistan","1787","Development of Trigonometry","This period marked significant advancements in the field of mathematics, particularly in trigonometry, as scholars sought to develop more accurate methods for astronomical calculations.","By the end of this period, trigonometry had evolved into a more sophisticated discipline, influencing both Islamic and European mathematical traditions.",800,900,"https://upload.wikimedia.org/wikipedia/commons/2/23/Image-Al-Kit%C4%81b_al-mu%E1%B8%ABta%E1%B9%A3ar_f%C4%AB_%E1%B8%A5is%C4%81b_al-%C4%9Fabr_wa-l-muq%C4%81bala.jpg","Image: Mathematics in the medieval Islamic world / Wikimedia Commons","https://en.wikipedia.org/wiki/Islamic_mathematics",{"_32":156,"_81":82},[204],{"_32":74,"_75":76},{"_30":154,"_72":171},{"_30":120,"_32":121},"1786","Development of Algebra","This period marked significant advancements in the field of algebra, with the introduction of systematic methods for solving equations.","The developments laid the groundwork for modern algebra, influencing mathematics in subsequent centuries.",850,"Image: Algebra / Wikimedia Commons","https://en.wikipedia.org/wiki/Algebra",{"_32":156,"_81":82},[216],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":120,"_32":121},"1772","Al-Ma'mun","An influential caliph known for promoting science, literature, and philosophy during his reign.","His patronage led to the flourishing of intellectual and cultural life in the Islamic Golden Age.",786,833,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/71/Coin_of_the_Abbasid_Caliph_al-Ma%27mun.jpg/330px-Coin_of_the_Abbasid_Caliph_al-Ma%27mun.jpg","Image: Al-Ma'mun / Wikimedia Commons","https://en.wikipedia.org/wiki/Al-Ma%27mun",{"_32":156,"_81":82},[231,232],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":101,"_32":102},{"_30":120,"_32":121},"1774","Al-Khwarizmi","A mathematician and astronomer, often referred to as the father of algebra.","His works laid the foundations for modern mathematics and influenced European scholars.",780,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7d/Madrid_-_Ciudad_Universitaria%2C_Monumento_a_Muhammad_al-Juarismi_%28cropped%29.jpg/330px-Madrid_-_Ciudad_Universitaria%2C_Monumento_a_Muhammad_al-Juarismi_%28cropped%29.jpg","Image: Al-Khwarizmi / Wikimedia Commons","https://en.wikipedia.org/wiki/Al-Khwarizmi",{"_32":190,"_81":123},[245],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":120,"_32":121},"1780","A flourishing period of cultural, economic, and scientific advancements across the Islamic world, leading to significant contributions in various fields.","The era ended with the Mongol invasion, which disrupted the progress and stability of the region.",750,"Image: Islamic Golden Age / Wikimedia Commons","https://en.wikipedia.org/wiki/Islamic_Golden_Age",{"_32":258,"_81":258},[256,257],{"_32":74,"_75":76},{"_30":154,"_72":171},{"_30":78,"_32":79},{"_30":120,"_32":121},"Global","75","The Abbasid Caliphate","A golden age of Islamic culture, science, and philosophy, marked by the flourishing of trade and intellectual endeavors.","The caliphate's decline led to fragmentation and the rise of regional powers, impacting the Islamic world.","https://upload.wikimedia.org/wikipedia/commons/thumb/b/b0/Abbasid_banner.svg/330px-Abbasid_banner.svg.png","Ec.Domnowall / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Abbasid_Caliphate","images/95be66759e93014c434379034367e2bf12f8e5cd.webp",{"_32":156,"_81":82},[271],{"_32":74,"_75":76},{"_30":154,"_72":171},{"_30":120,"_32":121},"1782","Al-Andalus","A period marked by the establishment of a culturally rich and diverse society in the Iberian Peninsula, influenced by various traditions.","The era concluded with the fall of the last Muslim stronghold, ending centuries of coexistence.",711,1492,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Al-Andalus732.svg/330px-Al-Andalus732.svg.png","Image: Al-Andalus / Wikimedia Commons","https://en.wikipedia.org/wiki/Al-Andalus",{"_32":103,"_81":104},[285],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"2255","Umayyad Caliphate","The Umayyad Caliphate was the second of the four major caliphates, expanding Islamic rule from Spain to Central Asia and fostering administrative and cultural developments.","It was succeeded by the Abbasid Caliphate, shifting the political center to Baghdad.",661,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/Umayyad_Caliphate_map.png/330px-Umayyad_Caliphate_map.png","Image: Umayyad Caliphate / Wikimedia Commons","https://en.wikipedia.org/wiki/Umayyad_Caliphate",{"_32":299,"_81":82},[298],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"Saudi Arabia",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,8]
