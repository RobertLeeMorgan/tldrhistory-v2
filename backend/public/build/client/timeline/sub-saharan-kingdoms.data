its territories.","startYear",1529,"startMonth",0,"startDay","endYear",1543,"endMonth","endDay","startSignificance",0.6,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/9/9d/Deaths_of_Gragn_and_Da_Gama.jpg/330px-Deaths_of_Gragn_and_Da_Gama.jpg","imageCredit","Image: Ethiopian–Adal War / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Ethiopian%E2%80%93Adal_War","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Sub-Saharan Kingdoms","icon","GiCeremonialMask",{"_30":81,"_32":82},{"_30":79,"_32":80},"7","religion","1","military","Ethiopia","continent","Africa","2101","Afonso I of Kongo","person","The king of Kongo who converted to Christianity and sought to modernize his kingdom through European alliances.","His reign marked significant cultural and political changes, although it ultimately led to challenges from European powers.",1456,0.75,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/be/Manikongo.jpg/330px-Manikongo.jpg","Image: Afonso I of Kongo / Wikimedia Commons","https://en.wikipedia.org/wiki/Afonso_I_of_Kongo",{"_32":106,"_84":85},[100,101],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"3","culture","2","politics","Democratic Republic of the Congo","2094","Mutapa Empire","period","This empire emerged in the 15th century, known for its wealth from gold trade and its influence over the region's politics and culture.","The empire gradually declined due to internal strife and external pressures, leading to its eventual fragmentation.",1420,1760,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/1455808337AnewandaccuratemapofthesouthernpartsofAfricaREDUCED.jpg/330px-1455808337AnewandaccuratemapofthesouthernpartsofAfricaREDUCED.jpg","Image: Mutapa Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Mutapa_Empire",{"_32":126,"_84":85},[122,123],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":124,"_32":125},"8","economic","Zimbabwe","948","The Great Mosque of Djenné","landmark","This mosque is a stunning example of Sudano-Sahelian architecture and is considered one of the greatest achievements of the Mali Empire. It serves as a center of worship and community gathering.","The mosque remains a vital part of the cultural landscape, symbolizing the enduring legacy of Islamic architecture in West Africa.",1200,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/75/Djenne_great_mud_mosque.jpg/330px-Djenne_great_mud_mosque.jpg","Image: Great Mosque of Djenné / Wikimedia Commons","https://en.wikipedia.org/wiki/Great_Mosque_of_Djenné",{"_32":143,"_84":85},[141,142],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":79,"_32":80},"Mali","2262","Ethiopian Empire","Also known as Abyssinia, the Ethiopian Empire was a Christian kingdom in the Horn of Africa with a rich history of culture, trade, and military power.","It lasted until the 20th century before being reorganized under modern Ethiopia.",1137,1974,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/03/Ethiopian_Empire_map.png/330px-Ethiopian_Empire_map.png","Image: Ethiopian Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Ethiopian_Empire",{"_32":83,"_84":85},[158],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"479","Great Zimbabwe","This archaeological site was the center of a powerful kingdom known for its impressive stone structures and trade networks.","The site was eventually abandoned, likely due to economic changes and resource depletion, but remains a symbol of African heritage.",1100,1450,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Conical_Tower_-_Great_Enclosure_III_%2833736918448%29.jpg/330px-Conical_Tower_-_Great_Enclosure_III_%2833736918448%29.jpg","Andrew Moore  from Johannesburg / South Africa / Wikimedia Commons / CC BY-SA 2.0","https://en.wikipedia.org/wiki/Great_Zimbabwe","images/86c70ea94a6b7acb65f9701c0f82f8f99f0861ba.webp",{"_32":126,"_84":85},[173],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"2263","Swahili Coast City-States","A collection of trading city-states along the East African coast, flourishing from trade with Arabia, Persia, and India.","Their independence declined due to Portuguese conquest and later colonial powers.",1000,1600,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Swahili_coast_map.png/330px-Swahili_coast_map.png","Image: Swahili Coast / Wikimedia Commons","https://en.wikipedia.org/wiki/Swahili_people#Swahili_city-states",{"_32":188,"_84":85},[187],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"Kenya","2092","Swahili Coast Trade Expansion","The Swahili Coast experienced significant trade expansion, connecting Africa to the Middle East and Asia through maritime routes.","This period marked the peak of trade activities, leading to cultural exchanges and the rise of powerful city-states along the coast.",1500,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/74/Swahili_coast.png/330px-Swahili_coast.png","Image: Swahili coast / Wikimedia Commons","https://en.wikipedia.org/wiki/Swahili_coast",{"_32":205,"_84":85},[202,203],{"_32":74,"_75":76},{"_30":79,"_72":201},"Kushim",{"_30":71,"_32":204},{"_30":124,"_32":125},"maritime","Tanzania","2095","Kanem-Bornu Empire","This empire emerged as a powerful state in the region, known for its military prowess and trade networks across the Sahara.","The empire eventually declined due to internal strife and external pressures, leading to its dissolution in the late 19th century.",700,1893,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Kanem%E2%80%93Bornu%2C_13th_century.png/330px-Kanem%E2%80%93Bornu%2C_13th_century.png","Image: Kanem–Bornu Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Kanem-Bornu_Empire",{"_32":221,"_84":85},[219,220],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":104,"_32":105},"Chad","1382","Tuareg Desert Nomads","A cultural group known for their nomadic lifestyle in the Sahara Desert, characterized by unique traditions and social structures.","The traditional nomadic way of life has been challenged by modern influences and climate change, leading to significant cultural shifts.",300,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cb/Homme_toureg.jpg/330px-Homme_toureg.jpg","Image: Tuareg people / Wikimedia Commons","https://en.wikipedia.org/wiki/Tuareg",{"_32":143,"_84":85},[235,236],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":237,"_32":238},"5","environment","481","Kingdom of Aksum","This kingdom emerged as a major trading empire in the region, known for its monumental obelisks and as an early adopter of Christianity.","The kingdom eventually declined due to economic shifts and the rise of neighboring powers, leading to its eventual dissolution.",100,940,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/KingEndybisEthiopia227-235CE.jpg/330px-KingEndybisEthiopia227-235CE.jpg","PHGCOM / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Kingdom_of_Aksum","images/3f97da9c9008f3ec16993c92e64c16436180e5c0.webp",{"_32":83,"_84":85},[253,254],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"950","The Aksum Obelisks","These towering granite obelisks were erected in the ancient city of Aksum, serving as markers for royal graves. They showcase the engineering prowess and artistic skills of the Aksumite civilization.","The obelisks have become a symbol of Ethiopia's rich history and cultural heritage, attracting visitors and scholars alike.",-330,0.4,"","https://en.wikipedia.org/wiki/Aksum_Obelisks",{"_32":83,"_84":85},[267,268],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":269,"_32":270},"9","art","489","Bantu Migration","This migration involved the movement of Bantu-speaking peoples across Africa, significantly influencing the continent's demographics and cultures.","The migration led to the establishment of various societies and the spread of agriculture and ironworking technologies.",-1000,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/03/East_and_southern_africa_early_iron_age.png/330px-East_and_southern_africa_early_iron_age.png","East&amp / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Bantu_migrations","images/fd951c845bc80bc4fd0bc3593e4be429b705982c.webp",{"_32":285,"_84":285},[284],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"Global","995","Kingdom of Kush","This period marks the rise of a powerful kingdom in Nubia, known for its wealth, military prowess, and cultural achievements, influencing neighboring regions.","The kingdom eventually declined due to internal strife and external pressures, leading to its eventual dissolution and absorption into other empires.",-1070,-350,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Kushite_heartland_and_Kushite_Empire_of_the_25th_dynasty_circa_700_BCE.jpg/330px-Kushite_heartland_and_Kushite_Empire_of_the_25th_dynasty_circa_700_BCE.jpg","Image: Kingdom of Kush / Wikimedia Commons","https://en.wikipedia.org/wiki/Kingdom_of_Kush",{"_32":301,"_84":85},[299,300],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"Sudan","2261","Ancient Nubia","Ancient Nubia was a region along the Nile, known for its rich trade networks, powerful kingdoms, and cultural exchanges with Egypt.","It gradually declined due to Egyptian conquests and internal fragmentation, giving rise to successor Nubian states.",-3500,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Nubia_map.png/330px-Nubia_map.png","Image: Ancient Nubia / Wikimedia Commons","https://en.wikipedia.org/wiki/History_of_Nubia",{"_32":301,"_84":85},[314],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,17]
