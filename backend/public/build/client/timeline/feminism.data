,"_40":191,"_42":89,"_44":192,"_45":191,"_46":89,"_47":193,"_48":49,"_50":125,"_52":194,"_54":195,"_56":196,"_58":-5,"_59":197,"_61":198,"_63":199,"_65":200,"_67":43,"_68":69},{"_30":172,"_32":173,"_34":35,"_36":174,"_38":175,"_40":153,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":125,"_50":49,"_52":176,"_54":177,"_56":178,"_58":-5,"_59":179,"_61":180,"_63":181,"_65":182,"_67":43,"_68":69},{"_30":149,"_32":150,"_34":84,"_36":151,"_38":152,"_40":153,"_42":140,"_44":154,"_45":155,"_46":156,"_47":157,"_48":140,"_50":49,"_52":158,"_54":159,"_56":160,"_58":161,"_59":162,"_61":163,"_63":164,"_65":165,"_67":43,"_68":69},{"_30":135,"_32":136,"_34":35,"_36":137,"_38":138,"_40":139,"_42":43,"_44":43,"_45":41,"_46":43,"_47":43,"_48":125,"_50":140,"_52":141,"_54":142,"_56":143,"_58":-5,"_59":144,"_61":145,"_63":146,"_65":147,"_67":43,"_68":69},{"_30":119,"_32":120,"_34":35,"_36":121,"_38":122,"_40":123,"_42":43,"_44":43,"_45":124,"_46":43,"_47":43,"_48":125,"_50":126,"_52":127,"_54":128,"_56":129,"_58":-5,"_59":130,"_61":131,"_63":132,"_65":133,"_67":43,"_68":69},{"_30":104,"_32":105,"_34":35,"_36":106,"_38":107,"_40":108,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":93,"_50":51,"_52":109,"_54":110,"_56":111,"_58":-5,"_59":112,"_61":113,"_63":114,"_65":115,"_67":43,"_68":69},{"_30":82,"_32":83,"_34":84,"_36":85,"_38":86,"_40":87,"_42":88,"_44":89,"_45":90,"_46":89,"_47":91,"_48":92,"_50":93,"_52":94,"_54":95,"_56":96,"_58":-5,"_59":97,"_61":98,"_63":99,"_65":100,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","1742","name","The 19th Amendment","type","event","startDescription","An amendment to the United States Constitution granting women the right to vote.","endDescription","This amendment was a culmination of decades of struggle for women's suffrage in the U.S.","startYear",1920,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.9,"endSignificance",0.2,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/5/5b/Greater_coat_of_arms_of_the_United_States.svg/330px-Greater_coat_of_arms_of_the_United_States.svg.png","imageCredit","Image: Nineteenth Amendment to the United States Constitution / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Nineteenth_Amendment_to_the_United_States_Constitution","cdnId","country",{"_32":79,"_80":81},"subjects",[76],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Feminism","icon","GiFemale",{"_30":77,"_32":78},"2","politics","United States of America","continent","NorthAmerica","894","Eva Perón","person","An influential political figure and advocate for labor rights and women's suffrage in Argentina, she became a symbol of hope for the marginalized.","Her legacy continues to resonate in discussions about social justice and equality in Argentina and beyond.",1919,5,7,1952,26,0.75,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Evita_%28cropped%29.JPG/330px-Evita_%28cropped%29.JPG","Image: Eva Perón / Wikimedia Commons","https://en.wikipedia.org/wiki/Eva_Per%C3%B3n",{"_32":102,"_80":103},[101],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"Argentina","SouthAmerica","1744","Representation of the People Act","An act that expanded the electorate in the United Kingdom, allowing women over 30 to vote for the first time.","This act marked a significant step towards gender equality in voting rights.",1918,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Coat_of_arms_of_the_United_Kingdom_%281901%E2%80%931952%29.svg/330px-Coat_of_arms_of_the_United_Kingdom_%281901%E2%80%931952%29.svg.png","Image: Representation of the People Act 1918 / Wikimedia Commons","https://en.wikipedia.org/wiki/Representation_of_the_People_Act_1918",{"_32":117,"_80":118},[116],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"United Kingdom","Europe","1730","Women's Social and Political Union","A militant organization formed to advocate for women's suffrage in the UK, employing various tactics to draw attention to their cause.","The organization dissolved after achieving partial success in the fight for women's voting rights, marking a significant shift in political engagement for women.",1903,1917,0.8,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c4/Annie_Kenney_and_Christabel_Pankhurst.jpg/330px-Annie_Kenney_and_Christabel_Pankhurst.jpg","Image: Women's Social and Political Union / Wikimedia Commons","https://en.wikipedia.org/wiki/Women%27s_Social_and_Political_Union",{"_32":117,"_80":118},[134],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"1729","National American Woman Suffrage Association","This organization was formed to advocate for women's right to vote in the United States, uniting various suffrage groups under a common goal.","The association played a crucial role in the passage of the 19th Amendment, which granted women the right to vote.",1890,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/128front.jpg/330px-128front.jpg","Image: National American Woman Suffrage Association / Wikimedia Commons","https://en.wikipedia.org/wiki/National_American_Woman_Suffrage_Association",{"_32":79,"_80":81},[148],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"324","Virginia Woolf","An English writer, she is known for her modernist classics and contributions to feminist literature.","Her works continue to influence literature and feminist thought.",1882,25,1941,3,28,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/George_Charles_Beresford_-_Virginia_Woolf_in_1902_-_Restoration.jpg/330px-George_Charles_Beresford_-_Virginia_Woolf_in_1902_-_Restoration.jpg","George Charles Beresford / Adam Cuerden / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Virginia_Woolf","images/80cf449360d5dd9fe2bde1c829d9885e6b8a0fc6.webp",{"_32":117,"_80":118},[166,167],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":170,"_32":171},{"_30":168,"_32":169},"9","art","3","culture","1728","Married Women's Property Act 1882","This legislation marked a significant change in the legal rights of married women, allowing them to own and control property independently of their husbands.","The act established a legal framework that empowered women, contributing to the broader feminist movement and subsequent reforms in women's rights.","https://upload.wikimedia.org/wikipedia/commons/thumb/2/22/Coat_of_arms_of_the_United_Kingdom_%281837%29.svg/330px-Coat_of_arms_of_the_United_Kingdom_%281837%29.svg.png","Image: Married Women's Property Act 1882 / Wikimedia Commons","https://en.wikipedia.org/wiki/Married_Women%27s_Property_Act_1882",{"_32":117,"_80":118},[183,184],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":185,"_32":186},"8","economic","1626","Seneca Falls Convention","This gathering marked the first women's rights convention in the United States, focusing on social, civil, and religious rights for women.","The convention concluded with the adoption of the Declaration of Sentiments, which outlined the grievances and demands of women.",1848,19,20,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Woman%27s_Rights_Convention.jpg/330px-Woman%27s_Rights_Convention.jpg","Image: Seneca Falls Convention / Wikimedia Commons","https://en.wikipedia.org/wiki/Seneca_Falls_Convention",{"_32":79,"_80":81},[201],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"533","Women's Suffrage Movement","A social and political movement advocating for women's right to vote, which gained momentum in the late 19th and early 20th centuries.","The movement achieved a significant victory with the ratification of the 19th Amendment, granting women the right to vote in the United States.",8,18,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Suffragists_Parade_Down_Fifth_Avenue%2C_1917.JPG/330px-Suffragists_Parade_Down_Fifth_Avenue%2C_1917.JPG","via their online store / here / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Women%27s_suffrage_in_the_United_States","images/2621a36722c79ce771ee81d01a44a0ec18a25479.webp",{"_32":79,"_80":81},[216,217],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":170,"_32":171},"1745","Women’s Emancipation Proclamation","This proclamation called for the rights and freedoms of women, marking a significant moment in the women's rights movement.","It laid the groundwork for future advocacy and legal reforms aimed at achieving gender equality.",0.1,{"_32":79,"_80":81},[227],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},"877","Susan B. Anthony","A prominent social reformer and women's rights activist, she played a key role in the women's suffrage movement.","Her tireless advocacy laid the groundwork for future generations in the fight for gender equality.",1820,2,15,1906,13,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/SB_Anthony_from_RoRaWW.jpg/330px-SB_Anthony_from_RoRaWW.jpg","Image: Susan B. Anthony / Wikimedia Commons","https://en.wikipedia.org/wiki/Susan_B._Anthony",{"_32":79,"_80":81},[244,245],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":170,"_32":171},"1571","A Vindication of the Rights of Woman","This influential work argued for women's rights and education, challenging the societal norms of the 18th century.","The text remains a foundational work in feminist literature and continues to inspire discussions on gender equality.",1792,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f1/A_Vindication_of_the_Rights_of_Woman_title_page.jpg/330px-A_Vindication_of_the_Rights_of_Woman_title_page.jpg","Image: A Vindication of the Rights of Woman / Wikimedia Commons","https://en.wikipedia.org/wiki/A_Vindication_of_the_Rights_of_Woman",{"_32":117,"_80":118},[258],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":259,"_32":260},"4","intellectual","1739","The Women's March on Versailles","A significant protest where women marched from Paris to Versailles, demanding bread and political reform during a time of economic hardship.","The march concluded with the royal family returning to Paris, symbolizing the shift of power and the growing influence of the populace.",1789,10,6,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/A_Versailles%2C_%C3%A0_Versailles_5_octobre_1789_-_Restoration.jpg/330px-A_Versailles%2C_%C3%A0_Versailles_5_octobre_1789_-_Restoration.jpg","Image: Women's March on Versailles / Wikimedia Commons","https://en.wikipedia.org/wiki/Women%27s_March_on_Versailles",{"_32":277,"_80":118},[275,276],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":170,"_32":171},"France","1573","Mary Wollstonecraft","An influential advocate for women's rights and education, she is best known for her work, 'A Vindication of the Rights of Woman'.","Her legacy continues to inspire feminist thought and discussions on gender equality.",1759,4,27,1797,9,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Mary_Wollstonecraft_by_John_Opie_%28c._1797%29.jpg/330px-Mary_Wollstonecraft_by_John_Opie_%28c._1797%29.jpg","Image: Mary Wollstonecraft / Wikimedia Commons","https://en.wikipedia.org/wiki/Mary_Wollstonecraft",{"_32":117,"_80":118},[294,295],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":77,"_32":78},{"_30":259,"_32":260},"644","The Book of the City of Ladies","This work is a feminist allegory that defends women and their contributions to society, creating a symbolic city populated by virtuous women from history.","Its legacy has inspired discussions on gender and women's roles throughout history, marking it as an important work in feminist literature.",1405,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Meister_der_%27Cit%C3%A9_des_Dames%27_002.jpg/330px-Meister_der_%27Cit%C3%A9_des_Dames%27_002.jpg","Unknown author / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Book_of_the_City_of_Ladies","images/cbda4664d5d0276088130eb7a78d2a089b81de06.webp",{"_32":277,"_80":118},[309,310],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":170,"_32":171},{"_30":259,"_32":260},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,42]
