0":182,"_42":43,"_44":43,"_45":183,"_47":43,"_48":43,"_49":118,"_51":50,"_53":184,"_55":185,"_57":186,"_59":187,"_60":188,"_62":189,"_64":190,"_66":191,"_68":43,"_69":70},{"_30":158,"_32":159,"_34":160,"_36":161,"_38":162,"_40":163,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":118,"_53":164,"_55":165,"_57":166,"_59":167,"_60":168,"_62":169,"_64":170,"_66":171,"_68":43,"_69":70},{"_30":144,"_32":145,"_34":35,"_36":146,"_38":147,"_40":148,"_42":43,"_44":43,"_45":132,"_47":43,"_48":43,"_49":50,"_51":118,"_53":149,"_55":150,"_57":151,"_59":-5,"_60":152,"_62":153,"_64":154,"_66":155,"_68":43,"_69":70},{"_30":128,"_32":129,"_34":35,"_36":130,"_38":131,"_40":132,"_42":43,"_44":43,"_45":133,"_47":43,"_48":43,"_49":89,"_51":118,"_53":134,"_55":-5,"_57":135,"_59":-5,"_60":136,"_62":137,"_64":138,"_66":139,"_68":43,"_69":70},{"_30":112,"_32":113,"_34":35,"_36":114,"_38":115,"_40":116,"_42":43,"_44":43,"_45":117,"_47":43,"_48":43,"_49":118,"_51":52,"_53":119,"_55":120,"_57":121,"_59":-5,"_60":122,"_62":123,"_64":124,"_66":125,"_68":43,"_69":70},{"_30":98,"_32":99,"_34":35,"_36":100,"_38":101,"_40":102,"_42":43,"_44":43,"_45":103,"_47":43,"_48":43,"_49":52,"_51":89,"_53":104,"_55":105,"_57":106,"_59":-5,"_60":107,"_62":108,"_64":109,"_66":110,"_68":43,"_69":70},{"_30":83,"_32":84,"_34":35,"_36":85,"_38":86,"_40":87,"_42":43,"_44":43,"_45":88,"_47":43,"_48":43,"_49":52,"_51":89,"_53":90,"_55":91,"_57":92,"_59":-5,"_60":93,"_62":94,"_64":95,"_66":96,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","2243","name","Chola Empire","type","period","startDescription","The Chola Empire was a major Tamil dynasty in southern India, renowned for its naval power, administration, and temple architecture.","endDescription","It gradually declined in the 13th century CE due to invasions and regional fragmentation.","startYear",300,"startMonth",0,"startDay","endYear",1279,"endMonth","endDay","startSignificance",0.9,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Chola_Empire_map.png/330px-Chola_Empire_map.png","imageCredit","Image: Chola Empire / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Chola_dynasty","cdnId","country",{"_32":80,"_81":82},"subjects",[77],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Ancient India","icon","GiLotusFlower",{"_30":78,"_32":79},"3","culture","India","continent","Asia","2242","Pallava Kingdom","The Pallava Kingdom was a South Indian dynasty that contributed significantly to Dravidian architecture and the spread of Hinduism in Southeast Asia.","It declined in the 9th century CE after conflicts with the Chola dynasty and other regional powers.",275,897,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Pallava_territory.png/330px-Pallava_territory.png","Image: Pallava Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Pallava",{"_32":80,"_81":82},[97],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"2240","Satavahana Empire","The Satavahana Empire was an Indian dynasty that ruled large parts of central and southern India, acting as a bridge between northern and southern Indian cultures.","It declined in the 3rd century CE, fragmented into smaller regional powers, paving the way for later dynasties like the Gupta Empire.",230,220,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Satavahana_Empire_map.png/330px-Satavahana_Empire_map.png","Image: Satavahana Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Satavahana",{"_32":80,"_81":82},[111],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"2241","Kushan Empire","The Kushan Empire was a syncretic empire in Central and South Asia, known for facilitating trade along the Silk Road and supporting the spread of Buddhism.","It declined in the 3rd century CE due to invasions and internal fragmentation.",30,375,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3b/Kushan_Empire_map.png/330px-Kushan_Empire_map.png","Image: Kushan Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Kushan_Empire",{"_32":127,"_81":82},[126],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"Afghanistan","1613","Post-Mauryan Period","This period followed the decline of the Maurya Empire, marked by regional kingdoms and the emergence of new powers in the Indian subcontinent.","The period concluded with the rise of the Gupta Empire, which heralded a new era of cultural and intellectual achievements.",-185,320,"","https://en.wikipedia.org/wiki/Post-Mauryan_period",{"_32":80,"_81":82},[140,141],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":142,"_32":143},{"_30":78,"_32":79},"2","politics","1523","Maurya Empire","A significant ancient Indian empire known for its vast territory and centralized administration, which marked a major period in Indian history.","The empire eventually declined due to internal strife and external invasions, leading to the fragmentation of its territories.",-322,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2f/Maurya_Empire%2C_c.250_BCE_network_model_v01.png/330px-Maurya_Empire%2C_c.250_BCE_network_model_v01.png","Image: Maurya Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Maurya_Empire",{"_32":80,"_81":82},[156,157],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":142,"_32":143},{"_30":78,"_32":79},"682","The Bhagavad Gita","event","This 700-verse Hindu scripture is part of the Indian epic Mahabharata, addressing the moral and philosophical dilemmas of life.","Its teachings continue to inspire spiritual and philosophical discourse across cultures.",-400,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a5/BhagavadGita-19th-century-Illustrated-Sanskrit-Chapter_1.20.21.jpg/330px-BhagavadGita-19th-century-Illustrated-Sanskrit-Chapter_1.20.21.jpg","britishlibrary / media / global / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Bhagavad_Gita","images/30dfb9537267c4370f6ed4d8431ab433751b35b6.webp",{"_32":80,"_81":82},[172,173],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":176,"_32":177},{"_30":174,"_32":175},"7","religion","4","intellectual","186","The Spread of Buddhism","This period marks the emergence and dissemination of Buddhism across the Indian subcontinent and beyond.","The religion established a significant following, influencing cultures and societies throughout Asia.",-500,-300,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Kamakura_Budda_Daibutsu_front_1885.jpg/330px-Kamakura_Budda_Daibutsu_front_1885.jpg","Dirk Beyer / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Buddhism","images/7a71011124b96e86a1eba1685918c0d72958eef6.webp",{"_32":80,"_81":82},[192,193],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},{"_30":174,"_32":175},"276","The Life of Siddhartha Gautama","person","The founder of Buddhism, his teachings emphasized the path to enlightenment and the cessation of suffering.","His death marked the beginning of a religious movement that would spread throughout Asia.",-563,-483,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/ff/Buddha_in_Sarnath_Museum_%28Dhammajak_Mutra%29.jpg/330px-Buddha_in_Sarnath_Museum_%28Dhammajak_Mutra%29.jpg","Tevaprapas Makklay / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Siddhartha_Gautama","images/72d38a316a5ed393d4241e42387ebf10f55decc2.webp",{"_32":80,"_81":82},[209],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":174,"_32":175},"2244","Pandya Kingdom","The Pandya Kingdom was an ancient Tamil dynasty in southern India, influential in trade, culture, and religion across the Tamil region.","It was eventually incorporated into larger empires, including the Chola and Vijayanagara empires.",-600,1345,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/54/Pandya_Empire_map.png/330px-Pandya_Empire_map.png","Image: Pandya Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Pandya_dynasty",{"_32":80,"_81":82},[224],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"1522","Mahajanapadas","This period marks the emergence of sixteen powerful states in ancient India, known for their political and economic advancements.","The period concluded as these states evolved into larger empires, significantly shaping the region's history.","https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/Mahajanapadas_%28c._500_BCE%29.png/330px-Mahajanapadas_%28c._500_BCE%29.png","Image: Mahajanapadas / Wikimedia Commons","https://en.wikipedia.org/wiki/Mahajanapadas",{"_32":80,"_81":82},[236,237],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":142,"_32":143},{"_30":238,"_32":239},"8","economic","2239","Magadha Kingdom","Magadha was an ancient kingdom in India, known for its role in the development of Jainism and Buddhism and for becoming a dominant political power in the Ganges plain.","It formed the core of several large empires, including the Maurya and Gupta Empires.",-684,-320,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1b/Magadha_Kingdom_map.png/330px-Magadha_Kingdom_map.png","Image: Magadha / Wikimedia Commons","https://en.wikipedia.org/wiki/Magadha",{"_32":80,"_81":82},[253],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"157","Vedic Period","This era is characterized by the composition of the Vedas, which are the oldest sacred texts of Hinduism, influencing Indian culture and society.","The period transitioned into the rise of various kingdoms and the development of new philosophies.",-1500,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Early_Vedic_Culture_%281700-1100_BCE%29.png/330px-Early_Vedic_Culture_%281700-1100_BCE%29.png","Avantiputra7 / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Vedic_period","images/8f4a9caba0b0825d59f3ba387f44223a70ce9ae2.webp",{"_32":80,"_81":82},[267,268],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},{"_30":174,"_32":175},"228","Harrapan Culture","This culture is characterized by its urban centers, advanced drainage systems, and standardized weights and measures.","The decline of this culture is attributed to various factors including climate change and shifts in trade routes.",-2600,-1900,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c9/Indus_Valley_Civilization%2C_Mature_Phase_%282600-1900_BCE%29.png/330px-Indus_Valley_Civilization%2C_Mature_Phase_%282600-1900_BCE%29.png","https://en.wikipedia.org/wiki/Harappan_culture","images/e345dd5f860672de31e19279fbab7767255513ad.webp",{"_32":284,"_81":82},[283],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"Pakistan","33","Indus Valley Civilization","This civilization was characterized by advanced urban planning, architecture, and social organization, flourishing along the Indus River.","The civilization declined due to various factors, including climate change and invasions, leading to the emergence of new cultures in the region.",-3300,-1300,0.85,"Avantiputra7 / Wikimedia Commons","https://en.wikipedia.org/wiki/Indus_Valley_Civilization",{"_32":284,"_81":82},[299],{"_32":74,"_75":76},{"_30":174,"_72":298},"Kushim",{"_30":78,"_32":79},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,20]
