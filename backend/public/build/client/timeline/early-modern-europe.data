:205,"_42":45,"_44":45,"_46":45,"_48":45,"_49":45,"_50":53,"_52":45,"_54":206,"_56":207,"_58":208,"_60":-5,"_62":209,"_64":210,"_66":211,"_68":212,"_70":45,"_71":72},{"_30":185,"_32":186,"_34":35,"_36":187,"_38":188,"_40":189,"_42":45,"_44":45,"_46":190,"_48":45,"_49":45,"_50":51,"_52":51,"_54":191,"_56":192,"_58":193,"_60":194,"_62":195,"_64":196,"_66":197,"_68":198,"_70":45,"_71":72},{"_30":162,"_32":163,"_34":122,"_36":164,"_38":165,"_40":166,"_42":167,"_44":168,"_46":169,"_48":170,"_49":171,"_50":167,"_52":167,"_54":172,"_56":173,"_58":174,"_60":175,"_62":176,"_64":177,"_66":178,"_68":179,"_70":45,"_71":72},{"_30":140,"_32":141,"_34":35,"_36":142,"_38":143,"_40":144,"_42":45,"_44":45,"_46":145,"_48":45,"_49":45,"_50":146,"_52":147,"_54":148,"_56":149,"_58":150,"_60":151,"_62":152,"_64":153,"_66":154,"_68":155,"_70":45,"_71":72},{"_30":120,"_32":121,"_34":122,"_36":123,"_38":124,"_40":125,"_42":126,"_44":43,"_46":127,"_48":128,"_49":129,"_50":53,"_52":53,"_54":130,"_56":131,"_58":132,"_60":-5,"_62":133,"_64":134,"_66":135,"_68":136,"_70":45,"_71":72},{"_30":103,"_32":104,"_34":35,"_36":105,"_38":106,"_40":107,"_42":45,"_44":45,"_46":108,"_48":45,"_49":45,"_50":51,"_52":51,"_54":109,"_56":110,"_58":111,"_60":112,"_62":113,"_64":114,"_66":115,"_68":116,"_70":45,"_71":72},{"_30":88,"_32":89,"_34":35,"_36":90,"_38":91,"_40":41,"_42":45,"_44":45,"_46":45,"_48":45,"_49":45,"_50":51,"_52":53,"_54":92,"_56":93,"_58":94,"_60":-5,"_62":95,"_64":96,"_66":97,"_68":98,"_70":45,"_71":72},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":45,"_49":45,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":45,"_71":72},"id","231","name","The Great Northern War","type","event","startDescription","A conflict that involved several Northern European powers, primarily Russia, Sweden, and Poland, aiming to establish dominance in the Baltic Sea region.","endDescription","The war concluded with the Treaty of Nystad, significantly altering the balance of power in Northern Europe.","startYear",1700,"startMonth",9,"startDay",0,"endYear",1721,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.9,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/4/49/Great_Northern_War_Collage.jpg/330px-Great_Northern_War_Collage.jpg","imageCredit","Imonoz / Wikimedia Commons / CC BY-SA 4.0","sourceUrl","https://en.wikipedia.org/wiki/Great_Northern_War","cdnId","images/d3c849d6ecc11bfcb46b3f395783053c1bd8d59f.webp","country",{"_32":85,"_86":87},"subjects",[79,80],"group",{"_32":76,"_77":78},"user",{"_30":73,"_74":75},"likes","liked",false,"6","username","HistOracle","Early Modern Europe","icon","GiQuillInk",{"_30":83,"_32":84},{"_30":81,"_32":82},"2","politics","1","military","Sweden","continent","Europe","1076","Invention of the Piano","The piano was invented as a new musical instrument that allowed for dynamic expression and versatility in performance.","The piano evolved over the centuries, becoming a staple in both classical and contemporary music.","https://upload.wikimedia.org/wikipedia/commons/thumb/0/01/Steinway_Vienna_002.JPG/330px-Steinway_Vienna_002.JPG","Image: Piano / Wikimedia Commons","https://en.wikipedia.org/wiki/Piano",{"_32":102,"_86":87},[99],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":100,"_32":101},"9","art","Italy","216","The Glorious Revolution","A bloodless coup that resulted in the overthrow of King James II of England.","The revolution established William and Mary as co-sovereigns, leading to constitutional changes.",1688,1689,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e9/William_of_Orange_III_and_his_Dutch_army_land_in_Brixham%2C_1688.jpg/330px-William_of_Orange_III_and_his_Dutch_army_land_in_Brixham%2C_1688.jpg","Johan Herman Isings / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Glorious_Revolution","images/5a0337b1f2c2171ae8a82e13e92cc571634b8174.webp",{"_32":119,"_86":87},[117,118],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":83,"_32":84},{"_30":81,"_32":82},"United Kingdom","1309","Peter the Great","person","A transformative ruler known for modernizing his country and expanding its territory, he played a crucial role in establishing Russia as a major European power.","His death marked the end of an era of significant reform and expansion, leaving a legacy that shaped the future of Russia.",1672,6,1725,2,8,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Inconnu_d%27apr%C3%A8s_J.-M._Nattier%2C_Portrait_de_Pierre_Ier_%28mus%C3%A9e_de_l%E2%80%99Ermitage%29.jpg/330px-Inconnu_d%27apr%C3%A8s_J.-M._Nattier%2C_Portrait_de_Pierre_Ier_%28mus%C3%A9e_de_l%E2%80%99Ermitage%29.jpg","Image: Peter the Great / Wikimedia Commons","https://en.wikipedia.org/wiki/Peter_the_Great",{"_32":139,"_86":87},[137,138],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":83,"_32":84},{"_30":81,"_32":82},"Russia","215","The Great Plague of London","A devastating epidemic that swept through London, causing widespread death and panic.","The outbreak ended with the onset of the Great Fire of London, which destroyed many infected areas.",1665,1666,0.7,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1e/Great_plague_of_london-1665.jpg/330px-Great_plague_of_london-1665.jpg","unknwn / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Great_Plague_of_London","images/e46c71f34fc1493d28e20f455a1c0bbf32c3fe24.webp",{"_32":119,"_86":87},[156,157],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":160,"_32":161},{"_30":158,"_32":159},"5","environment","3","culture","309","Isaac Newton","An English mathematician, physicist, astronomer, and author, he is widely recognized as one of the most influential scientists of all time.","His work laid the groundwork for classical mechanics and significantly advanced the scientific revolution.",1643,1,4,1727,3,31,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f7/Portrait_of_Sir_Isaac_Newton%2C_1689_%28brightened%29.jpg/330px-Portrait_of_Sir_Isaac_Newton%2C_1689_%28brightened%29.jpg","Godfrey Kneller / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Isaac_Newton","images/37076dafcd140b60c98b083f1bda03a01f322a3d.webp",{"_32":119,"_86":87},[182],{"_32":76,"_77":78},{"_30":180,"_74":181},"7","Kushim",{"_30":183,"_32":184},"4","intellectual","214","The English Civil War","A series of armed conflicts and political machinations between Parliamentarians and Royalists.","The war ended with the establishment of the Commonwealth of England under Oliver Cromwell.",1642,1651,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/12/Battle_of_Naseby.jpg/330px-Battle_of_Naseby.jpg","Encyclopædia Britannica online / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/English_Civil_War","images/7a346150c26367a23f0cebbf7690f60936a9b7dc.webp",{"_32":119,"_86":87},[199,200],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":83,"_32":84},{"_30":81,"_32":82},"1469","Discovery of Blood Circulation","William Harvey demonstrated that blood circulates continuously through the heart and vessels, overturning centuries of Galenic theory.","This discovery laid the groundwork for modern medicine and changed the approach to human anatomy and health.",1628,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/29/Circulatory_System_en.svg/330px-Circulatory_System_en.svg.png","Image: Circulatory system / Wikimedia Commons","https://en.wikipedia.org/wiki/Blood_circulation",{"_32":119,"_86":87},[213],{"_32":76,"_77":78},{"_30":180,"_74":181},{"_30":183,"_32":184},"639","The Anatomy of Melancholy","This work is a comprehensive study of melancholy, exploring its causes and effects, and blending philosophy, psychology, and literature.","Its exploration of human emotion and mental health has continued to resonate, influencing literature and psychology.",1621,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Robert_Burton%27s_Anatomy_of_Melancholy%2C_1626%2C_2nd_edition.jpg/330px-Robert_Burton%27s_Anatomy_of_Melancholy%2C_1626%2C_2nd_edition.jpg","Robert Burton / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Anatomy_of_Melancholy","images/6ca1de7693802c912fa52f511666c3839af8fcf9.webp",{"_32":119,"_86":87},[227,228],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":160,"_32":161},{"_30":183,"_32":184},"1468","Invention of the Telescope","The invention marked a significant advancement in optical technology, allowing for distant objects to be magnified and observed with clarity.","The invention laid the groundwork for future astronomical discoveries and advancements in various scientific fields.",1608,0.1,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/ac/100inchHooker.jpg/330px-100inchHooker.jpg","Image: Telescope / Wikimedia Commons","https://en.wikipedia.org/wiki/Telescope",{"_32":243,"_86":87},[242],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":183,"_32":184},"Netherlands","859","Don Quixote","This novel follows the adventures of a man who becomes a self-styled knight, exploring themes of reality versus illusion and the nature of heroism.","It is regarded as one of the first modern novels and has had a profound influence on literature.",1605,1615,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/ba/Title_page_first_edition_Don_Quijote.jpg/330px-Title_page_first_edition_Don_Quijote.jpg","Juan de la Cuesta / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Don_Quixote","images/0d02e2ed756bca6cf26cfe9379559fc2b3382491.webp",{"_32":260,"_86":87},[258,259],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":160,"_32":161},{"_30":183,"_32":184},"Spain","1073","The Evolution of Opera","Opera emerged as a new art form, combining music, theater, and visual arts to create a unique experience.","This evolution in performance art significantly impacted the cultural landscape of Europe.",1600,0.85,0.3,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Macbeth_applause_at_Savonlinna_Opera_festival_in_2007_-_panoramio.jpg/330px-Macbeth_applause_at_Savonlinna_Opera_festival_in_2007_-_panoramio.jpg","Image: Opera / Wikimedia Commons","https://en.wikipedia.org/wiki/Opera",{"_32":276,"_86":276},[275],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":160,"_32":161},"Global","1553","René Descartes","A prominent philosopher and mathematician known for his contributions to modern philosophy and the development of Cartesian coordinates.","His death marked the end of an influential career that shaped the foundations of modern Western thought.",1596,1650,11,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Frans_Hals_-_Portret_van_Ren%C3%A9_Descartes.jpg/330px-Frans_Hals_-_Portret_van_Ren%C3%A9_Descartes.jpg","Image: René Descartes / Wikimedia Commons","https://en.wikipedia.org/wiki/Ren%C3%A9_Descartes",{"_32":292,"_86":87},[291],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":183,"_32":184},"France","1159","Invention of the Toilet","The invention of the modern flush toilet is credited to Sir John Harington, who designed and built the first one for Queen Elizabeth I in 1596. His \"Ajax\" device used a cistern and a valve to flush waste through a downpipe.","The design did not become popular until the 18th century when Alexander Cummings added a crucial innovation: an S-shaped pipe to block sewer gases.","","https://en.wikipedia.org/wiki/Ajax_toilet",{"_32":119,"_86":87},[303],{"_32":76,"_77":78},{"_30":180,"_74":181},{"_30":183,"_32":184},"1554","Galileo Galilei","A pioneering figure in the scientific revolution, he made significant contributions to physics, astronomy, and the scientific method.","His legacy endures as a foundational figure in modern science, despite facing opposition from the church.",1564,15,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fc/Galileo_Galilei_%281564-1642%29_RMG_BHC2700.tiff/lossy-page1-320px-Galileo_Galilei_%281564-1642%29_RMG_BHC2700.tiff.jpg","Image: Galileo Galilei / Wikimedia Commons","https://en.wikipedia.org/wiki/Galileo_Galilei",{"_32":102,"_86":87},[317],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":183,"_32":184},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,35]
