_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":92,"_51":93,"_52":194,"_54":195,"_56":196,"_58":-5,"_59":197,"_61":198,"_63":199,"_65":200,"_67":43,"_68":69},{"_30":175,"_32":176,"_34":87,"_36":177,"_38":178,"_40":164,"_42":43,"_44":43,"_45":179,"_47":43,"_48":43,"_49":50,"_51":92,"_52":180,"_54":181,"_56":182,"_58":-5,"_59":183,"_61":184,"_63":185,"_65":186,"_67":43,"_68":69},{"_30":160,"_32":161,"_34":35,"_36":162,"_38":163,"_40":164,"_42":43,"_44":43,"_45":165,"_47":43,"_48":43,"_49":114,"_51":114,"_52":166,"_54":167,"_56":168,"_58":-5,"_59":169,"_61":170,"_63":171,"_65":172,"_67":43,"_68":69},{"_30":143,"_32":144,"_34":107,"_36":145,"_38":146,"_40":147,"_42":113,"_44":148,"_45":149,"_47":113,"_48":150,"_49":114,"_51":50,"_52":151,"_54":152,"_56":153,"_58":-5,"_59":154,"_61":155,"_63":156,"_65":157,"_67":43,"_68":69},{"_30":124,"_32":125,"_34":107,"_36":126,"_38":127,"_40":128,"_42":129,"_44":130,"_45":131,"_47":132,"_48":133,"_49":114,"_51":50,"_52":134,"_54":135,"_56":136,"_58":-5,"_59":137,"_61":138,"_63":139,"_65":140,"_67":43,"_68":69},{"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_40":110,"_42":111,"_44":111,"_45":112,"_47":113,"_48":111,"_49":114,"_51":111,"_52":115,"_54":116,"_56":117,"_58":-5,"_59":118,"_61":119,"_63":120,"_65":121,"_67":43,"_68":69},{"_30":85,"_32":86,"_34":87,"_36":88,"_38":89,"_40":90,"_42":43,"_44":43,"_45":91,"_47":43,"_48":43,"_49":92,"_51":93,"_52":94,"_54":95,"_56":96,"_58":-5,"_59":97,"_61":98,"_63":99,"_65":100,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":50,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","1676","name","Azuchi-Momoyama Period","type","period","startDescription","This era saw the unification of Japan under powerful leaders and significant cultural developments.","endDescription","The period ended with the establishment of the Tokugawa shogunate, marking a new chapter in Japanese history.","startYear",1568,"startMonth",0,"startDay","endYear",1600,"endMonth","endDay","startSignificance",0.8,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/c/c6/Azuchimomoyama-japan.png/330px-Azuchimomoyama-japan.png","imageCredit","Image: Azuchi–Momoyama period / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Azuchi-Momoyama_period","cdnId","country",{"_32":82,"_83":84},"subjects",[76,77],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Feudal Japan","icon","GiSamuraiHelmet",{"_30":80,"_32":81},{"_30":78,"_32":79},"3","culture","2","politics","Japan","continent","Asia","1425","Battles of Kawanakajima","event","A series of conflicts between two powerful samurai clans in Japan, marked by strategic maneuvers and fierce combat.","The battles concluded with no decisive victor, influencing the political landscape of Japan and the rise of the Tokugawa shogunate.",1553,1564,0.7,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/BattleKawanakajima.jpg/330px-BattleKawanakajima.jpg","Image: Battles of Kawanakajima / Wikimedia Commons","https://en.wikipedia.org/wiki/Battles_of_Kawanakajima",{"_32":82,"_83":84},[101,102],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1","military","1832","Tokugawa Ieyasu","person","A key figure in unifying Japan, he established the Tokugawa shogunate, which ruled for over 250 years.","His legacy shaped Japan's political landscape and social structure for centuries.",1543,1,1616,6,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/11/Tokugawa_Ieyasu2.JPG/330px-Tokugawa_Ieyasu2.JPG","Image: Tokugawa Ieyasu / Wikimedia Commons","https://en.wikipedia.org/wiki/Tokugawa_Ieyasu",{"_32":82,"_83":84},[122,123],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1557","Hideyoshi","A prominent figure in Japanese history, known for unifying Japan during the late 16th century and establishing a centralized government.","His death marked the end of an era of unification, leading to a power struggle among his successors.",1537,3,17,1598,9,18,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/09/Toyotomi_Hideyoshi_c1598_Kodai-ji_Temple.png/330px-Toyotomi_Hideyoshi_c1598_Kodai-ji_Temple.png","Image: Toyotomi Hideyoshi / Wikimedia Commons","https://en.wikipedia.org/wiki/Hideyoshi",{"_32":82,"_83":84},[141,142],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1560","Oda Nobunaga","A prominent figure in Japanese history, known for his role in the unification of Japan during the late 16th century.","His life came to a sudden end, marking a significant turning point in the ongoing efforts to consolidate power in Japan.",1534,23,1582,21,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Odanobunaga.jpg/330px-Odanobunaga.jpg","Image: Oda Nobunaga / Wikimedia Commons","https://en.wikipedia.org/wiki/Oda_Nobunaga",{"_32":82,"_83":84},[158,159],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1675","Sengoku Period","This was a time of social upheaval, political intrigue, and near-constant military conflict among rival daimyos.","The period concluded with the unification of Japan under the Tokugawa shogunate, bringing relative peace.",1467,1603,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Sengoku_period_battle.jpg/330px-Sengoku_period_battle.jpg","Image: Sengoku period / Wikimedia Commons","https://en.wikipedia.org/wiki/Sengoku_period",{"_32":82,"_83":84},[173,174],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1411","Onin War","A major civil war that marked the beginning of the Sengoku period, characterized by a struggle for power among the samurai clans of Japan.","The conflict concluded with the destruction of Kyoto and the fragmentation of power, leading to prolonged warfare among various factions.",1477,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Onin-War-1467-1477-The-Battle-of-Onin-by-Utagawa-Yoshitora.png/330px-Onin-War-1467-1477-The-Battle-of-Onin-by-Utagawa-Yoshitora.png","Image: Ōnin War / Wikimedia Commons","https://en.wikipedia.org/wiki/Onin_War",{"_32":82,"_83":84},[187,188],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":80,"_32":81},"1366","Ninja","Covert agents in feudal Japan known for espionage, sabotage, guerrilla warfare, and assassinations.","The role of the ninja diminished with the unification of Japan, leading to their romanticized portrayal in popular culture.",1460,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Hokusai-sketches---hokusai-manga-vol6-crop.jpg/330px-Hokusai-sketches---hokusai-manga-vol6-crop.jpg","Image: Ninja / Wikimedia Commons","https://en.wikipedia.org/wiki/Ninja",{"_32":82,"_83":84},[201,202],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":78,"_32":79},"1864","Sesshū Tōyō","A prominent figure in Japanese ink painting, known for his mastery of the suiboku-ga style.","His legacy continues to influence Japanese art and culture, establishing him as a pivotal figure in the history of East Asian art.",1420,1506,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/75/Portrait_of_Sesshu.jpg/330px-Portrait_of_Sesshu.jpg","Image: Sesshū Tōyō / Wikimedia Commons","https://en.wikipedia.org/wiki/Sesshū_Tōyō",{"_32":82,"_83":84},[216],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":217,"_32":218},"9","art","1562","Muromachi Period","This era is marked by the rise of the Ashikaga shogunate and significant cultural developments in Japan, including the flourishing of the arts.","The period concluded with the fall of the Ashikaga shogunate, leading to the unification of Japan under the Tokugawa shogunate.",1336,1573,"","Image: Muromachi period / Wikimedia Commons","https://en.wikipedia.org/wiki/Muromachi_period",{"_32":82,"_83":84},[232,233],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":78,"_32":79},"1558","Ashikaga Shogunate","This period marked the rise of the Ashikaga family as shoguns, overseeing a time of cultural flourishing and political fragmentation in Japan.","The shogunate ended as a result of internal conflicts and the rise of powerful daimyos, leading to the unification of Japan under the Tokugawa shogunate.","Image: Ashikaga shogunate / Wikimedia Commons","https://en.wikipedia.org/wiki/Ashikaga_shogunate",{"_32":82,"_83":84},[244,245],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":78,"_32":79},"942","Himeji Castle","landmark","This historic castle is renowned for its elegant architecture and is one of the best-preserved examples of Japanese feudal castles. It is often referred to as the 'White Heron Castle' due to its brilliant white exterior.","Himeji Castle has been designated a UNESCO World Heritage Site and continues to attract visitors from around the globe.",1333,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Himeji_castle_in_may_2015.jpg/330px-Himeji_castle_in_may_2015.jpg","Image: Himeji Castle / Wikimedia Commons","https://en.wikipedia.org/wiki/Himeji_Castle",{"_32":82,"_83":84},[260,261],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":78,"_32":79},"2390","Japanese Katana","Curved, single-edged sword used by samurai in Japan for precision and cutting efficiency.","Remains a symbol of Japanese martial culture and craftsmanship.",1200,"https://en.wikipedia.org/wiki/File:Katana.png","Image: Katana / Wikimedia Commons","https://en.wikipedia.org/wiki/Katana",{"_32":82,"_83":84},[274,275],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":78,"_32":79},"1368","Samurai","The military nobility and officer caste of medieval and early-modern Japan, known for their code of honor and martial skills.","The samurai class was abolished during the Meiji Restoration, leading to significant changes in Japanese society.",1185,1868,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Koboto_Santaro%2C_a_Japanese_military_commander_Wellcome_V0037661.jpg/330px-Koboto_Santaro%2C_a_Japanese_military_commander_Wellcome_V0037661.jpg","Image: Samurai / Wikimedia Commons","https://en.wikipedia.org/wiki/Samurai",{"_32":82,"_83":84},[289,290],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":103,"_32":104},{"_30":78,"_32":79},"2414","Jujutsu","An ancient Japanese martial art focused on joint locks, throws, and grappling, used by samurai in unarmored or armored combat.","Influenced modern judo, aikido, and Brazilian jiu-jitsu.",700,"https://en.wikipedia.org/wiki/File:Jujutsu_training.jpg","Image: Jujutsu / Wikimedia Commons","https://en.wikipedia.org/wiki/Jujutsu",{"_32":82,"_83":84},[303],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,27]
