_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":93,"_51":93,"_53":95,"_55":189,"_57":190,"_59":-5,"_61":191,"_63":192,"_65":193,"_67":194,"_69":43,"_70":71},{"_30":170,"_32":171,"_34":89,"_36":172,"_38":173,"_40":174,"_42":43,"_44":43,"_45":175,"_47":43,"_48":43,"_49":52,"_51":176,"_53":177,"_55":178,"_57":179,"_59":-5,"_61":180,"_63":181,"_65":182,"_67":183,"_69":43,"_70":71},{"_30":155,"_32":156,"_34":35,"_36":157,"_38":158,"_40":145,"_42":43,"_44":43,"_45":159,"_47":43,"_48":43,"_49":93,"_51":94,"_53":160,"_55":161,"_57":162,"_59":-5,"_61":163,"_63":164,"_65":165,"_67":166,"_69":43,"_70":71},{"_30":141,"_32":142,"_34":35,"_36":143,"_38":144,"_40":145,"_42":43,"_44":43,"_45":146,"_47":43,"_48":43,"_49":94,"_51":93,"_53":147,"_55":148,"_57":149,"_59":-5,"_61":150,"_63":151,"_65":152,"_67":153,"_69":43,"_70":71},{"_30":125,"_32":126,"_34":35,"_36":127,"_38":128,"_40":129,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":130,"_51":93,"_53":131,"_55":132,"_57":133,"_59":134,"_61":135,"_63":136,"_65":137,"_67":138,"_69":43,"_70":71},{"_30":108,"_32":109,"_34":89,"_36":110,"_38":111,"_40":112,"_42":43,"_44":43,"_45":113,"_47":43,"_48":43,"_49":52,"_51":114,"_53":115,"_55":116,"_57":117,"_59":-5,"_61":118,"_63":119,"_65":120,"_67":121,"_69":43,"_70":71},{"_30":87,"_32":88,"_34":89,"_36":90,"_38":91,"_40":41,"_42":43,"_44":43,"_45":92,"_47":43,"_48":43,"_49":93,"_51":94,"_53":95,"_55":96,"_57":97,"_59":98,"_61":99,"_63":100,"_65":101,"_67":102,"_69":43,"_70":71},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":43,"_70":71},"id","271","name","The Development of Greek Tragedy","type","event","startDescription","A transformative cultural movement that introduced dramatic storytelling and complex characters to theater.","endDescription","This art form evolved and influenced literature and performance in subsequent centuries.","startYear",-600,"startMonth",0,"startDay","endYear",-500,"endMonth","endDay","startSignificance",0.7,"endSignificance",0.6,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Dionysos_mask_Louvre_Myr347.jpg/330px-Dionysos_mask_Louvre_Myr347.jpg","imageCredit","Marie-Lan Nguyen / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/Greek_tragedy","cdnId","images/e6d3e6c21be470d91113c376854d7f8d71dce7ca.webp","country",{"_32":84,"_85":86},"subjects",[78,79],"group",{"_32":75,"_76":77},"user",{"_30":72,"_73":74},"likes","liked",false,"6","username","HistOracle","Ancient Greece","icon","GiLaurelCrown",{"_30":82,"_32":83},{"_30":80,"_32":81},"9","art","3","culture","Greece","continent","Europe","182","The Development of Greek Philosophy","period","A transformative period in which thinkers began to explore questions of existence, ethics, and the nature of knowledge, laying the foundation for Western philosophy.","This intellectual movement influenced countless generations and remains a cornerstone of philosophical inquiry.",-300,0.9,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/Map_of_Greece%2C_Archipelago_and_part_of_Anadoli%3B_Louis_Stanislas_d%27Arcy_Delarochette_1791.jpg/330px-Map_of_Greece%2C_Archipelago_and_part_of_Anadoli%3B_Louis_Stanislas_d%27Arcy_Delarochette_1791.jpg","Louis Stanislas d'Arcy Delarochette / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Ancient_Greece","images/4517f34ef70ce6b3f9a42a556e47a846024d7c7c.webp",{"_32":84,"_85":86},[105],{"_32":75,"_76":77},{"_30":103,"_73":104},"7","Kushim",{"_30":106,"_32":107},"4","intellectual","2229","Lydian Kingdom","The Kingdom of Lydia was an Iron Age state in western Anatolia that became powerful under the Mermnad dynasty, noted for its wealth and early coinage.","Lydia was conquered by the Persian Achaemenid Empire in the mid-6th century BCE, ending its independent rule.",-680,-546,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f1/Lydia_c._500_BC.png/330px-Lydia_c._500_BC.png","Image: Lydian territory / Wikimedia Commons","https://en.wikipedia.org/wiki/Lydia",{"_32":123,"_85":124},[122],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"Turkey","MiddleEast","632","The Iliad","This ancient Greek epic poem attributed to Homer narrates the events of the Trojan War and the Greek hero Achilles' role in it, exploring themes of honor, wrath, and fate.","Its enduring legacy has influenced countless works of literature and remains a foundational text in Western literature.",-750,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/38/Detail._Wooden_board_inscribed_in_ink_with_lines_468-473%2C_Book_I_of_Homer%27s_Iliad._Roman_Egypt._On_display_at_the_British_Museum.jpg/330px-Detail._Wooden_board_inscribed_in_ink_with_lines_468-473%2C_Book_I_of_Homer%27s_Iliad._Roman_Egypt._On_display_at_the_British_Museum.jpg","Unknown author / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Iliad","images/4c269028f360f08dd6b89ce6eb2a4ec6b85dca84.webp",{"_32":84,"_85":86},[139,140],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":82,"_32":83},{"_30":106,"_32":107},"2413","Greco-Roman Wrestling","A style of wrestling practiced in ancient Greece and Rome, emphasizing throws and grappling.","Foundation of modern Olympic wrestling styles.",-776,400,"https://en.wikipedia.org/wiki/File:Greco-Roman_wrestling.jpg","Image: Greco-Roman Wrestling / Wikimedia Commons","https://en.wikipedia.org/wiki/Ancient_Greek_wrestling",{"_32":84,"_85":86},[154],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"987","Olympic Games","This ancient festival was held every four years in Olympia, honoring Zeus through athletic competitions and cultural events.","The games were abolished by the Roman Emperor Theodosius I as part of a campaign against pagan practices.",393,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Olympic_rings_without_rims.svg/330px-Olympic_rings_without_rims.svg.png","Image: Olympic Games / Wikimedia Commons","https://en.wikipedia.org/wiki/Olympic_Games",{"_32":84,"_85":86},[167,168],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":82,"_32":83},{"_30":103,"_32":169},"religion","2230","Phrygian Kingdom","The Phrygian Kingdom emerged in Anatolia after the Late Bronze Age collapse, becoming known for its rich culture under kings such as Midas.","After invasions and eventual conquest by Lydia, followed by incorporation into larger empires such as Persia, Phrygia ceased to exist as an independent political entity.",-800,-675,0.3,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/22/Phrygia_map.png/330px-Phrygia_map.png","Image: Phrygian region / Wikimedia Commons","https://en.wikipedia.org/wiki/Phrygians",{"_32":123,"_85":124},[184],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"1513","Archaic Greece","This era marked the emergence of city-states and the development of art, architecture, and political systems in ancient Greece.","The period concluded with the rise of classical Greece, characterized by increased political complexity and cultural achievements.","Image: Archaic Greece / Wikimedia Commons","https://en.wikipedia.org/wiki/Archaic_Greece",{"_32":84,"_85":86},[195,196],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":197,"_32":198},{"_30":82,"_32":83},"2","politics","1388","Sparta","This period encompasses the development of Spartan society, known for its unique social structure, military discipline, and emphasis on austerity and communal living.","The period concluded with the decline of Spartan dominance after the Battle of Leuctra, leading to significant changes in their societal structure.",-146,0.85,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/db/Spartan_Territory_Before_371_BC.png/330px-Spartan_Territory_Before_371_BC.png","Image: Sparta / Wikimedia Commons","https://en.wikipedia.org/wiki/Sparta",{"_32":84,"_85":86},[213,214],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":215,"_32":216},{"_30":82,"_32":83},"1","military","1059","Ancient Greek Music","This period marked the development of music in ancient Greece, characterized by the use of instruments like the lyre and a rich tradition of vocal music.","The legacy of ancient Greek music continued to influence Western music traditions long after its decline.","https://upload.wikimedia.org/wikipedia/commons/thumb/1/1f/Salpinx_player_MAR_Palermo_NI1853.jpg/330px-Salpinx_player_MAR_Palermo_NI1853.jpg","Image: Music of ancient Greece / Wikimedia Commons","https://en.wikipedia.org/wiki/Ancient_Greek_music",{"_32":84,"_85":86},[228],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":80,"_32":81},"2415","Siege Ramps","Assyrian reliefs depict engineered siege ramps used to breach fortified cities.","Demonstrated systematic, state-organized siege engineering.",-900,-700,"https://en.wikipedia.org/wiki/File:Assyrian_siege_Lachish.jpg","Siege of Lachish relief / British Museum","https://en.wikipedia.org/wiki/Siege_of_Lachish",{"_32":84,"_85":86},[242,243],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":215,"_32":216},{"_30":82,"_32":83},"2232","Corinth","Corinth was a prominent city-state in ancient Greece, influential in trade, art, and politics throughout the Archaic and Classical periods.","Corinth lost its independence after Roman conquest in 146 BCE but remained an important urban and cultural center under Roman rule.",-1000,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/Ancient_Corinth_map.png/330px-Ancient_Corinth_map.png","Image: Ancient Corinth / Wikimedia Commons","https://en.wikipedia.org/wiki/Corinth",{"_32":84,"_85":86},[256],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"151","Mycenaean Greece","This period is characterized by the rise of powerful kingdoms and the development of early Greek culture and language.","The period ended with the collapse of palatial centers and the onset of the Greek Dark Ages.",-1600,-1100,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/33/Mycenaean_World_en.png/330px-Mycenaean_World_en.png","Alexikoua / Panthera tigris tigris / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Mycenaean_Greece","images/7519b281e440b8d5a7a2c5872d19c733de4c4471.webp",{"_32":84,"_85":86},[271,272],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":215,"_32":216},{"_30":82,"_32":83},"1480","Cycladic Civilization","This period is characterized by the emergence of a distinct culture in the Cyclades, marked by unique art and architecture, particularly marble figurines.","The civilization gradually declined and was absorbed into the Minoan culture, leading to significant changes in the region's social and economic structures.",-3000,-2000,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Cyclades_map-fr.jpg/330px-Cyclades_map-fr.jpg","Image: Cycladic culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Cycladic_civilization",{"_32":84,"_85":86},[286,287],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":80,"_32":81},"34","Minoan Civilization","This civilization is known for its advanced art, architecture, and trade networks, flourishing on the island of Crete. Led by the legendary ruler of Crete king Minos and setting of the Minotaur and the Labyrinth.","The civilization declined due to the Thera Eruption, one of the largest eruptions in recorded history, and invasions such as the Mycenaean Conquest, paving the way for the rise of Mycenaean Greece.",-1450,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/ff/Map_Minoan_Crete-en.svg/330px-Map_Minoan_Crete-en.svg.png","Bibi Saint-Pol / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Minoan_civilization","images/ed9b09464b9e354c694c89aa41ac9f74e29b4872.webp",{"_32":84,"_85":86},[301,302],{"_32":75,"_76":77},{"_30":103,"_73":104},{"_30":82,"_32":83},{"_30":72,"_32":303},"maritime",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,2]
