45,"_39":89,"_41":146,"_42":147,"_44":124,"_46":40,"_48":89,"_50":49,"_52":148,"_54":149,"_56":150,"_58":-5,"_59":151,"_61":152,"_63":153,"_65":154,"_67":68,"_69":70},{"_27":118,"_29":119,"_31":120,"_33":121,"_35":122,"_37":123,"_39":124,"_41":125,"_42":126,"_44":127,"_46":128,"_48":129,"_50":129,"_52":130,"_54":131,"_56":132,"_58":-5,"_59":133,"_61":134,"_63":135,"_65":136,"_67":68,"_69":70},{"_27":104,"_29":105,"_31":85,"_33":106,"_35":107,"_37":108,"_39":109,"_41":110,"_42":68,"_44":68,"_46":68,"_48":51,"_50":68,"_52":111,"_54":-5,"_56":112,"_58":-5,"_59":113,"_61":114,"_63":115,"_65":116,"_67":68,"_69":70},{"_27":83,"_29":84,"_31":85,"_33":86,"_35":87,"_37":38,"_39":68,"_41":68,"_42":88,"_44":68,"_46":68,"_48":51,"_50":89,"_52":90,"_54":91,"_56":92,"_58":93,"_59":94,"_61":95,"_63":96,"_65":97,"_67":68,"_69":70},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70},"id","1579","name","French Revolution","type","period","startDescription","A period characterized by radical social and political upheaval in France, challenging the monarchy and establishing republican ideals.","endDescription","Concluded with the rise of Napoleon Bonaparte, marking a shift towards authoritarian rule and the end of revolutionary governance.","startYear",1789,"startMonth",5,"startDay","endYear",1799,"endMonth",11,"endDay",9,"startSignificance",0.9,"endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Anonymous_-_Prise_de_la_Bastille.jpg/330px-Anonymous_-_Prise_de_la_Bastille.jpg","imageCredit","Image: French Revolution / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/French_Revolution","cdnId","country",{"_29":80,"_81":82},"subjects",[77],"group",{"_29":74,"_75":76},"user",{"_27":71,"_72":73},"likes",0,"liked",false,"6","username","HistOracle","The Enlightenment","icon","GiLightBulb",{"_27":78,"_29":79},"2","politics","France","continent","Europe","640","The Confessions","event","This autobiographical work is one of the first modern autobiographies, exploring the author's life and thoughts, and reflecting on the nature of self and society.","It concluded with a profound influence on the genre of autobiography and the exploration of personal identity.",1790,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/12/Confessions_Rousseau_Aldus_P028.jpg/330px-Confessions_Rousseau_Aldus_P028.jpg","files / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Confessions_(Rousseau)","images/d32e7dea6f08d3583bb6aa7364c22cbbf070b813.webp",{"_29":80,"_81":82},[98,99],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":102,"_29":103},{"_27":100,"_29":101},"4","intellectual","3","culture","1169","First Manned Flight in a Hot Air Balloon","The first successful manned flight in a hot air balloon marked a significant milestone in aviation history, showcasing human ingenuity and the possibilities of flight.","This event laid the groundwork for future developments in aeronautics and inspired further exploration of flight technology.",1783,6,4,"","https://en.wikipedia.org/wiki/First_manned_flight_in_a_hot_air_balloon",{"_29":80,"_81":82},[117],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":102,"_29":103},"1164","Ludwig van Beethoven","person","A renowned composer and pianist, he is a pivotal figure in the transition between the Classical and Romantic eras in Western music.","His legacy endures through his influential compositions and the profound impact he had on the music world.",1770,12,17,1827,3,26,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Joseph_Karl_Stieler%27s_Beethoven_mit_dem_Manuskript_der_Missa_solemnis.jpg/330px-Joseph_Karl_Stieler%27s_Beethoven_mit_dem_Manuskript_der_Missa_solemnis.jpg","Image: Ludwig van Beethoven / Wikimedia Commons","https://en.wikipedia.org/wiki/Ludwig_van_Beethoven",{"_29":140,"_81":82},[137],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":138,"_29":139},"9","art","Germany","1163","Wolfgang Amadeus Mozart","A prolific and influential composer of the Classical era, known for his symphonies, operas, and chamber music that have shaped Western music.","His death marked the end of an era in classical music, leaving a legacy that continues to inspire musicians and composers worldwide.",1756,27,1791,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/ad/The_Mozart_Family_-_Wolfgang_Amadeus_Mozart_headshot.jpg/330px-The_Mozart_Family_-_Wolfgang_Amadeus_Mozart_headshot.jpg","Image: Wolfgang Amadeus Mozart / Wikimedia Commons","https://en.wikipedia.org/wiki/Wolfgang_Amadeus_Mozart",{"_29":156,"_81":82},[155],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":138,"_29":139},"Austria","1078","Birth of the Symphony Orchestra","The symphony orchestra was established as a large ensemble capable of performing complex orchestral works.","This formation became essential for composers, allowing for rich musical textures and large-scale compositions.",1750,0.85,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/08/Orchestra_Simfonica_Bucure%C8%99ti.jpg/330px-Orchestra_Simfonica_Bucure%C8%99ti.jpg","Image: Orchestra / Wikimedia Commons","https://en.wikipedia.org/wiki/Symphony_orchestra",{"_29":172,"_81":82},[171],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":138,"_29":139},"Italy","1057","The Classical Era","This period is characterized by the development of classical music, emphasizing clarity, balance, and form.","The era concluded with the transition to Romanticism, marking a significant evolution in musical expression.",1730,1820,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9e/Mozart_family_crop.jpg/330px-Mozart_family_crop.jpg","Image: Classical period (music) / Wikimedia Commons","https://en.wikipedia.org/wiki/Classical_period_(music)",{"_29":188,"_81":188},[186,187],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":102,"_29":103},{"_27":138,"_29":139},"Global","322","Catherine the Great","Empress of Russia, she expanded the empire significantly and is known for her patronage of the arts and education.","Her reign is often considered the Golden Age of the Russian Empire.",1729,2,1796,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Catherine_II_after_Roslin%2C_Rokotov_%281780s%2C_Kunsthistorisches_Museum%29.jpg/330px-Catherine_II_after_Roslin%2C_Rokotov_%281780s%2C_Kunsthistorisches_Museum%29.jpg","Kunsthistorisches Museum / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Catherine_the_Great","images/81ab3dc662199ac2ade35a2403c007c320273fa0.webp",{"_29":206,"_81":82},[204,205],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":78,"_29":79},{"_27":102,"_29":103},"Russia","1588","Immanuel Kant","A prominent philosopher known for his work in epistemology and ethics, shaping modern Western philosophy.","His death marked the end of an era in philosophical thought, influencing countless future thinkers.",1724,22,1804,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/79/Immanuel_Kant_-_Gemaelde_1.jpg/330px-Immanuel_Kant_-_Gemaelde_1.jpg","Image: Immanuel Kant / Wikimedia Commons","https://en.wikipedia.org/wiki/Immanuel_Kant",{"_29":140,"_81":82},[221],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":100,"_29":101},"1587","Jean-Jacques Rousseau","A prominent philosopher and writer whose ideas influenced the French Revolution and modern political thought.","His legacy continues to shape discussions around democracy, education, and individual freedom.",1712,28,1778,7,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Jean-Jacques_Rousseau_%28painted_portrait%29.jpg/330px-Jean-Jacques_Rousseau_%28painted_portrait%29.jpg","Image: Jean-Jacques Rousseau / Wikimedia Commons","https://en.wikipedia.org/wiki/Jean-Jacques_Rousseau",{"_29":80,"_81":82},[237,238],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":78,"_29":79},{"_27":100,"_29":101},"1586","Voltaire","A prominent Enlightenment thinker known for his wit, advocacy of civil liberties, and criticism of established religion.","His legacy endures through his writings that champion freedom of speech and separation of church and state.",1694,21,30,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Atelier_de_Nicolas_de_Largilli%C3%A8re%2C_portrait_de_Voltaire%2C_d%C3%A9tail_%28mus%C3%A9e_Carnavalet%29_-002.jpg/330px-Atelier_de_Nicolas_de_Largilli%C3%A8re%2C_portrait_de_Voltaire%2C_d%C3%A9tail_%28mus%C3%A9e_Carnavalet%29_-002.jpg","Image: Voltaire / Wikimedia Commons","https://en.wikipedia.org/wiki/Voltaire",{"_29":80,"_81":82},[253,254],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":78,"_29":79},{"_27":100,"_29":101},"60","The Age of Enlightenment","An intellectual and philosophical movement emphasizing reason, individualism, and skepticism of authority.","The Enlightenment laid the groundwork for modern democratic and scientific thought.",1685,1815,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d4/Les_salons_au_XVIIIe_si%C3%A8cle_-_Histoire_Image.jpg/330px-Les_salons_au_XVIIIe_si%C3%A8cle_-_Histoire_Image.jpg","Anicet Charles Gabriel Lemonnier / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Age_of_Enlightenment","images/433be948581fe22d5269b426227dd2e660d41095.webp",{"_29":188,"_81":188},[269,270],{"_29":74,"_75":76},{"_27":71,"_72":73},{"_27":78,"_29":79},{"_27":100,"_29":101},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,38]
