8,"_42":43,"_44":43,"_45":189,"_46":43,"_48":43,"_50":53,"_52":162,"_54":190,"_56":191,"_58":192,"_60":-5,"_62":193,"_64":194,"_66":195,"_68":196,"_70":43,"_71":72},{"_30":169,"_32":170,"_34":89,"_36":171,"_38":172,"_40":173,"_42":43,"_44":43,"_45":174,"_46":43,"_48":43,"_50":144,"_52":51,"_54":175,"_56":176,"_58":177,"_60":-5,"_62":178,"_64":179,"_66":180,"_68":181,"_70":43,"_71":72},{"_30":157,"_32":158,"_34":35,"_36":159,"_38":160,"_40":161,"_42":43,"_44":43,"_45":92,"_46":43,"_48":43,"_50":51,"_52":162,"_54":-5,"_56":-5,"_58":163,"_60":-5,"_62":164,"_64":165,"_66":166,"_68":167,"_70":43,"_71":72},{"_30":137,"_32":138,"_34":35,"_36":139,"_38":140,"_40":141,"_42":142,"_44":143,"_45":141,"_46":142,"_48":143,"_50":144,"_52":145,"_54":146,"_56":147,"_58":148,"_60":-5,"_62":149,"_64":150,"_66":151,"_68":152,"_70":43,"_71":72},{"_30":122,"_32":123,"_34":35,"_36":124,"_38":125,"_40":126,"_42":43,"_44":43,"_45":126,"_46":43,"_48":43,"_50":51,"_52":53,"_54":127,"_56":128,"_58":129,"_60":-5,"_62":130,"_64":131,"_66":132,"_68":133,"_70":43,"_71":72},{"_30":105,"_32":106,"_34":35,"_36":107,"_38":108,"_40":92,"_42":43,"_44":43,"_45":43,"_46":43,"_48":43,"_50":53,"_52":43,"_54":109,"_56":110,"_58":111,"_60":112,"_62":113,"_64":114,"_66":115,"_68":116,"_70":43,"_71":72},{"_30":87,"_32":88,"_34":89,"_36":90,"_38":91,"_40":92,"_42":43,"_44":43,"_45":93,"_46":43,"_48":43,"_50":51,"_52":94,"_54":95,"_56":96,"_58":97,"_60":-5,"_62":98,"_64":99,"_66":100,"_68":101,"_70":43,"_71":72},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":41,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":43,"_71":72},"id","522","name","Trial of the Pirate Captain Kidd","type","event","startDescription","Captain Kidd was tried for piracy and murder in a highly publicized trial that reflected the tensions between piracy and colonial law.","endDescription","His execution marked a significant moment in the fight against piracy, serving as a warning to other would-be pirates.","startYear",1701,"startMonth",0,"startDay","endYear","endMonth",5,"endDay",23,"startSignificance",0.7,"endSignificance",0.6,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/5/50/William_Kidd.jpg/330px-William_Kidd.jpg","imageCredit","James Thornhill / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/William_Kidd","cdnId","images/acd7d84adc060737ce2b84a7a5336513ed24f068.webp","country",{"_32":84,"_85":86},"subjects",[79,80],"group",{"_32":76,"_77":78},"user",{"_30":73,"_74":75},"likes","liked",false,"6","username","HistOracle","Pirates","icon","GiPirateFlag",{"_30":82,"_32":83},{"_30":73,"_32":81},"maritime","2","politics","United Kingdom","continent","Europe","1282","Anne Bonny","person","A notorious pirate known for her fierce temperament and involvement in piracy during the early 18th century.","Her life ended in obscurity, with little known about her fate after her capture.",1700,1720,0.1,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/Ann_Bonny%2C_Cole_1724.jpg/330px-Ann_Bonny%2C_Cole_1724.jpg","Image: Anne Bonny / Wikimedia Commons","https://en.wikipedia.org/wiki/Anne_Bonny",{"_32":103,"_85":104},[102],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"Bahamas","NorthAmerica","524","Pirate Code","The Pirate Code was a set of rules that governed the conduct of pirates aboard ships, emphasizing democracy and shared profits among crew members.","Though not universally adopted, the code reflected a unique form of governance among pirates that contrasted sharply with the hierarchical structures of naval forces.","https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Pg_154_-_So_the_Treasure_was_Divided.jpg/330px-Pg_154_-_So_the_Treasure_was_Divided.jpg","Howard Pyle / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Pirate_code","images/e3dbca3d05f82d6e0a3b9cc6c8f3039747df1515.webp",{"_32":121,"_85":121},[117,118],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":119,"_32":120},{"_30":73,"_32":81},"3","culture","Global","1944","Capture of the Ganj-i-Sawai","This significant maritime event involved the seizure of a Mughal ship by pirates, marking a notable confrontation between European pirates and the Mughal Empire.","The event concluded with the pirates successfully capturing the ship, leading to increased tensions and further piracy in the region.",1695,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Avery_Chasing_the_Great_Mughal%27s_Ship.jpg/330px-Avery_Chasing_the_Great_Mughal%27s_Ship.jpg","Image: Capture of the Grand Mughal Fleet / Wikimedia Commons","https://en.wikipedia.org/wiki/Capture_of_the_Ganj-i-Sawai",{"_32":135,"_85":136},[134],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"India","Asia","1945","Port Royal Earthquake","A catastrophic seismic event that struck a notorious pirate haven, leading to widespread destruction and loss of life.","The earthquake resulted in the submergence of much of the town, marking a significant decline in its prominence as a center of piracy.",1692,6,7,0.8,0.9,"","Image: 1692 Jamaica earthquake / Wikimedia Commons","https://en.wikipedia.org/wiki/Port_Royal_earthquake",{"_32":156,"_85":104},[155],{"_32":76,"_77":78},{"_30":153,"_74":154},"7","Kushim",{"_30":73,"_32":81},"Jamaica","526","The Pirate Round","This term refers to the route taken by pirates from the Caribbean to the Indian Ocean, where they engaged in piracy against merchant ships.","The Pirate Round expanded the geographical scope of piracy, leading to increased wealth for some pirates and greater naval responses from colonial powers.",1690,0.5,"https://en.wikipedia.org/wiki/Pirate_round",{"_32":121,"_85":121},[168],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"1941","Samuel Bellamy","A prominent pirate known for his romantic exploits and significant influence in the Golden Age of Piracy.","His life ended at sea during a storm, marking the conclusion of his notorious piratical career.",1689,1717,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Samuel_Bellamy%2C_Wreck_of_the_Whydah%2C_from_the_Pirates_of_the_Spanish_Main_series_%28N19%29_for_Allen_%26_Ginter_Cigarettes_MET_DP835027.jpg/330px-Samuel_Bellamy%2C_Wreck_of_the_Whydah%2C_from_the_Pirates_of_the_Spanish_Main_series_%28N19%29_for_Allen_%26_Ginter_Cigarettes_MET_DP835027.jpg","Image: Samuel Bellamy / Wikimedia Commons","https://en.wikipedia.org/wiki/Samuel_Bellamy",{"_32":183,"_85":104},[182],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"United States of America","1283","Stede Bonnet","A notable figure in the early 18th century, known for his unconventional approach to piracy and his brief career on the high seas.","His life ended in execution, marking a significant moment in the history of piracy.",1688,1718,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Bonnet.gif/330px-Bonnet.gif","Image: Stede Bonnet / Wikimedia Commons","https://en.wikipedia.org/wiki/Stede_Bonnet",{"_32":198,"_85":104},[197],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"Barbados","1281","Calico Jack","A notorious English pirate known for his distinctive flag featuring a skull and crossbones, he became a symbol of the Golden Age of Piracy.","His life ended on the gallows after being captured, marking a significant moment in the decline of piracy in the Caribbean.",1682,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b3/Rackham%2C_Jack.jpg/330px-Rackham%2C_Jack.jpg","Image: John Rackham / Wikimedia Commons","https://en.wikipedia.org/wiki/Calico_Jack",{"_32":156,"_85":104},[211],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"1940","Henry Every","A notorious English pirate, known for his successful raids and significant impact on maritime piracy during the late 17th century.","His fate remains uncertain, with various accounts suggesting he may have lived in obscurity after retiring from piracy.",1659,1696,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Every%2CHenry.JPG/330px-Every%2CHenry.JPG","Image: Henry Every / Wikimedia Commons","https://en.wikipedia.org/wiki/Henry_Every",{"_32":84,"_85":86},[225],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"1954","The Golden Age of Piracy","period","This period marked a significant rise in piracy across the Caribbean and the Americas, characterized by notorious pirates and their exploits.","The decline of piracy was influenced by increased naval patrols and the establishment of colonial law enforcement, leading to a reduction in pirate activities.",1650,1730,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/The_Capture_of_the_Pirate_Blackbeard_1718_by_Jean_Leon_Gerome_Ferris_%28retouched%29.jpg/330px-The_Capture_of_the_Pirate_Blackbeard_1718_by_Jean_Leon_Gerome_Ferris_%28retouched%29.jpg","Image: Golden Age of Piracy / Wikimedia Commons","https://en.wikipedia.org/wiki/Golden_Age_of_Piracy",{"_32":121,"_85":121},[240],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"1934","Pirate Republic of Madagascar","A significant era characterized by the establishment of pirate communities on the island, where buccaneers operated with relative autonomy and engaged in maritime trade.","The decline of the pirate republic led to increased colonial control and the eventual suppression of piracy in the region.","https://en.wikipedia.org/wiki/Pirate_Republic_of_Madagascar",{"_32":251,"_85":252},[250],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"Madagascar","Africa","1280","Henry Morgan","A Welsh privateer, pirate, and admiral of the English Royal Navy known for his raids against the Spanish in the Caribbean.","He passed away in Port Royal, Jamaica, leaving behind a legacy as one of the most famous pirates in history.",1635,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Morgan%2CHenry.jpg/330px-Morgan%2CHenry.jpg","Image: Henry Morgan / Wikimedia Commons","https://en.wikipedia.org/wiki/Henry_Morgan",{"_32":156,"_85":104},[265],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"1386","Barbary Corsairs","This period was marked by the activities of privateers and pirates operating from North African ports, engaging in maritime raids across the Mediterranean.","The decline of the Barbary Corsairs was due to European naval power and changing political dynamics in the region.",1500,1800,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1e/Laureys_a_Castro_-_A_Sea_Fight_with_Barbary_Corsairs.jpg/330px-Laureys_a_Castro_-_A_Sea_Fight_with_Barbary_Corsairs.jpg","Image: Barbary corsairs / Wikimedia Commons","https://en.wikipedia.org/wiki/Barbary_corsairs",{"_32":280,"_85":252},[279],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},"Tunisia","525","Port Royal","landmark","This historic city in Jamaica was known as the 'wickedest city on earth' during the height of piracy, serving as a base for many infamous pirates.","The city was devastated by an earthquake in 1692, leading to its decline and the end of its status as a pirate haven.",1494,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3e/Old_Port_Royal_-_Project_Gutenberg_eText_19396.png/330px-Old_Port_Royal_-_Project_Gutenberg_eText_19396.png","John Masefield / Bea   o / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Port_Royal","images/f686d5dd64ca05d82c2e06f9833529821af1baf6.webp",{"_32":156,"_85":104},[295],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":73,"_32":81},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,25]
