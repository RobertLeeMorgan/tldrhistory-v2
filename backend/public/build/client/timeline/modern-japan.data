0":202,"_42":72,"_44":72,"_46":203,"_48":72,"_50":72,"_52":55,"_54":53,"_56":204,"_58":205,"_60":206,"_62":-5,"_63":207,"_65":208,"_67":209,"_69":210,"_71":72,"_73":74},{"_30":183,"_32":184,"_34":35,"_36":185,"_38":186,"_40":187,"_42":114,"_44":114,"_46":188,"_48":114,"_50":189,"_52":53,"_54":55,"_56":190,"_58":191,"_60":192,"_62":-5,"_63":193,"_65":194,"_67":195,"_69":196,"_71":72,"_73":74},{"_30":163,"_32":164,"_34":35,"_36":165,"_38":166,"_40":167,"_42":168,"_44":169,"_46":95,"_48":114,"_50":170,"_52":98,"_54":171,"_56":172,"_58":173,"_60":174,"_62":-5,"_63":175,"_65":176,"_67":177,"_69":178,"_71":72,"_73":74},{"_30":144,"_32":145,"_34":35,"_36":146,"_38":147,"_40":148,"_42":114,"_44":149,"_46":150,"_48":49,"_50":151,"_52":97,"_54":98,"_56":152,"_58":153,"_60":154,"_62":-5,"_63":155,"_65":156,"_67":157,"_69":158,"_71":72,"_73":74},{"_30":125,"_32":126,"_34":127,"_36":128,"_38":129,"_40":130,"_42":51,"_44":49,"_46":131,"_48":114,"_50":132,"_52":55,"_54":53,"_56":133,"_58":134,"_60":135,"_62":-5,"_63":136,"_65":137,"_67":138,"_69":139,"_71":72,"_73":74},{"_30":109,"_32":110,"_34":35,"_36":111,"_38":112,"_40":113,"_42":114,"_44":115,"_46":47,"_48":49,"_50":51,"_52":49,"_54":55,"_56":116,"_58":117,"_60":118,"_62":-5,"_63":119,"_65":120,"_67":121,"_69":122,"_71":72,"_73":74},{"_30":90,"_32":91,"_34":92,"_36":93,"_38":94,"_40":95,"_42":51,"_44":96,"_46":41,"_48":43,"_50":45,"_52":97,"_54":98,"_56":99,"_58":100,"_60":101,"_62":-5,"_63":102,"_65":103,"_67":104,"_69":105,"_71":72,"_73":74},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":59,"_60":61,"_62":-5,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":74},"id","1839","name","Shōwa Period","type","person","startDescription","This era witnessed Japan's transformation into a major economic power and significant cultural changes.","endDescription","It concluded with the death of the emperor, marking the end of an influential period in Japanese history.","startYear",1926,"startMonth",12,"startDay",25,"endYear",1989,"endMonth",1,"endDay",7,"startSignificance",0.9,"endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Emperor_Showa.jpg/330px-Emperor_Showa.jpg","imageCredit","Image: Shōwa era / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Sh%C5%8Dwa_period","cdnId","country",{"_32":87,"_88":89},"subjects",[81,82],"group",{"_32":78,"_79":80},"user",{"_30":75,"_76":77},"likes",0,"liked",false,"6","username","HistOracle","Modern Japan","icon","GiJapan",{"_30":85,"_32":86},{"_30":83,"_32":84},"8","economic","3","culture","Japan","continent","Asia","1649","Taisho Democracy","period","This period is characterized by a shift towards more democratic governance and political liberalization in Japan.","The period concluded with the rise of militarism and the end of democratic practices.",1912,30,0.7,0.6,"","Image: Taishō Democracy / Wikimedia Commons","https://en.wikipedia.org/wiki/Taisho_democracy",{"_32":87,"_88":89},[106],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},"2","politics","1852","Shōwa Emperor","A pivotal figure in Japanese history, he presided over a period of significant transformation, including Japan's militarization and subsequent post-war recovery.","His death marked the end of an era, leading to a new imperial reign and a shift in Japan's national identity.",1901,4,29,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Hirohito_in_dress_uniform_%28cropped%29.jpg/330px-Hirohito_in_dress_uniform_%28cropped%29.jpg","Image: Hirohito / Wikimedia Commons","https://en.wikipedia.org/wiki/Shōwa_Emperor",{"_32":87,"_88":89},[123,124],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":85,"_32":86},"1584","First Sino-Japanese War","event","A conflict between two East Asian powers, marking a significant shift in regional dynamics and showcasing military modernization efforts.","The war concluded with a decisive victory for Japan, leading to the Treaty of Shimonoseki and significant territorial and political changes in East Asia.",1894,1895,17,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8b/Fotoreproductie_van_een_schilderij%2C_voorstellende_het_Japanse_slagschip_Matsushima_tijdens_de_Slag_bij_de_Yalu-rivier_Flagship_Matsushima_in_the_midst_of_the_battle_%28titel_op_object%29%2C_RP-F-2001-7-1637B-49_%28cropped%29.jpg/330px-thumbnail.jpg","Image: First Sino-Japanese War / Wikimedia Commons","https://en.wikipedia.org/wiki/First_Sino-Japanese_War",{"_32":87,"_88":89},[140,141],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":142,"_32":143},{"_30":107,"_32":108},"1","military","1862","Kagawa Toyohiko","A significant religious leader and social reformer, he advocated for the rights of the poor and promoted Christian values in Japan.","His legacy continues to influence social justice movements within the country.",1888,10,1960,23,"https://upload.wikimedia.org/wikipedia/commons/c/c8/KAGAWA_Toyohiko_young.JPG","Image: Toyohiko Kagawa / Wikimedia Commons","https://en.wikipedia.org/wiki/Kagawa_Toyohiko",{"_32":87,"_88":89},[159,160],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":85,"_32":86},{"_30":161,"_32":162},"7","religion","1836","Ishikawa Takuboku","An influential poet known for his tanka poetry, he expressed the struggles of modern life in Japan.","His works remain significant in the study of modern Japanese literature.",1885,2,20,13,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cb/Takuboku_Ishikawa.jpg/330px-Takuboku_Ishikawa.jpg","Image: Takuboku Ishikawa / Wikimedia Commons","https://en.wikipedia.org/wiki/Ishikawa_Takuboku",{"_32":87,"_88":89},[179,180],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":85,"_32":86},{"_30":181,"_32":182},"4","intellectual","1860","Yamamoto Isoroku","A prominent naval officer, he is best known for planning the attack on Pearl Harbor, which brought the United States into World War II.","His death during the war underscored the challenges faced by Japan in its military endeavors.",1884,1943,18,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/79/Portrait_of_Yamamoto_Isoroku.jpg/330px-Portrait_of_Yamamoto_Isoroku.jpg","Image: Isoroku Yamamoto / Wikimedia Commons","https://en.wikipedia.org/wiki/Yamamoto_Isoroku",{"_32":87,"_88":89},[197],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":142,"_32":143},"1848","Kitaro Nishida","A prominent philosopher who founded the Kyoto School, he significantly influenced modern Japanese thought and introduced Western philosophy to Japan.","His legacy continues to impact philosophical discourse in Japan and beyond, establishing him as a key figure in 20th-century philosophy.",1870,1945,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/13/Portrait-of-Kitaro-Nishida.png/330px-Portrait-of-Kitaro-Nishida.png","Image: Kitarō Nishida / Wikimedia Commons","https://en.wikipedia.org/wiki/Kitaro_Nishida",{"_32":87,"_88":89},[211],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":181,"_32":182},"1652","Meiji Period","A transformative era marked by rapid modernization and industrialization, leading Japan to emerge as a global power.","The period concluded with the death of the emperor, transitioning Japan into a new phase of its history.",1868,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/ba/Meiji_tenno3.jpg/330px-Meiji_tenno3.jpg","Image: Meiji era / Wikimedia Commons","https://en.wikipedia.org/wiki/Meiji_period",{"_32":87,"_88":89},[224,225],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":85,"_32":86},"2254","Empire of Japan","The Empire of Japan was the modernized, centralized state established during the Meiji Restoration, expanding as a major imperial power in Asia.","It ended after Japan's defeat in World War II, transitioning to the modern constitutional monarchy.",1947,3,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/Empire_of_Japan_map.png/330px-Empire_of_Japan_map.png","Image: Empire of Japan / Wikimedia Commons","https://en.wikipedia.org/wiki/Empire_of_Japan",{"_32":87,"_88":89},[240],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":85,"_32":86},"500","The Meiji Restoration","A political revolution that restored imperial rule in Japan and initiated a period of rapid modernization and industrialization.","This era transformed Japan into a major world power and set the stage for its future conflicts.","https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Emperor_Meiji_by_Takahashi_Yuichi.jpg/330px-Emperor_Meiji_by_Takahashi_Yuichi.jpg","Takahashi Yuichi / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Meiji_Restoration","images/b824991c5d890b8d476c2175d2e61a7d12c6acd6.webp",{"_32":87,"_88":89},[253,254],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":85,"_32":86},"1845","Sōseki Natsume","A prominent novelist and scholar, he is known for his works that explore the complexities of modern Japanese society.","His death marked the end of an influential literary career, leaving a lasting impact on Japanese literature.",1867,9,1916,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/17/Natsume_Soseki_photo.jpg/330px-Natsume_Soseki_photo.jpg","Image: Natsume Sōseki / Wikimedia Commons","https://en.wikipedia.org/wiki/Natsume_Sōseki",{"_32":87,"_88":89},[269,270],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":85,"_32":86},{"_30":181,"_32":182},"1861","Takahashi Korekiyo","An influential politician and economist, he played a crucial role in Japan's economic policies during the early 20th century.","His assassination marked a significant moment in Japan's political history, reflecting the turbulent times of the era.",1854,1936,11,26,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/86/Korekiyo_Takahashi_2.jpg/330px-Korekiyo_Takahashi_2.jpg","Image: Takahashi Korekiyo / Wikimedia Commons","https://en.wikipedia.org/wiki/Takahashi_Korekiyo",{"_32":87,"_88":89},[286,287],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":83,"_32":84},"1833","Emperor Meiji","A pivotal figure in Japanese history, he presided over the Meiji Restoration, which transformed Japan into a modern state.","His reign marked the end of feudalism and the rise of Japan as a global power.",1852,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Meiji_Emperor.jpg/330px-Meiji_Emperor.jpg","Image: Emperor Meiji / Wikimedia Commons","https://en.wikipedia.org/wiki/Emperor_Meiji",{"_32":87,"_88":89},[300,301],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":85,"_32":86},"1846","Ito Hirobumi","A prominent statesman and four-time Prime Minister of Japan, he played a key role in the Meiji Restoration and modernization of Japan.","His assassination marked a significant moment in Japanese politics and highlighted the tensions of the era.",1841,16,1909,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7d/IT%C5%8C_Hirobumi.jpg/330px-IT%C5%8C_Hirobumi.jpg","Image: Itō Hirobumi / Wikimedia Commons","https://en.wikipedia.org/wiki/Ito_Hirobumi",{"_32":87,"_88":89},[316,317],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":107,"_32":108},{"_30":181,"_32":182},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,28]
