":196,"_42":197,"_44":198,"_45":199,"_47":200,"_48":201,"_49":137,"_51":50,"_53":202,"_55":203,"_57":204,"_59":-5,"_61":205,"_63":206,"_65":207,"_67":208,"_69":43,"_70":71},{"_30":179,"_32":180,"_34":165,"_36":181,"_38":182,"_40":183,"_42":43,"_44":43,"_45":184,"_47":43,"_48":43,"_49":137,"_51":137,"_53":138,"_55":185,"_57":186,"_59":-5,"_61":187,"_63":188,"_65":189,"_67":190,"_69":43,"_70":71},{"_30":163,"_32":164,"_34":165,"_36":166,"_38":167,"_40":168,"_42":43,"_44":43,"_45":169,"_47":43,"_48":43,"_49":137,"_51":50,"_53":170,"_55":171,"_57":172,"_59":173,"_61":174,"_63":175,"_65":176,"_67":177,"_69":43,"_70":71},{"_30":147,"_32":148,"_34":35,"_36":149,"_38":150,"_40":151,"_42":43,"_44":43,"_45":152,"_47":43,"_48":43,"_49":137,"_51":50,"_53":153,"_55":56,"_57":154,"_59":155,"_61":156,"_63":157,"_65":158,"_67":159,"_69":43,"_70":71},{"_30":131,"_32":132,"_34":35,"_36":133,"_38":134,"_40":135,"_42":43,"_44":43,"_45":136,"_47":43,"_48":43,"_49":137,"_51":50,"_53":138,"_55":138,"_57":139,"_59":-5,"_61":140,"_63":141,"_65":142,"_67":143,"_69":43,"_70":71},{"_30":111,"_32":112,"_34":88,"_36":113,"_38":114,"_40":115,"_42":92,"_44":116,"_45":117,"_47":92,"_48":118,"_49":50,"_51":119,"_53":120,"_55":121,"_57":122,"_59":-5,"_61":123,"_63":124,"_65":125,"_67":126,"_69":43,"_70":71},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":91,"_42":92,"_44":93,"_45":94,"_47":95,"_48":96,"_49":52,"_51":97,"_53":98,"_55":99,"_57":100,"_59":-5,"_61":101,"_63":102,"_65":103,"_67":104,"_69":43,"_70":71},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":43,"_70":71},"id","482","name","Pan-Africanism","type","period","startDescription","This movement aimed to unify African nations and peoples, promoting solidarity and political independence across the continent.","endDescription","While it faced challenges, the movement significantly influenced decolonization efforts and continues to inspire unity among Africans today.","startYear",1900,"startMonth",0,"startDay","endYear",2000,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/a/ab/Flag_of_the_UNIA.svg/330px-Flag_of_the_UNIA.svg.png","imageCredit","Unknown author / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/Pan-Africanism","cdnId","images/fdce2595bba037a399961b5633a3e8eb36db8c1a.webp","country",{"_32":84,"_85":84},"subjects",[78,79],"group",{"_32":75,"_76":77},"user",{"_30":72,"_73":74},"likes","liked",false,"6","username","HistOracle","Black History","icon","GiFist",{"_30":82,"_32":83},{"_30":80,"_32":81},"3","culture","2","politics","Global","continent","1666","Bessie Coleman","person","The first African American woman to hold a pilot's license, she was a pioneering aviator and advocate for racial and gender equality.","Her legacy inspires future generations of aviators and advocates for diversity in aviation.",1892,1,26,1926,4,30,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/33/Bessie_Coleman_in_1923.jpg/330px-Bessie_Coleman_in_1923.jpg","Image: Bessie Coleman / Wikimedia Commons","https://en.wikipedia.org/wiki/Bessie_Coleman",{"_32":109,"_85":110},[105,106],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":107,"_32":108},{"_30":80,"_32":81},"1","military","United States of America","NorthAmerica","1667","Zora Neale Hurston","A key figure of the Harlem Renaissance, she was an author and anthropologist known for her contributions to African American literature.","Her works, particularly 'Their Eyes Were Watching God', continue to be celebrated for their rich portrayal of Black culture.",1891,7,1960,28,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Hurston%2C_Zora_Neale_4_%28cropped%29.jpg/330px-Hurston%2C_Zora_Neale_4_%28cropped%29.jpg","Image: Zora Neale Hurston / Wikimedia Commons","https://en.wikipedia.org/wiki/Zora_Neale_Hurston",{"_32":109,"_85":110},[127,128],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":80,"_32":81},{"_30":129,"_32":130},"9","art","1081","Development of Jazz Music","Jazz emerged as a unique genre, blending African rhythms with European musical traditions, primarily in the United States.","Jazz continued to evolve, influencing various music styles and becoming a significant cultural movement worldwide.",1890,1970,0.9,"","https://en.wikipedia.org/wiki/Jazz",{"_32":109,"_85":110},[146],{"_32":75,"_76":77},{"_30":144,"_73":145},"7","Kushim",{"_30":129,"_32":130},"495","Congo Free State","This state was established as a personal possession of King Leopold II of Belgium, marked by severe exploitation and atrocities.","The state was eventually annexed by Belgium, leading to significant changes in governance and colonial policies.",1885,1908,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7c/Flag_of_the_Congo_Free_State.svg/330px-Flag_of_the_Congo_Free_State.svg.png","https://en.wikipedia.org/wiki/Congo_Free_State","images/50452e13dc24deeef1efab40b74e30984071eb71.webp",{"_32":161,"_85":162},[160],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"Democratic Republic of the Congo","Africa","493","Scramble for Africa","event","This period saw European powers rapidly colonizing Africa, leading to significant political and social changes across the continent.","The consequences of this scramble have had lasting effects on African nations and their development.",1881,1914,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e7/African-civilizations-map-pre-colonial.svg/330px-African-civilizations-map-pre-colonial.svg.png","Jeff Israel / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Scramble_for_Africa","images/73ba9789d1dd05bba1903917a8cc6dafd5172917.webp",{"_32":84,"_85":84},[178],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"1570","Jim Crow Laws","A series of state and local laws that enforced racial segregation in the Southern United States, institutionalizing a system of discrimination.","The legal framework of segregation was dismantled through civil rights legislation, leading to the end of institutionalized racial discrimination.",1877,1965,"Image: Jim Crow laws / Wikimedia Commons","https://en.wikipedia.org/wiki/Jim_Crow_laws",{"_32":109,"_85":110},[191],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},"1665","W.E.B. Du Bois","An influential sociologist, historian, and civil rights activist who co-founded the NAACP and advocated for African American rights.","His legacy continues to influence civil rights movements and academic discourse on race and equality.",1868,2,23,1963,8,27,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d3/W.E.B._Du_Bois_by_James_E._Purdy%2C_1907.jpg/330px-W.E.B._Du_Bois_by_James_E._Purdy%2C_1907.jpg","Image: W. E. B. Du Bois / Wikimedia Commons","https://en.wikipedia.org/wiki/W._E._B._Du_Bois",{"_32":109,"_85":110},[209,210],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":211,"_32":212},"4","intellectual","570","The Reconstruction Era","This period followed the Civil War, focusing on rebuilding the South and integrating formerly enslaved people into society.","Reconstruction ended with the withdrawal of federal troops, leading to the establishment of Jim Crow laws and systemic racial segregation.",1865,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/78/ReconstructionEraColl.png/330px-ReconstructionEraColl.png","Excel23 / Wikimedia Commons / CC0","https://en.wikipedia.org/wiki/Reconstruction_era","images/78104b88968800308308d694d08e6399c98aa791.webp",{"_32":109,"_85":110},[226,227],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":80,"_32":81},"1668","George Washington Carver","A prominent agricultural scientist and inventor known for his work with peanuts and crop rotation.","His contributions significantly advanced agricultural practices and improved the livelihoods of many farmers.",1864,1943,5,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/George_Washington_Carver_c1910_-_Restoration.jpg/330px-George_Washington_Carver_c1910_-_Restoration.jpg","Image: George Washington Carver / Wikimedia Commons","https://en.wikipedia.org/wiki/George_Washington_Carver",{"_32":109,"_85":110},[243,244],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":211,"_32":212},{"_30":245,"_32":246},"8","economic","545","The Emancipation Proclamation","An executive order issued during the Civil War that declared the freedom of all enslaved people in Confederate-held territory.","This proclamation marked a significant turning point in the fight against slavery in the United States.",1863,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ec/Hand_colored_Emancipation_The_Past_and_the_Future_by_Thomas_Nast.jpg/330px-Hand_colored_Emancipation_The_Past_and_the_Future_by_Thomas_Nast.jpg","Thomas Nast / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Emancipation_Proclamation","images/140b545a82731b7c38c6c981991619519fc87119.webp",{"_32":109,"_85":110},[260,261],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":80,"_32":81},"532","American Civil War","A conflict between the Northern states and the Southern states of the United States, primarily over slavery and states' rights.","The war concluded with the defeat of the Confederacy, leading to the abolition of slavery and significant changes in American society.",1861,12,9,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/Battle_of_Gettysburg%2C_by_Currier_and_Ives.png/330px-Battle_of_Gettysburg%2C_by_Currier_and_Ives.png","Licensing . / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/American_Civil_War","images/fe3e11cc046e3e4908a0b366a84b1ad4236cbc35.webp",{"_32":109,"_85":110},[277,278],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":80,"_32":81},"874","Harriet Tubman","An abolitionist and political activist, she escaped slavery and became a leading figure in the Underground Railroad.","Her efforts helped many enslaved people reach freedom, and she became a symbol of courage and resistance.",1822,1913,3,10,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/%28Portrait_of_Harriet_Tubman%29_%28LOC%29_%2838899564300%29_%28cropped_3x4%29.jpg/330px-%28Portrait_of_Harriet_Tubman%29_%28LOC%29_%2838899564300%29_%28cropped_3x4%29.jpg","Image: Harriet Tubman / Wikimedia Commons","https://en.wikipedia.org/wiki/Harriet_Tubman",{"_32":109,"_85":110},[295,296],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":82,"_32":83},{"_30":80,"_32":81},"1162","Transatlantic Slave Trade","This period marked the forced transportation of millions of Africans to the Americas, fundamentally altering societies and economies across continents.","The trade officially ended in the late 19th century, leading to significant social and political changes in both Africa and the Americas.",1500,1866,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/16/Slave_Auction_Ad.jpg/330px-Slave_Auction_Ad.jpg","Image: Atlantic slave trade / Wikimedia Commons","https://en.wikipedia.org/wiki/Transatlantic_slave_trade",{"_32":84,"_85":84},[310],{"_32":75,"_76":77},{"_30":72,"_73":74},{"_30":80,"_32":81},"14","Gregory Shithouse","asdfasdfasdfasdfsadf",199,{"_32":162,"_85":162},[319],{"_32":75,"_76":77},{"_30":144,"_73":145},{"_30":129,"_32":130},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,41]
