"_42":43,"_44":43,"_45":189,"_47":43,"_48":43,"_49":112,"_51":113,"_53":190,"_55":191,"_57":192,"_59":-5,"_60":193,"_62":194,"_64":195,"_66":196,"_68":43,"_69":70},{"_30":170,"_32":171,"_34":88,"_36":172,"_38":173,"_40":174,"_42":43,"_44":43,"_45":163,"_47":43,"_48":43,"_49":113,"_51":175,"_53":148,"_55":-5,"_57":176,"_59":-5,"_60":177,"_62":178,"_64":179,"_66":180,"_68":43,"_69":70},{"_30":158,"_32":159,"_34":88,"_36":160,"_38":161,"_40":162,"_42":43,"_44":43,"_45":163,"_47":43,"_48":43,"_49":50,"_51":113,"_53":148,"_55":-5,"_57":164,"_59":-5,"_60":165,"_62":166,"_64":167,"_66":168,"_68":43,"_69":70},{"_30":142,"_32":143,"_34":88,"_36":144,"_38":145,"_40":146,"_42":43,"_44":43,"_45":147,"_47":43,"_48":43,"_49":50,"_51":113,"_53":148,"_55":149,"_57":150,"_59":-5,"_60":151,"_62":152,"_64":153,"_66":154,"_68":43,"_69":70},{"_30":123,"_32":124,"_34":35,"_36":125,"_38":126,"_40":127,"_42":43,"_44":43,"_45":128,"_47":43,"_48":43,"_49":129,"_51":50,"_53":130,"_55":131,"_57":132,"_59":-5,"_60":133,"_62":134,"_64":135,"_66":136,"_68":43,"_69":70},{"_30":106,"_32":107,"_34":35,"_36":108,"_38":109,"_40":110,"_42":43,"_44":43,"_45":111,"_47":43,"_48":43,"_49":112,"_51":113,"_53":114,"_55":115,"_57":116,"_59":-5,"_60":117,"_62":118,"_64":119,"_66":120,"_68":43,"_69":70},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":91,"_42":43,"_44":43,"_45":92,"_47":43,"_48":43,"_49":50,"_51":52,"_53":93,"_55":94,"_57":95,"_59":-5,"_60":96,"_62":97,"_64":98,"_66":99,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","1706","name","Raja Ali Haji","type","person","startDescription","An influential Malay scholar and poet, known for his contributions to literature and the development of the Malay language.","endDescription","His works continue to be celebrated in Malay literature, influencing future generations of writers.","startYear",1808,"startMonth",0,"startDay","endYear",1873,"endMonth","endDay","startSignificance",0.7,"endSignificance",0.5,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/1/14/Raja_Ali_Haji.jpg/330px-Raja_Ali_Haji.jpg","imageCredit","Image: Raja Ali Haji / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Raja_Ali_Haji","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Colonial Southeast Asia","icon","GiAnchor",{"_30":81,"_32":82},{"_30":79,"_32":80},"4","intellectual","3","culture","Indonesia","continent","Asia","1695","Batavian Revolution","event","This event marked the overthrow of the Dutch colonial government in Batavia, leading to the establishment of a new political order influenced by revolutionary ideals.","The revolution concluded with the restoration of Dutch control, but it left a lasting impact on the region's political landscape.",1795,1806,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Krayenhoff_Daendels_1795.jpeg/330px-Krayenhoff_Daendels_1795.jpeg","Image: Batavian Revolution / Wikimedia Commons","https://en.wikipedia.org/wiki/Batavian_Revolution",{"_32":83,"_84":85},[100,101],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"2","politics","1","military","1700","Pangeran Diponegoro","A Javanese prince and national hero known for leading a major revolt against Dutch colonial rule in the early 19th century.","His resistance efforts became a symbol of Indonesian nationalism and anti-colonial struggle.",1785,1855,0.8,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Diponegoro.jpg/330px-Diponegoro.jpg","Image: Diponegoro / Wikimedia Commons","https://en.wikipedia.org/wiki/Pangeran_Diponegoro",{"_32":83,"_84":85},[121,122],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"1699","Thomas Stamford Raffles","A British statesman and Lieutenant Governor of Java, known for founding Singapore and his interest in the region's natural history.","His legacy includes the establishment of Singapore as a major trading port and his contributions to British colonial policy.",1781,1826,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a0/George_Francis_Joseph_-_Sir_Thomas_Stamford_Bingley_Raffles.jpg/330px-George_Francis_Joseph_-_Sir_Thomas_Stamford_Bingley_Raffles.jpg","Image: Stamford Raffles / Wikimedia Commons","https://en.wikipedia.org/wiki/Thomas_Stamford_Raffles",{"_32":141,"_84":85},[137,138],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":139,"_32":140},"8","economic","Singapore","1611","Burmese–Siamese War","A series of conflicts between two neighboring kingdoms that shaped the regional power dynamics in Southeast Asia.","The war concluded with a treaty that established borders and influenced future relations between the two states.",1775,1782,"","Image: Burmese–Siamese wars / Wikimedia Commons","https://en.wikipedia.org/wiki/Burmese%E2%80%93Siamese_War",{"_32":157,"_84":85},[155,156],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"Myanmar","1694","Battle of Batavia","A significant military confrontation took place in Batavia, where forces clashed over control of the region, marking a pivotal moment in colonial power struggles.","The battle concluded with a decisive victory, solidifying the dominance of one faction in the area and altering the balance of power in Southeast Asia.",1628,1629,"https://en.wikipedia.org/wiki/Battle_of_Batavia",{"_32":83,"_84":85},[169],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},"1717","Siamese–Portuguese War","The conflict between the Kingdom of Siam and Portuguese colonial forces arose from trade disputes and territorial ambitions in the region.","The war concluded with a peace treaty, allowing for continued trade but marking a decline in Portuguese influence in Southeast Asia.",1624,0.4,"https://en.wikipedia.org/wiki/Siamese%E2%80%93Portuguese_War",{"_32":183,"_84":85},[181,182],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":139,"_32":140},"Thailand","1703","Sultan Iskandar Muda","A prominent ruler of the Aceh Sultanate, known for his military conquests and cultural patronage during the early 17th century.","His reign marked the peak of Aceh's power, but after his death, the sultanate began to decline.",1607,1636,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ee/Lukisan_Iskandar_muda.jpg/327px-Lukisan_Iskandar_muda.jpg","Image: Iskandar Muda / Wikimedia Commons","https://en.wikipedia.org/wiki/Sultan_Iskandar_Muda",{"_32":83,"_84":85},[197,198],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":81,"_32":82},"1716","Dutch–Ming Trade Relations","The establishment of trade relations between the Dutch East India Company and the Ming dynasty marked a significant shift in commercial dynamics in Southeast Asia.","These relations concluded with the fall of the Ming dynasty, leading to a new era of trade under the Qing dynasty.",1602,1662,"https://en.wikipedia.org/wiki/Dutch%E2%80%93Ming_trade_relations",{"_32":83,"_84":85},[210],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":139,"_32":140},"1691","Dutch East India Company","period","This entity was established to manage trade and colonial activities in Asia, particularly in the spice trade.","The company was dissolved, leading to the transfer of its assets and responsibilities to the Dutch government.",1799,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/Flag_of_the_Dutch_East_India_Company.svg/330px-Flag_of_the_Dutch_East_India_Company.svg.png","Image: Dutch East India Company / Wikimedia Commons","https://en.wikipedia.org/wiki/Dutch_East_India_Company",{"_32":225,"_84":226},[224],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":139,"_32":140},"Netherlands","Europe","1698","Sultan Agung","A prominent ruler of the Mataram Sultanate known for his military campaigns and efforts to expand his territory in Java.","His reign marked the peak of Mataram's power, but after his death, the sultanate faced internal strife and decline.",1593,1645,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Anyakrakusuma_of_Mataram.jpg/330px-Anyakrakusuma_of_Mataram.jpg","Image: Sultan Agung of Mataram / Wikimedia Commons","https://en.wikipedia.org/wiki/Sultan_Agung",{"_32":83,"_84":85},[240,241],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"1602","Spanish–Moro Wars","A series of conflicts between Spanish colonial forces and Muslim groups in the Philippines.","The wars ended with the cession of the Philippines to the United States, altering the region's political landscape.",1565,1898,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Christian_Filipinos_under_Spanish_army_in_Mindanao_in_their_battle_against_the_Moro_Muslim%2C_circa_1887.jpg/330px-Christian_Filipinos_under_Spanish_army_in_Mindanao_in_their_battle_against_the_Moro_Muslim%2C_circa_1887.jpg","Image: Spanish–Moro conflict / Wikimedia Commons","https://en.wikipedia.org/wiki/Spanish%E2%80%93Moro_Wars",{"_32":257,"_84":85},[255,256],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},{"_30":102,"_32":103},"Philippines","1704","Sultan Alauddin Riayat Shah II","The Sultan of Malacca known for his efforts to strengthen the sultanate's power and influence during the 16th century.","His reign was marked by internal strife and external threats, leading to the eventual decline of Malacca.",1555,1571,"Image: Alauddin Riayat Shah II of Johor / Wikimedia Commons","https://en.wikipedia.org/wiki/Sultan_Alauddin_Riayat_Shah_II",{"_32":272,"_84":85},[270,271],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":81,"_32":82},"Malaysia","1719","Battle of Malacca","A significant military engagement that marked the Portuguese conquest of a vital trading port in Southeast Asia.","The battle concluded with the Portuguese establishing control over the region, altering trade routes and power dynamics in Southeast Asia.",1511,"Image: Battle of Malacca / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Malacca",{"_32":272,"_84":85},[284],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":104,"_32":105},"1608","Aceh Sultanate","A powerful Islamic sultanate that played a key role in trade and politics in the region.","The sultanate's fall marked the end of significant local resistance against colonial powers.",1496,1903,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/Flag_of_Aceh_Sultanate.svg/330px-Flag_of_Aceh_Sultanate.svg.png","Image: Aceh Sultanate / Wikimedia Commons","https://en.wikipedia.org/wiki/Aceh_Sultanate",{"_32":83,"_84":85},[298,299],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":139,"_32":140},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,37]
