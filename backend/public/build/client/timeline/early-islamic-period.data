40":190,"_42":191,"_44":192,"_45":190,"_46":191,"_47":192,"_48":88,"_50":193,"_51":194,"_53":195,"_55":196,"_57":-5,"_58":197,"_60":198,"_62":199,"_64":200,"_66":43,"_67":68},{"_30":170,"_32":171,"_34":83,"_36":172,"_38":173,"_40":174,"_42":43,"_44":43,"_45":175,"_46":43,"_47":43,"_48":108,"_50":88,"_51":176,"_53":177,"_55":178,"_57":-5,"_58":179,"_60":180,"_62":181,"_64":182,"_66":43,"_67":68},{"_30":155,"_32":156,"_34":35,"_36":157,"_38":158,"_40":159,"_42":43,"_44":43,"_45":159,"_46":43,"_47":43,"_48":49,"_50":49,"_51":160,"_53":161,"_55":162,"_57":-5,"_58":163,"_60":164,"_62":165,"_64":166,"_66":43,"_67":68},{"_30":137,"_32":138,"_34":139,"_36":140,"_38":141,"_40":142,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":49,"_50":108,"_51":143,"_53":144,"_55":145,"_57":-5,"_58":146,"_60":147,"_62":148,"_64":149,"_66":43,"_67":68},{"_30":119,"_32":120,"_34":35,"_36":121,"_38":122,"_40":123,"_42":43,"_44":43,"_45":124,"_46":43,"_47":43,"_48":108,"_50":88,"_51":125,"_53":126,"_55":127,"_57":-5,"_58":128,"_60":129,"_62":130,"_64":131,"_66":43,"_67":68},{"_30":102,"_32":103,"_34":35,"_36":104,"_38":105,"_40":106,"_42":107,"_44":107,"_45":106,"_46":107,"_47":107,"_48":108,"_50":108,"_51":109,"_53":110,"_55":111,"_57":-5,"_58":112,"_60":113,"_62":114,"_64":115,"_66":43,"_67":68},{"_30":81,"_32":82,"_34":83,"_36":84,"_38":85,"_40":86,"_42":43,"_44":43,"_45":87,"_46":43,"_47":43,"_48":88,"_50":89,"_51":90,"_53":91,"_55":92,"_57":-5,"_58":93,"_60":94,"_62":95,"_64":96,"_66":43,"_67":68},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":41,"_46":43,"_47":43,"_48":49,"_50":49,"_51":52,"_53":54,"_55":56,"_57":-5,"_58":59,"_60":61,"_62":63,"_64":65,"_66":43,"_67":68},"id","1784","name","Battle of Manzikert","type","event","startDescription","A decisive military confrontation that significantly impacted the power dynamics in the region, leading to territorial changes.","endDescription","The battle concluded with a notable victory, reshaping the political landscape of the area.","startYear",1071,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.85,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/5/58/131_Bataille_de_Malazgirt.jpg/330px-131_Bataille_de_Malazgirt.jpg","imageCredit","Image: Battle of Manzikert / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Battle_of_Manzikert","cdnId","country",{"_32":78,"_79":80},"subjects",[75],"group",{"_32":72,"_73":74},"user",{"_30":69,"_70":71},"likes","liked",false,"6","username","HistOracle","Early Islamic Period","icon","GiArabicDoor",{"_30":76,"_32":77},"1","military","Turkey","continent","MiddleEast","2259","Almoravid Empire","period","The Almoravid Empire was a Berber Muslim empire in North Africa and Iberia that promoted Islamic learning, culture, and military expansion.","It collapsed due to internal dissent and the rise of the Almohads.",1040,1147,0.8,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Almoravid_Empire_map.png/330px-Almoravid_Empire_map.png","Image: Almoravid Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Almoravid_dynasty",{"_32":100,"_79":101},[97],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},"3","culture","Morocco","Africa","1778","Battle of Tours","A significant military engagement where forces clashed, marking a pivotal moment in the expansion of a religious and cultural influence.","The battle concluded with a decisive victory, halting the advance of forces into new territories.",732,10,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e7/Steuben_-_Bataille_de_Poitiers.png/330px-Steuben_-_Bataille_de_Poitiers.png","Image: Battle of Tours / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Tours",{"_32":117,"_79":118},[116],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},"France","Europe","1275","Muslim Conquest of the Iberian Peninsula","A significant military campaign that led to the establishment of Muslim rule over a large part of the Iberian Peninsula, marking a pivotal moment in European history.","The conquest concluded with the consolidation of Muslim territories, leading to the formation of the Umayyad Emirate of Córdoba.",711,726,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/66/Conquistaislamicapeninsula2.svg/330px-Conquistaislamicapeninsula2.svg.png","Image: Muslim conquest of the Iberian Peninsula / Wikimedia Commons","https://en.wikipedia.org/wiki/Muslim_conquest_of_the_Iberian_Peninsula",{"_32":136,"_79":118},[132,133],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},{"_30":134,"_32":135},"2","politics","Spain","1722","The Umayyad Mosque","landmark","This grand mosque, located in Damascus, is one of the oldest and largest mosques in the world, showcasing early Islamic architecture.","The mosque remains a significant religious site and a symbol of Islamic heritage.",705,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d5/Umayyad_Mosque%2C_Damascus.jpg/330px-Umayyad_Mosque%2C_Damascus.jpg","Image: Umayyad Mosque / Wikimedia Commons","https://en.wikipedia.org/wiki/Umayyad_Mosque",{"_32":154,"_79":80},[150,151],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":98,"_32":99},{"_30":152,"_32":153},"7","religion","Syria","1781","Siege of Jerusalem","A critical military operation that resulted in the capture of a significant religious city, altering the political landscape of the region.","The siege concluded successfully, establishing control over a key area of religious importance.",637,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2c/Mohammad_adil-Muslim_invasion_of_Syria-4.PNG/330px-Mohammad_adil-Muslim_invasion_of_Syria-4.PNG","Image: First Muslim conquest of Jerusalem / Wikimedia Commons","https://en.wikipedia.org/wiki/Siege_of_Jerusalem_(637)",{"_32":169,"_79":80},[167,168],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},{"_30":152,"_32":153},"Israel","998","The Rashidun Caliphate","This period marks the first phase of Islamic governance following the death of the Prophet Muhammad, characterized by rapid expansion and consolidation of power.","The period concluded with the establishment of the Umayyad Caliphate, marking a significant shift in Islamic leadership and governance.",632,661,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Rashidun_Caliphate.svg/330px-Rashidun_Caliphate.svg.png","Image: Rashidun Caliphate / Wikimedia Commons","https://en.wikipedia.org/wiki/Rashidun_Caliphate",{"_32":185,"_79":80},[183,184],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},"Iraq","1721","The Battle of Uhud","This significant battle was fought between the early Muslims and the Quraysh tribe, marking a crucial moment in the early Islamic military history.","The battle concluded with a tactical defeat for the Muslims, impacting their morale and strategies in subsequent conflicts.",625,3,19,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/99/The_Prophet_Muhammad_and_the_Muslim_Army_at_the_Battle_of_Uhud%2C_from_the_Siyer-i_Nebi%2C_1595.jpg/330px-The_Prophet_Muhammad_and_the_Muslim_Army_at_the_Battle_of_Uhud%2C_from_the_Siyer-i_Nebi%2C_1595.jpg","Image: Battle of Uhud / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Uhud",{"_32":202,"_79":80},[201],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},"Saudi Arabia","1009","The Battle of Badr","This pivotal battle marked the first major confrontation between the early Muslims and the Quraysh tribe, shaping the future of the Islamic community.","The battle concluded with a decisive victory for the Muslims, boosting their morale and solidifying their position in Medina.",624,13,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4d/Siyer-i_Nebi_-_Imam_Ali_und_Hamza_bei_dem_vorgezogenen_Einzelkampf_in_Badr_gegen_die_G%C3%B6tzendiener.jpg/330px-Siyer-i_Nebi_-_Imam_Ali_und_Hamza_bei_dem_vorgezogenen_Einzelkampf_in_Badr_gegen_die_G%C3%B6tzendiener.jpg","Image: Battle of Badr / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Badr",{"_32":202,"_79":80},[216,217],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},{"_30":152,"_32":153},"1720","The Constitution of Medina","This foundational document established a multi-religious Islamic state in Medina, outlining the rights and duties of all citizens.","The constitution laid the groundwork for governance and inter-community relations in the early Muslim community.",622,"","Image: Constitution of Medina / Wikimedia Commons","https://en.wikipedia.org/wiki/Constitution_of_Medina",{"_32":202,"_79":80},[230,231],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},"1023","The Quran","This period marks the revelation of a significant religious text, which is considered the word of God in Islam, delivered to the Prophet Muhammad over 23 years.","The period concludes with the death of the Prophet Muhammad, after which the text's teachings continued to shape a major world religion.",610,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/Birmingham_Quran_manuscript_full.jpg/330px-Birmingham_Quran_manuscript_full.jpg","Image: Quran / Wikimedia Commons","https://en.wikipedia.org/wiki/Quran",{"_32":202,"_79":80},[246],{"_32":72,"_73":74},{"_30":152,"_70":245},"Kushim",{"_30":152,"_32":153},"57","The Rise of Islam","Islam emerged in the 7th century, rapidly spreading across the Arabian Peninsula and beyond.","The period saw the establishment of a caliphate that significantly influenced world history.","https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Map_of_expansion_of_Caliphate.svg/330px-Map_of_expansion_of_Caliphate.svg.png","DieBuche / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Rise_of_Islam","images/d512d51ac58836e05d5719e05b6e85e03b94cdcc.webp",{"_32":202,"_79":80},[259,260],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},"892","Ali ibn Abi Talib","person","A prominent figure in early Islamic history, known for his close relationship with the Prophet and his role in the development of the Islamic community. He was the first male to convert to Islam and served as a key supporter and advisor.","His assassination marked a significant turning point in Islamic history, leading to the division between Sunni and Shia Islam and shaping the future of the Muslim world.",600,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cc/Istanbul_-_Santa_Sofia_-_Medall%C3%B3_%28cropped%29.JPG/330px-Istanbul_-_Santa_Sofia_-_Medall%C3%B3_%28cropped%29.JPG","Image: Ali / Wikimedia Commons","https://en.wikipedia.org/wiki/Ali",{"_32":185,"_79":80},[274,275],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},"891","Abu Bakr","A prominent companion and father-in-law of a significant religious leader, he played a crucial role in the early development of a major world religion.","His leadership marked the beginning of the caliphate and the expansion of the religious community after the death of his companion.",573,634,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c3/20131203_Istanbul_091.jpg/330px-20131203_Istanbul_091.jpg","Image: Abu Bakr / Wikimedia Commons","https://en.wikipedia.org/wiki/Abu_Bakr",{"_32":202,"_79":80},[289,290],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},"888","Muhammad","A significant religious and political leader, he is regarded as the founder of Islam and is believed to be the last prophet in a long line of prophets. His teachings and revelations form the basis of the Islamic faith.","His death marked the end of his earthly life, but his teachings continued to spread rapidly, leading to the establishment of a major world religion.",570,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Dark_vignette_Al-Masjid_AL-Nabawi_Door800x600x300_%28cropped%29.jpg/330px-Dark_vignette_Al-Masjid_AL-Nabawi_Door800x600x300_%28cropped%29.jpg","Image: Muhammad / Wikimedia Commons","https://en.wikipedia.org/wiki/Muhammad",{"_32":202,"_79":80},[303,304],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":134,"_32":135},{"_30":152,"_32":153},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,23]
