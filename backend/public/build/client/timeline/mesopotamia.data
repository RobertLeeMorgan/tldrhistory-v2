":190,"_42":43,"_44":43,"_45":191,"_47":43,"_48":43,"_49":192,"_51":175,"_53":193,"_55":194,"_57":195,"_59":196,"_60":197,"_62":198,"_64":199,"_66":200,"_68":43,"_69":70},{"_30":170,"_32":171,"_34":141,"_36":172,"_38":173,"_40":174,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":175,"_51":43,"_53":176,"_55":177,"_57":178,"_59":-5,"_60":179,"_62":180,"_64":181,"_66":182,"_68":43,"_69":70},{"_30":153,"_32":154,"_34":122,"_36":155,"_38":156,"_40":157,"_42":43,"_44":43,"_45":158,"_47":43,"_48":43,"_49":159,"_51":144,"_53":160,"_55":161,"_57":162,"_59":-5,"_60":163,"_62":164,"_64":165,"_66":166,"_68":43,"_69":70},{"_30":139,"_32":140,"_34":141,"_36":142,"_38":143,"_40":125,"_42":43,"_44":43,"_45":126,"_47":43,"_48":43,"_49":89,"_51":144,"_53":145,"_55":146,"_57":147,"_59":-5,"_60":148,"_62":149,"_64":150,"_66":151,"_68":43,"_69":70},{"_30":120,"_32":121,"_34":122,"_36":123,"_38":124,"_40":125,"_42":43,"_44":43,"_45":126,"_47":43,"_48":43,"_49":50,"_51":127,"_53":128,"_55":129,"_57":130,"_59":-5,"_60":131,"_62":132,"_64":133,"_66":134,"_68":43,"_69":70},{"_30":101,"_32":102,"_34":35,"_36":103,"_38":104,"_40":105,"_42":43,"_44":43,"_45":106,"_47":43,"_48":43,"_49":50,"_51":107,"_53":108,"_55":109,"_57":110,"_59":111,"_60":112,"_62":113,"_64":114,"_66":115,"_68":43,"_69":70},{"_30":83,"_32":84,"_34":85,"_36":86,"_38":87,"_40":41,"_42":43,"_44":43,"_45":88,"_47":43,"_48":43,"_49":50,"_51":89,"_53":90,"_55":91,"_57":92,"_59":-5,"_60":93,"_62":94,"_64":95,"_66":96,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","2228","name","Neo-Sumerian Empire","type","period","startDescription","The Neo-Sumerian Empire, also identified with the Third Dynasty of Ur, represented a period when Sumerian states reasserted control in Mesopotamia following the Akkadian Empire.","endDescription","This period ended as external pressures and internal decline ushered in the ascendancy of other Mesopotamian powers like Isin and Larsa.","startYear",-2112,"startMonth",0,"startDay","endYear",-2004,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.6,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Ur_III_Empire_map.png/330px-Ur_III_Empire_map.png","imageCredit","Image: Neo-Sumerian Empire / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Neo-Sumerian_Empire","cdnId","country",{"_32":80,"_81":82},"subjects",[77],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Mesopotamia","icon","GiScrollUnfurled",{"_30":78,"_32":79},"3","culture","Iraq","continent","MiddleEast","1496","Ur-Nammu","person","A prominent ruler known for establishing one of the earliest known legal codes and for significant contributions to architecture and urban development.","His reign marked the end of a significant dynasty, but his legal reforms influenced future generations.",-2095,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/ab/King_Ur-Nammu.jpg/330px-King_Ur-Nammu.jpg","Image: Ur-Nammu / Wikimedia Commons","https://en.wikipedia.org/wiki/Ur-Nammu",{"_32":80,"_81":82},[97,98],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":99,"_32":100},{"_30":78,"_32":79},"2","politics","40","Akkadian Empire","This empire is recognized as one of the first empires in history, known for its military conquests and administrative innovations.","The empire eventually fell due to internal strife and external pressures, leading to the fragmentation of Mesopotamia.",-2334,-2154,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/Empire_akkad.svg/330px-Empire_akkad.svg.png","Sémhur / Zunkir / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Akkadian_Empire","images/28df43c9dca8b60b54f1e423bae7f5170dec43c0.webp",{"_32":80,"_81":82},[116,117],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":118,"_32":119},{"_30":99,"_32":100},"1","military","1804","Lagash","landmark","An ancient Sumerian city-state known for its contributions to art, architecture, and governance.","Lagash's influence waned over time, but it remains a significant site for understanding early civilization.",-2500,-2000,0.4,"","Image: Lagash / Wikimedia Commons","https://en.wikipedia.org/wiki/Lagash",{"_32":80,"_81":82},[137,138],{"_32":74,"_75":76},{"_30":135,"_72":136},"7","Kushim",{"_30":99,"_32":100},{"_30":78,"_32":79},"1126","Lyre of Ur","event","The Lyre of Ur is an ancient stringed instrument discovered in the Royal Cemetery of Ur, reflecting the musical traditions of early Mesopotamia.","The lyre fell out of use as musical tastes evolved, but it remains a significant artifact of ancient music history.",0.3,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/00/The_Queen%27s_gold_lyre_from_the_Royal_Cemetery_at_Ur._C._2500_BCE._Iraq_Museum.jpg/330px-The_Queen%27s_gold_lyre_from_the_Royal_Cemetery_at_Ur._C._2500_BCE._Iraq_Museum.jpg","Image: Lyres of Ur / Wikimedia Commons","https://en.wikipedia.org/wiki/Lyre_of_Ur",{"_32":80,"_81":82},[152],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"1805","Nippur","A significant religious center in ancient Mesopotamia, known for its temple dedicated to the god Enlil.","The site eventually lost its prominence, yet it played a crucial role in the religious life of the region.",-2900,-539,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Ruins_from_a_temple_in_Naffur.jpg/330px-Ruins_from_a_temple_in_Naffur.jpg","Image: Nippur / Wikimedia Commons","https://en.wikipedia.org/wiki/Nippur",{"_32":80,"_81":82},[167,168],{"_32":74,"_75":76},{"_30":135,"_72":136},{"_30":78,"_32":79},{"_30":135,"_32":169},"religion","1222","Invention of Money","The inception of money in Mesopotamia marked a pivotal shift in human economic practices, transitioning from barter systems to a standardized medium of exchange; often in the form of silver pieces or barley.","This innovation laid the groundwork for complex economies and trade systems that would evolve over millennia.",-3000,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Euro_coins_and_banknotes_%28cropped%29.jpg/330px-Euro_coins_and_banknotes_%28cropped%29.jpg","Image: Money / Wikimedia Commons","https://en.wikipedia.org/wiki/Money",{"_32":80,"_81":82},[183],{"_32":74,"_75":76},{"_30":135,"_72":136},{"_30":184,"_32":185},"8","economic","51","The Rise of Writing Systems","The invention of cuneiform in Mesopotamia marked a revolutionary advancement in communication and record-keeping.","This event laid the foundation for future civilizations to develop complex administrative and literary traditions.",-3200,-3100,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/Rosetta_Stone.JPG/330px-Rosetta_Stone.JPG","Hans Hillewaert / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Writing","images/787253fa51455c8ebe7522068c8f26c459eab290.webp",{"_32":80,"_81":82},[201,202],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},{"_30":203,"_32":204},"4","intellectual","1799","Pantheon of Sumerian Gods","The Sumerian pantheon consists of numerous deities, each representing various aspects of life and nature.","These gods played a central role in Sumerian religion and culture, influencing later civilizations.",-3500,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8c/Wall_plaque_showing_libation_scene_from_Ur%2C_Iraq%2C_2500_BCE._British_Museum_%28adjusted_for_perspective%29.jpg/330px-Wall_plaque_showing_libation_scene_from_Ur%2C_Iraq%2C_2500_BCE._British_Museum_%28adjusted_for_perspective%29.jpg","Image: Sumerian religion / Wikimedia Commons","https://en.wikipedia.org/wiki/Sumerian_religion",{"_32":80,"_81":82},[217],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":135,"_32":169},"53","The Construction of Ziggurats","These massive structures served as temples and administrative centers, symbolizing the religious and political power of city-states.","Ziggurats became iconic representations of Mesopotamian civilization and its architectural ingenuity.","https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/White_Temple_ziggurat_in_Uruk.jpg/330px-White_Temple_ziggurat_in_Uruk.jpg","tobeytravels / Wikimedia Commons / CC BY-SA 2.0","https://en.wikipedia.org/wiki/Ziggurat","images/da697d38bac8fbc422f3830df7d3a4294346babe.webp",{"_32":80,"_81":82},[230,231],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},{"_30":135,"_32":169},"50","Early Mesopotamian City-States","This period marked the rise of urban centers in Mesopotamia, characterized by the development of writing, trade, and centralized governance.","The period transitioned into the dominance of larger empires, leading to further advancements in culture and politics.","https://upload.wikimedia.org/wikipedia/commons/thumb/e/ed/N-Mesopotamia_and_Syria_english.svg/330px-N-Mesopotamia_and_Syria_english.svg.png","Goran tek-en / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/History_of_Mesopotamia","images/8720f35fd249831080a220de8abbff2be83bec84.webp",{"_32":80,"_81":82},[244,245],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":99,"_32":100},{"_30":78,"_32":79},"31","Sumerian Civilization","This period marks the rise of one of the world's first urban civilizations, characterized by the development of writing, architecture, and complex societal structures.","The civilization gradually declined due to invasions and environmental changes, leading to the rise of other cultures in the region.","https://upload.wikimedia.org/wikipedia/commons/thumb/0/02/Sumer_satellite_map.jpg/330px-Sumer_satellite_map.jpg","NASA / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Sumer","images/dd6fb690569ffe5baaf5543fa36e23bb88eb4526.webp",{"_32":80,"_81":82},[258,259],{"_32":74,"_75":76},{"_30":135,"_72":136},{"_30":99,"_32":100},{"_30":78,"_32":79},"2332","Uruk Culture","A Bronze Age culture in Mesopotamia known for the emergence of the first cities, writing (cuneiform), and monumental architecture.","Transitioned into the Sumerian city-states, solidifying urban civilization and complex administrative systems.",-4000,1,"https://en.wikipedia.org/wiki/File:Uruk_period_map.png","Image: Uruk Culture Map / Wikimedia Commons","https://en.wikipedia.org/wiki/Uruk_period",{"_32":80,"_81":82},[273],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},"1803","Uruk","An ancient city known for its monumental architecture and as a center of early urbanization in Mesopotamia.","The city eventually declined, but its legacy influenced subsequent civilizations in the region.","Image: Uruk / Wikimedia Commons","https://en.wikipedia.org/wiki/Uruk",{"_32":80,"_81":82},[284,285],{"_32":74,"_75":76},{"_30":135,"_72":136},{"_30":78,"_32":79},{"_30":135,"_32":169},"2331","Ubaid Culture","A prehistoric Mesopotamian culture that laid the foundations for urbanization and temple-centered communities.","Evolved into the Uruk culture, leading to the first cities in Sumer and the rise of state-level societies.",-6500,-3800,"https://en.wikipedia.org/wiki/File:Ubaid_period_map.png","Image: Ubaid Culture Map / Wikimedia Commons","https://en.wikipedia.org/wiki/Ubaid_period",{"_32":80,"_81":82},[299],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":78,"_32":79},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,4]
