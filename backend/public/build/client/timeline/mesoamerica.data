0,"_41":40,"_42":139,"_44":40,"_45":40,"_46":105,"_48":125,"_49":140,"_51":141,"_53":142,"_55":-5,"_56":143,"_58":144,"_60":145,"_62":146,"_64":40,"_65":66},{"_27":119,"_29":120,"_31":32,"_33":121,"_35":122,"_37":123,"_39":40,"_41":40,"_42":124,"_44":40,"_45":40,"_46":105,"_48":125,"_49":126,"_51":127,"_53":128,"_55":-5,"_56":129,"_58":130,"_60":131,"_62":132,"_64":40,"_65":66},{"_27":98,"_29":99,"_31":100,"_33":101,"_35":102,"_37":103,"_39":40,"_41":40,"_42":43,"_44":40,"_45":40,"_46":104,"_48":105,"_49":106,"_51":107,"_53":108,"_55":-5,"_56":109,"_58":110,"_60":111,"_62":112,"_64":40,"_65":66},{"_27":82,"_29":83,"_31":32,"_33":84,"_35":85,"_37":86,"_39":40,"_41":40,"_42":43,"_44":40,"_45":40,"_46":87,"_48":88,"_49":89,"_51":90,"_53":91,"_55":-5,"_56":92,"_58":93,"_60":94,"_62":95,"_64":40,"_65":66},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":40,"_45":40,"_46":47,"_48":47,"_49":50,"_51":52,"_53":54,"_55":-5,"_56":57,"_58":59,"_60":61,"_62":63,"_64":40,"_65":66},"id","1374","name","Aztec Empire","type","period","startDescription","A powerful Mesoamerican civilization known for its architectural, agricultural, and military achievements.","endDescription","The empire fell to Spanish conquest, leading to significant cultural and demographic changes.","startYear",1428,"startMonth",0,"startDay","endYear",1521,"endMonth","endDay","startSignificance",0.9,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/d/d2/Aztec_Empire.png/330px-Aztec_Empire.png","imageCredit","Image: Aztecs / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Aztec","cdnId","country",{"_29":79,"_80":81},"subjects",[73,74],"group",{"_29":70,"_71":72},"user",{"_27":67,"_68":69},"likes","liked",false,"6","username","HistOracle","Mesoamerica","icon","GiMayanPyramid",{"_27":77,"_29":78},{"_27":75,"_29":76},"3","culture","1","military","Mexico","continent","NorthAmerica","1384","Jaguar Warriors","Elite military units of the Aztec Empire, renowned for their combat skills and distinctive jaguar-themed attire.","The decline of these warriors coincided with the fall of the Aztec Empire, marking a significant cultural shift.",1400,0.7,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e6/Jaguar_warrior.jpg/330px-Jaguar_warrior.jpg","Image: Jaguar warrior / Wikimedia Commons","https://en.wikipedia.org/wiki/Jaguar_warrior",{"_29":79,"_80":81},[96,97],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":77,"_29":78},{"_27":75,"_29":76},"1640","Tenochtitlan","landmark","Founded on an island in Lake Texcoco, this city became the capital of the Aztec Empire and a major cultural and economic center.","The city was ultimately destroyed during the Spanish conquest, marking a significant turning point in Mesoamerican history.",1325,1,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a1/Painting_of_Tenochtitlan-Tlatelolco_on_Lake_Texcoco_%289755215791%29.jpg/330px-Painting_of_Tenochtitlan-Tlatelolco_on_Lake_Texcoco_%289755215791%29.jpg","Image: Tenochtitlan / Wikimedia Commons","https://en.wikipedia.org/wiki/Tenochtitlan",{"_29":79,"_80":81},[113,114],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":117,"_29":118},{"_27":115,"_29":116},"8","economic","2","politics","2269","Purépecha","The Purépecha were a Mesoamerican civilization in western Mexico, known for their metallurgy, fortified cities, and resistance to the Aztecs.","They were eventually conquered by the Spanish, but the culture survives today.",1300,1522,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e1/Purepecha_map.png/330px-Purepecha_map.png","Image: Purépecha / Wikimedia Commons","https://en.wikipedia.org/wiki/Purépecha",{"_29":79,"_80":81},[133],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},"1517","Toltec Civilization","This period is characterized by the rise of a Mesoamerican culture known for its architectural and artistic achievements, particularly in central Mexico.","The civilization declined, leading to the rise of other cultures in the region, marking the end of its significant influence.",900,1168,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4b/Toltecas.png/330px-Toltecas.png","Image: Toltec / Wikimedia Commons","https://en.wikipedia.org/wiki/Toltec",{"_29":79,"_80":81},[147,148],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":149,"_29":150},"9","art","307","Chichen Itza","This large pre-Columbian archaeological site was a major city of the Maya civilization, known for its pyramid, El Castillo, and astronomical significance.","It is a UNESCO World Heritage Site and continues to be a vital part of Mexico's cultural heritage.",600,1200,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/51/Chichen_Itza_3.jpg/330px-Chichen_Itza_3.jpg","Daniel Schwen / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Chichen_Itza","images/67ec52fcdc6c97f67be3a35185108cfe4f51a813.webp",{"_29":79,"_80":81},[165,166],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":167,"_29":168},"7","religion","1641","Classic Period","This era marks a significant phase in Mesoamerican history characterized by the rise of powerful city-states and advancements in art and architecture.","The period concluded with the decline of major city-states, leading to a shift in cultural and political dynamics across the region.",250,"","https://en.wikipedia.org/wiki/Classic_Mesoamerican",{"_29":79,"_80":81},[180,181],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":149,"_29":150},"69","Maya Civilization","The Maya civilization was known for its advanced writing, art, architecture, and astronomical systems.","The civilization experienced a decline, leading to the abandonment of many cities and a shift in societal structures.","https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Mayamap.png/330px-Mayamap.png","Kmusser / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Maya_civilization","images/bf9caed271e770b189d51e7ee065e2f1c1f2b42c.webp",{"_29":79,"_80":81},[194,195],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":196,"_29":197},"4","intellectual","1519","Teotihuacan","This ancient Mesoamerican city is known for its impressive pyramids and complex urban planning, showcasing the advanced civilization that once thrived there.","The city's decline led to its eventual abandonment, leaving behind a rich archaeological legacy that continues to be studied and admired.",100,750,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/58/Teotihuac%C3%A1n-5973.JPG/330px-Teotihuac%C3%A1n-5973.JPG","Image: Teotihuacan / Wikimedia Commons","https://en.wikipedia.org/wiki/Teotihuacan",{"_29":79,"_80":81},[211,212],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":167,"_29":168},"2268","Zapotec Civilization","The Zapotec Civilization was an indigenous Mesoamerican culture known for its cities, writing system, and monumental architecture.","It declined after the Spanish conquest but the culture persisted in Oaxaca.",-700,0.85,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/66/Zapotec_region_map.png/330px-Zapotec_region_map.png","Image: Zapotec / Wikimedia Commons","https://en.wikipedia.org/wiki/Zapotec_civilization",{"_29":79,"_80":81},[227],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},"36","Olmec Civilization","This civilization is considered the first major civilization in Mexico, known for its colossal head sculptures and influence on later cultures.","The civilization declined, but its cultural practices influenced subsequent Mesoamerican societies.",-1200,-400,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f3/Olmec_Heartland_Overview_4.svg/330px-Olmec_Heartland_Overview_4.svg.png","Unknown author / Wikimedia Commons / CC BY 3.0","https://en.wikipedia.org/wiki/Olmec","images/10f995e7de63ad130b03f7b369cb8234109f374f.webp",{"_29":79,"_80":81},[244,245],{"_29":70,"_71":72},{"_27":167,"_68":243},"Kushim",{"_27":75,"_29":76},{"_27":149,"_29":150},"1518","Preclassic Maya","This period marks the early development of Maya civilization, characterized by the establishment of agricultural practices and the emergence of complex societies.","The period concluded with significant cultural advancements, leading to the Classic Maya period, where city-states flourished.",-2000,"Image: Preclassic Maya / Wikimedia Commons","https://en.wikipedia.org/wiki/Preclassic_Maya",{"_29":258,"_80":81},[257],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},"Guatemala",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,18]
