:217,"_40":218,"_42":181,"_44":201,"_46":219,"_48":43,"_50":220,"_52":43,"_53":94,"_55":221,"_57":222,"_59":223,"_61":224,"_63":225,"_65":226,"_67":227,"_69":228,"_71":72,"_73":74},{"_30":196,"_32":197,"_34":35,"_36":198,"_38":199,"_40":200,"_42":201,"_44":51,"_46":202,"_48":184,"_50":203,"_52":43,"_53":43,"_55":204,"_57":205,"_59":206,"_61":207,"_63":208,"_65":209,"_67":210,"_69":211,"_71":72,"_73":74},{"_30":176,"_32":177,"_34":35,"_36":178,"_38":179,"_40":180,"_42":181,"_44":182,"_46":183,"_48":184,"_50":45,"_52":43,"_53":54,"_55":185,"_57":186,"_59":187,"_61":188,"_63":189,"_65":190,"_67":191,"_69":192,"_71":72,"_73":74},{"_30":157,"_32":158,"_34":35,"_36":159,"_38":160,"_40":161,"_42":72,"_44":72,"_46":162,"_48":72,"_50":72,"_52":54,"_53":54,"_55":163,"_57":164,"_59":165,"_61":166,"_63":167,"_65":168,"_67":169,"_69":170,"_71":72,"_73":74},{"_30":135,"_32":136,"_34":35,"_36":137,"_38":138,"_40":139,"_42":45,"_44":140,"_46":141,"_48":142,"_50":119,"_52":43,"_53":54,"_55":143,"_57":144,"_59":145,"_61":146,"_63":147,"_65":148,"_67":149,"_69":150,"_71":72,"_73":74},{"_30":110,"_32":111,"_34":112,"_36":113,"_38":114,"_40":115,"_42":43,"_44":116,"_46":117,"_48":118,"_50":119,"_52":120,"_53":54,"_55":121,"_57":122,"_59":123,"_61":124,"_63":125,"_65":126,"_67":127,"_69":128,"_71":72,"_73":74},{"_30":87,"_32":88,"_34":89,"_36":90,"_38":91,"_40":92,"_42":72,"_44":72,"_46":93,"_48":72,"_50":72,"_52":54,"_53":94,"_55":95,"_57":96,"_59":97,"_61":98,"_63":99,"_65":100,"_67":101,"_69":102,"_71":72,"_73":74},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":43,"_53":54,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70,"_71":72,"_73":74},"id","327","name","Stephen Hawking","type","person","startDescription","A theoretical physicist and cosmologist, he is known for his work on black holes and the nature of the universe.","endDescription","His contributions to science and popular science communication have inspired millions.","startYear",1942,"startMonth",1,"startDay",8,"endYear",2018,"endMonth",3,"endDay",14,"startSignificance","endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/e/eb/Stephen_Hawking.StarChild.jpg","imageCredit","NASA / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/Stephen_Hawking","cdnId","images/2ddec9a370f96304599e717d812e2b7e06f160f6.webp","country",{"_32":84,"_85":86},"subjects",[81],"group",{"_32":78,"_79":80},"user",{"_30":75,"_76":77},"likes",0,"liked",false,"6","username","HistOracle","Modern Era","icon","GiEarthAmerica",{"_30":82,"_32":83},"4","intellectual","United Kingdom","continent","Europe","459","Sydney Harbour Bridge","landmark","The Sydney Harbour Bridge is an iconic steel arch bridge that connects Sydney's central business district with the North Shore.","It has become a symbol of Sydney and a major tourist attraction, celebrated for its engineering and design.",1923,1932,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/55/Sydney_Harbour_Bridge-16_October_2025.jpg/330px-Sydney_Harbour_Bridge-16_October_2025.jpg","Servite et contribuere / Wikimedia Commons / CC0","https://en.wikipedia.org/wiki/Sydney_Harbour_Bridge","images/3e4d7de3b7bcd165c1afe5c3506647168d99db62.webp",{"_32":108,"_85":109},[103,104],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":75,"_32":105},"maritime","3","culture","Australia","Oceania","531","Prohibition in the United States","period","A nationwide constitutional ban on the production, importation, transportation, and sale of alcoholic beverages.","Prohibition ended with the repeal of the 18th Amendment, highlighting the challenges of enforcing such a ban.",1920,16,1933,12,5,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b0/Detroit_police_inspecting_equipment_found_in_a_clandestine_underground_brewery_during_the_prohibition_era_-_NARA_-_541928.jpg/330px-Detroit_police_inspecting_equipment_found_in_a_clandestine_underground_brewery_during_the_prohibition_era_-_NARA_-_541928.jpg","Unknown author / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Prohibition_in_the_United_States","images/5bf075b3b8c9a398983ede7fe1ff7bf97cdfb916.webp",{"_32":133,"_85":134},[129,130],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":131,"_32":132},{"_30":106,"_32":107},"2","politics","United States of America","NorthAmerica","330","Mother Teresa","A Roman Catholic nun and missionary, she is known for her charitable work and dedication to the poor.","Her legacy of compassion and service continues to inspire humanitarian efforts worldwide.",1910,26,1997,9,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Mother_Teresa_1.jpg/330px-Mother_Teresa_1.jpg","Kingkongphoto &amp / USA / Wikimedia Commons / CC BY-SA 2.0","https://en.wikipedia.org/wiki/Mother_Teresa","images/4fa2a94514aa506f3cfb5f0a503bc9cc08455b17.webp",{"_32":155,"_85":156},[151,152],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":153,"_32":154},"7","religion","India","Asia","355","Frida Kahlo","A Mexican painter known for her unique style and deeply personal works that explore identity, postcolonialism, and gender.","Her death marked the end of an influential artistic career that continues to inspire and resonate with many.",1907,1954,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Frida_Kahlo%2C_by_Guillermo_Kahlo.jpg/330px-Frida_Kahlo%2C_by_Guillermo_Kahlo.jpg","Guillermo Kahlo / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Frida_Kahlo","images/06d826dbb0cbee177e380533d03a7f0836fb2d5d.webp",{"_32":175,"_85":134},[171,172],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":173,"_32":174},"9","art","Mexico","326","Pablo Picasso","A Spanish painter, sculptor, printmaker, ceramicist, and stage designer, he is known for co-founding the Cubist movement.","His innovative techniques and styles have had a profound influence on modern art.",1881,10,25,1973,4,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/98/Pablo_picasso_1.jpg/330px-Pablo_picasso_1.jpg","revistero / internacional / pintura-pablo-picasso.htm / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Pablo_Picasso","images/81dfe84ae159c92a797ab89a4c88fb1c4de02da2.webp",{"_32":195,"_85":86},[193,194],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":173,"_32":174},"Spain","318","Albert Einstein","A theoretical physicist, he is best known for developing the theory of relativity and making significant contributions to quantum mechanics.","His work fundamentally changed the understanding of physics and the universe.",1879,2,1955,18,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/Albert_Einstein_Head_cleaned.jpg/330px-Albert_Einstein_Head_cleaned.jpg","Orren Jack Turner / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Albert_Einstein","images/ddb80ec070951df4f97842542e6d29b54d670182.webp",{"_32":213,"_85":86},[212],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":82,"_32":83},"Germany","317","Mahatma Gandhi","A leader of the Indian independence movement against British rule, he is known for his philosophy of nonviolent resistance.","His assassination was a significant loss for the movement and left a lasting legacy of peace and civil rights.",1869,1948,30,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/Mahatma-Gandhi%2C_studio%2C_1931.jpg/330px-Mahatma-Gandhi%2C_studio%2C_1931.jpg","Elliott &amp / Fry / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Mahatma_Gandhi","images/85f1a364d8e73f475ad65c4f44d84fa78bcfe9bd.webp",{"_32":155,"_85":156},[230,231],{"_32":78,"_79":80},{"_30":153,"_76":229},"Kushim",{"_30":131,"_32":132},{"_30":106,"_32":107},"301","Neuschwanstein Castle","This fairy-tale castle was commissioned by Ludwig II of Bavaria and is known for its picturesque setting and romantic architecture. It draws inspiration from Wagnerian operas.","It remains one of the most popular tourist destinations in Germany, symbolizing romanticism and fantasy.",1886,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f8/Schloss_Neuschwanstein_2013.jpg/330px-Schloss_Neuschwanstein_2013.jpg","Thomas Wolf / Wikimedia Commons / CC BY-SA 3.0 de","https://en.wikipedia.org/wiki/Neuschwanstein_Castle","images/fdbd0c7beb3af14883c169abcf17cb269d54f2ab.webp",{"_32":213,"_85":86},[245,246],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":173,"_32":174},"315","Marie Curie","A physicist and chemist, she conducted pioneering research on radioactivity and was the first woman to win a Nobel Prize.","Her groundbreaking work laid the foundation for advances in medical treatments and nuclear physics.",1867,11,7,1934,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Marie_Curie_c._1920s.jpg/330px-Marie_Curie_c._1920s.jpg","Henri Manuel / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Marie_Curie","images/569fcd85446138c460fb8cc7b85df5d015f08979.webp",{"_32":264,"_85":86},[263],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":82,"_32":83},"Poland","2273","Austro-Hungarian Empire","The Austro-Hungarian Empire was a multi-ethnic Central European empire, formed by the dual monarchy of Austria and Hungary in 1867.","It dissolved in 1918 following World War I, leading to the formation of several independent states.",1918,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Austria-Hungary_map_1914.png/330px-Austria-Hungary_map_1914.png","Image: Austro-Hungarian Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Austria-Hungary",{"_32":278,"_85":86},[277],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},"Austria","320","Sigmund Freud","An Austrian neurologist and the founder of psychoanalysis, he developed influential theories on the unconscious mind.","His work has had a profound impact on psychology, culture, and the understanding of human behavior.",1856,6,1939,23,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/Sigmund_Freud%2C_by_Max_Halberstadt_%28cropped%29.jpg/330px-Sigmund_Freud%2C_by_Max_Halberstadt_%28cropped%29.jpg","Max Halberstadt / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Sigmund_Freud","images/b25a08c7da8ed2d15c19b22df9e48a00bd4a6803.webp",{"_32":278,"_85":86},[295,296],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":82,"_32":83},"353","Vincent van Gogh","A Dutch post-impressionist painter known for his vivid colors and emotional depth, whose works have had a profound influence on modern art.","His death marked the end of a troubled life but left a lasting legacy in the art world.",1853,1890,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Vincent_van_Gogh_-_Self-Portrait_-_Google_Art_Project_%28454045%29.jpg/330px-Vincent_van_Gogh_-_Self-Portrait_-_Google_Art_Project_%28454045%29.jpg","Vincent van Gogh / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Vincent_van_Gogh","images/d9008e5126802be0eb82feafbb8a343141edfe3e.webp",{"_32":313,"_85":86},[311,312],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":173,"_32":174},"Netherlands","321","Friedrich Nietzsche","A German philosopher, cultural critic, and poet, he is known for his critiques of traditional European morality and religion.","His ideas have influenced a wide range of fields, including philosophy, psychology, and the arts.",1844,15,1900,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1b/Nietzsche187a.jpg/330px-Nietzsche187a.jpg","Friedrich Hermann Hartmann / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Friedrich_Nietzsche","images/17d06df711d9f9474be7f60610bbefa90be9c285.webp",{"_32":213,"_85":86},[329,330],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":106,"_32":107},{"_30":82,"_32":83},"319","Charles Darwin","An English naturalist, geologist, and biologist, he is best known for his contributions to the science of evolution.","His theories on natural selection and adaptation transformed the understanding of biology.",1809,1882,19,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Charles_Darwin_seated_crop.jpg/330px-Charles_Darwin_seated_crop.jpg","Bea   o / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Charles_Darwin","images/8f84374206d8d53117229f00e562f42dc39c5000.webp",{"_32":84,"_85":86},[346],{"_32":78,"_79":80},{"_30":75,"_76":77},{"_30":82,"_32":83},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true]
