9,"_37":170,"_39":171,"_41":172,"_43":156,"_44":173,"_46":174,"_47":175,"_48":49,"_50":51,"_52":176,"_54":177,"_56":178,"_58":-5,"_59":179,"_61":180,"_63":181,"_65":182,"_67":42,"_68":69},{"_29":150,"_31":151,"_33":34,"_35":152,"_37":153,"_39":154,"_41":155,"_43":156,"_44":42,"_46":42,"_47":42,"_48":157,"_50":51,"_52":158,"_54":159,"_56":160,"_58":-5,"_59":161,"_61":162,"_63":163,"_65":164,"_67":42,"_68":69},{"_29":137,"_31":138,"_33":34,"_35":139,"_37":140,"_39":141,"_41":42,"_43":42,"_44":141,"_46":42,"_47":42,"_48":49,"_50":112,"_52":142,"_54":143,"_56":144,"_58":-5,"_59":145,"_61":146,"_63":147,"_65":148,"_67":42,"_68":69},{"_29":122,"_31":123,"_33":34,"_35":124,"_37":125,"_39":126,"_41":42,"_43":42,"_44":127,"_46":42,"_47":42,"_48":49,"_50":128,"_52":129,"_54":130,"_56":131,"_58":-5,"_59":132,"_61":133,"_63":134,"_65":135,"_67":42,"_68":69},{"_29":104,"_31":105,"_33":34,"_35":106,"_37":107,"_39":108,"_41":109,"_43":110,"_44":89,"_46":111,"_47":111,"_48":51,"_50":112,"_52":113,"_54":114,"_56":115,"_58":-5,"_59":116,"_61":117,"_63":118,"_65":119,"_67":42,"_68":69},{"_29":85,"_31":86,"_33":34,"_35":87,"_37":88,"_39":89,"_41":90,"_43":91,"_44":92,"_46":42,"_47":42,"_48":49,"_50":42,"_52":93,"_54":94,"_56":95,"_58":96,"_59":97,"_61":98,"_63":99,"_65":100,"_67":42,"_68":69},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":42,"_44":45,"_46":42,"_47":42,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":42,"_68":69},"id","1372","name","Apache Wars","type","event","startDescription","A series of conflicts between the United States and various Apache tribes over land and sovereignty.","endDescription","The wars concluded with the surrender of the last major Apache leader, marking a significant loss for the tribes.","startYear",1849,"startMonth",0,"startDay","endYear",1886,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/A_Dash_for_the_Timber_by_Frederic_Remington.jpg/330px-A_Dash_for_the_Timber_by_Frederic_Remington.jpg","imageCredit","Image: Apache Wars / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Apache_Wars","cdnId","country",{"_31":82,"_83":84},"subjects",[76,77],"group",{"_31":73,"_74":75},"user",{"_29":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Early Republic","icon","GiMusket",{"_29":80,"_31":81},{"_29":78,"_31":79},"2","politics","1","military","United States of America","continent","NorthAmerica","556","The Gold Rush","This mass migration of people to California was sparked by the discovery of gold, leading to a population boom and significant economic growth in the region.","The rush ended as gold became harder to find, but it left a lasting legacy on California's development and American culture.",1848,1,24,1855,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/04/1850_Woman_and_Men_in_California_Gold_Rush.jpg/330px-1850_Woman_and_Men_in_California_Gold_Rush.jpg","Gold-Rush-Girls / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/California_Gold_Rush","images/1de039070cf22a132e98fe90f1b3f21f37a5ad93.webp",{"_31":82,"_83":84},[101],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":102,"_31":103},"3","culture","568","The Mexican-American War","This armed conflict between the United States and Mexico stemmed from territorial disputes following the annexation of Texas.","The war concluded with the Treaty of Guadalupe Hidalgo, resulting in significant territorial gains for the United States.",1846,4,25,2,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/MXAMWAR.png/330px-MXAMWAR.png","Excel23 / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Mexican–American_War",{"_31":82,"_83":84},[120,121],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":80,"_31":81},{"_29":78,"_31":79},"1147","The Oregon Trail","A significant migration route that facilitated the movement of thousands of settlers westward across North America.","The trail became less used as railroads provided faster and safer alternatives for westward expansion.",1843,1860,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/40/Wpdms_nasa_topo_oregon_trail.jpg/330px-Wpdms_nasa_topo_oregon_trail.jpg","Image: Oregon Trail / Wikimedia Commons","https://en.wikipedia.org/wiki/Oregon_Trail",{"_31":82,"_83":84},[136],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":102,"_31":103},"1339","Invention of the Revolver","The development of a firearm that could fire multiple rounds without reloading transformed personal and military weaponry.","This innovation marked a significant advancement in firearm technology, influencing future designs and warfare.",1836,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c9/Colt_Autentica.jpg/330px-Colt_Autentica.jpg","Image: Revolver / Wikimedia Commons","https://en.wikipedia.org/wiki/Revolver",{"_31":82,"_83":84},[149],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":80,"_31":81},"1723","The Election of 1828","This pivotal election marked a significant shift in American politics, characterized by intense campaigning and the rise of populism.","The election concluded with a decisive victory, solidifying the new political landscape and influencing future electoral processes.",1828,10,31,0.9,"","Image: List of elections in 1828 / Wikimedia Commons","https://en.wikipedia.org/wiki/Election_of_1828",{"_31":82,"_83":84},[165],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":78,"_31":79},"881","Walt Whitman","person","A poet and essayist, he is often called the father of free verse and is known for his work that celebrates the individual and democracy.","His writings reflect the spirit of America and have left a lasting impact on literature and culture.",1819,5,1892,3,26,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Walt_Whitman_-_George_Collins_Cox.jpg/330px-Walt_Whitman_-_George_Collins_Cox.jpg","Image: Walt Whitman / Wikimedia Commons","https://en.wikipedia.org/wiki/Walt_Whitman",{"_31":82,"_83":84},[183,184],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":102,"_31":103},{"_29":185,"_31":186},"9","art","540","The War of 1812","A military conflict between the United States and Great Britain, fueled by trade restrictions and territorial expansion.","The war ended in a stalemate, but it fostered a sense of national identity and unity in the United States.",1812,6,18,1815,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fc/War_of_1812_Montage.jpg/330px-War_of_1812_Montage.jpg","Clockwise / from top / George Munger / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/War_of_1812","images/3699b54c7caa2755a3bd7ca844707be423279c66.webp",{"_31":82,"_83":84},[203,204],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":80,"_31":81},{"_29":78,"_31":79},"884","Abraham Lincoln","A prominent leader who served as the 16th President of the United States, known for his leadership during the Civil War and his efforts to abolish slavery.","His assassination marked a significant turning point in American history, leading to a period of reconstruction and change in the nation.",1809,12,1865,15,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Abraham_Lincoln_1863_Portrait_%283x4_cropped%29.jpg/330px-Abraham_Lincoln_1863_Portrait_%283x4_cropped%29.jpg","Image: Abraham Lincoln / Wikimedia Commons","https://en.wikipedia.org/wiki/Abraham_Lincoln",{"_31":82,"_83":84},[220,221],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":78,"_31":79},{"_29":222,"_31":223},"7","religion","1583","The Lewis and Clark Expedition","This expedition was a significant journey undertaken to explore the newly acquired western territory of the United States, providing valuable information about the land and its resources.","The expedition concluded successfully, having mapped the region and established relations with various Native American tribes, paving the way for westward expansion.",1804,14,1806,9,23,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/85/Lewis_and_Clark.jpg/330px-Lewis_and_Clark.jpg","Image: Lewis and Clark Expedition / Wikimedia Commons","https://en.wikipedia.org/wiki/Lewis_and_Clark_Expedition",{"_31":82,"_83":84},[240,241],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":80,"_31":81},{"_29":102,"_31":103},"541","The Louisiana Purchase","The acquisition of the Louisiana territory by the United States from France, which doubled the size of the nation.","This pivotal land deal significantly expanded U.S. territory and influence in North America.",1803,30,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/Louisiana_Purchase.png/330px-Louisiana_Purchase.png","William Morris / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Louisiana_Purchase","images/0eaa45f23f324dab171352dab28270daff0a3096.webp",{"_31":82,"_83":84},[256],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":78,"_31":79},"637","The Federalist Papers","This collection of 85 articles and essays promotes the ratification of the United States Constitution, articulating the principles of government and the importance of a strong federal system.","The work concluded with a lasting impact on American political theory and practice, influencing the interpretation of the Constitution.",1787,1788,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/The_Federalist_%281st_ed%2C_1788%2C_vol_I%2C_title_page%29_-_02.jpg/330px-The_Federalist_%281st_ed%2C_1788%2C_vol_I%2C_title_page%29_-_02.jpg","Publius  [ Alexander Hamilton / John Jay / James Madison ]. / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/The_Federalist_Papers","images/f23d570378f5530862cb2eeed9e1a474fb8958da.webp",{"_31":82,"_83":84},[271,272],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":78,"_31":79},{"_29":273,"_31":274},"4","intellectual","2281","United States","period","The United States was founded following independence from Britain, establishing a federal republic with democratic institutions.","It grew into a major world power through industrialization, territorial expansion, and global influence.",1776,7,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/USA_orthographic.svg/330px-USA_orthographic.svg.png","Image: United States / Wikimedia Commons","https://en.wikipedia.org/wiki/United_States",{"_31":82,"_83":84},[290],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":102,"_31":103},"564","The American Revolution","This conflict between the thirteen American colonies and Great Britain resulted from growing tensions over taxation and governance without representation.","The war concluded with the signing of the Treaty of Paris, establishing the independence of the United States and laying the foundation for a new nation.",1775,19,1783,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/Declaration_of_Independence_%281819%29%2C_by_John_Trumbull.jpg/330px-Declaration_of_Independence_%281819%29%2C_by_John_Trumbull.jpg","John Trumbull / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/American_Revolution","images/c08d6103b77a6a6816ebf8f634b4744f756aaba2.webp",{"_31":82,"_83":84},[306,307],{"_31":73,"_74":75},{"_29":70,"_71":72},{"_29":80,"_31":81},{"_29":78,"_31":79},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,46]
