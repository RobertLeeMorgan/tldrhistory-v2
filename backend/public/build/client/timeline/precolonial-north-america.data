43,"_44":43,"_45":180,"_47":43,"_48":43,"_49":52,"_51":121,"_53":181,"_55":182,"_57":183,"_59":-5,"_60":184,"_62":185,"_64":186,"_66":187,"_68":43,"_69":70},{"_30":160,"_32":161,"_34":88,"_36":162,"_38":163,"_40":164,"_42":43,"_44":43,"_45":165,"_47":43,"_48":43,"_49":166,"_51":93,"_53":167,"_55":168,"_57":169,"_59":-5,"_60":170,"_62":171,"_64":172,"_66":173,"_68":43,"_69":70},{"_30":146,"_32":147,"_34":88,"_36":148,"_38":149,"_40":150,"_42":43,"_44":43,"_45":151,"_47":43,"_48":43,"_49":52,"_51":93,"_53":152,"_55":153,"_57":154,"_59":-5,"_60":155,"_62":156,"_64":157,"_66":158,"_68":43,"_69":70},{"_30":131,"_32":132,"_34":35,"_36":133,"_38":134,"_40":135,"_42":43,"_44":43,"_45":136,"_47":43,"_48":43,"_49":50,"_51":52,"_53":137,"_55":138,"_57":139,"_59":-5,"_60":140,"_62":141,"_64":142,"_66":143,"_68":43,"_69":70},{"_30":115,"_32":116,"_34":88,"_36":117,"_38":118,"_40":91,"_42":43,"_44":43,"_45":119,"_47":43,"_48":43,"_49":120,"_51":121,"_53":122,"_55":123,"_57":124,"_59":-5,"_60":125,"_62":126,"_64":127,"_66":128,"_68":43,"_69":70},{"_30":102,"_32":103,"_34":88,"_36":104,"_38":105,"_40":91,"_42":43,"_44":43,"_45":106,"_47":43,"_48":43,"_49":52,"_51":93,"_53":107,"_55":108,"_57":109,"_59":-5,"_60":110,"_62":111,"_64":112,"_66":113,"_68":43,"_69":70},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":91,"_42":43,"_44":43,"_45":92,"_47":43,"_48":43,"_49":52,"_51":93,"_53":94,"_55":95,"_57":96,"_59":-5,"_60":97,"_62":98,"_64":99,"_66":100,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","2031","name","Chaco Canyon","type","landmark","startDescription","This significant archaeological site served as a major center for the Ancestral Puebloans, featuring a complex of monumental buildings and ceremonial structures.","endDescription","The site declined in importance and was largely abandoned, marking the end of its role as a cultural and economic hub.","startYear",850,"startMonth",0,"startDay","endYear",1150,"endMonth","endDay","startSignificance",0.9,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/Chaco_Canyon_Chetro_Ketl_great_kiva_plaza_NPS.jpg/330px-Chaco_Canyon_Chetro_Ketl_great_kiva_plaza_NPS.jpg","imageCredit","Image: Chaco Culture National Historical Park / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Chaco_Canyon","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Precolonial North America","icon","GiTotem",{"_30":81,"_32":82},{"_30":79,"_32":80},"8","economic","3","culture","United States of America","continent","NorthAmerica","2317","Choctaw","period","A Native American people originally from the Southeastern United States, known for mound-building, agriculture, and complex social structures.","European colonization and forced relocations changed their traditional lands and society, but the Choctaw continue today as a recognized tribe.",800,1800,0.6,"https://en.wikipedia.org/wiki/File:Choctaw_people.jpg","Image: Choctaw People / Wikimedia Commons","https://en.wikipedia.org/wiki/Choctaw",{"_32":83,"_84":85},[101],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2316","Natchez","A Native American people in the Mississippi Valley, known for mound-building, complex social hierarchy, and ceremonial life.","European colonization led to their dispersal and integration with other groups.",1730,"https://en.wikipedia.org/wiki/File:Natchez_people.jpg","Image: Natchez People / Wikimedia Commons","https://en.wikipedia.org/wiki/Natchez_people",{"_32":83,"_84":85},[114],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2024","Mississippian culture","A mound-building Native American culture that flourished in the southeastern United States, characterized by complex societies and trade networks.","This culture began to decline with European contact, leading to significant changes in social and economic structures.",1600,0.85,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9e/Mississippian_cultures_HRoe_2010.jpg/330px-Mississippian_cultures_HRoe_2010.jpg","Image: Mississippian culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Mississippian_culture",{"_32":83,"_84":85},[129,130],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"2026","Cahokia","A pre-Columbian Native American city located near present-day St. Louis, known for its large earthen mounds and complex society.","Cahokia declined significantly by the 14th century, leaving behind a rich archaeological legacy that reveals its cultural significance.",600,1400,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/Monks_Mound_-_Summer_2024.jpg/330px-Monks_Mound_-_Summer_2024.jpg","Image: Cahokia / Wikimedia Commons","https://en.wikipedia.org/wiki/Cahokia",{"_32":83,"_84":85},[144,145],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"2032","Ancestral Puebloans","This period marks the development of the Ancestral Puebloans, known for their unique architectural style and complex societies in the Four Corners region.","The period concluded as environmental changes and societal shifts led to the migration of many groups away from their established settlements.",100,1300,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ec/Cliff_Palace%2C_Mesa_Verde_Park%2C_Colorado%2C_US_%2836%29.jpg/330px-Cliff_Palace%2C_Mesa_Verde_Park%2C_Colorado%2C_US_%2836%29.jpg","Image: Ancestral Puebloans / Wikimedia Commons","https://en.wikipedia.org/wiki/Ancestral_Puebloans",{"_32":83,"_84":85},[159],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2028","Hopewell Tradition","This cultural period is characterized by the construction of large earthen mounds and the development of complex societies in the eastern United States.","The tradition gradually declined, leading to the emergence of new cultural practices and the eventual rise of other indigenous groups.",-200,500,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/Hopewell_Exchange_Network_HRoe_2010.jpg/330px-Hopewell_Exchange_Network_HRoe_2010.jpg","Image: Hopewell tradition / Wikimedia Commons","https://en.wikipedia.org/wiki/Hopewell_tradition",{"_32":83,"_84":85},[174],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2033","Dorset Culture","This period is characterized by the development of unique cultural practices among the Dorset people, including their distinctive art and tool-making techniques.","The period concluded as the Dorset culture gradually declined, influenced by environmental changes and interactions with other cultures.",-500,-1500,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Late_Dorset_%28max_extent%29.svg/330px-Late_Dorset_%28max_extent%29.svg.png","Image: Dorset culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Dorset_culture",{"_32":189,"_84":85},[188],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"Canada","2318","Adena","A Pre-Columbian Native American culture in the Ohio River Valley, known for mound-building and ceremonial practices.","The Adena culture gradually evolved into the Hopewell tradition, influencing later cultures in Eastern North America.",-1000,"https://en.wikipedia.org/wiki/File:Adena_mound.jpg","Image: Adena Mound / Wikimedia Commons","https://en.wikipedia.org/wiki/Adena_culture",{"_32":83,"_84":85},[202],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2314","Siouan","A Native American linguistic and cultural group of the Great Plains and Midwest, known for semi-nomadic hunting and complex social structures.","European colonization disrupted traditional lifestyles, but descendants maintain cultural practices today.","https://en.wikipedia.org/wiki/File:Siouan_people.jpg","Image: Siouan People / Wikimedia Commons","https://en.wikipedia.org/wiki/Siouan_languages",{"_32":83,"_84":85},[214],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2313","Algonquian","A group of Native American tribes in Northeastern North America, speaking Algonquian languages and practicing hunting, fishing, and agriculture.","The tribes continue today, but colonial contact dramatically changed their traditional way of life.","https://en.wikipedia.org/wiki/File:Algonquian_people.jpg","Image: Algonquian People / Wikimedia Commons","https://en.wikipedia.org/wiki/Algonquian_peoples",{"_32":83,"_84":85},[226],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2315","Iroquoian","A confederation of Native American tribes in the Northeastern United States and Canada, known for longhouses and matrilineal society.","The Iroquois Confederacy remained influential through European contact and into modern times.",-1200,1700,"https://en.wikipedia.org/wiki/File:Iroquois_longhouse.jpg","Image: Iroquois Longhouse / Wikimedia Commonsasdfasdfasdfasdfsadfasdfasdfsdafasdfsadfasdfasdfsdafasdf","https://en.wikipedia.org/wiki/Iroquois",{"_32":83,"_84":85},[242],{"_32":74,"_75":76},{"_30":240,"_72":241},"7","Kushim",{"_30":81,"_32":82},"2319","Eskimo","Indigenous peoples of the Arctic regions, including Alaska, Canada, Greenland, and Siberia, traditionally hunter-gatherers specialized in marine resources.","Many Eskimo groups adapted to modern nation-states but retain traditional cultural practices and subsistence knowledge.",-2000,"https://en.wikipedia.org/wiki/File:Inuit_family.jpg","Image: Inuit Family / Wikimedia Commons","https://en.wikipedia.org/wiki/Inuit",{"_32":189,"_84":85},[255],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"2027","Clovis Culture","This prehistoric culture is characterized by distinctive stone tools and hunting practices, primarily associated with large game.","The culture gradually transitioned as environmental changes and the extinction of megafauna occurred, leading to new cultural adaptations.",-13000,-10000,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d0/Clovis_spearpoints_-_Cleveland_Museum_of_Natural_History.jpg/330px-Clovis_spearpoints_-_Cleveland_Museum_of_Natural_History.jpg","Image: Clovis culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Clovis_culture",{"_32":83,"_84":85},[269],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"1331","Bering Land Bridge","A significant geological formation that connected Asia and North America during the last Ice Age, allowing for migration of species and humans.","The bridge submerged due to rising sea levels, marking the end of a crucial migration route for early humans.",-25000,-12000,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/52/Beringia_land_bridge-noaagov.gif/330px-Beringia_land_bridge-noaagov.gif","Image: Beringia / Wikimedia Commons","https://en.wikipedia.org/wiki/Bering_Land_Bridge",{"_32":83,"_84":85},[283],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":284,"_32":285},"5","environment",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,10]
