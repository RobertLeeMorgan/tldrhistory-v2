"_40":41,"_42":41,"_43":150,"_44":41,"_45":41,"_46":47,"_48":151,"_49":152,"_51":153,"_53":154,"_55":-5,"_56":155,"_58":156,"_60":157,"_62":158,"_64":41,"_65":66},{"_28":130,"_30":131,"_32":132,"_34":133,"_36":134,"_38":135,"_40":41,"_42":41,"_43":136,"_44":41,"_45":41,"_46":102,"_48":137,"_49":138,"_51":-5,"_53":139,"_55":-5,"_56":140,"_58":141,"_60":142,"_62":143,"_64":41,"_65":66},{"_28":114,"_30":115,"_32":116,"_34":117,"_36":118,"_38":100,"_40":41,"_42":41,"_43":119,"_44":41,"_45":41,"_46":83,"_48":120,"_49":121,"_51":122,"_53":123,"_55":124,"_56":125,"_58":126,"_60":127,"_62":128,"_64":41,"_65":66},{"_28":95,"_30":96,"_32":97,"_34":98,"_36":99,"_38":100,"_40":41,"_42":41,"_43":101,"_44":41,"_45":41,"_46":83,"_48":102,"_49":103,"_51":104,"_53":105,"_55":-5,"_56":106,"_58":107,"_60":108,"_62":109,"_64":41,"_65":66},{"_28":79,"_30":80,"_32":33,"_34":81,"_36":82,"_38":39,"_40":41,"_42":41,"_43":41,"_44":41,"_45":41,"_46":83,"_48":47,"_49":84,"_51":85,"_53":86,"_55":87,"_56":88,"_58":89,"_60":90,"_62":91,"_64":41,"_65":66},{"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":41,"_43":41,"_44":41,"_45":41,"_46":47,"_48":41,"_49":50,"_51":52,"_53":54,"_55":-5,"_56":57,"_58":59,"_60":61,"_62":63,"_64":41,"_65":66},"id","2212","name","Sacsayhuamán","type","landmark","startDescription","A ceremonial complex located near Cusco, known for its massive stone walls and architectural precision.","endDescription","The site remains a significant cultural landmark and tourist attraction.","startYear",1450,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.8,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Sacsayhuam%C3%A1n%2C_Cusco%2C_Per%C3%BA%2C_2015-07-31%2C_DD_27.JPG/330px-Sacsayhuam%C3%A1n%2C_Cusco%2C_Per%C3%BA%2C_2015-07-31%2C_DD_27.JPG","imageCredit","Image: Sacsayhuamán / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Sacsayhuam%C3%A1n","cdnId","country",{"_30":76,"_77":78},"subjects",[73],"group",{"_30":70,"_71":72},"user",{"_28":67,"_68":69},"likes","liked",false,"6","username","HistOracle","Andean Civilizations","icon","GiMountaintop",{"_28":74,"_30":75},"9","art","Peru","continent","SouthAmerica","297","Machu Picchu","This iconic Incan citadel is renowned for its sophisticated dry-stone construction and panoramic views of the Andes Mountains. It served as a royal estate and religious site.","Today, it stands as a UNESCO World Heritage Site and a symbol of Incan civilization, attracting millions of visitors each year.",0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Machu_Picchu%2C_2023_%28012%29.jpg/330px-Machu_Picchu%2C_2023_%28012%29.jpg","Draceane / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Machu_Picchu","images/c063de05291e20757a01415f3c7b67924a9c384b.webp",{"_30":76,"_77":78},[92],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},"3","culture","1614","Pachacuti","person","A transformative leader who expanded the Inca Empire significantly and is credited with establishing its administrative framework.","His death marked the end of a pivotal era of expansion and consolidation for the Inca Empire.",1438,1471,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Brooklyn_Museum_-_Pachacuti%2C_Tenth_Inca%2C_1_of_14_Portraits_of_Inca_Kings_%28cropped%29.jpg/330px-Brooklyn_Museum_-_Pachacuti%2C_Tenth_Inca%2C_1_of_14_Portraits_of_Inca_Kings_%28cropped%29.jpg","Image: Pachacuti / Wikimedia Commons","https://en.wikipedia.org/wiki/Pachacuti",{"_30":76,"_77":78},[110,111],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":112,"_30":113},{"_28":93,"_30":94},"2","politics","580","Inca Empire","period","A vast empire that dominated the Andean region, known for its advanced architecture, agriculture, and road systems.","The fall of the empire marked the beginning of Spanish colonization and significant cultural changes in the region.",1533,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9e/Suntur_Paucar.svg/330px-Suntur_Paucar.svg.png","Adapted from  Huhsunqu / made by Pachakutec / Wikimedia Commons / CC BY-SA 2.5","https://en.wikipedia.org/wiki/Inca_Empire","images/c7a83fe3bed746fc88636bbe314cf9c45526612f.webp",{"_30":76,"_77":78},[129],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},"2211","Chimu Civilization","event","An influential culture known for its elaborate pottery and the construction of the city of Chan Chan.","The civilization was eventually absorbed into the Inca Empire, leaving a lasting artistic legacy.",900,1470,0.5,"","https://en.wikipedia.org/wiki/Chimu_civilization",{"_30":76,"_77":78},[144],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":74,"_30":75},"1521","Wari Empire","This period marked the rise of a significant Andean civilization known for its advanced architecture and urban planning.","The period concluded with the decline of the empire, leading to the emergence of new cultural and political entities in the region.",500,1000,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Map_of_Wari_in_Peru.svg/320px-Map_of_Wari_in_Peru.svg.png","Image: Wari culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Wari_culture",{"_30":76,"_77":78},[159,160],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":112,"_30":113},{"_28":93,"_30":94},"1615","Tiwanaku","This archaeological site features impressive stone structures and is considered a significant center of Andean civilization.","The site declined in prominence, with many structures falling into disrepair as the civilization waned.",300,1100,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0c/PUERTA_DEL_SOL_TIWANAKU.jpg/330px-PUERTA_DEL_SOL_TIWANAKU.jpg","Image: Tiwanaku / Wikimedia Commons","https://en.wikipedia.org/wiki/Tiwanaku",{"_30":179,"_77":78},[176,177],{"_30":70,"_71":72},{"_28":174,"_68":175},"7","Kushim",{"_28":93,"_30":94},{"_28":174,"_30":178},"religion","Bolivia","1520","Moche Civilization","This period is characterized by the development of a complex society in ancient Peru, known for its impressive architectural and artistic achievements.","The period concluded with the decline of the civilization, leading to significant changes in the cultural landscape of the region.",100,800,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/H_Luna_Frisorestaurado_lou.jpg/330px-H_Luna_Frisorestaurado_lou.jpg","Image: Moche culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Moche_civilization",{"_30":76,"_77":78},[193,194],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},{"_28":74,"_30":75},"1249","Nazca Lines","The Nazca Lines are a series of large ancient geoglyphs located in the Nazca Desert, in southern Peru, created by the Nazca culture between 500 BCE and 500 CE.","The purpose of the Nazca Lines remains a mystery, with theories ranging from astronomical alignments to religious significance, but they continue to be a subject of fascination and study.",-500,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f7/L%C3%ADneas_de_Nazca%2C_Nazca%2C_Per%C3%BA%2C_2015-07-29%2C_DD_49.JPG/330px-L%C3%ADneas_de_Nazca%2C_Nazca%2C_Per%C3%BA%2C_2015-07-29%2C_DD_49.JPG","Image: Nazca lines / Wikimedia Commons","https://en.wikipedia.org/wiki/Nazca_Lines",{"_30":76,"_77":78},[207,208],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},{"_28":74,"_30":75},"2208","Chavín de Huantar","An archaeological site featuring a complex of stone buildings and temples, known for its intricate carvings and religious significance.","The site declined in importance but remains a key example of early Andean civilization architecture.",-900,200,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/60/Chav%C3%ADn_de_Hu%C3%A1ntar_-_51149086708.jpg/330px-Chav%C3%ADn_de_Hu%C3%A1ntar_-_51149086708.jpg","Image: Chavín de Huántar / Wikimedia Commons","https://en.wikipedia.org/wiki/Chav%C3%ADn_de_Huantar",{"_30":76,"_77":78},[222],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":74,"_30":75},"37","Chavin Civilization","This civilization is known for its religious and artistic achievements, influencing later Andean cultures.","The civilization declined, but its legacy continued through subsequent cultures in the region.",-200,0.65,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/ChavinMap.svg/330px-ChavinMap.svg.png","QQuantum / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Chav%C3%ADn_culture","images/51d1abc30c47ba16cd0c36931dfa19c879666bff.webp",{"_30":76,"_77":78},[238,239],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},{"_28":174,"_30":178},"1516","Norte Chico","This ancient civilization, located in present-day Peru, is known for its early urban development and complex society.","The civilization gradually declined, leading to the rise of other cultures in the region.",-3000,-1800,"https://upload.wikimedia.org/wikipedia/commons/1/1b/Peru_site_locations.png","Image: Caral–Supe civilization / Wikimedia Commons","https://en.wikipedia.org/wiki/Norte_Chico_civilization",{"_30":76,"_77":78},[253,254],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},{"_28":255,"_30":256},"8","economic","1250","Caral-Supe Civilization","This ancient civilization is known for its impressive urban centers and monumental architecture, showcasing advanced societal organization and cultural development.","The civilization gradually declined, leading to the abandonment of its cities and a shift in regional power dynamics.","https://upload.wikimedia.org/wikipedia/commons/thumb/4/4a/Mayor_Pyramid_and_circular_enclosure._Caral%2C_Peru.jpg/330px-Mayor_Pyramid_and_circular_enclosure._Caral%2C_Peru.jpg","Image: Caral / Wikimedia Commons","https://en.wikipedia.org/wiki/Caral",{"_30":76,"_77":78},[268],{"_30":70,"_71":72},{"_28":67,"_68":69},{"_28":93,"_30":94},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,19]
