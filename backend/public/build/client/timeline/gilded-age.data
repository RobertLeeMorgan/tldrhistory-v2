,"_36":188,"_38":189,"_40":190,"_42":191,"_44":192,"_46":139,"_48":193,"_49":194,"_50":51,"_52":90,"_53":195,"_55":196,"_57":197,"_59":-5,"_60":198,"_62":199,"_64":200,"_66":201,"_68":47,"_69":70},{"_30":168,"_32":169,"_34":35,"_36":170,"_38":171,"_40":172,"_42":47,"_44":47,"_46":173,"_48":174,"_49":107,"_50":90,"_52":175,"_53":176,"_55":177,"_57":178,"_59":-5,"_60":179,"_62":180,"_64":181,"_66":182,"_68":47,"_69":70},{"_30":150,"_32":151,"_34":35,"_36":152,"_38":153,"_40":154,"_42":155,"_44":107,"_46":154,"_48":155,"_49":107,"_50":90,"_52":156,"_53":157,"_55":158,"_57":159,"_59":-5,"_60":160,"_62":161,"_64":162,"_66":163,"_68":47,"_69":70},{"_30":135,"_32":136,"_34":35,"_36":137,"_38":138,"_40":139,"_42":107,"_44":140,"_46":47,"_48":47,"_49":47,"_50":51,"_52":141,"_53":142,"_55":143,"_57":144,"_59":-5,"_60":145,"_62":146,"_64":147,"_66":148,"_68":47,"_69":70},{"_30":120,"_32":121,"_34":35,"_36":122,"_38":123,"_40":124,"_42":47,"_44":47,"_46":47,"_48":47,"_49":47,"_50":51,"_52":47,"_53":91,"_55":125,"_57":126,"_59":-5,"_60":127,"_62":128,"_64":129,"_66":130,"_68":47,"_69":70},{"_30":101,"_32":102,"_34":103,"_36":104,"_38":105,"_40":106,"_42":107,"_44":108,"_46":47,"_48":47,"_49":47,"_50":90,"_52":47,"_53":109,"_55":110,"_57":111,"_59":112,"_60":113,"_62":114,"_64":115,"_66":116,"_68":47,"_69":70},{"_30":86,"_32":87,"_34":35,"_36":88,"_38":89,"_40":41,"_42":47,"_44":47,"_46":47,"_48":47,"_49":47,"_50":90,"_52":47,"_53":91,"_55":92,"_57":93,"_59":-5,"_60":94,"_62":95,"_64":96,"_66":97,"_68":47,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":47,"_49":47,"_50":51,"_52":47,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":47,"_69":70},"id","1756","name","Wounded Knee Massacre","type","event","startDescription","A tragic confrontation between U.S. troops and Lakota Sioux, resulting in significant loss of life.","endDescription","The massacre underscored the violent conflicts between Native Americans and the U.S. government during westward expansion.","startYear",1890,"startMonth",12,"startDay",29,"endYear",0,"endMonth","endDay","startSignificance",0.8,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Soldiers_at_a_burial_for_the_dead_at_Wounded_Knee%2C_South_Dakota%2C_c._1891.jpg/330px-Soldiers_at_a_burial_for_the_dead_at_Wounded_Knee%2C_South_Dakota%2C_c._1891.jpg","imageCredit","Image: Wounded Knee Massacre / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Wounded_Knee_Massacre","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Gilded Age","icon","GiRevolver",{"_30":81,"_32":82},{"_30":79,"_32":80},"3","culture","1","military","United States of America","continent","NorthAmerica","1754","The Sherman Antitrust Act","A landmark federal statute aimed at curbing monopolies and promoting competition in the marketplace.","The act laid the groundwork for antitrust law enforcement in the U.S., influencing economic policies for decades.",0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Great_Seal_of_the_United_States_%28obverse%29.svg/330px-Great_Seal_of_the_United_States_%28obverse%29.svg.png","Image: Sherman Antitrust Act / Wikimedia Commons","https://en.wikipedia.org/wiki/Sherman_Antitrust_Act",{"_32":83,"_84":85},[98],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":99,"_32":100},"8","economic","573","The Statue of Liberty","landmark","This iconic symbol of freedom and democracy was a gift from France to the United States, representing hope for immigrants arriving by sea.","The statue continues to be a powerful emblem of American ideals and a welcoming sight for newcomers.",1886,10,28,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Front_view_of_Statue_of_Liberty_%28cropped%29.jpg/330px-Front_view_of_Statue_of_Liberty_%28cropped%29.jpg","AskALotl / Wikimedia Commons / CC0","https://en.wikipedia.org/wiki/Statue_of_Liberty","images/856bccc7d8ff49d027f89fbcded6e2773e43945d.webp",{"_32":83,"_84":85},[117,118],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":71,"_32":119},"maritime","1753","The Chinese Exclusion Act","A federal law that prohibited the immigration of Chinese laborers to the United States, reflecting the racial tensions of the time.","The act remained in effect for several decades, significantly impacting Chinese communities and immigration policies in the U.S.",1882,"Image: Chinese Exclusion Act / Wikimedia Commons","https://en.wikipedia.org/wiki/Chinese_Exclusion_Act",{"_32":83,"_84":85},[131,132],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":133,"_32":134},{"_30":79,"_32":80},"2","politics","1095","Gunfight at the O.K. Corral","A famous shootout between lawmen and outlaws occurred in a small Arizona town, marking a pivotal moment in the law enforcement history of the American West.","The shootout ended with several casualties, solidifying the event's place in American folklore and contributing to the mythos of the Wild West.",1881,26,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Tombstone_%28probably_in_1881%29_%28cropped%29.jpg/330px-Tombstone_%28probably_in_1881%29_%28cropped%29.jpg","Image: Gunfight at the O.K. Corral / Wikimedia Commons","https://en.wikipedia.org/wiki/Gunfight_at_the_O.K._Corral",{"_32":83,"_84":85},[149],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"1174","The Telephone","This event marks the first successful demonstration of the telephone, revolutionizing communication.","The event concluded with the establishment of the telephone as a viable means of communication.",1876,3,0.1,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Telefon_BW_2012-02-18_13-44-32.JPG/330px-Telefon_BW_2012-02-18_13-44-32.JPG","Image: Telephone / Wikimedia Commons","https://en.wikipedia.org/wiki/Telephone",{"_32":83,"_84":85},[164,165],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":166,"_32":167},"4","intellectual","1751","The Transcontinental Railroad Completion","The construction of a rail line that connected the eastern U.S. with the western territories, facilitating transportation and commerce.","The completion of the railroad marked a significant milestone in American infrastructure, enabling faster movement of goods and people across the continent.",1863,1869,5,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5d/East_and_West_Shaking_hands_at_the_laying_of_last_rail_Union_Pacific_Railroad_-_Restoration.jpg/330px-East_and_West_Shaking_hands_at_the_laying_of_last_rail_Union_Pacific_Railroad_-_Restoration.jpg","Image: First transcontinental railroad / Wikimedia Commons","https://en.wikipedia.org/wiki/First_Transcontinental_Railroad",{"_32":83,"_84":85},[183,184],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":71,"_32":119},{"_30":99,"_32":100},"1092","Billy the Kid","person","A notorious figure of the American Old West, known for his gunfighting skills and involvement in the Lincoln County War.","His life ended in a shootout with law enforcement, cementing his legacy as a legendary outlaw.",1859,11,23,7,14,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/01/Billy_the_Kid_tintype%2C_Fort_Sumner%2C_1879-80-Edit2.jpg/330px-Billy_the_Kid_tintype%2C_Fort_Sumner%2C_1879-80-Edit2.jpg","Image: Billy the Kid / Wikimedia Commons","https://en.wikipedia.org/wiki/Billy_the_Kid",{"_32":83,"_84":85},[202],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},"1152","Nikola Tesla","A pioneering inventor and electrical engineer known for his contributions to the development of alternating current electricity supply systems.","His legacy continues to influence modern electrical engineering and technology.",1856,1943,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/79/Tesla_circa_1890.jpeg/330px-Tesla_circa_1890.jpeg","Image: Nikola Tesla / Wikimedia Commons","https://en.wikipedia.org/wiki/Nikola_Tesla",{"_32":83,"_84":85},[216],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":166,"_32":167},"1758","Thomas Edison","An American inventor and businessman, he is best known for his contributions to the development of electric light and power utilities.","His innovations laid the groundwork for modern electric power generation and distribution.",1847,2,1931,18,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9d/Thomas_Edison2.jpg/330px-Thomas_Edison2.jpg","Image: Thomas Edison / Wikimedia Commons","https://en.wikipedia.org/wiki/Thomas_Edison",{"_32":83,"_84":85},[233,234],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":166,"_32":167},{"_30":99,"_32":100},"1757","John D. Rockefeller","A prominent figure in the American oil industry, he co-founded the Standard Oil Company and revolutionized the petroleum industry.","His legacy includes significant philanthropic contributions and the establishment of various foundations.",1839,8,1937,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a0/Portrait_of_J._D._Rockefeller.jpg/330px-Portrait_of_J._D._Rockefeller.jpg","Image: John D. Rockefeller / Wikimedia Commons","https://en.wikipedia.org/wiki/John_D._Rockefeller",{"_32":83,"_84":85},[249],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":99,"_32":100},"879","John Muir","A naturalist and environmentalist, he was instrumental in the establishment of national parks in the United States.","His writings and activism helped to promote conservation and the appreciation of nature.",1838,4,21,1914,24,0.75,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/ab/John_Muir_Watkins_Portrait_circa_1875_Edit.png/330px-John_Muir_Watkins_Portrait_circa_1875_Edit.png","Image: John Muir / Wikimedia Commons","https://en.wikipedia.org/wiki/John_Muir",{"_32":83,"_84":85},[267,268],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":269,"_32":270},"5","environment","873","Mark Twain","An influential writer and humorist, he is best known for his novels that capture the essence of American life.","His works continue to resonate, highlighting social issues and the complexities of human nature.",1835,30,1910,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Mark_Twain_by_AF_Bradley.jpg/330px-Mark_Twain_by_AF_Bradley.jpg","A.F. Bradley / New York / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Mark_Twain","images/8dd9f02d92de3f472d0ff0b3bfc19ae0316bd5d2.webp",{"_32":83,"_84":85},[286,287],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":288,"_32":289},"9","art","1749","Andrew Carnegie","A leading figure in the steel industry, he played a crucial role in the expansion of the American economy during the Gilded Age.","He left a legacy of philanthropy, funding libraries, education, and peace initiatives.",25,1919,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d7/Andrew_Carnegie%2C_three-quarter_length_portrait%2C_seated%2C_facing_slightly_left%2C_1913_%28cropped%29_%282%29.jpg/330px-Andrew_Carnegie%2C_three-quarter_length_portrait%2C_seated%2C_facing_slightly_left%2C_1913_%28cropped%29_%282%29.jpg","Image: Andrew Carnegie / Wikimedia Commons","https://en.wikipedia.org/wiki/Andrew_Carnegie",{"_32":83,"_84":85},[303,304],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":99,"_32":100},"1755","Tammany Hall","period","A political organization that played a significant role in New York City politics, known for its influence and corruption.","The decline of Tammany Hall marked the end of an era in New York politics, as reform movements gained traction.",1789,1960,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/97/Tammany_Hall_logo_crop.jpg/330px-Tammany_Hall_logo_crop.jpg","Image: Tammany Hall / Wikimedia Commons","https://en.wikipedia.org/wiki/Tammany_Hall",{"_32":83,"_84":85},[319],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":133,"_32":134},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,47]
