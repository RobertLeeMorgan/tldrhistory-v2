":40,"_42":40,"_44":40,"_45":40,"_46":49,"_48":104,"_50":132,"_52":133,"_53":134,"_55":-5,"_56":135,"_58":136,"_60":137,"_62":138,"_64":40,"_65":66},{"_27":112,"_29":113,"_31":32,"_33":114,"_35":115,"_37":116,"_39":40,"_41":40,"_42":103,"_44":40,"_45":40,"_46":49,"_48":88,"_50":51,"_52":117,"_53":118,"_55":-5,"_56":119,"_58":120,"_60":121,"_62":122,"_64":40,"_65":66},{"_27":98,"_29":99,"_31":32,"_33":100,"_35":101,"_37":102,"_39":40,"_41":40,"_42":103,"_44":40,"_45":40,"_46":49,"_48":104,"_50":51,"_52":-5,"_53":105,"_55":-5,"_56":106,"_58":107,"_60":108,"_62":109,"_64":40,"_65":66},{"_27":82,"_29":83,"_31":32,"_33":84,"_35":85,"_37":86,"_39":40,"_41":40,"_42":87,"_44":40,"_45":40,"_46":49,"_48":88,"_50":89,"_52":90,"_53":91,"_55":-5,"_56":92,"_58":93,"_60":94,"_62":95,"_64":40,"_65":66},{"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":40,"_42":43,"_44":40,"_45":40,"_46":47,"_48":49,"_50":51,"_52":-5,"_53":54,"_55":-5,"_56":57,"_58":59,"_60":61,"_62":63,"_64":40,"_65":66},"id","2014","name","The Guarani Wars","type","event","startDescription","A series of conflicts between the Guarani people and Portuguese settlers over land and resources, reflecting the tensions of colonial expansion.","endDescription","The wars ended with the defeat of the Guarani, leading to the loss of their territories and significant demographic changes.","startYear",1750,"startMonth",0,"startDay","endYear",1756,"endMonth","endDay","startSignificance",0.8,"endSignificance",0.7,"imageUrl","","imageCredit","sourceUrl","https://en.wikipedia.org/wiki/Guarani_Wars","cdnId","country",{"_29":79,"_80":81},"subjects",[73,74],"group",{"_29":70,"_71":72},"user",{"_27":67,"_68":69},"likes","liked",false,"6","username","HistOracle","Pre-Columbian Brazil","icon","GiSpearFeather",{"_27":77,"_29":78},{"_27":75,"_29":76},"2","politics","1","military","Brazil","continent","SouthAmerica","1407","Orellana's Journey","An expedition that navigated the Amazon River, marking a significant exploration of the region's vast waterways and cultures.","The expedition concluded with the crew's return, having faced numerous challenges and contributing to European knowledge of South America.",1541,1542,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/34/Francisco_de_Orellana1.JPG/330px-Francisco_de_Orellana1.JPG","Image: Francisco de Orellana / Wikimedia Commons","https://en.wikipedia.org/wiki/Francisco_de_Orellana",{"_29":79,"_80":81},[96],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":67,"_29":97},"maritime","2016","The Rise of the Tupi Confederation","A significant political and military alliance formed among various Tupi tribes in response to European colonization efforts.","The confederation eventually fragmented due to internal conflicts and external pressures from colonial powers.",1500,1600,0.5,"https://en.wikipedia.org/wiki/Tupi_Confederation",{"_29":79,"_80":81},[110,111],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":77,"_29":78},{"_27":75,"_29":76},"2012","The Tupi-Guarani Migration","This event marks the migration of the Tupi-Guarani peoples into Brazil, significantly impacting the region's demographics and cultures.","The migration led to the establishment of new settlements and interactions with other indigenous groups and later European settlers.",1000,"Image: Tupi people / Wikimedia Commons","https://en.wikipedia.org/wiki/Tupi_people",{"_29":79,"_80":81},[123,124],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":125,"_29":126},"3","culture","1408","The Ticuna People","period","A cultural group known for their unique traditions, language, and social structures, primarily inhabiting the Amazon rainforest region.","The cultural practices and social structures of the Ticuna continue to evolve, reflecting changes in their environment and interactions with other communities.","https://upload.wikimedia.org/wikipedia/commons/thumb/a/a6/Indios_amazonas_1865_00.jpg/330px-Indios_amazonas_1865_00.jpg","Image: Ticuna / Wikimedia Commons","https://en.wikipedia.org/wiki/Ticuna_people",{"_29":79,"_80":81},[141],{"_29":70,"_71":72},{"_27":139,"_68":140},"7","Kushim",{"_27":125,"_29":126},"2020","Xinguano Cultural Complex","landmark","This complex represents a significant archaeological site in Brazil, showcasing the rich cultural heritage of the indigenous Xinguano people.","The site continues to be a focal point for understanding the pre-Columbian history and cultural practices of the region.",800,"https://en.wikipedia.org/wiki/Xinguano_Cultural_Complex",{"_29":79,"_80":81},[153],{"_29":70,"_71":72},{"_27":139,"_68":140},{"_27":125,"_29":126},"1406","Marajoara Civilization","This civilization thrived in the Amazon region, known for its complex society and advanced pottery techniques.","The civilization gradually declined, influenced by environmental changes and external factors.",400,1400,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Burian_urn%2C_AD_1000-1250%2C_Marajoara_culture_-_AMNH_-_DSC06177_b.jpg/330px-Burian_urn%2C_AD_1000-1250%2C_Marajoara_culture_-_AMNH_-_DSC06177_b.jpg","Image: Marajoara culture / Wikimedia Commons","https://en.wikipedia.org/wiki/Marajoara_culture",{"_29":79,"_80":81},[167,168],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":125,"_29":126},{"_27":169,"_29":170},"8","economic","2023","Tapajós Culture","This period marks the development of the Tapajós culture, characterized by advanced agricultural practices and complex social structures.","The culture began to decline with the arrival of Europeans, leading to significant changes in their way of life.",-1000,"https://en.wikipedia.org/wiki/Tapaj%C3%B3s_culture",{"_29":79,"_80":81},[181],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":125,"_29":126},"2009","The Amazonian Tribes","This period encompasses the diverse tribes of the Amazon, known for their unique cultures, languages, and adaptations to the rainforest environment.","The period ended with increased contact with Europeans, leading to significant cultural exchanges and disruptions.","https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/Brazil_Native_Alone_in_2022.svg/330px-Brazil_Native_Alone_in_2022.svg.png","Image: Indigenous peoples in Brazil / Wikimedia Commons","https://en.wikipedia.org/wiki/Amazonian_tribes",{"_29":79,"_80":81},[193,194],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":125,"_29":126},{"_27":195,"_29":196},"5","environment","2010","The Arawak","This period marks the arrival and establishment of the Arawak people in the region, known for their agricultural practices and social structures.","The period concluded with the arrival of European colonizers, leading to significant changes in the social and cultural landscape.",-2000,0.9,"Image: Arawak / Wikimedia Commons","https://en.wikipedia.org/wiki/Arawak",{"_29":79,"_80":81},[209,210],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":75,"_29":76},{"_27":125,"_29":126},"2018","Sambaqui Culture","This cultural period is characterized by the construction of shell mounds and the development of complex societies along the Brazilian coast.","The culture gradually evolved, influencing subsequent indigenous cultures in the region.",-5000,"https://en.wikipedia.org/wiki/Sambaqui",{"_29":79,"_80":81},[221],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":125,"_29":126},"2015","The Serra da Capivara","A significant archaeological site known for its prehistoric rock paintings, providing insight into the early inhabitants of the region.","The site continues to be a vital resource for understanding the cultural history of ancient peoples in Brazil.",-20000,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7e/Canoas_-_Vale_Verde.JPG/330px-Canoas_-_Vale_Verde.JPG","Image: Serra da Capivara National Park / Wikimedia Commons","https://en.wikipedia.org/wiki/Serra_da_Capivara",{"_29":79,"_80":81},[234,235],{"_29":70,"_71":72},{"_27":67,"_68":69},{"_27":125,"_29":126},{"_27":236,"_29":237},"9","art",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,43]
