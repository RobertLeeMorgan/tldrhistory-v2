40":200,"_42":201,"_44":202,"_46":200,"_48":71,"_50":71,"_52":53,"_54":53,"_55":203,"_57":204,"_59":205,"_61":-5,"_62":206,"_64":207,"_66":208,"_68":209,"_70":71,"_72":73},{"_30":179,"_32":180,"_34":132,"_36":181,"_38":182,"_40":183,"_42":184,"_44":185,"_46":183,"_48":43,"_50":186,"_52":53,"_54":53,"_55":187,"_57":188,"_59":189,"_61":-5,"_62":190,"_64":191,"_66":192,"_68":193,"_70":71,"_72":73},{"_30":163,"_32":164,"_34":132,"_36":165,"_38":166,"_40":167,"_42":51,"_44":117,"_46":167,"_48":51,"_50":117,"_52":168,"_54":169,"_55":170,"_57":171,"_59":172,"_61":-5,"_62":173,"_64":174,"_66":175,"_68":176,"_70":71,"_72":73},{"_30":148,"_32":149,"_34":132,"_36":150,"_38":151,"_40":152,"_42":117,"_44":153,"_46":152,"_48":43,"_50":114,"_52":53,"_54":96,"_55":154,"_57":155,"_59":156,"_61":-5,"_62":157,"_64":158,"_66":159,"_68":160,"_70":71,"_72":73},{"_30":130,"_32":131,"_34":132,"_36":133,"_38":134,"_40":135,"_42":136,"_44":136,"_46":135,"_48":136,"_50":136,"_52":53,"_54":96,"_55":137,"_57":138,"_59":139,"_61":-5,"_62":140,"_64":141,"_66":142,"_68":143,"_70":71,"_72":73},{"_30":109,"_32":110,"_34":35,"_36":111,"_38":112,"_40":113,"_42":114,"_44":115,"_46":116,"_48":117,"_50":118,"_52":96,"_54":97,"_55":119,"_57":120,"_59":121,"_61":-5,"_62":122,"_64":123,"_66":124,"_68":125,"_70":71,"_72":73},{"_30":89,"_32":90,"_34":91,"_36":92,"_38":93,"_40":94,"_42":71,"_44":71,"_46":95,"_48":71,"_50":71,"_52":96,"_54":97,"_55":98,"_57":99,"_59":100,"_61":-5,"_62":101,"_64":102,"_66":103,"_68":104,"_70":71,"_72":73},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":53,"_55":56,"_57":58,"_59":60,"_61":-5,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73},"id","1901","name","Abdulhamid II","type","person","startDescription","The 34th Sultan of the Ottoman Empire, known for his autocratic rule and modernization efforts.","endDescription","His reign ended with the dissolution of the Ottoman Empire and the establishment of the Republic of Turkey.","startYear",1842,"startMonth",9,"startDay",21,"endYear",1918,"endMonth",2,"endDay",10,"startSignificance",0.9,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Sultan_Gazi_Abd%C3%BCl_Hamid_II_-_%D8%A7%D9%84%D8%B3%D9%84%D8%B7%D8%A7%D9%86_%D8%A7%D9%84%D8%BA%D8%A7%D8%B2%D9%8A_%D8%B9%D8%A8%D8%AF_%D8%A7%D9%84%D8%AD%D9%85%D9%8A%D8%AF_%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A.png/330px-Sultan_Gazi_Abd%C3%BCl_Hamid_II_-_%D8%A7%D9%84%D8%B3%D9%84%D8%B7%D8%A7%D9%86_%D8%A7%D9%84%D8%BA%D8%A7%D8%B2%D9%8A_%D8%B9%D8%A8%D8%AF_%D8%A7%D9%84%D8%AD%D9%85%D9%8A%D8%AF_%D8%A7%D9%84%D8%AB%D8%A7%D9%86%D9%8A.png","imageCredit","Image: Abdul Hamid II / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Abdulhamid_II","cdnId","country",{"_32":86,"_87":88},"subjects",[80,81],"group",{"_32":77,"_78":79},"user",{"_30":74,"_75":76},"likes",0,"liked",false,"6","username","HistOracle","Ottoman Empire","icon","GiCrossedSabres",{"_30":84,"_32":85},{"_30":82,"_32":83},"3","culture","2","politics","Turkey","continent","MiddleEast","1892","Tanzimat","period","A period of reform aimed at modernizing the Ottoman Empire's administrative structure, military, and legal systems to strengthen the state.","The reforms laid the groundwork for future modernization efforts but also faced significant resistance and challenges.",1839,1876,0.8,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c7/Coat_of_arms_of_the_Ottoman_Empire_%281882%E2%80%931922%29.svg/330px-Coat_of_arms_of_the_Ottoman_Empire_%281882%E2%80%931922%29.svg.png","Image: Tanzimat / Wikimedia Commons","https://en.wikipedia.org/wiki/Tanzimat",{"_32":86,"_87":88},[105,106],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":107,"_32":108},"8","economic","1894","Selim III","An influential sultan known for his attempts at modernizing the Ottoman military and administrative systems, initiating significant reforms.","His reign ended with his deposition, reflecting the challenges faced by reformist leaders in the empire.",1761,12,24,1808,7,28,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0a/Konstantin_Kapidagli_002.jpg/330px-Konstantin_Kapidagli_002.jpg","Image: Selim III / Wikimedia Commons","https://en.wikipedia.org/wiki/Selim_III",{"_32":86,"_87":88},[126,127],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},{"_30":84,"_32":85},"1","military","1899","Treaty of Karlowitz","event","This treaty marked a significant turning point in the power dynamics of Europe, concluding the Great Turkish War and establishing peace between the Ottoman Empire and the Holy League.","The treaty resulted in territorial losses for the Ottoman Empire, signaling a decline in its influence in Europe and the rise of the Habsburg Monarchy.",1699,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/Treaty_of_Karlowitz.jpg/330px-Treaty_of_Karlowitz.jpg","Image: Treaty of Karlowitz / Wikimedia Commons","https://en.wikipedia.org/wiki/Treaty_of_Karlowitz",{"_32":146,"_87":147},[144,145],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},{"_30":84,"_32":85},"Hungary","Europe","1891","The Siege of Vienna","A pivotal military campaign where the Ottoman forces attempted to capture Vienna, marking a critical moment in the struggle between the empire and European powers.","The failed siege marked the beginning of the empire's territorial retreat in Europe and a shift in the balance of power.",1683,14,"","Image: Siege of Vienna / Wikimedia Commons","https://en.wikipedia.org/wiki/Siege_of_Vienna",{"_32":162,"_87":147},[161],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},"Austria","1889","Battle of Lepanto","A major naval engagement between the Holy League and the Ottoman Empire, marking a significant turning point in the struggle for naval supremacy in the Mediterranean.","The battle resulted in a decisive defeat for the Ottomans, impacting their naval dominance and European perceptions of their military power.",1571,0.85,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3d/Laureys_a_Castro_-_The_Battle_of_Lepanto.jpeg/330px-Laureys_a_Castro_-_The_Battle_of_Lepanto.jpeg","Image: Battle of Lepanto / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Lepanto",{"_32":178,"_87":147},[177],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},"Greece","1898","Siege of Malta","A significant military confrontation where the Ottoman Empire attempted to capture the strategically important island of Malta from the Knights Hospitaller.","The siege concluded with the failure of the Ottoman forces to capture Malta, marking a pivotal moment in the struggle for control of the Mediterranean.",1565,5,18,11,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c5/Dimostrazione_di_tutte_le_batterie.png/330px-Dimostrazione_di_tutte_le_batterie.png","Image: Great Siege of Malta / Wikimedia Commons","https://en.wikipedia.org/wiki/Siege_of_Malta_(1565)",{"_32":195,"_87":147},[194],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},"Malta","1897","Battle of Mohács","A significant battle that marked the clash between the Ottoman Empire and the Kingdom of Hungary, leading to a decisive Ottoman victory.","The battle resulted in the fragmentation of Hungary and the establishment of Ottoman dominance in Central Europe.",1526,8,29,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Battle_of_Mohacs_1526.png/330px-Battle_of_Mohacs_1526.png","Image: Battle of Mohács / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Moh%C3%A1cs",{"_32":146,"_87":147},[210],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},"1890","Süleyman the Magnificent","A prominent ruler known for his significant contributions to the arts, architecture, and law, marking the apex of the empire's power and cultural achievements.","His death marked the beginning of a gradual decline in the empire's influence and territorial control.",1494,6,1566,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e9/EmperorSuleiman.jpg/330px-EmperorSuleiman.jpg","Image: Suleiman the Magnificent / Wikimedia Commons","https://en.wikipedia.org/wiki/Suleiman_the_Magnificent",{"_32":86,"_87":88},[225,226],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"1904","Selim I","A significant Ottoman sultan known for expanding the empire's territory and consolidating power.","His reign marked the beginning of the Ottoman Empire's golden age, leaving a lasting legacy.",1467,1520,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/66/Nakka%C5%9F_Selim.jpg/330px-Nakka%C5%9F_Selim.jpg","Image: Selim I / Wikimedia Commons","https://en.wikipedia.org/wiki/Selim_I",{"_32":86,"_87":88},[240,241],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},{"_30":84,"_32":85},"1893","Topkapi Palace","landmark","An opulent palace that served as the administrative center and residence of the Ottoman sultans for centuries, showcasing the empire's architectural grandeur.","It remains a significant historical site and museum, reflecting the rich cultural heritage of the Ottoman Empire.",1459,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Topkap%C4%B1_-_01.jpg/330px-Topkap%C4%B1_-_01.jpg","Image: Topkapı Palace / Wikimedia Commons","https://en.wikipedia.org/wiki/Topkapi_Palace",{"_32":86,"_87":88},[256,257],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},{"_30":258,"_32":259},"9","art","1903","Mehmed II","A prominent figure known for his military conquests and administrative reforms, he transformed the Ottoman Empire into a significant power in the 15th century.","His reign concluded with his death, leaving behind a legacy of territorial expansion and cultural development.",1432,3,30,1481,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6e/Bellini%2C_Gentile_-_Sultan_Mehmet_II.jpg/330px-Bellini%2C_Gentile_-_Sultan_Mehmet_II.jpg","Image: Mehmed II / Wikimedia Commons","https://en.wikipedia.org/wiki/Mehmed_II",{"_32":86,"_87":88},[275,276],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},{"_30":84,"_32":85},"1896","Battle of Ankara","A significant conflict that marked a turning point in the power dynamics of the region, involving two major empires.","The battle concluded with a decisive victory, leading to a temporary fragmentation of the Ottoman Empire.",1402,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Timur_reviews_his_troops_in_the_plain_of_Sivas_in_the_battle_of_Ankara_in_mid-summer_1402._Zafarnama_of_1436%2C_facing_folios_356r_%28left%29%2C_355v_%28right%29.jpg/330px-Timur_reviews_his_troops_in_the_plain_of_Sivas_in_the_battle_of_Ankara_in_mid-summer_1402._Zafarnama_of_1436%2C_facing_folios_356r_%28left%29%2C_355v_%28right%29.jpg","Image: Battle of Ankara / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Ankara",{"_32":86,"_87":88},[289],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":128,"_32":129},"1489","This period marked the rise of a vast empire that spanned three continents, known for its cultural, political, and military achievements.","The period concluded with the dissolution of the empire following World War I, leading to the establishment of modern nation-states.",1299,1922,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Flag_of_the_Ottoman_Empire_%281844%E2%80%931922%29.svg/330px-Flag_of_the_Ottoman_Empire_%281844%E2%80%931922%29.svg.png","Image: Ottoman Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Ottoman_Empire",{"_32":86,"_87":88},[302,303],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"1902","Osman I","The founder of the Ottoman Empire, he established a small principality in Bithynia that grew into a vast empire.","His death marked the transition of leadership to his son, which continued the expansion of the empire he founded.",1258,1326,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4a/I_Osman.jpg/330px-I_Osman.jpg","Image: Osman I / Wikimedia Commons","https://en.wikipedia.org/wiki/Osman_I",{"_32":86,"_87":88},[317],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,16]
