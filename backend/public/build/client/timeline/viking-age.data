0":192,"_42":193,"_44":194,"_45":192,"_47":193,"_48":194,"_49":50,"_51":112,"_52":195,"_54":196,"_56":197,"_58":-5,"_59":198,"_61":199,"_63":200,"_65":201,"_67":43,"_68":69},{"_30":169,"_32":170,"_34":87,"_36":171,"_38":172,"_40":173,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":174,"_51":175,"_52":176,"_54":177,"_56":178,"_58":-5,"_59":179,"_61":180,"_63":181,"_65":182,"_67":43,"_68":69},{"_30":154,"_32":155,"_34":35,"_36":156,"_38":157,"_40":158,"_42":43,"_44":43,"_45":159,"_47":43,"_48":43,"_49":112,"_51":50,"_52":160,"_54":161,"_56":162,"_58":-5,"_59":163,"_61":164,"_63":165,"_65":166,"_67":43,"_68":69},{"_30":138,"_32":139,"_34":87,"_36":140,"_38":141,"_40":142,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":112,"_51":43,"_52":143,"_54":144,"_56":145,"_58":-5,"_59":146,"_61":147,"_63":148,"_65":149,"_67":43,"_68":69},{"_30":123,"_32":124,"_34":35,"_36":125,"_38":126,"_40":127,"_42":43,"_44":43,"_45":128,"_47":43,"_48":43,"_49":112,"_51":113,"_52":129,"_54":130,"_56":131,"_58":-5,"_59":132,"_61":133,"_63":134,"_65":135,"_67":43,"_68":69},{"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_40":110,"_42":43,"_44":43,"_45":111,"_47":43,"_48":43,"_49":112,"_51":113,"_52":114,"_54":115,"_56":116,"_58":-5,"_59":117,"_61":118,"_63":119,"_65":120,"_67":43,"_68":69},{"_30":85,"_32":86,"_34":87,"_36":88,"_38":89,"_40":90,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":91,"_52":92,"_54":93,"_56":94,"_58":-5,"_59":95,"_61":96,"_63":97,"_65":98,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":50,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","1122","name","Harald Hardrada","type","person","startDescription","A formidable Viking king known for his military prowess and attempts to claim the English throne.","endDescription","His death at the Battle of Stamford Bridge marked the end of the Viking Age in England.","startYear",1015,"startMonth",0,"startDay","endYear",1066,"endMonth","endDay","startSignificance",0.9,"endSignificance","imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/0/0e/Harold-III-Coin.png/330px-Harold-III-Coin.png","imageCredit","Image: Harald Hardrada / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Harald_Hardrada","cdnId","country",{"_32":82,"_83":84},"subjects",[76,77],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Viking Age","icon","GiVikingHelmet",{"_30":80,"_32":81},{"_30":78,"_32":79},"2","politics","1","military","Norway","continent","Europe","2034","L'Anse aux Meadows","landmark","This archaeological site is the first known evidence of European settlement in North America, showcasing Norse presence in the New World.","The site remains a significant cultural landmark, providing insights into Norse exploration and settlement.",1000,0.1,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/68/Authentic_Viking_recreation.jpg/330px-Authentic_Viking_recreation.jpg","Image: L'Anse aux Meadows / Wikimedia Commons","https://en.wikipedia.org/wiki/L%27Anse_aux_Meadows",{"_32":103,"_83":104},[101],{"_32":73,"_74":75},{"_30":99,"_71":100},"7","Kushim",{"_30":70,"_32":102},"maritime","Canada","NorthAmerica","2133","Varangian Guard","period","This period marks the establishment of the Varangian Guard, an elite unit of the Byzantine Army composed mainly of Norse warriors.","The Varangian Guard's influence waned as the Byzantine Empire faced internal strife and external pressures, leading to its eventual dissolution.",988,1043,0.8,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/The_body_of_Leo_V_is_dragged_to_the_Hippodrome_through_the_Skyla_Gate.jpg/330px-The_body_of_Leo_V_is_dragged_to_the_Hippodrome_through_the_Skyla_Gate.jpg","Image: Varangian Guard / Wikimedia Commons","https://en.wikipedia.org/wiki/Varangian_Guard",{"_32":122,"_83":84},[121],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"Greece","1124","Leif Erikson","A Norse explorer from Iceland, credited with being the first European to set foot in North America, well before Columbus.","His legacy as a pioneer of exploration is celebrated, particularly in North America, where he is recognized for his contributions to maritime history.",970,1020,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Leif_Erikson_Statue%2C_Duluth_%2815290644106%29.jpg/330px-Leif_Erikson_Statue%2C_Duluth_%2815290644106%29.jpg","Image: Leif Erikson / Wikimedia Commons","https://en.wikipedia.org/wiki/Leif_Erikson",{"_32":137,"_83":84},[136],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":70,"_32":102},"Iceland","2119","Jelling Stones","These monumental stones are significant runestones that commemorate King Gorm the Old and his wife, Queen Thyra, marking the transition to Christianity in Denmark.","The stones remain a symbol of Denmark's early history and the unification of the Danish people.",965,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/Runesten_i_Jelling.jpg/330px-Runesten_i_Jelling.jpg","Image: Jelling stones / Wikimedia Commons","https://en.wikipedia.org/wiki/Jelling_stones",{"_32":153,"_83":84},[150,151],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},{"_30":99,"_32":152},"religion","Denmark","2134","Sweyn Forkbeard","A prominent king known for his military conquests and political maneuvers across Scandinavia and England.","His reign marked the establishment of Danish rule in England, influencing the region's political landscape.",960,1014,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Sweyn_Forkbeard.jpg/330px-Sweyn_Forkbeard.jpg","Image: Swein Forkbeard / Wikimedia Commons","https://en.wikipedia.org/wiki/Sweyn_Forkbeard",{"_32":153,"_83":84},[167,168],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":78,"_32":79},"1109","Althing","This assembly is one of the oldest parliaments in the world, established by the Norse settlers in Iceland.","The Althing continues to function today, symbolizing the democratic traditions rooted in Viking governance.",930,0.75,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/Althing_Logo.svg/330px-Althing_Logo.svg.png","Image: Althing / Wikimedia Commons","https://en.wikipedia.org/wiki/Althing",{"_32":137,"_83":84},[183,184],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},{"_30":185,"_32":186},"3","culture","2132","Battle of Edington","event","A significant conflict during the Viking Age, where the Saxons faced the invading Danish forces in a decisive battle.","The battle concluded with a Saxon victory, leading to the Treaty of Wedmore and the establishment of a boundary between Saxon and Viking territories.",878,4,6,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/27/Ethandunmem.jpg/330px-Ethandunmem.jpg","Image: Battle of Edington / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Edington",{"_32":203,"_83":84},[202],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"United Kingdom","2124","Settlement of Iceland","The beginning of a significant migration and establishment of Norse communities in a previously uninhabited land.","The formation of the Althing marked the establishment of a legislative assembly, solidifying governance in the new settlements.",874,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/36/The_Norwegians_land_in_Iceland_year_872.jpg/330px-The_Norwegians_land_in_Iceland_year_872.jpg","Image: Settlement of Iceland / Wikimedia Commons","https://en.wikipedia.org/wiki/Settlement_of_Iceland",{"_32":137,"_83":84},[216,217],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},{"_30":185,"_32":186},"2131","Battle of Hafrsfjord","This significant conflict marked the unification of Norway under a single ruler, showcasing the power struggles among local chieftains.","The battle concluded with a decisive victory that established a central authority in Norway, leading to the consolidation of various tribes.",872,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/82/Ole_Peter_Hansen_Balling_Harald_H%C3%A5rfagre_i_slaget_ved_Hafrsfjord.jpg/330px-Ole_Peter_Hansen_Balling_Harald_H%C3%A5rfagre_i_slaget_ved_Hafrsfjord.jpg","Image: Battle of Hafrsfjord / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Hafrsfjord",{"_32":82,"_83":84},[230,231],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":78,"_32":79},"2122","Siege of Paris","A significant military confrontation where Viking forces besieged the city, showcasing their naval prowess and tactical strategies.","The siege concluded with a substantial ransom paid to the Vikings, highlighting the vulnerability of the Frankish kingdom.",845,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c2/Viking_Siege_of_Paris.jpg/330px-Viking_Siege_of_Paris.jpg","Image: Siege of Paris (845) / Wikimedia Commons","https://en.wikipedia.org/wiki/Siege_of_Paris_(845)",{"_32":246,"_83":84},[245],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"France","1123","Ivar the Boneless","A legendary Viking leader known for his cunning strategies and leadership in the Great Heathen Army.","His death left a significant impact on Viking raids in England and the legacy of his family.",830,873,"","https://en.wikipedia.org/wiki/Ivar_the_Boneless",{"_32":261,"_83":84},[259,260],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":80,"_32":81},{"_30":185,"_32":186},"Ireland","1114","Oseberg Ship","An archaeological find, this ship is one of the best-preserved Viking ships, showcasing advanced shipbuilding techniques.","Its discovery provided significant insights into Viking maritime culture and burial practices.",820,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/Osebergskipet_2016.jpg/330px-Osebergskipet_2016.jpg","Image: Oseberg ship / Wikimedia Commons","https://en.wikipedia.org/wiki/Oseberg_ship",{"_32":82,"_83":84},[274,275],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":185,"_32":186},{"_30":70,"_32":102},"2123","First Raid on Lindisfarne","This significant raid marked the beginning of the Viking Age, showcasing the Norsemen's maritime prowess and their impact on Christian communities.","The raid concluded with the looting of the monastery, leading to widespread fear and marking a pivotal moment in European history.",793,8,"https://en.wikipedia.org/wiki/First_raid_on_Lindisfarne",{"_32":203,"_83":84},[287,288],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":99,"_32":152},"74","The Viking Age","A period marked by Norse exploration, trade, and raids across Europe, significantly impacting various cultures.","The Viking Age ended with the integration of Norsemen into European societies, transforming their legacy.","https://upload.wikimedia.org/wikipedia/commons/thumb/9/9a/Bildsten_fr%C3%A5n_Smiss%2C_Gotland.jpg/330px-Bildsten_fr%C3%A5n_Smiss%2C_Gotland.jpg","historical museum / Wikimedia Commons / CC BY 2.5","https://en.wikipedia.org/wiki/Viking_Age","images/ae5acb9685c3d8115c277b2532c2cbc55dd320a1.webp",{"_32":82,"_83":84},[301,302],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":80,"_32":81},{"_30":185,"_32":186},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,9]
