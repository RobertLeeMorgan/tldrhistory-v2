ndMonth","endDay","startSignificance",1,"endSignificance",0,"imageUrl","imageCredit","sourceUrl","https://en.wikipedia.org/wiki/Dissolution_of_the_Soviet_Union","cdnId","country",{"_32":81,"_82":83},"subjects",[75,76],"group",{"_32":72,"_73":74},"user",{"_30":69,"_70":71},"likes","liked",false,"7","username","Kushim","Cold War","icon","GiSubmarineMissile",{"_30":79,"_32":80},{"_30":77,"_32":78},"2","politics","1","military","Russia","continent","Europe","543","The Space Shuttle Program","period","A program by NASA that developed reusable spacecraft to transport astronauts and cargo to and from space.","The program concluded after 30 years of service, marking significant advancements in space exploration and technology.",1981,4,2011,7,21,0.8,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/STS120LaunchHiRes-edit1.jpg/330px-STS120LaunchHiRes-edit1.jpg","NASA / edited by  jjron / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Space_Shuttle","images/9a6de6587c7013d9f89c4d7c51d295c8b6fe96be.webp",{"_32":111,"_82":112},[106,107],{"_32":72,"_73":74},{"_30":104,"_70":105},"6","HistOracle",{"_30":109,"_32":110},{"_30":104,"_32":108},"maritime","4","intellectual","United States of America","NorthAmerica","986","Apollo 11 Moon Landing","This historic event marked the first time humans set foot on the lunar surface, showcasing remarkable advancements in space exploration.","The successful return of the astronauts to Earth concluded a pivotal moment in human history and space exploration.",1969,20,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/A_Man_on_the_Moon%2C_AS11-40-5903_%28cropped%29.jpg/330px-A_Man_on_the_Moon%2C_AS11-40-5903_%28cropped%29.jpg","Image: Apollo 11 / Wikimedia Commons","https://en.wikipedia.org/wiki/Apollo_11",{"_32":111,"_82":112},[126,127],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":128,"_32":129},{"_30":109,"_32":110},"3","culture","1487","My Lai Massacre","A tragic event during the Vietnam War where a large number of unarmed South Vietnamese civilians were killed by U.S. Army soldiers.","The incident led to widespread outrage and became a pivotal moment in public perception of the Vietnam War.",1968,3,16,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/77/My_Lai_massacre.jpg/330px-My_Lai_massacre.jpg","Image: My Lai massacre / Wikimedia Commons","https://en.wikipedia.org/wiki/My_Lai_massacre",{"_32":146,"_82":147},[145],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":79,"_32":80},"Vietnam","Asia","292","The Cuban Missile Crisis","A 13-day confrontation between the United States and the Soviet Union over Soviet ballistic missiles deployed in Cuba.","The crisis ended with an agreement to remove missiles from Cuba and a secret U.S. commitment to withdraw missiles from Turkey.",1962,10,28,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/PGM-19A_Jupiter_missile-02.jpg/330px-PGM-19A_Jupiter_missile-02.jpg","USAF / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Cuban_Missile_Crisis","images/6992046f949804fa1b70413c49e27c08597b4b33.webp",{"_32":166,"_82":112},[164,165],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":79,"_32":80},{"_30":77,"_32":78},"Cuba","1488","Agent Orange","A powerful herbicide and defoliant deployed by the U.S. military during the Vietnam War as a weapon of chemical warfare, aimed at destroying forests and crops to deprive enemy forces of cover and food.","The spraying campaign ended, but Agent Orange left a legacy of long-term suffering: severe health problems, birth defects, and environmental destruction across Vietnam.",1961,1971,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1f/US-Huey-helicopter-spraying-Agent-Orange-in-Vietnam.jpg/330px-US-Huey-helicopter-spraying-Agent-Orange-in-Vietnam.jpg","Image: Agent Orange / Wikimedia Commons","https://en.wikipedia.org/wiki/Agent_Orange",{"_32":146,"_82":147},[180,181],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":79,"_32":80},{"_30":182,"_32":183},"5","environment","569","The Apollo Program","This program was initiated to land humans on the Moon and bring them safely back to Earth, showcasing American technological prowess during the Space Race.","The program successfully achieved its goal with Apollo 11, marking a significant achievement in human exploration and science.",1972,19,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/00/Apollo_program.svg/330px-Apollo_program.svg.png","Original / NASA   Vector / Lommes / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Apollo_program","images/9d76e0a84c6504076dfe4ec3c09773f599f1b12c.webp",{"_32":111,"_82":112},[198,199],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":79,"_32":80},{"_30":109,"_32":110},"291","The Space Race","A competition between the United States and the Soviet Union for supremacy in space exploration, marked by significant technological advancements.","The period concluded with the Apollo-Soyuz Test Project, symbolizing a thaw in relations between the two superpowers.",1957,1975,17,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/be/Sputnik_asm.jpg/330px-Sputnik_asm.jpg","NSSDC / NASA [1] / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Space_Race","images/1f72a31df0eae26cceae9397016e9dd567241c2a.webp",{"_32":217,"_82":217},[216],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":109,"_32":110},"Global","238","The Vietnam War","A conflict in Southeast Asia involving North Vietnam and South Vietnam, with significant U.S. involvement.","The war ended with the fall of Saigon, leading to the reunification of Vietnam under communist control.",1955,11,30,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/67/U.S._Army_UH-1H_Hueys_insert_ARVN_troops_at_Kh%C3%A2m_%C4%90%E1%BB%A9c%2C_Vietnam%2C_12_July_1970_%2879431435%29.jpg/330px-U.S._Army_UH-1H_Hueys_insert_ARVN_troops_at_Kh%C3%A2m_%C4%90%E1%BB%A9c%2C_Vietnam%2C_12_July_1970_%2879431435%29.jpg","U.S. Air Force / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Vietnam_War","images/be770c89e5cf97d091b6d22eeacc3c3a7790c1ea.webp",{"_32":146,"_82":147},[233,234],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":79,"_32":80},{"_30":77,"_32":78},"290","The Korean War","A conflict between North and South Korea that began when North Korea invaded the South, leading to a military response from the United Nations.","The war ended with an armistice agreement, establishing the Korean Demilitarized Zone, but no formal peace treaty was signed.",1950,6,25,1953,27,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7b/Chosin.jpg/330px-Chosin.jpg","Photo by Corporal Peter McDonald / USMC / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Korean_War","images/c10a7e4dac3fa13c811bd053241b969dd35a8f64.webp",{"_32":254,"_82":147},[252,253],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":79,"_32":80},{"_30":77,"_32":78},"South Korea","236","The Cold War","A prolonged period of geopolitical tension between the Soviet Union and the United States.","The period concluded with the dissolution of the Soviet Union, marking a significant shift in global power dynamics.",1947,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/dc/NATO_vs._Warsaw_Pact_%281949-1990%29.svg/330px-NATO_vs._Warsaw_Pact_%281949-1990%29.svg.png","Discombobulates / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Cold_War","images/6a747d57bcca9f2a81e221f3619c0d2a97ad4f8e.webp",{"_32":217,"_82":217},[268],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":77,"_32":78},"360","Operation Highjump","This large-scale military operation aimed to establish the United States' presence in Antarctica and conduct extensive scientific research.","The operation successfully mapped large portions of Antarctica and laid the groundwork for future international cooperation in polar research.",1946,8,2,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/05/USS_Sennet_%28SS-408%29_in_Antartica_1947.jpg/330px-USS_Sennet_%28SS-408%29_in_Antartica_1947.jpg","U.S. Navy / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Operation_Highjump","images/9867ad4746afe4a2b9861028514dc1a817abd095.webp",{"_32":286,"_82":286},[284,285],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":79,"_32":80},{"_30":182,"_32":183},"Antarctica","1868","Battle of Khalkhin Gol","A significant conflict between the Soviet Union and Japan, marking a key moment in military history.","The battle concluded with a decisive Soviet victory, influencing future military strategies in the region.",1939,5,9,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f0/Japanese_soldiers_creeping_in_front_of_wrecked_Soviet_tanks.jpg/330px-Japanese_soldiers_creeping_in_front_of_wrecked_Soviet_tanks.jpg","Image: Battles of Khalkhin Gol / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_Khalkhin_Gol",{"_32":302,"_82":147},[301],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":79,"_32":80},"Mongolia","897","Fidel Castro","person","A revolutionary leader who played a pivotal role in the Cuban Revolution, he established a socialist state in Cuba that lasted for decades.","His policies and leadership style have left a lasting impact on Cuba and its relationship with the world.",1926,13,2016,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/32/Fidel_Castro_%28c._1959%29_%283x4_cropped%29.jpg/330px-Fidel_Castro_%28c._1959%29_%283x4_cropped%29.jpg","Image: Fidel Castro / Wikimedia Commons","https://en.wikipedia.org/wiki/Fidel_Castro",{"_32":166,"_82":112},[318],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":77,"_32":78},"1362","Soviet Union","A socialist state that existed in Eurasia, known for its significant influence on global politics, economy, and culture during the 20th century.","The dissolution marked the end of a superpower and led to the emergence of multiple independent states.",1922,"https://upload.wikimedia.org/wikipedia/commons/thumb/a/a9/Flag_of_the_Soviet_Union.svg/330px-Flag_of_the_Soviet_Union.svg.png","Image: Soviet Union / Wikimedia Commons","https://en.wikipedia.org/wiki/Soviet_Union",{"_32":81,"_82":83},[331,332],{"_32":72,"_73":74},{"_30":104,"_70":105},{"_30":77,"_32":78},{"_30":128,"_32":129},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,39]
