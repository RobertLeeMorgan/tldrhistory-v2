,"_42":43,"_44":43,"_45":183,"_46":43,"_47":43,"_48":88,"_50":51,"_52":184,"_54":185,"_55":186,"_57":-5,"_58":187,"_60":188,"_62":189,"_64":190,"_66":43,"_67":68},{"_30":163,"_32":164,"_34":83,"_36":165,"_38":166,"_40":167,"_42":43,"_44":43,"_45":168,"_46":43,"_47":43,"_48":49,"_50":169,"_52":170,"_54":171,"_55":172,"_57":-5,"_58":173,"_60":174,"_62":175,"_64":176,"_66":43,"_67":68},{"_30":150,"_32":151,"_34":83,"_36":152,"_38":153,"_40":154,"_42":43,"_44":43,"_45":41,"_46":43,"_47":43,"_48":155,"_50":51,"_52":156,"_54":157,"_55":158,"_57":-5,"_58":159,"_60":160,"_62":161,"_64":162,"_66":43,"_67":68},{"_30":137,"_32":138,"_34":83,"_36":139,"_38":140,"_40":141,"_42":43,"_44":43,"_45":142,"_46":43,"_47":43,"_48":49,"_50":88,"_52":53,"_54":-5,"_55":143,"_57":-5,"_58":144,"_60":145,"_62":146,"_64":147,"_66":43,"_67":68},{"_30":118,"_32":119,"_34":120,"_36":121,"_38":122,"_40":123,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":124,"_50":49,"_52":125,"_54":126,"_55":127,"_57":-5,"_58":128,"_60":129,"_62":130,"_64":131,"_66":43,"_67":68},{"_30":102,"_32":103,"_34":35,"_36":104,"_38":105,"_40":106,"_42":107,"_44":108,"_45":106,"_46":107,"_47":108,"_48":51,"_50":88,"_52":109,"_54":110,"_55":111,"_57":-5,"_58":112,"_60":113,"_62":114,"_64":115,"_66":43,"_67":68},{"_30":81,"_32":82,"_34":83,"_36":84,"_38":85,"_40":86,"_42":43,"_44":43,"_45":87,"_46":43,"_47":43,"_48":49,"_50":88,"_52":89,"_54":90,"_55":91,"_57":-5,"_58":92,"_60":93,"_62":94,"_64":95,"_66":43,"_67":68},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":41,"_46":43,"_47":43,"_48":49,"_50":51,"_52":53,"_54":53,"_55":56,"_57":-5,"_58":59,"_60":61,"_62":63,"_64":65,"_66":43,"_67":68},"id","2142","name","Moroccan Invasion of Songhai","type","event","startDescription","This military campaign marked the beginning of the decline of the Songhai Empire, as Moroccan forces invaded to seize control of the lucrative trans-Saharan trade routes.","endDescription","The invasion ultimately led to the fragmentation of the Songhai Empire and the establishment of Moroccan influence in West Africa.","startYear",1591,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.8,"endSignificance",0.7,"imageUrl","","imageCredit","sourceUrl","https://en.wikipedia.org/wiki/Moroccan_invasion_of_Songhai","cdnId","country",{"_32":78,"_79":80},"subjects",[75],"group",{"_32":72,"_73":74},"user",{"_30":69,"_70":71},"likes","liked",false,"7","username","Kushim","West African Empires","icon","GiDjembe",{"_30":76,"_32":77},"1","military","Mali","continent","Africa","2266","Luba Empire","period","The Luba Empire was a centralized kingdom in central Africa, known for its art, political organization, and trade networks.","It declined due to internal divisions and the expansion of neighboring powers.",1585,1889,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/Luba_Empire_map.png/330px-Luba_Empire_map.png","Image: Luba Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Luba_people",{"_32":101,"_79":80},[98],{"_32":72,"_73":74},{"_30":96,"_70":97},"6","HistOracle",{"_30":99,"_32":100},"3","culture","Democratic Republic of the Congo","2143","Battle of the Three Kings","A significant military confrontation that marked the struggle for power in the region, involving key figures from Portugal and Morocco.","The battle concluded with a decisive defeat for the Portuguese forces, impacting their influence in West Africa.",1578,8,4,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/4f/Battle_of_alcacer_quibir.jpg/330px-Battle_of_alcacer_quibir.jpg","Image: Battle of Alcácer Quibir / Wikimedia Commons","https://en.wikipedia.org/wiki/Battle_of_the_Three_Kings",{"_32":117,"_79":80},[116],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":76,"_32":77},"Morocco","2144","Queen Amina of Zazzau","person","A prominent and powerful ruler known for her military conquests and expansion of the Zazzau kingdom, she is celebrated for her leadership and strategic prowess.","Her legacy endures as a symbol of female empowerment and military strength in West African history.",1533,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/eb/Queen_Amina_Statue_%28cropped%29.jpg/330px-Queen_Amina_Statue_%28cropped%29.jpg","Image: Amina of Zazzau / Wikimedia Commons","https://en.wikipedia.org/wiki/Amina_of_Zazzau",{"_32":136,"_79":80},[132,133],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":76,"_32":77},{"_30":134,"_32":135},"2","politics","Nigeria","2141","Igbo Confederacies","A collection of autonomous communities and city-states in southeastern Nigeria, known for their rich cultural heritage and complex social structures.","The confederacies gradually diminished in power due to colonial influences and the imposition of foreign governance.",1500,1900,"https://en.wikipedia.org/wiki/Igbo_confederacies",{"_32":136,"_79":80},[148,149],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":134,"_32":135},{"_30":99,"_32":100},"1209","Songhai Empire","This empire emerged as a successor to the Mali Empire, dominating trade routes and becoming one of the largest empires in African history.","The empire fell to Moroccan invaders, leading to its disintegration and loss of economic power.",1430,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/49/Map_of_the_Songhay_Empire.png/330px-Map_of_the_Songhay_Empire.png","Image: Songhai Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Songhai_Empire",{"_32":78,"_79":80},[],{"_32":72,"_73":74},{"_30":96,"_70":97},"2265","Kongo Kingdom","The Kongo Kingdom was a centralized state in west-central Africa that engaged in trade with Europeans and developed a sophisticated political system.","It gradually lost independence under colonial pressure and was absorbed into the Congo Free State and later Belgian Congo.",1390,1914,0.65,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Kongo_Kingdom_map.png/330px-Kongo_Kingdom_map.png","Image: Kongo Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Kingdom_of_Kongo",{"_32":101,"_79":80},[177],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":99,"_32":100},"2139","Oyo Empire","The Oyo Empire was a powerful Yoruba state in West Africa, known for its sophisticated political structure and military prowess.","The empire declined in the late 19th century due to internal strife and external pressures, leading to its eventual collapse.",1300,1896,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/85/Oyo_Empire_at_Its_Greatest_Extent%2C_c._1780_%285%29.jpg/330px-Oyo_Empire_at_Its_Greatest_Extent%2C_c._1780_%285%29.jpg","Image: Oyo Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Oyo_Empire",{"_32":136,"_79":80},[191,192],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":76,"_32":77},{"_30":134,"_32":135},"918","Mansa Musa","The ninth emperor of the Mali Empire, he is renowned for his wealth, lavish pilgrimage to Mecca, and the promotion of education and culture. His reign is often considered the height of the Mali Empire's power and influence.","His death marked the decline of the Mali Empire, but his legacy continues to influence the region's culture and history.",1280,1337,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/46/Catalan_Atlas_BNF_Sheet_6_Mansa_Musa_%28cropped%29.jpg/330px-Catalan_Atlas_BNF_Sheet_6_Mansa_Musa_%28cropped%29.jpg","Image: Mansa Musa / Wikimedia Commons","https://en.wikipedia.org/wiki/Mansa_Musa",{"_32":78,"_79":80},[207],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":99,"_32":100},"483","Mali Empire","This empire was one of the largest and wealthiest in West Africa, known for its rich resources, trade routes, and centers of learning.","The empire eventually fragmented into smaller states due to internal strife and external pressures, leading to its decline.",1235,1600,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/Map_of_the_Mali_Empire.png/330px-Map_of_the_Mali_Empire.png","HetmanTheResearcher / Wikimedia Commons / CC BY 4.0","https://en.wikipedia.org/wiki/Mali_Empire","images/f1e184724418887edf1055e71427a9ee3846cce3.webp",{"_32":78,"_79":80},[223],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":224,"_32":225},"4","intellectual","1430","Mossi Kingdom v Islamic Empires","A series of conflicts between the Mossi Kingdom and various Islamic empires, primarily over territorial control and influence.","The conflicts resulted in the consolidation of the Mossi Kingdom's power and the establishment of its cultural identity amidst external pressures.",1200,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/96/WestAfrica1530-en.svg/330px-WestAfrica1530-en.svg.png","Image: Mossi Kingdoms / Wikimedia Commons","https://en.wikipedia.org/wiki/Mossi_Kingdom",{"_32":239,"_79":80},[238],{"_32":72,"_73":74},{"_30":69,"_70":71},{"_30":76,"_32":77},"Burkina Faso","2140","Benin Kingdom","This kingdom was known for its sophisticated governance, rich culture, and impressive artistic achievements, particularly in bronze and ivory.","The kingdom faced significant decline after the British invasion, leading to its eventual dissolution and loss of sovereignty.",1180,1897,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fd/Benin_1625_locator.png/330px-Benin_1625_locator.png","Image: Kingdom of Benin / Wikimedia Commons","https://en.wikipedia.org/wiki/Benin_Kingdom",{"_32":136,"_79":80},[253,254],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":134,"_32":135},{"_30":99,"_32":100},"494","Timbuktu","landmark","This historic city was a major center for trade, culture, and education in medieval West Africa, known for its libraries and universities.","It remains a UNESCO World Heritage site, symbolizing the rich history and cultural heritage of Africa.",1100,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/67/Donkeys%2C_Timbuktu.jpg/330px-Donkeys%2C_Timbuktu.jpg","people / Wikimedia Commons / CC BY 2.0","https://en.wikipedia.org/wiki/Timbuktu","images/cc711faac8c451f652643683b609d8283af42583.webp",{"_32":78,"_79":80},[270,271],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":99,"_32":100},{"_30":224,"_32":225},"1627","The Trans-Saharan Trade","This event marked the beginning of extensive trade routes across the Sahara Desert, facilitating the exchange of goods, culture, and ideas between West Africa and the Mediterranean.","The decline of the trade routes occurred due to colonial interventions and the rise of alternative trade routes, significantly altering the economic landscape of West Africa.",700,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d8/French_language_map_of_Central_and_Eastern_Africa_1862.jpg/330px-French_language_map_of_Central_and_Eastern_Africa_1862.jpg","Image: Trans-Saharan trade / Wikimedia Commons","https://en.wikipedia.org/wiki/Trans-Saharan_trade",{"_32":78,"_79":80},[284,285],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":99,"_32":100},{"_30":286,"_32":287},"8","economic","2135","Ghana Empire","This period marks the rise of a powerful empire in West Africa, known for its wealth and trade, particularly in gold and salt.","The empire eventually declined due to various factors including overextension and competition from neighboring states.",300,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/Ghana_empire_map.png/330px-Ghana_empire_map.png","Image: Ghana Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Ghana_Empire",{"_32":78,"_79":80},[300],{"_32":72,"_73":74},{"_30":96,"_70":97},{"_30":286,"_32":287},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,32]
