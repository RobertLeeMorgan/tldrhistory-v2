88,"_42":71,"_44":71,"_46":189,"_48":71,"_49":71,"_51":190,"_53":157,"_55":191,"_57":192,"_59":193,"_61":194,"_62":195,"_64":196,"_66":197,"_68":198,"_70":71,"_72":73},{"_30":169,"_32":170,"_34":91,"_36":171,"_38":172,"_40":173,"_42":71,"_44":71,"_46":174,"_48":71,"_49":71,"_51":54,"_53":175,"_55":176,"_57":177,"_59":178,"_61":-5,"_62":179,"_64":180,"_66":181,"_68":182,"_70":71,"_72":73},{"_30":151,"_32":152,"_34":91,"_36":153,"_38":154,"_40":155,"_42":71,"_44":71,"_46":156,"_48":71,"_49":71,"_51":157,"_53":54,"_55":158,"_57":159,"_59":160,"_61":-5,"_62":161,"_64":162,"_66":163,"_68":164,"_70":71,"_72":73},{"_30":137,"_32":138,"_34":91,"_36":139,"_38":140,"_40":141,"_42":71,"_44":71,"_46":94,"_48":71,"_49":71,"_51":52,"_53":54,"_55":142,"_57":143,"_59":144,"_61":145,"_62":146,"_64":147,"_66":148,"_68":149,"_70":71,"_72":73},{"_30":122,"_32":123,"_34":35,"_36":124,"_38":125,"_40":126,"_42":71,"_44":71,"_46":127,"_48":71,"_49":71,"_51":97,"_53":52,"_55":128,"_57":129,"_59":130,"_61":-5,"_62":131,"_64":132,"_66":133,"_68":134,"_70":71,"_72":73},{"_30":107,"_32":108,"_34":109,"_36":110,"_38":111,"_40":112,"_42":71,"_44":71,"_46":95,"_48":71,"_49":71,"_51":97,"_53":52,"_55":113,"_57":114,"_59":115,"_61":-5,"_62":116,"_64":117,"_66":118,"_68":119,"_70":71,"_72":73},{"_30":89,"_32":90,"_34":91,"_36":92,"_38":93,"_40":94,"_42":71,"_44":71,"_46":95,"_48":71,"_49":71,"_51":96,"_53":97,"_55":98,"_57":99,"_59":100,"_61":-5,"_62":101,"_64":102,"_66":103,"_68":104,"_70":71,"_72":73},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":45,"_46":47,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":-5,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73},"id","911","name","Empress Dowager Cixi","type","person","startDescription","A powerful and influential figure in late Qing dynasty China, she effectively controlled the Chinese government for nearly half a century. Her reign was marked by significant political and social changes.","endDescription","Her death marked the end of an era, leading to the fall of the Qing dynasty and the establishment of the Republic of China.","startYear",1835,"startMonth",11,"startDay",29,"endYear",1908,"endMonth","endDay",15,"startSignificance",0.8,"endSignificance",0.7,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/7/7a/The_Ci-Xi_Imperial_Dowager_Empress_%289.2%29.PNG/330px-The_Ci-Xi_Imperial_Dowager_Empress_%289.2%29.PNG","imageCredit","Image: Empress Dowager Cixi / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Empress_Dowager_Cixi","cdnId","country",{"_32":86,"_87":88},"subjects",[80,81],"group",{"_32":77,"_78":79},"user",{"_30":74,"_75":76},"likes",0,"liked",false,"6","username","HistOracle","Imperial China","icon","GiPagoda",{"_30":84,"_32":85},{"_30":82,"_32":83},"3","culture","2","politics","China","continent","Asia","1548","Qing Dynasty","period","The last imperial dynasty of China, it was established by the Manchu and characterized by territorial expansion and cultural flourishing.","The dynasty ended with the Xinhai Revolution, leading to the establishment of the Republic of China and significant political change.",1644,1912,0.95,0.9,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Flag_of_China_%281889%E2%80%931912%29.svg/330px-Flag_of_China_%281889%E2%80%931912%29.svg.png","Image: Qing dynasty / Wikimedia Commons","https://en.wikipedia.org/wiki/Qing_dynasty",{"_32":86,"_87":88},[105,106],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"946","Forbidden City","landmark","This imperial palace served as the home of emperors and the political center of Chinese government for almost 500 years. It is a masterpiece of traditional Chinese architecture and is surrounded by a large defensive wall.","After the fall of the Qing dynasty, the palace was no longer used as a royal residence and became a museum, preserving its rich history and cultural significance.",1406,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ef/The_Forbidden_City_-_View_from_Coal_Hill.jpg/330px-The_Forbidden_City_-_View_from_Coal_Hill.jpg","Image: Forbidden City / Wikimedia Commons","https://en.wikipedia.org/wiki/Forbidden_City",{"_32":86,"_87":88},[120,121],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"907","Zheng He","A Chinese mariner, explorer, diplomat, and fleet admiral during the early Ming dynasty, he is known for his seven voyages to Southeast Asia, South Asia, the Middle East, and East Africa.","His expeditions greatly expanded China's maritime and commercial influence, establishing trade routes and diplomatic relations.",1371,1433,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0e/2016_Malakka%2C_Stadhuys_%2809%29.jpg/330px-2016_Malakka%2C_Stadhuys_%2809%29.jpg","Image: Zheng He / Wikimedia Commons","https://en.wikipedia.org/wiki/Zheng_He",{"_32":86,"_87":88},[135],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":74,"_32":136},"maritime","205","The Ming Dynasty","A major Chinese dynasty known for its trade expansion, cultural achievements, and the construction of the Great Wall.","The dynasty ended with the rise of the Qing Dynasty, marking a significant transition in Chinese history.",1368,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Map_of_Ming_Chinese_empire_1415_%28cropped_2%29.jpg/330px-Map_of_Ming_Chinese_empire_1415_%28cropped_2%29.jpg","Albert Herrmann  Creator / Georg Westermann / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Ming_dynasty","images/7fe1326ced0346dd51a11069b56b1e0bbd13cd1d.webp",{"_32":86,"_87":88},[150],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},"1550","Jin Dynasty","Founded by the Jurchen people, this dynasty ruled northern China and was known for its military prowess and cultural developments.","The dynasty ended when the Mongol Empire conquered its territories, leading to significant changes in the region's power dynamics.",1115,1234,0.75,"","Image: Jin / Wikimedia Commons","https://en.wikipedia.org/wiki/Jin_dynasty",{"_32":86,"_87":88},[165,166],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":167,"_32":168},{"_30":82,"_32":83},"1","military","2250","Western Xia","The Western Xia Dynasty was a Tangut-ruled kingdom in northwestern China, known for its distinct Tangut script and interactions with neighboring Song and Liao dynasties.","It was destroyed by the Mongol Empire under Genghis Khan in the 13th century.",1038,1227,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7f/Western_Xia_map.png/330px-Western_Xia_map.png","Image: Western Xia / Wikimedia Commons","https://en.wikipedia.org/wiki/Western_Xia",{"_32":86,"_87":88},[183],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},"200","The Song Dynasty","This period is known for its economic prosperity, technological innovations, and flourishing arts, marking a high point in Chinese civilization.","The dynasty ended with the Mongol conquest, leading to the establishment of the Yuan dynasty.",960,1279,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/69/China_-_Song_Dynasty-en.svg/330px-China_-_Song_Dynasty-en.svg.png","Mozzan / Kanguole / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Song_dynasty","images/f103f28f6e7e5151b733b884dbf60a50e83c5c07.webp",{"_32":86,"_87":88},[199],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},"2249","Liao Dynasty","The Liao Dynasty was established by the Khitan people in northern China and Mongolia, known for its dual administration system accommodating both nomadic and sedentary populations.","It fell to the Jurchen-led Jin Dynasty in the 12th century.",907,1125,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9e/Liao_dynasty_map.png/330px-Liao_dynasty_map.png","Image: Liao Dynasty / Wikimedia Commons","https://en.wikipedia.org/wiki/Liao_dynasty",{"_32":86,"_87":88},[213],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},"1551","Five Dynasties and Ten Kingdoms","This period was marked by political fragmentation and the rise of multiple short-lived dynasties and kingdoms in China after the Tang dynasty.","It concluded with the establishment of the Song dynasty, which unified China and brought about significant advancements.",979,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/Five_Dynasties_Ten_Kingdoms_923_CE.png/330px-Five_Dynasties_Ten_Kingdoms_923_CE.png","Image: Five Dynasties and Ten Kingdoms period / Wikimedia Commons","https://en.wikipedia.org/wiki/Five_Dynasties_and_Ten_Kingdoms",{"_32":86,"_87":88},[226,227],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"1340","Invention of the Fire Lance","event","The fire lance was an early type of firearm that combined a tube for gunpowder and projectiles with a flame-producing mechanism.","The use of the fire lance gradually evolved into more advanced firearms, marking a significant shift in military technology.",900,1000,0.5,"https://upload.wikimedia.org/wikipedia/commons/4/48/%E6%A2%A8%E8%8A%B1%E9%8E%97.jpg","Image: Fire lance / Wikimedia Commons","https://en.wikipedia.org/wiki/Fire_lance",{"_32":86,"_87":88},[243],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":167,"_32":168},"76","The Tang Dynasty","A high point in Chinese civilization, known for its cultural, political, and economic prosperity.","The dynasty's fall marked the beginning of a period of disunity in China, impacting its future development.",618,1,12,31,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9f/Tang_outline_map%2C_661.svg/330px-Tang_outline_map%2C_661.svg.png","Kanguole / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Tang_dynasty","images/0835f4e18fe19485133f7a773a023a550ef93999.webp",{"_32":86,"_87":88},[260,261],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":84,"_32":85},{"_30":82,"_32":83},"2248","Sui Dynasty","The Sui Dynasty unified China after a long period of division, initiating major infrastructure projects like the Grand Canal and strengthening central government.","It collapsed due to internal revolts and overextension in military campaigns.",581,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Sui_dynasty_map.png/330px-Sui_dynasty_map.png","Image: Sui Dynasty / Wikimedia Commons","https://en.wikipedia.org/wiki/Sui_dynasty",{"_32":86,"_87":88},[274],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":82,"_32":83},"1312","Shaolin Monks","The establishment of the Shaolin Temple marked the beginning of a significant cultural and religious movement in China, intertwining martial arts with Buddhist practices.","The influence of the Shaolin monks continues to shape martial arts and cultural practices in China and beyond, symbolizing resilience and spiritual discipline.",495,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1d/Shaolin_Temple_%2810199450903%29.jpg/330px-Shaolin_Temple_%2810199450903%29.jpg","Image: Shaolin Monastery / Wikimedia Commons","https://en.wikipedia.org/wiki/Shaolin_Temple",{"_32":86,"_87":88},[289,290],{"_32":77,"_78":79},{"_30":287,"_75":288},"7","Kushim",{"_30":82,"_32":83},{"_30":287,"_32":291},"religion","64","Three Kingdoms","The Three Kingdoms period was characterized by the fragmentation of the Han dynasty and the rise of three rival states in China.","It ended with the reunification of China under the Jin dynasty, marking a significant shift in power.",220,280,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b9/Three_Kingdoms_timelapse.gif/330px-Three_Kingdoms_timelapse.gif","Three Kingdoms fan / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Three_Kingdoms","images/aabffc7452604546c4ac4cdf4b3a281ca16ff3d6.webp",{"_32":86,"_87":88},[306,307],{"_32":77,"_78":79},{"_30":74,"_75":76},{"_30":167,"_32":168},{"_30":84,"_32":85},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,22]
