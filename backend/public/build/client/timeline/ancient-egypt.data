:190,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":112,"_50":43,"_52":191,"_54":192,"_56":193,"_58":-5,"_59":194,"_61":195,"_63":196,"_65":197,"_67":43,"_68":69},{"_30":170,"_32":171,"_34":87,"_36":172,"_38":173,"_40":174,"_42":43,"_44":43,"_45":175,"_46":43,"_47":43,"_48":51,"_50":51,"_52":176,"_54":177,"_56":178,"_58":-5,"_59":179,"_61":180,"_63":181,"_65":182,"_67":43,"_68":69},{"_30":155,"_32":156,"_34":107,"_36":157,"_38":158,"_40":159,"_42":43,"_44":43,"_45":160,"_46":43,"_47":43,"_48":49,"_50":112,"_52":161,"_54":162,"_56":163,"_58":-5,"_59":164,"_61":165,"_63":166,"_65":167,"_67":43,"_68":69},{"_30":138,"_32":139,"_34":35,"_36":140,"_38":141,"_40":142,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":112,"_50":143,"_52":144,"_54":145,"_56":146,"_58":-5,"_59":147,"_61":148,"_63":149,"_65":150,"_67":43,"_68":69},{"_30":124,"_32":125,"_34":107,"_36":126,"_38":127,"_40":128,"_42":43,"_44":43,"_45":129,"_46":43,"_47":43,"_48":49,"_50":112,"_52":130,"_54":131,"_56":132,"_58":-5,"_59":133,"_61":134,"_63":135,"_65":136,"_67":43,"_68":69},{"_30":105,"_32":106,"_34":107,"_36":108,"_38":109,"_40":110,"_42":43,"_44":43,"_45":111,"_46":43,"_47":43,"_48":49,"_50":112,"_52":113,"_54":114,"_56":115,"_58":-5,"_59":116,"_61":117,"_63":118,"_65":119,"_67":43,"_68":69},{"_30":85,"_32":86,"_34":87,"_36":88,"_38":89,"_40":90,"_42":43,"_44":43,"_45":91,"_46":43,"_47":43,"_48":49,"_50":49,"_52":92,"_54":93,"_56":94,"_58":-5,"_59":95,"_61":96,"_63":97,"_65":98,"_67":43,"_68":69},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":43,"_46":43,"_47":43,"_48":49,"_50":51,"_52":53,"_54":55,"_56":57,"_58":-5,"_59":60,"_61":62,"_63":64,"_65":66,"_67":43,"_68":69},"id","993","name","Rosetta Stone","type","landmark","startDescription","A granodiorite stele inscribed with a decree issued at Memphis, Egypt, in 196 BCE, featuring the same text in three scripts.","endDescription","The stone became a key to deciphering Egyptian hieroglyphs, significantly advancing the understanding of ancient Egyptian language and culture.","startYear",-196,"startMonth",0,"startDay","endYear","endMonth","endDay","startSignificance",0.9,"endSignificance",1,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/Rosetta_Stone.JPG/330px-Rosetta_Stone.JPG","imageCredit","Image: Rosetta Stone / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Rosetta_Stone","cdnId","country",{"_32":82,"_83":84},"subjects",[76,77],"group",{"_32":73,"_74":75},"user",{"_30":70,"_71":72},"likes","liked",false,"6","username","HistOracle","Ancient Egypt","icon","GiEgyptianPyramids",{"_30":80,"_32":81},{"_30":78,"_32":79},"4","intellectual","3","culture","Egypt","continent","Africa","1512","Ptolemaic Kingdom","period","This period marked the establishment of a Hellenistic kingdom in Egypt, characterized by a blend of Greek and Egyptian cultures.","The kingdom concluded with the Roman annexation, leading to the end of Ptolemaic rule and the integration of Egypt into the Roman Empire.",-305,-30,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/68/Ptolemaic_Kingdom_III-II_century_BC_-_en.svg/330px-Ptolemaic_Kingdom_III-II_century_BC_-_en.svg.png","Image: Ptolemaic Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Ptolemaic_Kingdom",{"_32":82,"_83":84},[101,102],{"_32":73,"_74":75},{"_30":99,"_71":100},"7","Kushim",{"_30":103,"_32":104},{"_30":80,"_32":81},"2","politics","1491","Ramses II","person","A prominent pharaoh of ancient Egypt known for his military exploits and monumental architecture, he ruled during the Nineteenth Dynasty.","His reign is marked by extensive building projects and the establishment of Egypt as a dominant power in the region.",-1303,-1213,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cf/Ramses_II_British_Museum.jpg/330px-Ramses_II_British_Museum.jpg","Image: Ramesses II / Wikimedia Commons","https://en.wikipedia.org/wiki/Ramses_II",{"_32":82,"_83":84},[120,121],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":122,"_32":123},{"_30":80,"_32":81},"1","military","1490","Tutankhamun","A young pharaoh of ancient Egypt, known for his opulent tomb and significant artifacts that provide insight into the 18th dynasty.","His untimely death at a young age led to a resurgence of interest in ancient Egyptian culture and history.",-1341,-1323,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/27/CairoEgMuseumTaaMaskMostlyPhotographed.jpg/330px-CairoEgMuseumTaaMaskMostlyPhotographed.jpg","Image: Tutankhamun / Wikimedia Commons","https://en.wikipedia.org/wiki/Tutankhamun",{"_32":82,"_83":84},[137],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"949","The Colossi of Memnon","These two massive stone statues represent Pharaoh Amenhotep III and are located on the west bank of the Nile near Luxor. They were originally erected to guard the entrance to his mortuary temple.","The Colossi have stood for over three millennia, enduring the elements and human activity, becoming a symbol of ancient Egyptian art and architecture.",-1350,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/ee/Colossi_of_Memnon_May_2015_2.JPG/330px-Colossi_of_Memnon_May_2015_2.JPG","Image: Colossi of Memnon / Wikimedia Commons","https://en.wikipedia.org/wiki/Colossi_of_Memnon",{"_32":82,"_83":84},[151,152],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":153,"_32":154},"9","art","1492","Amenhotep III","A prominent pharaoh of the Eighteenth Dynasty, known for his extensive building projects and diplomatic relations.","His reign marked the height of ancient Egyptian civilization, leaving a lasting legacy in art and architecture.",-1386,-1349,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Colossal_Amenhotep_III_British_Museum.jpg/330px-Colossal_Amenhotep_III_British_Museum.jpg","Image: Amenhotep III / Wikimedia Commons","https://en.wikipedia.org/wiki/Amenhotep_III",{"_32":82,"_83":84},[168,169],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":103,"_32":104},{"_30":80,"_32":81},"1511","New Kingdom of Egypt","This period marked the height of ancient Egyptian civilization, characterized by powerful pharaohs and monumental architecture.","The era concluded with a decline in power and influence, leading to fragmentation and the eventual conquest by foreign powers.",-1550,-1070,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/03/Egypt_NK_edit.svg/330px-Egypt_NK_edit.svg.png","Image: New Kingdom of Egypt / Wikimedia Commons","https://en.wikipedia.org/wiki/New_Kingdom_of_Egypt",{"_32":82,"_83":84},[183,184],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":103,"_32":104},{"_30":80,"_32":81},"1460","Rhind Mathematical Papyrus","event","An ancient Egyptian document that serves as a key source of information on mathematics in the ancient world, showcasing various mathematical problems and solutions.","The papyrus remains a vital artifact for understanding the mathematical practices of ancient civilizations.",-1650,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d9/Rhind_Mathematical_Papyrus.jpg/330px-Rhind_Mathematical_Papyrus.jpg","Image: Rhind Mathematical Papyrus / Wikimedia Commons","https://en.wikipedia.org/wiki/Rhind_Mathematical_Papyrus",{"_32":82,"_83":84},[198],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":78,"_32":79},"149","Middle Kingdom of Egypt","This period is characterized by the reunification of Egypt and a flourishing of art and literature.","The Middle Kingdom ended with the invasion of the Hyksos, leading to a significant shift in power.",-2055,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/04/Ancient_Egyptian_old_and_middle_kingdom.svg/330px-Ancient_Egyptian_old_and_middle_kingdom.svg.png","Gert7 / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Middle_Kingdom_of_Egypt","images/e771026aab978c4bda69cceaf1e51d6ef49445c5.webp",{"_32":82,"_83":84},[212,213],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":78,"_32":79},{"_30":153,"_32":154},"294","Great Pyramid of Giza","This monumental tomb, built for the Pharaoh Khufu, is the largest of the three pyramids on the Giza plateau. It showcases the architectural prowess of ancient Egypt.","As the last of the Seven Wonders of the Ancient World still in existence, it remains a testament to ancient engineering and cultural significance.",-2580,-2560,"https://upload.wikimedia.org/wikipedia/commons/thumb/e/e7/Great_Pyramid_of_Giza_-_Pyramid_of_Khufu.jpg/330px-Great_Pyramid_of_Giza_-_Pyramid_of_Khufu.jpg","Unknown author / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Great_Pyramid_of_Giza","images/19806658fc5833de003e3ea78fe1df71cdc6743e.webp",{"_32":82,"_83":84},[228,229],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},{"_30":99,"_32":230},"religion","1493","Djoser","A significant figure in ancient Egypt, known for commissioning the Step Pyramid, which marked a major advancement in architectural design.","His reign is noted for the establishment of the pyramid as a royal tomb, influencing subsequent pharaonic burial practices.",-2670,-2640,0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/43/Djoser_statue.jpg/330px-Djoser_statue.jpg","Image: Djoser / Wikimedia Commons","https://en.wikipedia.org/wiki/Djoser",{"_32":82,"_83":84},[245],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"277","Old Kingdom Egypt","The Old Kingdom saw the rise of a powerful monarchy, pyramid-building, and flourishing art and religion.","It ended as central authority weakened, local rulers gained power, and Egypt entered a period of fragmentation.",-2686,-2181,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/17/Ancient_Egypt_map-en.svg/330px-Ancient_Egypt_map-en.svg.png","Jeff Dahl / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/First_Intermediate_Period_of_Egypt","images/e2b68292a740608e9c0a8844dbb92fd1027bd6ff.webp",{"_32":82,"_83":84},[261],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":103,"_32":104},"1128","Ancient Egyptian Harp","The ancient Egyptian harp was a prominent musical instrument used in various ceremonies and entertainment, showcasing the rich cultural heritage of Egypt.","The use of the harp gradually declined with the advent of new musical styles and instruments, marking the end of its prominence in ancient Egyptian society.",-3000,0.4,"","https://en.wikipedia.org/wiki/Ancient_Egyptian_harp",{"_32":82,"_83":84},[274],{"_32":73,"_74":75},{"_30":70,"_71":72},{"_30":80,"_32":81},"41","Early Dynastic Egypt","This period begins with the unification of Upper and Lower Egypt under the first pharaohs, traditionally attributed to Narmer. Writing systems, royal iconography, and state administration become firmly established.","The state grew more stable and wealthy, enabling the large-scale organization needed for monumental construction. This transition leads into the Old Kingdom.",-3100,"https://en.wikipedia.org/wiki/Ancient_Egypt",{"_32":82,"_83":84},[285,286],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":103,"_32":104},{"_30":80,"_32":81},"1514","Pre-Dynastic Egypt","Begins with early farming communities along the Nile, developing pottery, irrigation, and village life. Distinct regional cultures such as the Badarian and Naqada emerge, laying the foundations of Egyptian society, religion, and artistic traditions.","The era concludes with increasing political unification, expanding trade, and the rise of powerful regional rulers in Upper Egypt.",-6000,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b0/Petrie-Decorated-01.jpg/330px-Petrie-Decorated-01.jpg","Image: Prehistoric Egypt / Wikimedia Commons","https://en.wikipedia.org/wiki/Pre-dynastic_Egypt",{"_32":82,"_83":84},[299],{"_32":73,"_74":75},{"_30":99,"_71":100},{"_30":80,"_32":81},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true]
