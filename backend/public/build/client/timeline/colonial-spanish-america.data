 their control.","startYear",1821,"startMonth",6,"startDay",24,"endYear","endMonth",0,"endDay","startSignificance",0.7,"endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/BatallaCarabobo01.JPG/330px-BatallaCarabobo01.JPG","imageCredit","Unknown author / Wikimedia Commons / Public domain","sourceUrl","https://en.wikipedia.org/wiki/Battle_of_Carabobo","cdnId","images/8b086c7465576ba8b8bc338fbc0417d05e74c523.webp","country",{"_32":82,"_83":84},"subjects",[79],"group",{"_32":76,"_77":78},"user",{"_30":73,"_74":75},"likes","liked",false,"6","username","HistOracle","Colonial Spanish America","icon","GiGalleon",{"_30":80,"_32":81},"1","military","Venezuela","continent","SouthAmerica","603","Peruvian War of Independence","A military campaign aimed at liberating Peru from Spanish colonial rule, involving several key battles.","The war concluded with the defeat of Spanish forces and the establishment of Peru's independence.",1820,1824,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/88/Peruvian_War_of_Independence_1.png/330px-Peruvian_War_of_Independence_1.png","LLs / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Peruvian_War_of_Independence","images/a45c9d7c9689437e129e0f84bcc8def536725753.webp",{"_32":104,"_83":84},[100,101],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":80,"_32":81},{"_30":102,"_32":103},"2","politics","Peru","574","Gran Colombia","period","A significant political entity that united several South American countries after their independence from Spanish rule.","The dissolution of this federation led to the emergence of several independent nations, reshaping the continent's political landscape.",1819,1831,0.85,0.75,"https://upload.wikimedia.org/wikipedia/en/thumb/5/5c/Flag_of_Gran_Colombia.svg/330px-Flag_of_Gran_Colombia.svg.png","Milenioscuro / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Gran_Colombia","images/8c18d7ba27b413ab24db45a4cc0d1fa666706198.webp",{"_32":123,"_83":84},[122],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"Colombia","591","Battle of Tucumán","A crucial battle in the Argentine War of Independence that helped secure control over the northern provinces.","The victory was a turning point in the struggle for independence, boosting morale among the revolutionaries.",1812,9,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/cd/Batalla_de_Tucum%C3%A1n.jpg/330px-Batalla_de_Tucum%C3%A1n.jpg","Francisco Fortuny / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Battle_of_Tucum%C3%A1n","images/b611c8b3752d1cc96b717a8b5829757f1891ef42.webp",{"_32":139,"_83":84},[138],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":80,"_32":81},"Argentina","589","Argentine War of Independence","A series of revolutionary events that led to Argentina's independence from Spanish colonial rule.","The culmination of these efforts resulted in the formal declaration of independence, shaping the nation's future.",1810,5,25,1816,7,"https://en.wikipedia.org/wiki/Argentine_War_of_Independence",{"_32":139,"_83":84},[154],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"600","Chilean War of Independence","A series of military conflicts that led to Chile's struggle for independence from Spanish colonial rule.","The war concluded with Chile's victory and the establishment of an independent republic.",1818,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/78/%C3%9Altimos_momentos_de_Rancagua_-_Subercaseaux.jpg/330px-%C3%9Altimos_momentos_de_Rancagua_-_Subercaseaux.jpg","Pedro Subercaseaux / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Chilean_War_of_Independence","images/a487bbfe80807b36a00b67fd3ab5ebf5760509e1.webp",{"_32":170,"_83":84},[168,169],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":80,"_32":81},{"_30":102,"_32":103},"Chile","604","Bolivian War of Independence","A series of conflicts that led to Bolivia's struggle for independence from Spanish colonial rule.","The war concluded with the establishment of Bolivia as an independent nation.",1809,1825,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/f/f9/Sucre1.jpg/330px-Sucre1.jpg","anonymous / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Bolivian_War_of_Independence","images/11dfe45c5f4d651951cc5b2e7ea63ea6a4be7a9a.webp",{"_32":188,"_83":84},[186,187],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":80,"_32":81},{"_30":102,"_32":103},"Bolivia","895","Simón Bolívar","person","A prominent leader in the struggle for independence across several South American countries, he played a crucial role in liberating Venezuela, Colombia, Ecuador, Peru, and Bolivia from Spanish rule.","His legacy as a liberator and visionary leader continues to inspire movements for freedom and democracy in Latin America.",1783,1830,12,17,0.9,1,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Sim%C3%B3n_Bol%C3%ADvar._Toro_Moreno%2C_Luis._1922%2C_Legislative_Palace%2C_La_Paz.png/330px-Sim%C3%B3n_Bol%C3%ADvar._Toro_Moreno%2C_Luis._1922%2C_Legislative_Palace%2C_La_Paz.png","Image: Simón Bolívar / Wikimedia Commons","https://en.wikipedia.org/wiki/Sim%C3%B3n_Bol%C3%ADvar",{"_32":82,"_83":84},[207],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"899","José de San Martín","A key figure in the South American wars of independence, he is best known for his role in liberating Argentina, Chile, and Peru from Spanish colonial rule.","His contributions to the independence movements have made him a national hero in several countries.",1778,2,1850,8,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Jos%C3%A9_de_San_Mart%C3%ADn_%28retrato%2C_c.1828%29.jpg/330px-Jos%C3%A9_de_San_Mart%C3%ADn_%28retrato%2C_c.1828%29.jpg","Image: José de San Martín / Wikimedia Commons","https://en.wikipedia.org/wiki/Jos%C3%A9_de_San_Mart%C3%ADn",{"_32":139,"_83":84},[223],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"1137","Túpac Amaru II","A prominent leader of an indigenous uprising against Spanish colonial rule in Peru, advocating for the rights of the oppressed.","His execution marked a significant moment in the struggle for indigenous rights and independence in South America.",1738,1781,"https://upload.wikimedia.org/wikipedia/commons/2/23/TupacAmaruII.jpg","Image: Túpac Amaru II / Wikimedia Commons","https://en.wikipedia.org/wiki/T%C3%BApac_Amaru_II",{"_32":104,"_83":84},[237,238],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},{"_30":239,"_32":240},"3","culture","1377","Gauchos","Gauchos are skilled horsemen and cattle herders from the Pampas region of South America, embodying a rich cultural heritage.","Their traditions continue to influence Argentine culture, particularly in music and dance.",1725,0.4,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/Gaucho1868b.jpg/330px-Gaucho1868b.jpg","Image: Gaucho / Wikimedia Commons","https://en.wikipedia.org/wiki/Gaucho",{"_32":139,"_83":84},[256,257],{"_32":76,"_77":78},{"_30":254,"_74":255},"7","Kushim",{"_30":239,"_32":240},{"_30":258,"_32":259},"8","economic","1141","King Philip II of Spain","A prominent monarch known for his extensive empire and staunch Catholicism, he ruled over Spain and its territories during a time of great political and military power.","His reign concluded with his death, marking the end of an era characterized by religious conflict and imperial expansion.",1527,21,1598,13,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/2d/Portrait_of_Philip_II_of_Spain_by_Sofonisba_Anguissola_-_002b.jpg/330px-Portrait_of_Philip_II_of_Spain_by_Sofonisba_Anguissola_-_002b.jpg","Image: Philip II of Spain / Wikimedia Commons","https://en.wikipedia.org/wiki/Philip_II_of_Spain",{"_32":278,"_83":279},[275,276],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},{"_30":254,"_32":277},"religion","Spain","Europe","575","Treaty of Tordesillas","An agreement between Spain and Portugal aimed at settling disputes over newly discovered lands in the Americas.","The treaty established a demarcation line, significantly influencing colonial expansion and territorial claims in South America.",1494,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bc/Treaty_of_Tordesillas.jpg/330px-Treaty_of_Tordesillas.jpg","Original / Biblioteca Nacional de Lisboa / Photo / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Treaty_of_Tordesillas","images/e319ac732b4898fb26e4ba1ad1e1c7639b345e75.webp",{"_32":279,"_83":279},[293],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"608","Spanish Colonization of the Americas","A significant historical period marked by the exploration and conquest of vast territories in the Americas by Spain.","The period concluded with the loss of Spain's last colonies in the Americas, marking the end of its colonial empire.",1492,1898,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Pend%C3%B3n_real_de_Medina_del_Campo.svg/330px-Pend%C3%B3n_real_de_Medina_del_Campo.svg.png","Pendón / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Spanish_colonization_of_the_Americas","images/2154ba539de6a1c5afcaa13256f0b00862d9e4bd.webp",{"_32":309,"_83":309},[308],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},"Global","1273","Spanish Inquisition","A judicial institution established to maintain Catholic orthodoxy in Spain, targeting converts from Judaism and Islam.","The institution was officially abolished, marking the end of its controversial practices and influence.",1478,1834,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/90/Inquisici%C3%B3n_espa%C3%B1ola.svg/330px-Inquisici%C3%B3n_espa%C3%B1ola.svg.png","Image: Spanish Inquisition / Wikimedia Commons","https://en.wikipedia.org/wiki/Spanish_Inquisition",{"_32":278,"_83":279},[323,324],{"_32":76,"_77":78},{"_30":73,"_74":75},{"_30":102,"_32":103},{"_30":254,"_32":277},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,29]
