2":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":52,"_51":92,"_53":191,"_55":192,"_57":193,"_59":-5,"_60":194,"_62":195,"_64":196,"_66":197,"_68":43,"_69":70},{"_30":168,"_32":169,"_34":35,"_36":170,"_38":171,"_40":172,"_42":173,"_44":174,"_45":175,"_47":43,"_48":43,"_49":50,"_51":50,"_53":176,"_55":177,"_57":178,"_59":179,"_60":180,"_62":181,"_64":182,"_66":183,"_68":43,"_69":70},{"_30":154,"_32":155,"_34":35,"_36":156,"_38":157,"_40":158,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":159,"_53":160,"_55":161,"_57":162,"_59":-5,"_60":163,"_62":164,"_64":165,"_66":166,"_68":43,"_69":70},{"_30":139,"_32":140,"_34":126,"_36":141,"_38":142,"_40":129,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":143,"_53":144,"_55":145,"_57":146,"_59":147,"_60":148,"_62":149,"_64":150,"_66":151,"_68":43,"_69":70},{"_30":124,"_32":125,"_34":126,"_36":127,"_38":128,"_40":129,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":50,"_51":130,"_53":131,"_55":132,"_57":133,"_59":-5,"_60":134,"_62":135,"_64":136,"_66":137,"_68":43,"_69":70},{"_30":107,"_32":108,"_34":88,"_36":109,"_38":110,"_40":111,"_42":43,"_44":43,"_45":112,"_47":43,"_48":43,"_49":92,"_51":93,"_53":113,"_55":114,"_57":115,"_59":-5,"_60":116,"_62":117,"_64":118,"_66":119,"_68":43,"_69":70},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":91,"_42":43,"_44":43,"_45":43,"_47":43,"_48":43,"_49":92,"_51":93,"_53":94,"_55":95,"_57":96,"_59":-5,"_60":97,"_62":98,"_64":99,"_66":100,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","913","name","Qin Shi Huang","type","person","startDescription","The first Emperor of China, he is known for unifying the country and initiating major reforms that laid the foundation for the imperial system. His reign saw the construction of significant infrastructure, including the Great Wall.","endDescription","His death led to a power struggle that ultimately resulted in the fall of the Qin dynasty, but his legacy continued to influence Chinese governance for centuries.","startYear",-259,"startMonth",0,"startDay","endYear",-210,"endMonth","endDay","startSignificance",0.9,"endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/QinShiHuang19century.jpg/330px-QinShiHuang19century.jpg","imageCredit","Image: Qin Shi Huang / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Qin_Shi_Huang","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"7","username","Kushim","Ancient China","icon","GiStoneWall",{"_30":81,"_32":82},{"_30":79,"_32":80},"3","culture","2","politics","China","continent","Asia","2204","Legalism","period","This philosophical school advocates for strict laws and harsh punishments as a means to maintain order and control in society.","Its principles were largely implemented during the Qin dynasty, influencing governance in subsequent periods.",-400,0.7,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/28/Statue_of_Shang_Yang.jpg/330px-Statue_of_Shang_Yang.jpg","Image: Legalism (Chinese philosophy) / Wikimedia Commons","https://en.wikipedia.org/wiki/Legalism_(Chinese_philosophy)",{"_32":106,"_84":106},[103],{"_32":74,"_75":76},{"_30":101,"_72":102},"6","HistOracle",{"_30":104,"_32":105},"4","intellectual","Global","1528","Warring States","This period was characterized by intense military conflict, political intrigue, and philosophical development among various states in ancient China.","The era concluded with the unification of China under the Qin Dynasty, ending centuries of fragmentation.",-475,-221,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/EN-WarringStatesAll260BCE.jpg/330px-EN-WarringStatesAll260BCE.jpg","Image: Warring States period / Wikimedia Commons","https://en.wikipedia.org/wiki/Warring_States_period",{"_32":83,"_84":85},[120,121],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":122,"_32":123},{"_30":104,"_32":105},"1","military","1127","Chinese Guqin","event","The Guqin is a plucked seven-string instrument with a history of over three thousand years, integral to Chinese music and philosophy.","Though its popularity waned, the Guqin remains a symbol of scholarly culture and is still played in modern times.",-500,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/32/ZhongNiShi.jpg/330px-ZhongNiShi.jpg","Image: Guqin / Wikimedia Commons","https://en.wikipedia.org/wiki/Guqin",{"_32":83,"_84":85},[138],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},"635","The Art of War","This ancient Chinese military treatise attributed to Sun Tzu emphasizes strategy, tactics, and the importance of adaptability in warfare.","Its principles have transcended military applications, influencing business, leadership, and conflict resolution in various fields.",1,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/de/Bamboo_book_-_unfolded_-_UCR.jpg/330px-Bamboo_book_-_unfolded_-_UCR.jpg","vlasta2 / bluefootedbooby on flickr.com / Wikimedia Commons / CC BY 2.0","https://en.wikipedia.org/wiki/The_Art_of_War","images/cf1b50184b0ed3d0846e7f116055c470ab726e13.webp",{"_32":83,"_84":85},[152,153],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":122,"_32":123},{"_30":104,"_32":105},"905","Sun Tzu","An ancient Chinese military strategist, philosopher, and author, known for his influential work on military tactics and strategy. His teachings have shaped military thought for centuries.","The legacy of this strategist continues to influence both military and non-military fields, including business and leadership.",-540,0.1,"https://upload.wikimedia.org/wikipedia/commons/c/cf/%E5%90%B4%E5%8F%B8%E9%A9%AC%E5%AD%99%E6%AD%A6.jpg","Image: Sun Tzu / Wikimedia Commons","https://en.wikipedia.org/wiki/Sun_Tzu",{"_32":83,"_84":85},[167],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":122,"_32":123},"180","The Life of Confucius","A philosopher whose teachings focused on morality, proper social relationships, and justice, shaping Chinese culture and philosophy.","His ideas continued to influence Chinese society and government long after his death, becoming a cornerstone of East Asian thought.",-551,9,28,-479,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/54/Confucius_Tang_Dynasty.jpg/330px-Confucius_Tang_Dynasty.jpg","Wu Daozi / Tang Dynasty. / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Confucius","images/f0bb09da1f4cf781e7e36bc59ebe43873427e7e4.webp",{"_32":83,"_84":85},[184,185],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":79,"_32":80},{"_30":104,"_32":105},"2201","Daoism","This philosophical and religious tradition emphasizes living in harmony with the Dao, or the fundamental nature of the universe.","Its teachings continue to influence various aspects of culture, spirituality, and art.",-600,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/7c/Wudangshan_pic_12.jpg/330px-Wudangshan_pic_12.jpg","Image: Taoism / Wikimedia Commons","https://en.wikipedia.org/wiki/Daoism",{"_32":106,"_84":106},[198],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":104,"_32":105},"181","The Construction of the Great Wall of China","landmark","A series of fortifications built to protect Chinese states and empires against invasions and raids from nomadic groups.","The wall evolved over centuries, becoming a symbol of China's enduring strength and architectural ingenuity.",-700,-200,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/23/The_Great_Wall_of_China_at_Jinshanling-edit.jpg/330px-The_Great_Wall_of_China_at_Jinshanling-edit.jpg","Severin.stalder / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Great_Wall_of_China","images/c0f597ae575216cb2a4c5a6763b78380e89958a3.webp",{"_32":83,"_84":85},[214,215],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":122,"_32":123},{"_30":79,"_32":80},"1515","Spring and Autumn Period","This era marked a time of significant political fragmentation and cultural development in ancient China, characterized by the rise of various states and philosophical schools.","The period concluded with the unification of China under the Qin dynasty, ending the feudal system and leading to a centralized imperial rule.",-770,-476,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Chinese_plain_5c._BC-en.svg/330px-Chinese_plain_5c._BC-en.svg.png","Image: Spring and Autumn period / Wikimedia Commons","https://en.wikipedia.org/wiki/Spring_and_Autumn_period",{"_32":83,"_84":85},[229,230],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"164","Zhou Dynasty","This dynasty is known for its philosophical developments and the establishment of feudalism in China.","The dynasty's fall marked the beginning of the Warring States period, leading to significant political changes.",-1046,-256,"https://upload.wikimedia.org/wikipedia/commons/8/89/Zhou_dynasty_1000_BC.png","Ian Kiu / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Zhou_dynasty","images/130ffc04bb679eea7d22ce31d69b8a4c3d2b1721.webp",{"_32":83,"_84":85},[245,246],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":81,"_32":82},{"_30":104,"_32":105},"35","Shang Dynasty","This dynasty is known for its advances in bronze metallurgy, writing, and urbanization, laying the foundation for Chinese civilization.","The dynasty ended with the overthrow by the Zhou, marking the beginning of a new era in Chinese history.",-1600,0.75,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/80/Shang_dynasty.svg/330px-Shang_dynasty.svg.png","Lamassu Design  Gurdjieff / Wikimedia Commons / CC BY-SA 3.0","https://en.wikipedia.org/wiki/Shang_dynasty","images/2c027edaafdadd673bd864d85ced239b93da911f.webp",{"_32":83,"_84":85},[261,262],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":79,"_32":80},"1524","Xia Dynasty","This period marks the earliest recorded dynasty in Chinese history, characterized by the establishment of a hereditary rule and significant advancements in agriculture and metallurgy.","The period concluded with the rise of the Shang Dynasty, which succeeded the Xia and continued the development of Chinese civilization.",-2070,"https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Xia_dynasty.svg/330px-Xia_dynasty.svg.png","Image: Xia dynasty / Wikimedia Commons","https://en.wikipedia.org/wiki/Xia_dynasty",{"_32":83,"_84":85},[275,276],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":81,"_32":82},{"_30":79,"_32":80},"150","Huang He River Civilization","This civilization emerged along the Yellow River, known for its agricultural advancements and early state formation.","It laid the foundation for subsequent Chinese dynasties and cultural developments.",-2100,"https://en.wikipedia.org/wiki/Huang_He_civilization",{"_32":83,"_84":85},[287],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":81,"_32":82},"227","Jiangzhai Culture","An early Neolithic culture in China known for its pottery and agricultural practices.","The culture transitioned into more complex societies with the rise of dynasties.",-3000,-2000,"https://upload.wikimedia.org/wikipedia/commons/thumb/8/8f/Jiangzhai_settlement_model%2C_Yangshao_culture%2C_Lintong%2C_Shaanxi.jpg/330px-Jiangzhai_settlement_model%2C_Yangshao_culture%2C_Lintong%2C_Shaanxi.jpg","Prof. Gary Lee Todd / Wikimedia Commons / CC BY-SA 4.0","https://en.wikipedia.org/wiki/Jiangzhai","images/d06f1e144e77450d6aad3675def7e3defc029cf7.webp",{"_32":83,"_84":85},[302],{"_32":74,"_75":76},{"_30":101,"_72":102},{"_30":79,"_32":80},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,5]
