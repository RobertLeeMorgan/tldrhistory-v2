39":185,"_41":71,"_43":71,"_45":46,"_47":71,"_49":71,"_51":93,"_53":186,"_55":187,"_57":188,"_59":189,"_61":-5,"_62":190,"_64":191,"_66":192,"_68":193,"_70":71,"_72":73},{"_29":163,"_31":164,"_33":34,"_35":165,"_37":166,"_39":167,"_41":48,"_43":168,"_45":169,"_47":170,"_49":91,"_51":153,"_53":52,"_55":171,"_57":172,"_59":173,"_61":-5,"_62":174,"_64":175,"_66":176,"_68":177,"_70":71,"_72":73},{"_29":145,"_31":146,"_33":34,"_35":147,"_37":148,"_39":149,"_41":150,"_43":151,"_45":152,"_47":150,"_49":54,"_51":153,"_53":52,"_55":154,"_57":155,"_59":156,"_61":-5,"_62":157,"_64":158,"_66":159,"_68":160,"_70":71,"_72":73},{"_29":123,"_31":124,"_33":125,"_35":126,"_37":127,"_39":128,"_41":71,"_43":71,"_45":129,"_47":71,"_49":71,"_51":52,"_53":93,"_55":130,"_57":131,"_59":132,"_61":133,"_62":134,"_64":135,"_66":136,"_68":137,"_70":71,"_72":73},{"_29":103,"_31":104,"_33":105,"_35":106,"_37":107,"_39":108,"_41":71,"_43":71,"_45":109,"_47":71,"_49":71,"_51":52,"_53":52,"_55":110,"_57":111,"_59":112,"_61":113,"_62":114,"_64":115,"_66":116,"_68":117,"_70":71,"_72":73},{"_29":86,"_31":87,"_33":34,"_35":88,"_37":89,"_39":90,"_41":42,"_43":91,"_45":92,"_47":48,"_49":50,"_51":52,"_53":93,"_55":94,"_57":95,"_59":96,"_61":-5,"_62":97,"_64":98,"_66":99,"_68":100,"_70":71,"_72":73},{"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":60,"_61":-5,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":73},"id","1323","name","Johann Sebastian Bach","type","person","startDescription","A renowned composer and musician of the Baroque period, known for his intricate musical compositions and mastery of counterpoint.","endDescription","His death marked the end of an era in classical music, but his works continue to influence composers and musicians worldwide.","startYear",1685,"startMonth",3,"startDay",31,"endYear",1750,"endMonth",7,"endDay",28,"startSignificance",0.9,"endSignificance",1,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/6/6a/Johann_Sebastian_Bach.jpg/330px-Johann_Sebastian_Bach.jpg","imageCredit","Image: Johann Sebastian Bach / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/Johann_Sebastian_Bach","cdnId","country",{"_31":83,"_84":85},"subjects",[80],"group",{"_31":77,"_78":79},"user",{"_29":74,"_75":76},"likes",0,"liked",false,"6","username","HistOracle","Baroque","icon","GiMusicalNotes",{"_29":81,"_31":82},"9","art","Germany","continent","Europe","1324","Antonio Vivaldi","A renowned composer and violinist, he is best known for his concertos, particularly 'The Four Seasons'. His work significantly influenced the Baroque music era.","His death marked the end of a prolific career that left a lasting legacy in classical music, though he fell into obscurity until his works were revived in the 20th century.",1678,4,1741,0.8,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Vivaldi.jpg/330px-Vivaldi.jpg","Image: Antonio Vivaldi / Wikimedia Commons","https://en.wikipedia.org/wiki/Antonio_Vivaldi",{"_31":102,"_84":85},[101],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"Italy","702","Paradise Lost","event","This epic poem explores the biblical story of the Fall of Man, delving into themes of temptation, free will, and redemption through its complex characters.","It has been lauded for its poetic grandeur and philosophical depth, influencing literature and theology for generations.",1667,1674,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Houghton_EC65.M6427P.1667aa_-_Paradise_Lost%2C_1667.jpg/330px-Houghton_EC65.M6427P.1667aa_-_Paradise_Lost%2C_1667.jpg","John Milton / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Paradise_Lost","images/bb3b44be7960199ac861e77b9bf922cb2c9feac5.webp",{"_31":122,"_84":85},[118,119],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":120,"_31":121},{"_29":81,"_31":82},"4","intellectual","United Kingdom","305","Palace of Versailles","landmark","This opulent palace was the principal royal residence of France until the start of the French Revolution. It is known for its grandeur and extensive gardens.","Today, it is a UNESCO World Heritage Site and a symbol of the absolute monarchy of the Ancien Régime.",1661,1682,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d2/Versailles-Chateau-Jardins02.jpg/330px-Versailles-Chateau-Jardins02.jpg","G CHP / Wikimedia Commons / CC BY-SA 2.5","https://en.wikipedia.org/wiki/Palace_of_Versailles","images/632b7574e6e0982240b3fc095c0520c168a94639.webp",{"_31":144,"_84":85},[138,139],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":142,"_31":143},{"_29":140,"_31":141},"3","culture","2","politics","France","1657","Louis XIV","The King of France known as the 'Sun King,' he epitomized absolute monarchy and the grandeur of the Baroque period.","His reign marked the peak of French power and culture, leaving a lasting impact on European politics and art.",1638,9,5,1715,0.95,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Louis_XIV_of_France.jpg/330px-Louis_XIV_of_France.jpg","Image: Louis XIV / Wikimedia Commons","https://en.wikipedia.org/wiki/Louis_XIV_of_France",{"_31":144,"_84":85},[161,162],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":142,"_31":143},{"_29":140,"_31":141},"1320","Rembrandt van Rijn","A master painter and etcher, he is widely regarded as one of the greatest painters in European art history.","His legacy continues to influence artists and art lovers around the world.",1606,15,1669,10,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Rembrandt_van_Rijn_-_Self-Portrait_-_Google_Art_Project.jpg/330px-Rembrandt_van_Rijn_-_Self-Portrait_-_Google_Art_Project.jpg","Image: Rembrandt / Wikimedia Commons","https://en.wikipedia.org/wiki/Rembrandt",{"_31":179,"_84":85},[178],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"Netherlands","968","The Baroque Period","period","This artistic style emphasized grandeur, drama, and movement, manifesting in architecture, music, and visual arts across Europe.","The Baroque style eventually evolved into the Rococo and Neoclassical styles, influencing future artistic movements.",1600,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6c/WLA_metmuseum_Venus_and_Adonis_by_Peter_Paul_Rubens.jpg/330px-WLA_metmuseum_Venus_and_Adonis_by_Peter_Paul_Rubens.jpg","Image: Baroque / Wikimedia Commons","https://en.wikipedia.org/wiki/Baroque",{"_31":195,"_84":195},[194],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":140,"_31":141},"Global","1659","Diego Velázquez","A Spanish painter, Velázquez is celebrated for his realistic and complex portraits, which exemplify the Baroque style.","His works remain influential, showcasing the depth of human emotion and the intricacies of royal life.",1599,6,1660,8,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/6c/Diego_Vel%C3%A1zquez_Autorretrato_45_x_38_cm_-_Colecci%C3%B3n_Real_Academia_de_Bellas_Artes_de_San_Carlos_-_Museo_de_Bellas_Artes_de_Valencia.jpg/330px-Diego_Vel%C3%A1zquez_Autorretrato_45_x_38_cm_-_Colecci%C3%B3n_Real_Academia_de_Bellas_Artes_de_San_Carlos_-_Museo_de_Bellas_Artes_de_Valencia.jpg","Image: Diego Velázquez / Wikimedia Commons","https://en.wikipedia.org/wiki/Diego_Vel%C3%A1zquez",{"_31":213,"_84":85},[212],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"Spain","1660","Gian Lorenzo Bernini","An Italian sculptor and architect, Bernini was a leading figure in Baroque art, known for his dramatic and emotive sculptures.","His work transformed the visual landscape of Rome, establishing a new standard for artistic expression in the Baroque style.",1598,12,1680,11,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d5/Gian_Lorenzo_Bernini%2C_self-portrait%2C_c1623.jpg/330px-Gian_Lorenzo_Bernini%2C_self-portrait%2C_c1623.jpg","Image: Gian Lorenzo Bernini / Wikimedia Commons","https://en.wikipedia.org/wiki/Gian_Lorenzo_Bernini",{"_31":102,"_84":85},[229],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"1661","Francisco de Quevedo","A Spanish writer and philosopher, Quevedo is known for his sharp wit and satirical works that reflect the Baroque literary style.","His writings continue to be studied for their rich language and critical insight into society and politics of his time.",1580,1645,0.75,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Quevedo_%28copia_de_Vel%C3%A1zquez%29.jpg/330px-Quevedo_%28copia_de_Vel%C3%A1zquez%29.jpg","Image: Francisco de Quevedo / Wikimedia Commons","https://en.wikipedia.org/wiki/Francisco_de_Quevedo",{"_31":213,"_84":85},[244],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":120,"_31":121},"1658","Peter Paul Rubens","A prominent Flemish artist known for his vibrant and dynamic Baroque paintings, Rubens was a master of color and movement.","His legacy endures through his influential works and the establishment of a distinctive Baroque style that shaped European art.",1577,1640,30,"https://upload.wikimedia.org/wikipedia/commons/thumb/2/24/Peter_Paul_Rubens_-_Self-portrait_-_RH.S.180_-_Rubenshuis_%28after_restoration%29.jpg/330px-Peter_Paul_Rubens_-_Self-portrait_-_RH.S.180_-_Rubenshuis_%28after_restoration%29.jpg","Image: Peter Paul Rubens / Wikimedia Commons","https://en.wikipedia.org/wiki/Peter_Paul_Rubens",{"_31":260,"_84":85},[259],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"Belgium","1654","Caravaggio","An influential Italian painter known for his dramatic use of light and shadow, Caravaggio's work marked a significant shift in Baroque art.","His untimely death left a lasting legacy, influencing countless artists and shaping the course of Baroque painting.",1571,29,1610,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Bild-Ottavio_Leoni%2C_Caravaggio.jpg/330px-Bild-Ottavio_Leoni%2C_Caravaggio.jpg","Image: Caravaggio / Wikimedia Commons","https://en.wikipedia.org/wiki/Caravaggio",{"_31":102,"_84":85},[275],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":81,"_31":82},"1662","The Escorial","This historical residence of the King of Spain is a complex of buildings that includes a monastery, palace, and library.","The construction was completed in 1584, symbolizing the power of the Spanish monarchy and the Catholic Church.",1563,1584,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Monasterio_de_El_Escorial_en_Madrid.jpg/330px-Monasterio_de_El_Escorial_en_Madrid.jpg","Image: El Escorial / Wikimedia Commons","https://en.wikipedia.org/wiki/El_Escorial",{"_31":213,"_84":85},[289,290],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":142,"_31":143},{"_29":291,"_31":292},"7","religion","1656","Johann Arndt","A German theologian and author, he is best known for his influential spiritual writings that contributed to the Baroque religious thought.","His works inspired many and played a significant role in the development of Protestant spirituality during the era.",1555,1621,0.7,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/6/66/Johann_Arndt.jpg/330px-Johann_Arndt.jpg","Image: Johann Arndt / Wikimedia Commons","https://en.wikipedia.org/wiki/Johann_Arndt",{"_31":83,"_84":85},[308],{"_31":77,"_78":79},{"_29":74,"_75":76},{"_29":291,"_31":292},[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,24]
