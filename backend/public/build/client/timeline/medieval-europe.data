195,"_42":43,"_44":43,"_45":196,"_47":43,"_48":43,"_49":50,"_51":183,"_53":197,"_55":198,"_57":199,"_59":-5,"_60":200,"_62":201,"_64":202,"_66":203,"_68":43,"_69":70},{"_30":175,"_32":176,"_34":35,"_36":177,"_38":178,"_40":179,"_42":180,"_44":181,"_45":182,"_47":183,"_48":184,"_49":130,"_51":50,"_53":144,"_55":145,"_57":146,"_59":-5,"_60":185,"_62":186,"_64":187,"_66":188,"_68":43,"_69":70},{"_30":155,"_32":156,"_34":121,"_36":157,"_38":158,"_40":124,"_42":43,"_44":43,"_45":109,"_47":43,"_48":43,"_49":52,"_51":159,"_53":160,"_55":161,"_57":162,"_59":163,"_60":164,"_62":165,"_64":166,"_66":167,"_68":43,"_69":70},{"_30":140,"_32":141,"_34":88,"_36":142,"_38":143,"_40":124,"_42":125,"_44":126,"_45":43,"_47":43,"_48":43,"_49":50,"_51":43,"_53":144,"_55":145,"_57":146,"_59":-5,"_60":147,"_62":148,"_64":149,"_66":150,"_68":43,"_69":70},{"_30":119,"_32":120,"_34":121,"_36":122,"_38":123,"_40":124,"_42":125,"_44":126,"_45":127,"_47":128,"_48":129,"_49":130,"_51":131,"_53":132,"_55":133,"_57":134,"_59":-5,"_60":135,"_62":136,"_64":137,"_66":138,"_68":43,"_69":70},{"_30":105,"_32":106,"_34":88,"_36":107,"_38":108,"_40":109,"_42":43,"_44":43,"_45":91,"_47":43,"_48":43,"_49":52,"_51":110,"_53":111,"_55":112,"_57":113,"_59":-5,"_60":114,"_62":115,"_64":116,"_66":117,"_68":43,"_69":70},{"_30":86,"_32":87,"_34":88,"_36":89,"_38":90,"_40":91,"_42":43,"_44":43,"_45":92,"_47":43,"_48":43,"_49":50,"_51":52,"_53":93,"_55":94,"_57":95,"_59":-5,"_60":96,"_62":97,"_64":98,"_66":99,"_68":43,"_69":70},{"_30":31,"_32":33,"_34":35,"_36":37,"_38":39,"_40":41,"_42":43,"_44":43,"_45":46,"_47":43,"_48":43,"_49":50,"_51":52,"_53":54,"_55":56,"_57":58,"_59":-5,"_60":61,"_62":63,"_64":65,"_66":67,"_68":43,"_69":70},"id","1246","name","William the Conqueror","type","person","startDescription","A pivotal figure in medieval history, he became the first Norman King of England after his victory at the Battle of Hastings.","endDescription","His reign marked the beginning of a new era in England, characterized by significant changes in governance and culture.","startYear",1028,"startMonth",0,"startDay","endYear",1087,"endMonth","endDay","startSignificance",0.9,"endSignificance",0.8,"imageUrl","https://upload.wikimedia.org/wikipedia/commons/thumb/3/34/William_the_Conqueror_%28TFA%29.jpg/330px-William_the_Conqueror_%28TFA%29.jpg","imageCredit","Image: William the Conqueror / Wikimedia Commons","sourceUrl","https://en.wikipedia.org/wiki/William_the_Conqueror","cdnId","country",{"_32":83,"_84":85},"subjects",[77,78],"group",{"_32":74,"_75":76},"user",{"_30":71,"_72":73},"likes","liked",false,"6","username","HistOracle","Medieval Europe","icon","GiVisoredHelm",{"_30":81,"_32":82},{"_30":79,"_32":80},"2","politics","1","military","United Kingdom","continent","Europe","2389","Medieval Arming Sword","event","Single-handed straight sword used across Europe by knights and soldiers.","Predecessor to the longsword and other late medieval designs.",1000,1500,"https://en.wikipedia.org/wiki/File:Medieval_Arming_Sword.png","Image: Arming Sword / Wikimedia Commons","https://en.wikipedia.org/wiki/Arming_sword",{"_32":104,"_84":85},[100,101],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":102,"_32":103},"3","culture","France","1071","The Development of Musical Notation","The introduction of musical notation allowed for the preservation and dissemination of musical works across Europe.","This innovation transformed music composition and education, leading to more complex musical forms.",900,0.2,"https://upload.wikimedia.org/wikipedia/commons/thumb/d/d3/Bachlut1.png/330px-Bachlut1.png","Image: Musical notation / Wikimedia Commons","https://en.wikipedia.org/wiki/Musical_notation#History",{"_32":85,"_84":85},[118],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"2300","Carolingian Empire","period","The Carolingian Empire was established by Charlemagne, unifying much of Western and Central Europe under a single rule and reviving the concept of a Western Roman Empire.","The empire fragmented into several successor states after the Treaty of Verdun in 843, laying the foundations for modern France and Germany.",800,12,25,843,8,10,0.95,0.85,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/Carolingian_Empire_814-en.svg/330px-Carolingian_Empire_814-en.svg.png","Image: Carolingian Empire / Wikimedia Commons","https://en.wikipedia.org/wiki/Carolingian_Empire",{"_32":104,"_84":85},[139],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"1582","Charlemagne's Coronation","A significant event marking the crowning of a ruler, symbolizing the fusion of Roman, Christian, and Germanic elements.","This event established a precedent for the relationship between the church and state in medieval Europe.","https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Charlemagne_denier_Mayence_812_814.jpg/330px-Charlemagne_denier_Mayence_812_814.jpg","Image: Charlemagne / Wikimedia Commons","https://en.wikipedia.org/wiki/Charlemagne",{"_32":104,"_84":85},[151,152],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":153,"_32":154},"7","religion","73","The Carolingian Renaissance","A revival of art, culture, and learning based on classical models, initiated by Charlemagne's reign.","This cultural flourishing laid the groundwork for the future development of medieval Europe.",0.7,"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Minuscule_caroline.jpg/330px-Minuscule_caroline.jpg","catalogues / illuminatedmanuscripts / record.asp / Wikimedia Commons / Public domain","https://en.wikipedia.org/wiki/Carolingian_Renaissance","images/8718c4f1e7a86d0330fc80e0c60f43f1cb1c3eec.webp",{"_32":104,"_84":85},[169,170],{"_32":74,"_75":76},{"_30":153,"_72":168},"Kushim",{"_30":173,"_32":174},{"_30":171,"_32":172},"9","art","4","intellectual","1580","Charlemagne","A king who united much of Western Europe during the early Middle Ages, he played a crucial role in the Carolingian Renaissance.","His death marked the end of a significant era of cultural and political consolidation in Europe.",742,4,2,814,1,28,{"_32":104,"_84":85},[189,190],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":79,"_32":80},{"_30":102,"_32":103},"1277","Reconquista","This period marks the centuries-long effort by Christian kingdoms to reclaim territory from Muslim rule in the Iberian Peninsula.","The conclusion of this period was marked by the fall of the last Muslim stronghold, leading to the unification of Spain under Christian rule.",718,1492,"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Cantigas_battle.jpg/330px-Cantigas_battle.jpg","Image: Reconquista / Wikimedia Commons","https://en.wikipedia.org/wiki/Reconquista",{"_32":206,"_84":85},[204,205],{"_32":74,"_75":76},{"_30":153,"_72":168},{"_30":79,"_32":80},{"_30":153,"_32":154},"Spain","1195","Beowulf","An Old English epic poem that tells the story of a heroic warrior who battles the monster Grendel. It is the oldest surviving long poem in English and a foundational work of early medieval literature.","The poem influenced later medieval storytelling and remains one of the most important works in English literary history.",700,"https://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Beowulf_Cotton_MS_Vitellius_A_XV_f._132r.jpg/330px-Beowulf_Cotton_MS_Vitellius_A_XV_f._132r.jpg","Image: Beowulf / Wikimedia Commons","https://en.wikipedia.org/wiki/Beowulf",{"_32":221,"_84":221},[219,220],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},{"_30":102,"_32":103},"Global","2297","Lombards","The Lombards were a Germanic people who ruled large parts of Italy after the fall of the Western Roman Empire.","Their kingdom was eventually conquered by the Franks under Charlemagne, integrating into the Carolingian Empire.",568,774,0.5,"https://upload.wikimedia.org/wikipedia/commons/thumb/7/73/Lombard_Kingdom.png/330px-Lombard_Kingdom.png","Image: Lombard Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Lombards",{"_32":237,"_84":85},[236],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"Italy","1063","Medieval Music","The medieval period saw the rise of polyphony and the establishment of musical notation, significantly advancing music theory and practice.","This era set the stage for the Renaissance, influencing the development of Western music.",500,1400,0.3,"","https://en.wikipedia.org/wiki/Music_of_the_medieval_period",{"_32":221,"_84":221},[251,252],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},{"_30":171,"_32":172},"2299","Anglo-Saxons","The Anglo-Saxons were Germanic settlers in Britain, establishing kingdoms after the Roman withdrawal and laying the foundations for medieval England.","The Anglo-Saxon kingdoms unified under the Kingdom of England and were later conquered by the Normans in 1066.",410,1066,"https://upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Anglo-Saxon_England.png/330px-Anglo-Saxon_England.png","Image: Anglo-Saxon England / Wikimedia Commons","https://en.wikipedia.org/wiki/Anglo-Saxons",{"_32":83,"_84":85},[266],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"1295","Attila the Hun","A prominent leader of the Huns, known for his military prowess and campaigns across Europe during the 5th century.","His death marked the decline of the Hunnic Empire, leading to the fragmentation of his forces and the end of his conquests.",406,453,"https://upload.wikimedia.org/wikipedia/commons/thumb/1/1b/Attila_%28K%C3%A9pes_kr%C3%B3nika%29_%28cropped%29.jpg/330px-Attila_%28K%C3%A9pes_kr%C3%B3nika%29_%28cropped%29.jpg","Image: Attila / Wikimedia Commons","https://en.wikipedia.org/wiki/Attila",{"_32":281,"_84":85},[280],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":81,"_32":82},"Hungary","2298","Saxons","The Saxons were a Germanic tribe inhabiting northern Germany and the Netherlands, later migrating to Britain and influencing early medieval England.","Saxon kingdoms merged into the Anglo-Saxon Heptarchy and ultimately into the Kingdom of England.",200,927,0.75,0.6,"https://upload.wikimedia.org/wikipedia/commons/thumb/5/5f/Anglo-Saxon_England_map.png/330px-Anglo-Saxon_England_map.png","https://en.wikipedia.org/wiki/Saxons",{"_32":297,"_84":85},[296],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"Germany","2294","Vandals","The Vandals were an East Germanic tribe that migrated through Europe and North Africa, establishing a kingdom in Carthage and impacting the Western Roman Empire.","Their kingdom was eventually defeated by the Byzantine Empire, but they influenced the history of North Africa and the Mediterranean.",534,"https://upload.wikimedia.org/wikipedia/commons/thumb/9/9f/Vandal_kingdom.png/330px-Vandal_kingdom.png","Image: Vandal Kingdom / Wikimedia Commons","https://en.wikipedia.org/wiki/Vandals",{"_32":311,"_84":312},[310],{"_32":74,"_75":76},{"_30":71,"_72":73},{"_30":102,"_32":103},"Tunisia","Africa",[],"subject",[],[],"yearStart",-300000,"yearEnd",2025,"search","sortBy",true,6]
